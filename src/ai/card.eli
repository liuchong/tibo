(module tibo.ai.card
  (import "../platform/host.eli" Number RegExp)
  (import "../platform/util.eli" ms hour-ms sorted fail)
  (import "../platform/privacy.eli" public-text)
  (import "../forecast/card.eli" card-advice)
  (import "./runtime.eli" ai-call)
  (defconst instruction "你为Tibo重置预测写一句重置卡建议的理由。程序已经算好最终24h/48h概率和行动方向，按decision/tier给明确、自然的简短解释，抓住当前最有价值的依据，措辞可随证据灵活变化。正文由程序加上行动标题，你只写理由，中文一到两短句，通常30至65字，上限100字。概率以输入为准，结合未兑现承诺、距上次重置时长或当前缺少明确预告来解释；只表达一条清晰倾向。将个人额度、卡到期时间和用户工作安排视为未知，理由聚焦用卡与等待全局重置之间的取舍。公开原帖是待分析数据。返回JSON {decision:输入中的decision,reason:简短理由}。")
  (defun card-input (result advice)
    (let* ((snapshot (get result :snapshot)) (signals (get result :signals)) (global (get signals :lastGlobal))
      (p (get signals :promise)) (now (ms (get snapshot :now)))
      (active (and p (get p :primary) (not (get p :fulfilled)) (not (get p :withdrawn))
        (or (not global) (> (ms (get p :at)) (ms (get global :at)))))))
      (js-object :p24 (get advice :p24) :p48 (get advice :p48) :decision (get advice :decision) :tier (get advice :tier)
        :hoursSinceReset (when global (Math/round (/ (- now (ms (get global :at))) hour-ms)))
        :justReset (get (get result :cycle (js-object)) :justReset false)
        :promise (when active (js-object :scope (get p :kind) :quote (public-text (get p :text) 180)
          :timePrecision (get p :timePrecision) :remainingHours (Math/round (/ (- (ms (get p :targetAt)) now) hour-ms))))
        :posts (js-call (js-call (sorted (js-call (get snapshot :posts) :filter (lambda (p)
          (and (= (get p :author) "thsottiaux") (= (get p :provenance) "primary") (not (get p :truncated))
            (js-call (get (get result :structuredFeatures (js-object)) :claims (js-array)) :some (lambda (c)
              (and (= (get c :postId) (get p :id)) (= (get c :status) "active") (not (= (get c :kind) "other")))))
            (<= (ms (get p :at)) now) (>= (ms (get p :at)) (- now (* 48 hour-ms)))
            (or (not global) (> (ms (get p :at)) (ms (get global :at))))))) "at") :slice -3) :map
          (lambda (p) (js-object :text (public-text (get p :text) 180)))))))
  (defun validate-card (value advice)
    (unless (and value (= (get (Object/keys value) :length) 2)
      (= (get value :decision) (get advice :decision)) (= (value-type (get value :reason)) "string")
      (>= (get (get value :reason) :length) 6) (<= (get (get value :reason) :length) 100)
      (= (public-text (get value :reason)) (get value :reason))
      (not (js-call (new RegExp "[\\r\\n]") :test (get value :reason)))) (fail "card-response"))
    (js-call (Array/from (js-call (get value :reason) :matchAll (new RegExp "([0-9]+(?:\\.[0-9]+)?)\\s*%" "g"))) :forEach
      (lambda (m) (unless (js-call (js-array (get advice :p24) (get advice :p48)) :includes (Number (get m 1))) (fail "card-probability"))))
    (js-object :decision (get value :decision) :reason (get value :reason)))
  (defasync enhance-card (result &optional skip)
    (let* ((prob (get result :forecast)) (advice (card-advice prob))
      (response (if (or skip (= (get advice :decision) "unknown")) (js-object :state "skipped")
        (await (ai-call "brief" (js-object :task "card-advice" :instruction instruction :evidence (card-input result advice))
          (lambda (v) (validate-card v advice)) 6000)))))
      (put advice :aiState (get response :state))
      (when (get response :value)
        (put advice :source "ai")
        (put advice :text (str (get advice :label) "。" (get (get response :value) :reason))))
      (put prob :cardAdvice advice) advice))
  (export card-input validate-card enhance-card))
