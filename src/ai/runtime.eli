(module tibo.ai.runtime
  (import "../platform/host.eli" Date Number fetch AbortSignal)
  (import "node:process" :default process)
  (import "node:crypto" createHash randomUUID)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" iso)
  (import "../platform/privacy.eli" source-free-text)
  (import "./conversation.eli" conversation-turns)
  (defconst feature-names (js-array "signals" "research" "search" "forecast" "review" "brief" "router" "translate" "answer" "repair" "oracle" "wish" "trigger" "festival"))
  (defconst token-limits (js-object :signals 1100 :research 1400 :search 220 :forecast 500 :review 320 :brief 650 :router 280 :translate 2800 :answer 1200 :repair 400 :oracle 380 :wish 160 :trigger 120 :festival 240))
  (defconst output-policy "2")
  (defun feature-policy (feature)
    (cond ((= feature "festival") "festival-1") ((= feature "trigger") "trigger-1") ((= feature "wish") "wish-3") ((= feature "oracle") "oracle-2") ((= feature "repair") "repair-2") ((= feature "router") "language-3")
      ((= feature "answer") "chat-2") ((= feature "translate") "text-3") (t output-policy)))
  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defun config ()
    (let* ((env (get process :env)) (key (get env :DEEPSEEK_API_KEY ""))
           (features (js-call (get env :TIBO_AI_FEATURES "") :split ","))
           (weight (Number (get env :TIBO_AI_WEIGHT "0.2"))))
      (js-object :key key :model "deepseek-flash" :endpoint "https://api.deepseek.com/chat/completions"
        :features (js-call feature-names :filter (lambda (name) (js-call features :some (lambda (s) (= (js-call s :trim) name)))))
        :weight (if (Number/isFinite weight) (Math/min 0.35 (Math/max 0 weight)) 0.2)
        :identity (digest (str key "|deepseek-flash|ai-policy-1")))))
  (defun fresh-state (identity) (js-object :identity identity :epoch (randomUUID) :provider (js-object :failures 0 :until 0) :features (js-object) :cache (js-array)))
  (defun failure-policy (status retry-after failures now)
    (let ((scope "provider") (reason "服务异常") (duration 0))
      (cond ((or (= status 401) (= status 403)) (setq reason "认证失败" duration 86400000))
            ((= status 402) (setq reason "余额不足" duration 3600000))
            ((= status 429) (setq reason "限流" duration (Math/max 60000 (Math/min 86400000 retry-after))))
            ((or (= status 400) (= status 404) (= status 422)) (setq scope "feature" reason "请求参数不兼容" duration 21600000))
            ((= status -2) (setq scope "feature" reason "输出未通过校验" duration (if (>= failures 2) 900000 0)))
            (t (setq reason (if (= status 0) "网络或超时" "服务异常")
                     duration (if (>= failures 3) (Math/min 900000 (* 60000 (Math/pow 2 (- failures 3)))) 0))))
      (js-object :scope scope :reason reason :failures failures :until (+ now duration) :status status)))
  (defun retry-delay (value now)
    (let ((seconds (Number value)))
      (if (and value (Number/isFinite seconds)) (* 1000 (Math/max 0 seconds))
        (let ((date (Date/parse (or value "")))) (if (Number/isFinite date) (Math/max 0 (- date now)) 60000)))))
  (defun validation-code (message)
    (cond ((= message "translation-changed-facts") "translation-changed-facts")
          ((or (= message "AI 引用不是输入中的原文") (= message "调研引用不在已抓取资料中")) "citation-not-in-input")
          ((or (= message "AI 调整没有引用") (= message "AI 摘要没有原文引用")) "missing-citation")
          ((= message "AI 概率调整没有未消耗的相关引用") "consumed-or-unrelated-citation")
          ((= message "调研枚举不合法") "invalid-enum")
          ((js-call message :startsWith "oracle-") message)
          (t "invalid-schema")))
  (defun cache-identity (feature payload)
    (let ((input (get payload :evidence)))
      ;; Cache stable evidence, not the ever-changing collection clock. Every hit
      ;; is still revalidated against the current post/window eligibility.
      (digest (JSON/stringify (js-object :publicPolicy "1" :policy (feature-policy feature) :feature feature :instruction (get payload :instruction)
        :conversation (get (conversation-turns (get payload :conversation)) :messages)
        :evidence (if (js-call (js-array "router" "repair") :includes feature) input (Object/fromEntries (js-call (Object/entries input) :filter (lambda (row) (not (= (get row 0) "now")))))))))))
  (defun request-messages (payload)
    (js-call (js-array (js-object :role "system" :content
      (str (source-free-text (get payload :instruction)) " 不提及第三方重置概率预测网站的名字或链接；完成本次指定任务，涉及当前事件的事实只依据本次公开输入。")))
      :concat (get (conversation-turns (get payload :conversation)) :messages)
      (js-array (js-object :role "user" :content (source-free-text (JSON/stringify (get payload :evidence)))))))
  (defun account-usage (state feature usage elapsed)
    (let* ((all (get state :usage (js-object))) (row (get all feature (js-object :calls 0 :promptTokens 0 :completionTokens 0))))
      (put row :calls (+ (get row :calls) 1))
      (put row :promptTokens (+ (get row :promptTokens) (get (or usage (js-object)) :promptTokens 0)))
      (put row :completionTokens (+ (get row :completionTokens) (get (or usage (js-object)) :completionTokens 0)))
      (put row :cacheHitTokens (+ (get row :cacheHitTokens 0) (get (or usage (js-object)) :cacheHitTokens 0)))
      (put row :cacheMissTokens (+ (get row :cacheMissTokens 0) (get (or usage (js-object)) :cacheMissTokens 0)))
      (put row :lastLatencyMs elapsed) (put all feature row) (put state :usage all)))
  ;; Serialize only state admission and reconciliation, never provider I/O.
  (defasync admit-call (cfg feature payload validator contract)
    (await (state-transaction "ai-gateway" (async ()
      (let* ((now (Date/now)) (stored (await (read-state "ai")))
        (state (if (and stored (= (get stored :identity) (get cfg :identity))) stored (fresh-state (get cfg :identity))))
        (provider (get state :provider)) (features (get state :features))
        (previous-local (get features feature (js-object :failures 0 :until 0)))
        (local (if (and (= (get previous-local :status) -2) (not (= (get previous-local :outputPolicy) contract)))
          (js-object :failures 0 :until 0 :revision (get previous-local :revision 0)) previous-local))
        (blocked (if (> (get provider :until) now) provider (if (> (get local :until) now) local nil)))
        (cache-key (cache-identity feature payload))
        (cache (js-call (get state :cache) :filter (lambda (r) (> (get r :until) now))))
        (hit (when (not (= feature "oracle")) (js-call cache :find (lambda (r) (= (get r :key) cache-key))))))
        (when hit
          (try (funcall validator (get hit :value))
            (catch error (setq cache (js-call cache :filter (lambda (r) (not (= (get r :key) cache-key)))) hit nil))))
        (put features feature local) (put state :cache cache)
        (await (write-state "ai" state))
        (cond (blocked (js-object :state "blocked" :reason (get blocked :reason)
          :retryAt (js-call (new Date (get blocked :until)) :toISOString)))
          (hit (js-object :state "cached" :value (funcall validator (get hit :value))
            :assistantContent (get hit :assistantContent (JSON/stringify (get hit :value)))
            :usage (js-object :promptTokens 0 :completionTokens 0)))
          (t (js-object :state "admitted" :started now :cacheKey cache-key :epoch (get state :epoch)
            :providerRevision (get provider :revision 0) :featureRevision (get local :revision 0)))))))))
  (defasync request-call (cfg feature payload validator timeout now)
    (let ((key (get cfg :key)) (status 0) (retry 60000) (value nil) (assistant-content nil)
      (usage nil) (valid false) (stage "transport") (detail nil))
      (try
        (let* ((response (await (fetch (get cfg :endpoint) (js-object :method "POST" :redirect "error"
                :headers (js-object :Content-Type "application/json" :Authorization (str "Bearer " key))
                :signal (AbortSignal/timeout (or timeout 15000))
                :body (JSON/stringify (js-object :model (get cfg :model) :stream false
                :thinking (js-object :type "disabled") :temperature (cond ((js-call (js-array "wish" "festival") :includes feature) 1.2) ((= feature "oracle") 1) (t 0)) :response_format (js-object :type "json_object") :max_tokens (if (= (get payload :task) "conversation-summary") 2048 (get token-limits feature 500))
                  :messages (request-messages payload)))))))
               (body nil))
          (setq status (get response :status) retry (retry-delay (js-call (get response :headers) :get "retry-after") now))
          (when (get response :ok)
            (setq status -2 stage "response-json")
            (let ((text (await (js-call response :text))))
              (when (> (get text :length) 100000) (throw "size"))
              (setq body (JSON/parse text)))
            (let ((u (get body :usage (js-object))))
              (setq usage (js-object :promptTokens (get u :prompt_tokens 0) :completionTokens (get u :completion_tokens 0) :cacheHitTokens (get u :prompt_cache_hit_tokens 0) :cacheMissTokens (get u :prompt_cache_miss_tokens 0))))
            (let* ((choice (get (get body :choices) 0)) (content (get (get choice :message) :content)))
              (setq stage (if (= (get choice :finish_reason) "length") "truncated" "empty-output"))
              (unless (and (= (get choice :finish_reason) "stop") (= (value-type content) "string") (> (get content :length) 0)) (throw "output"))
              (setq stage "output-json" value (JSON/parse content))
              (let ((original (JSON/stringify value)))
                (setq stage "schema" value (funcall validator value) valid t)
                (setq assistant-content (if (= original (JSON/stringify value)) content (JSON/stringify value)))))))
        (catch error
          (when (= stage "schema") (setq detail (validation-code (get error :message ""))))
          (when (or (= (get error :name) "TimeoutError") (= (get error :name) "AbortError")) (setq status 0 stage "timeout"))))
      (js-object :valid valid :status status :retry retry :value value :assistantContent assistant-content
        :usage usage :stage stage :detail detail)))
  (defasync finish-call (cfg feature contract admission outcome)
    (await (state-transaction "ai-gateway" (async ()
      (let* ((state (await (read-state "ai"))) (now (Date/now))
        (valid (get outcome :valid)) (status (get outcome :status)) (usage (get outcome :usage))
        (stage (get outcome :stage)) (detail (get outcome :detail)) (value (get outcome :value))
        (assistant-content (get outcome :assistantContent)))
        ;; Reset or credential replacement invalidates in-flight reconciliation.
        (if (or (not state) (not (= (get state :identity) (get cfg :identity)))
          (not (= (get state :epoch) (get admission :epoch))))
          (js-object :state "fallback" :reason "AI 配置已更新")
          (let* ((features (get state :features)) (provider (get state :provider))
            (local (get features feature (js-object :failures 0 :until 0)))
            (cache (js-call (get state :cache) :filter (lambda (r) (> (get r :until) now))))
            (attempts (get state :lastAttempts (js-object))))
            (account-usage state feature usage (- now (get admission :started)))
            (put attempts feature (js-object :at (iso now) :state (if valid "ok" "fallback")
              :stage (if valid "validated" stage) :validationCode detail :code (if valid 200 status) :usage usage))
            (put state :lastAttempts attempts)
            (let ((result
              (if valid
                (progn
                  ;; A concurrent older success cannot erase a newer failure.
                  (when (= (get provider :revision 0) (get admission :providerRevision))
                    (put state :provider (js-object :failures 0 :until 0 :revision (+ (get provider :revision 0) 1))))
                  (when (= (get local :revision 0) (get admission :featureRevision))
                    (put features feature (js-object :failures 0 :until 0 :revision (+ (get local :revision 0) 1))))
                  (unless (= feature "oracle")
                    (setq cache (js-call cache :filter (lambda (r) (not (= (get r :key) (get admission :cacheKey))))))
                    (js-call cache :push (js-object :key (get admission :cacheKey)
                      :until (+ now (if (js-call (js-array "signals" "research" "search") :includes feature) 21600000 1200000))
                      :value value :assistantContent assistant-content)))
                  (js-object :state "ok" :value value :assistantContent assistant-content :usage usage))
                (let* ((feature-failure (or (= status -2) (= status 400) (= status 404) (= status 422)))
                  (bucket (if feature-failure local provider))
                  (policy (failure-policy status (get outcome :retry) (+ (get bucket :failures 0) 1) now)))
                  (put policy :revision (+ (get bucket :revision 0) 1))
                  (put policy :outputPolicy contract) (put policy :stage stage) (put policy :validationCode detail)
                  ;; A weaker in-flight failure cannot shorten a live circuit
                  ;; established by authentication, balance or rate limiting.
                  (when (and (> (get bucket :until 0) now) (> (get bucket :until 0) (get policy :until)))
                    (setq policy (Object/assign (js-object) bucket
                      (js-object :failures (get policy :failures) :revision (get policy :revision)))))
                  (if (= (get policy :scope) "feature") (put features feature policy) (put state :provider policy))
                  (js-object :state "fallback" :reason (get policy :reason) :code status
                    :retryAt (if (> (get policy :until) now) (iso (get policy :until)) nil))))))
              (put state :cache (js-call cache :slice -128))
              (await (write-state "ai" state)) result))))))))
  (defasync ai-call (feature payload validator &optional timeout)
    (let* ((cfg (config)) (key (get cfg :key)) (contract (feature-policy feature)))
      (cond ((= (get key :length) 0) (js-object :state "disabled" :reason "未配置密钥"))
        ((not (js-call (get cfg :features) :includes feature)) (js-object :state "disabled" :reason "功能未启用"))
        ((> (+ (get (JSON/stringify (get payload :evidence)) :length) (get (JSON/stringify (get payload :conversation (js-array))) :length))
          (if (= (get payload :inputMode) "conversation") 4000000 24000))
          (js-object :state "skipped" :reason "任务输入超限，保留基础判断"))
        (t (try
          (let ((admission (await (admit-call cfg feature payload validator contract))))
            (if (not (= (get admission :state) "admitted")) admission
              (let ((outcome (await (request-call cfg feature payload validator timeout (get admission :started)))))
                (await (finish-call cfg feature contract admission outcome)))))
          (catch error (js-object :state "fallback" :reason "AI 状态暂不可用")))))))
  (defasync ai-status ()
    (let ((cfg (config)))
      (try
        (let ((stored (await (read-state "ai"))))
          (js-object :model (get cfg :model) :configured (> (get (get cfg :key) :length) 0)
            :enabledFeatures (get cfg :features) :weight (get cfg :weight) :tokenLimits token-limits
            :usage (if (and stored (= (get stored :identity) (get cfg :identity))) (get stored :usage (js-object)) nil)
            :lastAttempts (if (and stored (= (get stored :identity) (get cfg :identity))) (get stored :lastAttempts (js-object)) nil)
            :circuit (if (and stored (= (get stored :identity) (get cfg :identity)))
                       (js-object :provider (get stored :provider) :features (get stored :features) :cached (get (get stored :cache) :length)) nil)))
        (catch error (js-object :state "unavailable")))))
  (defasync reset-ai (&optional backup-key)
    (await (state-transaction "ai-gateway" (async ()
      (when backup-key (await (write-state backup-key (js-object :kind "ai" :at (iso (Date/now)) :value (await (read-state "ai"))))))
      (await (write-state "ai" (fresh-state (get (config) :identity))))))))
  (export feature-names feature-policy config ai-call failure-policy retry-delay ai-status reset-ai))
