(module tibo.ai.semantic-recovery
  (import "../platform/host.eli" Date Promise Number TextEncoder)
  (import "node:crypto" createHash)
  (import "node:timers" setTimeout clearTimeout)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" canonical-text ms)
  (import "./semantic-contract.eli" build-semantic-input decode-semantic)
  (import "./runtime.eli" ai-call config)
  (defconst semantic-policy "semantic-reset-4")
  (defconst principles "你是官方公告语义分析器。输入均为公开资料。先理解每条消息的真实讨论对象，再判断语气、状态及事件关系。每个否定要绑定被否定的命题：否定已完成只说明交付尚未发生，原有承诺继续有效；撤回承诺才表示未来安排取消。结合按时间排列的前文、官方引用和每日计划解释省略、否定、转折、反讽及跨句表述。额度重置、产品功能上线、banked手动卡和个人每周刷新分别归类。产品覆盖所有用户不意味着额度重置。每日二选一属于条件计划，当日选定reset属于该日交付承诺，回复的将来时间补充期限；延期需要表达改变原有安排。完成状态描述已有事实，后句祝语里的明日不改变前句已完成状态。将作者本人的断言与引用他人的话分开。明确安排与意向、期待、可能分别标注。boundary是唯一已确认重置边界，当前承诺与已完成历史分开。每条判断引用本行连续4至180字符原文，并提供解释所指对象所用的contextRefs；scope不明用unknown。判断所指事件可依据语义关联，不伪造官方引用。")
  (defun instruction (profile)
    (str principles " contextRefs/basisRefs使用本次输入中截至now已经公开的原帖ref；后续本人回复可以补充此前公告的对象或期限，断言at仍属于原帖。所引用的关联与原帖自身表达分开，不将后文当作原帖逐字内容。"
      (cond ((= profile "main")
        " 一次返回全部7个windows的评分和重要原帖断言。每个窗口的allowedRefs是唯一可引用集合，正文已带windows成员。support/opposition/commitment/imminence各为0..1，分别衡量对下一次重置的支持、反对、确定性、时间接近程度；历史窗口只描述历史表达，旧已完成前的预告不支持下一次，同日产品改进不构成反对。无证据为0，非零数值须引用窗口内原文。返回JSON {dimensions:{窗口name:{support,opposition,commitment,imminence,citations:[{ref,quote}]}},postClaims:[{ref,kind,subject,scope,statement,quote,contextRefs,timeText,timing,contextMissing}],documentClaims:[]}。kind:promise/hint/incident/programme/progress/release/completion/negation/other；subject:codex-usage/chatgpt-work-usage/product-change/personal-task/unknown；scope:global/banked/partial/unknown；statement:future/completed/conditional/negated/unknown。postClaims只用p开头ref，资料断言放documentClaims，不能混入推文。最多16个重要断言。原帖断言优先覆盖boundary之后的全部相关消息；更早原帖只供历史窗口解释，长期条件计划保留。明确的落地期限属于promise、future、commitment，省略对象由上下文补齐。timeText为quote中的原样时间词或null；timing为null或{stance,window,amount,zone}。stance:commitment/expectation/intention/possibility/conditional/negated/unknown，window:within-hours/within-days/today/tomorrow/soon/this-week/next-week/unspecified，amount仅原文明写数字时长，zone:PST/PDT/PT/UTC/unknown。完成公告kind=completion，subject为额度，scope=global，statement=completed；没有具体时间的当日决定仍是promise，保留Day标签。原承诺存在且后文仅否定已完成时，保留promise/future；negation用于撤回安排或否定未来预期，不把它当作取消既有承诺。只输出JSON。")
        ((= profile "chain")
          " 独立重建承诺—期限—交付事件链，检查全部近期原帖是否有被遗漏的承诺或完成，保留相关历史前文作对象依据。返回JSON {links:[{ref,object,status,scope,quote,basisRefs}]}。object:quota_reset/product_release/campaign/other；status:promise/deadline/fulfilled/delayed/withdrawn/conditional/irrelevant；scope:global/banked/partial/unknown。时间字段由主分析提供，本次聚焦对象和状态。basisRefs是用于确认所指事件的其他原帖ref。普通无关消息省略，产品上线归product_release，长期二选一归campaign，额度已交付归quota_reset+fulfilled。仅用p开头原帖ref。不要返回概率。")
        (t " 重新从完整的相关原文重建所指对象、状态及前后关联，独立裁决，没有给你其他分析的结论。返回简化JSON {decisions:{原帖ref:{subject,state,scope,quote,contextRefs}}}。subject:usage_reset/product_update/other；state:planned/conditional/completed/delayed/cancelled/unclear；scope:global/banked/partial/unknown。contextRefs保留具体承诺及期限的关联。仅用p开头原帖ref，普通无关消息省略。"))))
  (defun compact-input (input)
    ;; Include the current full recent sequence, not only a classifier's candidates.
    (let* ((last (get (get input :posts) (- (get (get input :posts) :length) 1)))
      (anchor (if last (ms (get last :at)) 0))
      (ids (get (get input :windows 0) :ids (js-array)))
      (posts (js-call (get input :posts) :filter (lambda (p)
        (or (>= (ms (get p :at)) (- anchor 259200000))
          (= (get p :id) (get (get input :lastGlobal (js-object)) :id))
          (= (get p :id) (get (get input :promise (js-object)) :programmePostId))
          (js-call (get p :windows) :includes "latest_three")))))
      (extra (js-array)))
      ;; Preserve programme and parent/reference context even outside recent dates.
      (js-call (get input :posts) :forEach (lambda (p)
        (when (or (js-call posts :some (lambda (child) (or (= (get child :parentId) (get p :id))
            (js-call (get child :resetContextPostIds (js-array)) :includes (get p :id)))))
          (js-call (get (get input :promise (js-object)) :programmePostIds (js-array)) :includes (get p :id)))
          (unless (js-call posts :includes p) (js-call extra :push p)))))
      (js-object :now (get input :now) :boundary (get input :boundary)
        :posts (js-call (js-call posts :concat extra) :sort (lambda (a b) (- (ms (get a :at)) (ms (get b :at)))))
        :documents (js-array) :windows (get input :windows) :promise (get input :promise))))
  (defun fingerprint (input)
    (js-call (js-call (createHash "sha256") :update (JSON/stringify
      (js-object :policy semantic-policy :providerIdentity (get (config) :identity) :boundary (get input :boundary)
        :posts (get input :posts) :documents (get input :documents)
        :windows (js-call (get input :windows) :map (lambda (w) (js-array (get w :name) (get w :ids))))))) :digest "hex"))
  (defun same-decision? (a b)
    (and (= (get a :postId) (get b :postId)) (= (get a :subject) (get b :subject))
      (= (get a :scope) (get b :scope)) (= (get a :kind) (get b :kind)) (= (get a :statement) (get b :statement)) (= (get a :semanticDelayed) (get b :semanticDelayed))
      (or (= (get (get a :contextPostIds) :length) 0) (= (get (get b :contextPostIds) :length) 0)
        (js-call (get a :contextPostIds) :some (lambda (id) (js-call (get b :contextPostIds) :includes id))))))
  (defun combine-opinions (opinions &optional boundary)
    (let ((claims (js-array)) (dimensions (js-array)) (errors (js-array)) (rows (js-array)) (pending false))
      (js-call opinions :forEach (lambda (opinion)
        (setq errors (js-call errors :concat (get opinion :errors)))
        (js-call (get opinion :dimensions) :forEach (lambda (score)
          (unless (js-call dimensions :some (lambda (old) (= (get old :name) (get score :name)))) (js-call dimensions :push score))))
        (js-call (get opinion :claims) :forEach (lambda (c)
          (let* ((votes (get (js-call opinions :filter (lambda (o)
              (js-call (get o :claims) :some (lambda (other) (same-decision? c other))))) :length))
            (critical (and (= (get c :scope) "global")
              (js-call (js-array "codex-usage" "chatgpt-work-usage") :includes (get c :subject))
              (or (js-call (js-array "completion" "promise" "negation") :includes (get c :kind)) (get c :semanticDelayed)))))
            (when (and critical (< votes 2)) (setq pending t))
            (when (and (or (not critical) (>= votes 2))
              (not (js-call claims :some (lambda (old) (same-decision? old c)))))
              (js-call claims :push (Object/assign (js-object) c (js-object :votes votes :semanticAgreed (>= votes 2))))))))))
      ;; One majority decision supersedes a dissent about the same source and object.
      (setq pending (js-call opinions :some (lambda (opinion)
        (js-call (get opinion :claims) :some (lambda (c)
          (and (or (not boundary) (> (ms (get c :at)) (ms boundary))) (= (get c :scope) "global") (or (js-call (js-array "completion" "promise" "negation") :includes (get c :kind)) (get c :semanticDelayed))
            (not (js-call claims :some (lambda (accepted)
              (and (get accepted :semanticAgreed)
                (or (= (get accepted :postId) (get c :postId))
                  (and (= (get accepted :kind) "completion") (> (ms (get accepted :at)) (ms (get c :at)))))))))))))))
      (js-call claims :forEach (lambda (c)
        (when (= (get c :sourceKind) "post")
          (let ((row (js-call rows :find (lambda (r) (= (get r :postId) (get c :postId))))))
            (unless row (setq row (js-object :postId (get c :postId) :extractor "post-claims-3" :claims (js-array))) (js-call rows :push row))
            (js-call (get row :claims) :push c)))))
      (js-object :claims claims :rows rows :dimensions dimensions :errors errors :pending pending)))
  (defasync bounded-request (request profile input timeout)
    (let ((timer nil))
      (try (await (Promise/race (js-array (funcall request profile input timeout)
        (new Promise (lambda (resolve) (setq timer (setTimeout (lambda () (funcall resolve (js-object :state "fallback" :code 0))) timeout)))))))
        (finally (when timer (clearTimeout timer))))))
  (defasync provider-request (profile input timeout)
    (let ((size (get (js-call (new TextEncoder) :encode (str (instruction profile) (JSON/stringify input))) :length)))
      (if (> size 970000) (js-object :state "skipped" :code -3)
        (await (ai-call "signals" (js-object :task (str "semantic-" profile) :contract (str semantic-policy "-" profile)
          :inputMode "dimension-assessment" :instruction (instruction profile) :evidence input)
          (lambda (value) (let ((decoded (decode-semantic value input profile)))
            (put decoded :decoded t) decoded)) timeout)))))
  (defasync analyze-semantic (raw-input &optional options)
    (setq options (or options (js-object)))
    (let* ((input (build-semantic-input raw-input)) (revision (fingerprint input))
      (key (str "semantic-" revision)) (directory (get options :directory))
      (budget (Math/min 60000 (Math/max 20 (get options :budgetMs 60000))))
      (max-attempts (Math/min 3 (Math/max 1 (get options :maxAttempts 3))))
      (request (get options :request provider-request)))
      (await (state-transaction key (async ()
        (let* ((saved (await (read-state key directory))) (started (Date/now))
          (opinions (js-array)) (calls (js-array)) (combined (combine-opinions opinions))
          (tries 0) (stop false) (retry-at (+ started 3600000)))
          (if (and saved (= (get saved :policy) semantic-policy)
            (or (= (get saved :analysisState) "ready") (> (get saved :retryAt 0) started)))
            (Object/assign (js-object) saved (js-object :state (if (= (get saved :analysisState) "ready") "cached" "blocked")))
            (progn
              (while (and (not stop) (< tries max-attempts) (< (- (Date/now) started) budget))
                (let* ((profile (get (js-array "main" "chain" "repair") tries))
                  (wire (if (= profile "main") input (compact-input input)))
                  (timeout (Math/max 1 (Math/min 20000 (- budget (- (Date/now) started)))))
                  (response (try (await (bounded-request request profile wire timeout))
                    (catch error (js-object :state "fallback" :code 0))))
                  (decoded nil))
                  (setq tries (+ tries 1))
                  (js-call calls :push (js-object :profile profile :state (get response :state) :code (get response :code)))
                  (when (get response :value)
                    (try (setq decoded (if (get (get response :value) :decoded) (get response :value)
                      (decode-semantic (get response :value) wire profile)))
                      (js-call opinions :push decoded)
                      (catch error (js-call calls :push (js-object :profile profile :validationCode (get error :message))))))
                  (setq combined (combine-opinions opinions (get (get input :boundary) :confirmedAt)))
                  (when (and (>= (get opinions :length) 2) (not (get combined :pending))) (setq stop t))
                  (when (or (js-call (js-array 401 402 403 429 400 404 422) :includes (get response :code))
                    (= (get response :state) "disabled") (and (= (get response :state) "blocked") (not (= (get response :code) -2)))) (setq stop t))))
              (Object/assign combined (js-object :policy semantic-policy :revision revision :calls calls :attempts tries
                :analysisState (if (and (>= (get opinions :length) 2) (not (get combined :pending))) "ready" "pending")
                :state (if (> (get opinions :length) 0) "ok" "fallback") :retryAt retry-at))
              (await (write-state key combined directory)) combined)))) (Math/max 1000 (+ budget 2000)) directory))))
  (export analyze-semantic build-semantic-input combine-opinions semantic-policy))
