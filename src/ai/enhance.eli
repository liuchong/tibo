(module tibo.ai.enhance
  (import "./dimensions.eli" assess-dimensions)
  (import "../evidence/dimensions.eli" dimension-input)
  (import "../forecast/dimensions.eli" apply-dimensions)
  (import "../forecast/features.eli" feature-state apply-structured-promise)
  (import "../forecast/reset-timing.eli" timing-assessment)
  (import "../forecast/promise-policy.eli" apply-promise-policy)
  (import "../platform/privacy.eli" public-text)
  (import "../evidence/post-context.eli" post-context)
  (import "../evidence/research.eli" documents-from sources-of)
  (import "../platform/util.eli" ms fail canonical-text)
  (defun public-event (event)
    (when event (js-object :id (public-text (get event :id) 100) :at (get event :at) :global (get event :global) :banked (get event :banked)
      :provenance (if (= (get event :provenance) "primary") "primary" "archive") :verified (get event :verified)
      :text (public-text (canonical-text (get event :text "")) 800))))
  (defun text? (value limit) (and (= (value-type value) "string") (> (get (js-call value :trim) :length) 0) (<= (get value :length) limit)))
  (defun evidence (result)
    (let* ((snapshot (get result :snapshot)) (now (get snapshot :now))
      (context (post-context (get snapshot :posts) now (get (get result :signals) :lastGlobal))))
      (js-object :now now :posts (get context :posts) :cycle (get result :cycle)
        :forecastCases (get snapshot :forecastCases (js-array)) :programme (get context :programme)
        :selection (get context :selection) :recentPostCount (get context :recentCount) :documents (documents-from snapshot)
        :lastGlobal (public-event (get (get result :signals) :lastGlobal)) :lastBanked (public-event (get (get result :signals) :lastBanked))
        :baseline (js-object :p24 (get (get result :forecast) :p24) :p48 (get (get result :forecast) :p48)))))
  (defun citation (item input)
    (unless (and item (text? (get item :postId) 100) (text? (get item :quote) 500)) (fail "AI 引用字段不合法"))
    (let ((post (js-call (sources-of input) :find (lambda (p) (= (get p :id) (get item :postId))))))
      (unless (and post (js-call (canonical-text (get post :text)) :includes (canonical-text (get item :quote)))) (fail "AI 引用不是输入中的原文"))
      (js-object :postId (get item :postId) :quote (canonical-text (get item :quote)) :provenance (get post :provenance))))
  (defun validate-brief (value input)
    (unless (and value (text? (get value :summary) 800) (Array/isArray (get value :followups))
      (>= (get (get value :followups) :length) 2) (<= (get (get value :followups) :length) 4)
      (js-call (get value :followups) :every (lambda (s) (text? s 160)))
      (Array/isArray (get value :citations)) (<= (get (get value :citations) :length) 5)) (fail "AI brief 输出格式不合法"))
    (let ((refs (js-call (get value :citations) :map (lambda (c) (citation c input)))))
      (when (and (> (get (get input :posts) :length) 0) (= (get refs :length) 0)) (fail "AI 摘要没有原文引用"))
      (js-object :summary (get value :summary) :followups (get value :followups) :citations refs)))
  (defun active-posts (input)
    (js-call (get input :posts) :filter (lambda (p)
      (and (or (not (get input :lastGlobal)) (> (ms (get p :at)) (ms (get (get input :lastGlobal) :at))))
        (js-call (get (get input :structuredFeatures (js-object)) :claims (js-array)) :some (lambda (c)
          (and (= (get c :postId) (get p :id)) (= (get c :status) "active") (not (= (get c :kind) "other")))))))))
  (defun task-input (name input)
    (let ((base (js-object :now (get input :now)
      :posts (js-call (get input :posts) :map (lambda (p)
        (js-object :id (get p :id) :at (get p :at) :text (public-text (canonical-text (get p :text)) 1200)
          :quoteText (public-text (canonical-text (get p :quoteText "")) 400) :truncated (get p :truncated false) :provenance (get p :provenance))))
      :lastGlobal (get input :lastGlobal) :lastBanked (get input :lastBanked) :programme (get input :programme)
      :claims (js-call (get (get input :structuredFeatures (js-object)) :claims (js-array)) :map (lambda (c)
        (js-object :postId (get c :postId) :kind (get c :kind) :subject (get c :subject) :scope (get c :scope)
          :statement (get c :statement) :quote (get c :quote) :status (get c :status) :targetAt (get c :targetAt)
          :timeText (get c :timeText) :timing (get c :timing) :expectedWindow (get c :expectedWindow)
          :contextMissing (get c :contextMissing)))))))
      (cond ((= name "search") (js-object :posts (js-call (active-posts input) :map (lambda (p)
        (js-object :id (get p :id) :text (public-text (canonical-text (get p :text)) 1200))))
        :knownDocuments (js-call (get input :documents) :map (lambda (d) (js-object :id (get d :id) :type (get d :type) :text (js-call (get d :text) :slice 0 300))))))
        ((= name "research") (Object/assign base (js-object :documents (get input :documents))))
        (t (Object/assign base (js-object :final (get input :final) :research (get input :research)))))))
  (defasync enhance (result &optional skip)
    (let* ((input (dimension-input result)) (extraction (await (assess-dimensions input skip)))
      (features (js-object)) (prob (get result :forecast)))
      (put extraction :posts (get input :posts))
      (let ((structured (feature-state result extraction)))
        (put result :structuredFeatures structured)
        (apply-structured-promise result structured)
        ;; Re-evaluate semantic promises against the same temporal baseline.
        (put prob :p24 (get prob :base24)) (put prob :p48 (get prob :base48))
        (apply-promise-policy prob (get result :signals) (get result :snapshot))
        (apply-dimensions result input extraction)
        (put prob :timingAssessment (timing-assessment structured (get prob :dimensions))))
      (put features :signals (js-object :state (get extraction :state) :aiRows (get extraction :aiRows)
        :ruleRows (get extraction :ruleRows) :calls (get extraction :calls) :value (js-object :rows (get extraction :rows))))
      (js-call (js-array "forecast" "review") :forEach (lambda (name)
        (put features name (js-object :state "retired" :reason "概率由自有算法计算"))))
      (js-call (js-array "search" "research" "brief") :forEach (lambda (name)
        (put features name (js-object :state (if (js-call (js-array "ok" "cached") :includes (get extraction :state)) "merged" "skipped")))))
      (put (get prob :information) :ai (if (js-call (js-array "ok" "cached") :includes (get extraction :state)) "维度评分可用" "规则维度降级"))
      (put result :ai (js-object :features features :baseline (js-object :p24 (get prob :base24) :p48 (get prob :base48))
        :weight 0 :documents (get input :documents) :windows (get input :windows)
        :recentPostCount (get (get (get input :windows) 2) :count)
        :postIds (js-call (get input :posts) :map (lambda (p) (get p :id))))) result))
  (export enhance evidence validate-brief task-input active-posts))
