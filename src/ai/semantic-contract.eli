(module tibo.ai.semantic-contract
  (import "../platform/host.eli" Number Map)
  (import "../platform/util.eli" fail canonical-text ms)
  (import "../evidence/reset-timing.eli" checked-timing local-timing)
  (import "../evidence/post-features.eli" feature-contract)
  (defun build-semantic-input (input)
    (let* ((windows (get input :windows))
      (posts (js-call (get input :posts) :map (lambda (p i)
        (let ((row (Object/fromEntries (js-call (Object/entries p) :filter (lambda (pair)
          (js-call (js-array "id" "at" "author" "text" "provenance" "truncated" "parentId" "parentText" "quoteText"
            "resetContextText" "resetContextPostIds" "programmeChoice") :includes (get pair 0)))))))
          (put row :ref (str "p" i)) (put row :sourceKind "post")
          (put row :windows (js-call (js-call windows :filter (lambda (w) (js-call (get w :ids) :includes (get p :id)))) :map (lambda (w) (get w :name)))) row))))
      (documents (js-call (get input :documents (js-array)) :map (lambda (p i)
        (js-object :ref (str "d" i) :sourceKind "document" :id (get p :id) :at (get p :at) :text (get p :text) :provenance (get p :provenance)))))
      (sources (js-call posts :concat documents)))
      (js-object :schemaVersion 2 :now (get input :now) :lastGlobal (get input :lastGlobal) :promise (get input :promise)
        :boundary (js-object :confirmedResetId (get (get input :lastGlobal (js-object)) :id)
          :confirmedAt (get (get input :lastGlobal (js-object)) :at))
        :posts posts :documents documents
        :windows (js-call windows :map (lambda (w)
          (Object/assign (js-object) w (js-object :allowedRefs (js-call (js-call sources :filter
            (lambda (p) (js-call (get w :ids) :includes (get p :id)))) :map (lambda (p) (get p :ref))))))))))
  (defun source-for (input ref)
    (js-call (js-call (get input :posts) :concat (get input :documents (js-array))) :find
      (lambda (p) (or (= (get p :ref) ref) (= (get p :id) ref)))))
  (defun reference (input ref &optional window)
    (let* ((id (or (get ref :ref) (get ref :postId))) (source (source-for input id))
      (quote (when (= (value-type (get ref :quote)) "string") (canonical-text (get ref :quote)))))
      (unless source (fail "semantic-source-reference"))
      (unless (and quote (>= (get quote :length) 4) (<= (get quote :length) 220)
        (js-call (canonical-text (get source :text)) :includes quote)) (fail "semantic-quote"))
      (when (and window (not (js-call (get window :ids) :includes (get source :id)))) (fail "semantic-window-reference"))
      (js-object :postId (get source :id) :quote quote)))
  (defun semantic-claim (item input)
    (let* ((ref (or (get item :ref) (get item :postId))) (source (source-for input ref))
      (proof (reference input (js-object :ref ref :quote (get item :quote))))
      (object (get item :object (get item :subject)))
      (status (get item :status (get item :state)))
      (kind (get item :kind (cond ((= object "campaign") "programme")
        ((= object "product_release") "release") ((= status "fulfilled") "completion")
        ((= status "completed") "completion") ((= status "conditional") "programme")
        ((js-call (js-array "promise" "deadline" "planned" "delayed") :includes status) "promise")
        ((js-call (js-array "withdrawn" "cancelled") :includes status) "negation") (t "other"))))
      (subject (cond ((js-call (js-array "usage_reset" "quota_reset" "campaign") :includes object) "codex-usage")
        ((js-call (js-array "product_update" "product_release") :includes object) "product-change") (t (or object "unknown"))))
      (statement (get item :statement (cond ((= status "conditional") "conditional")
        ((js-call (js-array "fulfilled" "completed") :includes status) "completed")
        ((js-call (js-array "promise" "deadline" "planned" "delayed") :includes status) "future")
        ((js-call (js-array "withdrawn" "cancelled") :includes status) "negated") (t "unknown"))))
      (scope (get item :scope "unknown")) (quote (get proof :quote))
      (time (get item :timeText)) (refs (get item :contextRefs (get item :basisRefs (get item :contextPostIds (js-array)))))
      (context-ids (js-array)) (timing nil) (timing-error nil))
      (unless (<= (ms (get source :at)) (ms (get input :now))) (fail "semantic-source-time"))
      (unless (and (js-call (js-array "promise" "hint" "incident" "programme" "progress" "release" "completion" "negation" "other") :includes kind)
        (js-call (js-array "codex-usage" "chatgpt-work-usage" "product-change" "personal-task" "unknown") :includes subject)
        (js-call (js-array "global" "banked" "partial" "unknown") :includes scope)
        (js-call (js-array "future" "completed" "conditional" "negated" "unknown") :includes statement)
        (Array/isArray refs) (<= (get refs :length) 12)) (fail "semantic-claim-enum"))
      (js-call refs :forEach (lambda (ref)
        (let ((other (source-for input ref)))
          ;; Later public replies can explain an earlier announcement. The
          ;; observation cutoff, rather than that announcement's time, bounds
          ;; available context; the claim keeps its original publication time.
          (unless (and other (<= (ms (get other :at)) (ms (get input :now)))) (fail "semantic-context-reference"))
          (js-call context-ids :push (get other :id)))))
      (when (and time (not (and (= (value-type time) "string") (js-call quote :includes time))))
        (setq time nil timing-error "semantic-time-reference"))
      (try (setq timing (checked-timing (or (get item :timing) (local-timing kind quote time)) time quote))
        (catch error (setq timing nil timing-error "semantic-timing-schema")))
      (js-object :postId (get source :id) :at (get source :at) :kind kind :subject subject :scope scope :statement statement
        :quote quote :quoteStart (js-call (canonical-text (get source :text)) :indexOf quote)
        :quoteEnd (+ (js-call (canonical-text (get source :text)) :indexOf quote) (get quote :length))
        :timeText time :timing timing :timingError timing-error
        :contextPostIds context-ids :contextMissing (or (get item :contextMissing false) (get source :truncated false))
        :sourceKind (get source :sourceKind) :provenance (get source :provenance)
        :semanticValidated t :semanticDelayed (= status "delayed") :extractorVersion feature-contract)))
  (defun decode-semantic (value input profile)
    (unless (and value (= (value-type value) "object")
      (or (get value :dimensions) (get value :postClaims) (get value :rows) (get value :links) (get value :decisions)))
      (fail "semantic-envelope"))
    (let ((claims (js-array)) (dimensions (js-array)) (errors (js-array)) (items (js-array)) (rows (new Map)))
      (let ((raw (get value :dimensions)))
        (js-call (get input :windows) :forEach (lambda (window)
          (let* ((name (get window :name)) (score (if (Array/isArray raw)
              (js-call raw :find (lambda (r) (= (get r :name) name))) (get (or raw (js-object)) name))))
            (when score
              (try
                (js-call (js-array "support" "opposition" "commitment" "imminence") :forEach (lambda (key)
                  (let ((n (get score key))) (unless (and (Number/isFinite n) (>= n 0) (<= n 1)) (fail "semantic-score")))))
                (unless (and (Array/isArray (get score :citations)) (<= (get (get score :citations) :length) 4)) (fail "semantic-citations"))
                (let ((refs (js-call (get score :citations) :map (lambda (r) (reference input r window)))))
                  (when (and (> (+ (get score :support) (get score :opposition) (get score :commitment) (get score :imminence)) 0)
                    (= (get refs :length) 0)) (fail "semantic-unreferenced-score"))
                  (js-call dimensions :push (Object/assign (js-object) score (js-object :name name :citations refs))))
                (catch error (js-call errors :push (js-object :path (str "dimensions." name) :code (get error :message)))))))))
      (js-call (get value :rows (js-array)) :forEach (lambda (row)
        (js-call (get row :claims (js-array)) :forEach (lambda (c)
          (js-call items :push (Object/assign (js-object) c (js-object :postId (get row :postId))))))))
      (js-call (js-array "postClaims" "documentClaims" "links") :forEach (lambda (key)
        (when (Array/isArray (get value key)) (setq items (js-call items :concat (get value key))))))
      (when (get value :decisions)
        (js-call (Object/entries (get value :decisions)) :forEach (lambda (pair)
          (js-call items :push (Object/assign (js-object) (get pair 1) (js-object :ref (get pair 0)))))))
      (js-call items :forEach (lambda (item i)
        (try (let ((claim (semantic-claim item input)))
          (js-call claims :push claim)
          (when (get claim :timingError)
            (js-call errors :push (js-object :path (str "claims." i ".timing") :code (get claim :timingError)))))
          (catch error (js-call errors :push (js-object :path (str "claims." i) :code (get error :message)
            :ref (or (get item :ref) (get item :postId))))))))
      (js-call claims :forEach (lambda (c)
        (when (= (get c :sourceKind) "post")
          (let ((row (js-call rows :get (get c :postId))))
            (unless row (setq row (js-object :postId (get c :postId) :extractor feature-contract :claims (js-array)))
              (js-call rows :set (get c :postId) row))
            (js-call (get row :claims) :push c)))))
      (js-object :claims claims :rows (Array/from (js-call rows :values)) :dimensions dimensions :errors errors :profile profile)))
  )
  (export build-semantic-input decode-semantic semantic-claim))
