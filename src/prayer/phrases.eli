(module tibo.prayer.phrases
  ;; Five progression pools, twelve short lines each; counters do not depend on prose.
  (defconst lines (js-array
    (js-array
      "香火亮了，屏幕旁多了一点暖色。"
      "光标闪个不停，像在替灵感敲门。"
      "键盘敲累了，来这里换个心情。"
      "这点香火，留给还没想明白的那行代码。"
      "窗外有风，桌边有光，今天慢慢来。"
      "键盘想歇一下，光标倒还在蹦迪。"
      "给脑子放个小假，灵感说不定就来了。"
      "把卡住的思路放下，香炉替你暖一会儿。"
      "愿望可以很长，这句话替你短一点。"
      "桌上添盏小灯，今晚有个好开头。"
      "先歇口气，代码不会趁你喝水跑掉。"
      "这一点亮光，送给正在努力的你。")
    (js-array
      "又见面了，给你的杯子留了个位置。"
      "熟客到场，香炉边的小凳子归你。"
      "代码有时绕路，你记得回来歇歇。"
      "变量还没起好名字，今天的晚饭倒可以先定。"
      "先吹凉咖啡，再吹散一点烦心事。"
      "灵感刚探头，先别急着给它写注释。"
      "来都来了，顺便把肩膀也放松一下。"
      "这盏灯认得你，今晚不用摸黑找路。"
      "代码可以重构，午饭别重热太多回。"
      "桌面可以乱，晚饭可别忘。"
      "愿望带到了，耳机可以摘下来透口气。"
      "写代码的手，也值得捧一会儿热茶。")
    (js-array
      "你和这盏灯，已经攒了不少小故事。"
      "难题开始绕圈，咱们先走直线去吃饭。"
      "愿望越攒越厚，蒲团倒还是软的。"
      "灯下的脚步熟了，回家的路也要记得。"
      "键盘声里，偶尔也该混一点笑声。"
      "代码再长，枕头也不负责续写。"
      "再绕的思路，走到这儿也能喘口气。"
      "咖啡杯圈了不少地图，今天往好消息走。"
      "那些还没命名的变量，今晚也有家可回。"
      "今天给难题搬把椅子，慢慢谈。"
      "思路打了结，喝口水再找线头。"
      "留下点光，给下次突然冒出来的灵感。")
    (js-array
      "老朋友来了，灯芯都亮得精神些。"
      "这儿有你的位置，也有你暂放的烦恼。"
      "难题还没说完，热茶已经续上了。"
      "好主意在散步，灵感未必坐工位。"
      "香火热闹归热闹，晚饭还是得趁热吃。"
      "代码写长了，记得看看远处的树。"
      "光标一闪一闪，像在提醒你眨眨眼。"
      "这盏灯陪你赶过路，也陪你慢下来。"
      "咖啡不写代码，陪你坐着倒很认真。"
      "夜里有人写代码，也有人替灯添光。"
      "今天来得正好，月亮刚把窗边照亮。"
      "灯下有空位，心事放下来就好。")
    (js-array
      "方丈来了，今天的茶可以泡浓一点。"
      "灯火连成了街，给路过的灵感指个方向。"
      "香火旺成这样，月亮路过都想蹭个暖。"
      "蒲团坐熟了，偶尔也出去晒晒太阳。"
      "你把小小的仪式，过成了日常的陪伴。"
      "灯光攒得够久，连雨夜都有了暖色。"
      "这桌故事够多了，今晚换你听听风。"
      "灯已经够亮了，今天不用靠屏幕照脸。"
      "门边多点了一盏灯，照你来的那条路。"
      "好消息还在路上，热茶已经在桌上。"
      "难题先放旁边，今晚不让它点菜。"
      "灯火亮成这样，今晚记得睡个好觉。")))
  (defconst wishes (js-array
    "愿汝夜里睡得安稳，token留给醒来的好想法。"
    "本神愿汝token花得值得，代码渐清楚，今晚睡得香。"
    "本座祝汝token陪灵感走远，调试少兜圈，收工有晚霞。"
    "愿汝token用在妙处，测试给好消息，咖啡仍有温度。"
    "善信，愿思路比token跑得快，好代码写完还有好心情。"
    "本神愿汝token陪你解开线头，难题说清，眉头舒展。"
    "本座愿汝token跟得上思路，Agent认准方向，脚步轻快。"
    "愿汝token照着新想法，工具帮上忙，今晚少熬夜。"
    "愿汝少耗token，多得答案，手边的难题也有转弯处。"
    "本神愿汝token陪你理顺代码，改动有把握，睡前有笑意。"
    "本座愿汝token带着耐心，日志露出线索，难题有转机。"
    "愿汝token跟灵感合拍，代码写得顺，晚饭吃得香。"
    "本神祝汝善用token，让Agent接住繁琐，把时间还给生活。"
    "本神祝汝token用得从容，Agent帮得恰好，热茶慢慢喝。"
    "本座愿汝token接住思路，分支合得顺，夜色不太长。"
    "愿汝token点亮新尝试，报错说清缘由，心里少猜谜。"
    "愿汝带着清楚的问题出发，token一路用得值得。"
    "本神愿汝token陪你找到症结，小补丁解大烦恼。"
    "本座祝汝token跟着真问题走，改动稳当，心情晴朗。"
    "愿汝token装得下好思路，Agent记得重点，聊天少绕远。"
    "善信，愿代码有脉络，token有去处，深夜的灯早些熄。"
    "本神愿汝token陪你弄懂旧代码，接手顺当，睡前安心。"
    "本座愿汝token帮你说清需求，事情讲明白，人也轻松些。"
    "愿汝token换来踏实进展，工具肯帮忙，晚风能赶上。"
    "愿汝把线索理清，把token用好，热茶喝完时眉头也舒展。"
    "本神愿汝token和灵感同行，代码有章法，忙碌有尽头。"
    "本座愿汝token陪你修好边角，测试照看成果，改动安心。"
    "愿汝token把好想法留下，Agent理清步骤，事情慢慢成。"
    "本座愿汝问得清楚、想得明白，token花在值得的答案上。"
    "本神祝汝token帮你少猜一点，日志多说实话，今晚少费神。"
    "本座愿汝token伴着清醒思路，重构走得稳，回家脚步轻。"
    "愿汝token陪你把文档说清，接手的人读得懂，心里有光。"
    "善信，愿好点子聊得下去，token接得上，夜里睡得香。"
    "本神愿汝token带着耐心，Agent弄懂题意，工作渐顺手。"
    "本座祝汝token用得巧，依赖理得顺，构建少闹心。"
    "愿汝token留下有用的答案，思路有出口，代码有归处。"
    "愿汝看清难处，善用token，收工时还能追上阳光。"
    "本神愿汝token帮你看清边界，异常有人接，心里不慌。"
    "本座愿汝token跟得上好节奏，Agent办实事，你安心喝茶。"
    "愿汝token陪你理好接口，约定讲清，合作轻快。"
    "本神祝汝难题有解，token用得从容，合上电脑也有好心情。"
    "本神愿汝token落在值得的地方，代码少弯路，人多余裕。"
    "本座愿汝token陪你复现问题，线索早明白，眉头早舒展。"
    "愿汝token帮你写出小而准的改动，热饭等得到你。"
    "愿汝写好代码，省好token，把温柔留给自己的日常。"
    "本神祝汝token跟着主意跑，Agent守住重点，今晚从容。"
    "本座愿汝token陪你把事办妥，桌上的花有空浇。"
    "愿汝token连着清楚的思路，提交有回音，咖啡不白等。"
    "善信，愿灵感找对路，token用对处，认真都有回音。"
    "本神愿汝token帮你把困惑讲透，回头看时心里踏实。"
    "本座祝汝token陪好点子开花，代码落地，窗外有晴天。"
    "愿汝token接住新的尝试，测试照亮盲点，改动稳稳当当。"
    "愿汝把问题拆清、把token用巧，Agent踏踏实实陪你走。"
    "本神愿汝token换来省心的结果，晚上有空听听喜欢的歌。"
    "本座愿汝token陪代码变简单，解释讲明白，日子轻一点。"
    "愿汝token装得下新发现，上下文接得住，讨论有着落。"
    "本座愿汝改动稳当，token用得值得，梦里有个好天气。"
    "本神愿汝token陪你守好成果，补丁不绕路，夜里睡得沉。"
    "本座愿汝token带来实在进展，难题渐少，笑意渐多。"
    "愿汝token陪你写到满意，关灯时心里轻松，梦里也晴朗。"))
  (defun local-wish (variant) (get wishes (% variant (get wishes :length))))
  (defun local-line (tier variant)
    (let ((pool (get lines tier))) (get pool (% variant (get pool :length)))))
  (export lines wishes local-wish local-line))
