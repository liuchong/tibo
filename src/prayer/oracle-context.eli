(module tibo.prayer.oracle-context
  (import "../platform/host.eli" RegExp Date)
  (import "node:crypto" createHash)
  (import "./prose.eli" repeated?)
  (import "../platform/util.eli" matches)
  (defun question-topic (question)
    (cond ((matches "编程|代码|写码|debug|coding|programming|bug|\\b(?:ci|pr|git)\\b" question) "coding")
      ((matches "agent|智能体|工具调用|workflow|自动化" question) "agent")
      ((matches "token|额度|限额|上下文|context|quota" question) "quota")
      ((matches "最近|新闻|消息|时事|发布|更新|news|latest|release" question) "news")
      ((matches "用过|有人|好用|好不好|体验|推荐|行不行|不太行|好用|experience|tried|recommend" question) "experience")
      (t "general")))
  (defun document-score (document topic)
    (let ((text (get document :text "")))
      (+ (cond ((and (= topic "coding") (matches "codex|coding|code|engineer|model guide|train" text)) 10)
        ((and (= topic "agent") (matches "agent|tool|workflow|collaborat" text)) 10)
        ((and (= topic "quota") (matches "token|context|usage|limit" text)) 10) (t 0))
        (if (matches "claude|anthropic" text) 2 0))))
  (defun document-key (document)
    ;; Feed row IDs change when fresh announcements arrive. Use the source and
    ;; its content to remember material, without sending this key to the model.
    (js-call (js-call (createHash "sha256") :update (str (get document :url "") "|" (get document :text ""))) :digest "hex"))
  (defun select-documents (documents topic &optional used)
    (js-call (js-call (js-call documents :filter (lambda (d)
      (or (= topic "news") (not (js-call (or used (js-array)) :includes (document-key d)))))) :sort (lambda (a b)
      (let ((score (- (document-score b topic) (document-score a topic))))
        (if (= score 0) (- (or (Date/parse (get b :at)) 0) (or (Date/parse (get a :at)) 0)) score)))) :slice 0 3))
  (export question-topic document-key select-documents repeated?))
