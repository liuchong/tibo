(module tibo.prayer.oracle-memory
  (import "node:crypto" createHash)
  (import "../platform/host.eli" Date)
  (import "../platform/state.eli" read-state write-state with-lock)
  (import "../platform/privacy.eli" public-text)
  (defun history-key (context)
    (str "oracle-replies-" (js-call (js-call (js-call (createHash "sha256") :update
      (str (get context :transport "local") ":" (get context :account "") ":" (get context :scope "local")
        (if (get context :purpose) (str ":" (get context :purpose)) ""))) :digest "hex") :slice 0 32)))
  (defasync recent-context (context)
    (try
      (let ((state (await (read-state (history-key context)))))
        (if (and state (Array/isArray (get state :items)) (> (get state :until 0) (Date/now)))
          (js-object :replies (js-call (get state :items) :filter (lambda (text) (= (value-type text) "string")))
            :sources (if (Array/isArray (get state :sources)) (get state :sources) (js-array))
            :angles (if (Array/isArray (get state :angles)) (js-call (get state :angles) :filter (lambda (s) (= (value-type s) "string"))) (js-array)))
          (js-object :replies (js-array) :sources (js-array) :angles (js-array))))
      (catch error (js-object :replies (js-array) :sources (js-array) :angles (js-array)))))
  (defasync recent-replies (context) (get (await (recent-context context)) :replies))
  (defasync remember-reply (context text &optional source-keys angle)
    (try
      (await (with-lock (history-key context) (async ()
        (let* ((history (await (recent-context context))) (items (get history :replies)) (sources (get history :sources)))
          (await (write-state (history-key context) (js-object :until (+ (Date/now) 86400000)
            :items (js-call (js-call items :concat (js-array (public-text text 360))) :slice -6)
            :angles (js-call (if angle (js-call (get history :angles) :concat (js-array (public-text angle 60))) (get history :angles)) :slice -6)
            :sources (js-call (js-call sources :concat
              (if (Array/isArray source-keys) source-keys (if source-keys (js-array source-keys) (js-array)))) :slice -12))))))))
      (catch error nil)))
  (export recent-context recent-replies remember-reply))
