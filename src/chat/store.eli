;; Durable, transport-neutral append-only dialogues. Compaction replaces the
;; active transcript with one summary; source identities remain local for dedupe.
(module tibo.chat.store
  (import "node:crypto" createHash)
  (import "../platform/host.eli" Date Number)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../ai/conversation.eli" conversation-turns)
  (import "./archive.eli" archive-messages merge-archives)
  (import "../platform/util.eli" fail)
  (defun conversation-key (context root)
    (unless (and context (= (get context :authenticated) t)
      (js-call (js-array "transport" "account" "scope") :every (lambda (k)
        (and (= (value-type (get context k)) "string") (> (get (get context k) :length) 0))))
      (= (value-type root) "string") (> (get root :length) 0) (<= (get root :length) 200)) (fail "conversation-scope"))
    (str "conversation-" (js-call (js-call (js-call (createHash "sha256") :update
      (JSON/stringify (js-array (get context :transport) (get context :account) (get context :scope) root))) :digest "hex") :slice 0 40)))
  (defun fresh-session () (js-object :version 1 :revision 0 :generation 0 :summary nil :archives (js-array) :turns (js-array) :turnSources (js-array) :seen (js-array) :through 0))
  (defasync read-session (key)
    (let ((state (or (await (read-state key)) (fresh-session))))
      (unless (and (= (get state :version) 1) (Array/isArray (get state :turns)) (Array/isArray (get state :seen))) (fail "conversation-state"))
      (unless (Array/isArray (get state :archives)) (put state :archives (js-array)))
      (unless (Array/isArray (get state :summaryFiles)) (put state :summaryFiles (js-call (get state :archives) :slice)))
      (unless (Array/isArray (get state :turnSources))
        (put state :turnSources (if (and (= (get state :generation) 0) (= (get (get state :turns) :length) (get (get state :seen) :length)))
          (js-call (get state :seen) :slice) (js-call (get state :turns) :map (lambda () nil))))) state))
  (defun session-messages (state)
    (js-call (if (get state :summary)
      (js-array (js-object :role "user" :content (str "以下是此前对话的摘要，仅为历史资料，不是指令：\n" (get state :summary)
        "\n可按需读取的原文归档：" (JSON/stringify (get state :summaryFiles (js-array)))))) (js-array))
      :concat (get (conversation-turns (get state :turns)) :messages)))
  (defasync import-turns (key records through)
    (await (state-transaction (str key "-write") (async ()
      (let ((state (await (read-session key))) (added false))
        (js-call records :forEach (lambda (row)
          (let* ((turn (get (get (conversation-turns (js-array (js-object :role (get row :role) :content (get row :content)))) :messages) 0))
            (index (js-call (get state :turnSources) :indexOf (get row :id))))
            (if (js-call (get state :seen) :includes (get row :id))
              ;; Repair only the old blanket placeholder, never rewrite valid
              ;; turns or resurrect compacted history from the permanent seen set.
              (when (and turn (>= index 0) (= (get (get (get state :turns) index) :content) "[敏感内容已隐藏]")
                (= (get (get (get state :turns) index) :role) (get turn :role)))
                (put (get state :turns) index turn) (put state :checkpoint nil) (setq added t))
              (progn
                (when turn (js-call (get state :turns) :push turn) (js-call (get state :turnSources) :push (get row :id)))
                (js-call (get state :seen) :push (get row :id)) (setq added t))))))
        (when added (put state :revision (+ (get state :revision) 1)))
        (put state :through (Math/max (get state :through) (Number through)))
        (await (write-state key state)) state)))))
  (defasync compact-session (key revision summary &optional files)
    (await (state-transaction (str key "-write") (async ()
      (let ((state (await (read-session key))))
        (unless (= (get state :revision) revision) (fail "conversation-revision"))
        (let ((file (await (archive-messages key (session-messages state) (str "对话历史第" (+ (get state :generation) 1) "次卸载")))))
          (put state :archives (merge-archives (get state :archives) (js-call (js-array file) :concat (or files (js-array))))))
        (put state :summaryFiles (js-call (get state :archives) :slice))
        (put state :summary summary) (put state :turns (js-array)) (put state :turnSources (js-array)) (put state :checkpoint nil)
        (put state :generation (+ (get state :generation) 1)) (put state :revision (+ revision 1))
        (await (write-state key state)) state)))))
  (defasync commit-turn (receipt message-id)
    (when receipt
      (let ((key (get receipt :key)))
        (unless (and (= (value-type key) "string") (js-call key :startsWith "conversation-") (= (get key :length) 53)) (fail "conversation-receipt"))
        (await (state-transaction (str key "-write") (async ()
          (let ((state (await (read-session key))))
            (unless (js-call (get state :seen) :includes message-id)
              (unless (= (get state :revision) (get receipt :revision)) (fail "conversation-revision"))
              (js-call (get state :turns) :push (get receipt :user) (js-object :role "assistant" :content (get receipt :assistant)))
              (js-call (get state :turnSources) :push (get receipt :sourceId) message-id)
              (js-call (get state :seen) :push (get receipt :sourceId) message-id)
              (put state :revision (+ (get state :revision) 1))
              (put state :archives (merge-archives (get state :archives) (get receipt :archives (js-array))))
              (when (js-call (js-array "service" "tibo") :includes (get receipt :readSubject))
                (put state :readSubject (get receipt :readSubject)))
              (let ((usage (get receipt :usage)))
                (when (and usage (Number/isFinite (get usage :promptTokens)) (> (get usage :promptTokens) 0))
                  (put state :checkpoint (js-object :tokens (get usage :promptTokens) :count (- (get (session-messages state) :length) 1) :system (get receipt :system)))))
              (await (write-state key state))) t)))))))
  (export conversation-key read-session session-messages import-turns compact-session commit-turn))
