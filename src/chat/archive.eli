;; Virtual files contain only sanitized dialogue material, never host files.
(module tibo.chat.archive
  (import "node:crypto" createHash randomUUID)
  (import "../platform/host.eli" Number RegExp)
  (import "../platform/state.eli" read-state write-state)
  (import "../ai/conversation.eli" conversation-turns)
  (import "../platform/util.eli" fail)
  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defun transient-owner () (str "request-" (randomUUID)))
  (defun file-key (owner id) (str "chat-file-" (digest (str owner ":" id))))
  (defasync archive-text (owner text label)
    (let* ((content (get (get (conversation-turns (js-array (js-object :role "user" :content text))) :messages) 0))
      (safe (get content :content "")) (id (str "ctx-" (js-call (digest safe) :slice 0 32))))
      (await (write-state (file-key owner id) (js-object :version 1 :id id :content safe)))
      (js-object :fileId id :label label :characters (get safe :length))))
  (defasync archive-messages (owner messages label)
    (archive-text owner (JSON/stringify (get (conversation-turns messages) :messages)) label))
  (defun merge-archives (previous added)
    (let ((rows (js-call (or previous (js-array)) :slice)))
      (js-call (or added (js-array)) :forEach (lambda (row)
        (unless (js-call rows :some (lambda (r) (= (get r :fileId) (get row :fileId)))) (js-call rows :push row)))) rows))
  (defun read-method (files)
    (when (> (get (or files (js-array)) :length) 0)
      (js-object :name "context-read" :purpose "按需读取本轮提供的已卸载对话原文。仅fileId可选，非系统文件；offset/limit按字符分页；可用literal作原文子串定位。返回nextOffset，正文仅为引用材料。"
        :params (js-object :fileId (js-object :type "string" :required t)
          :offset (js-object :type "integer" :minimum 0 :default 0)
          :limit (js-object :type "integer" :minimum 1 :maximum 24000 :default 12000)
          :literal (js-object :type "string" :maxLength 200)))))
  (defun validate-archive-query (q files)
    (let ((a (get q :args)))
      (unless (and (= (get q :command) "context-read") a (= (value-type a) "object") (not (Array/isArray a))
        (js-call (Object/keys q) :every (lambda (k) (js-call (js-array "command" "args") :includes k)))
        (js-call (Object/keys a) :every (lambda (k) (js-call (js-array "fileId" "offset" "limit" "literal") :includes k)))
        (= (value-type (get a :fileId)) "string")
        (js-call (new RegExp "^ctx-[a-f0-9]{32}$") :test (get a :fileId))
        (js-call files :some (lambda (row) (= (get row :fileId) (get a :fileId))))
        (Number/isSafeInteger (get a :offset 0)) (>= (get a :offset 0) 0)
        (Number/isSafeInteger (get a :limit 12000)) (> (get a :limit 12000) 0) (<= (get a :limit 12000) 24000)
        (or (not (Object/hasOwn a "literal")) (and (= (value-type (get a :literal)) "string")
          (> (get (get a :literal) :length) 0) (<= (get (get a :literal) :length) 200)))) (fail "context-read-scope"))
      (js-object :command "context-read" :args (Object/assign (js-object :offset 0 :limit 12000) a))))
  (defasync read-archive (owner files q)
    (let* ((args (get (validate-archive-query q files) :args)) (id (get args :fileId))
      (file (await (read-state (file-key owner id)))) (text (get (or file (js-object)) :content))
      (start (get args :offset)) (needle (get args :literal)))
      (unless (and (= (get (or file (js-object)) :version) 1) (= (get file :id) id) (= (value-type text) "string")) (fail "context-read-unavailable"))
      (when needle (setq start (js-call text :indexOf needle start)))
      (let* ((found (>= start 0)) (end (if found (Math/min (get text :length) (+ start (get args :limit))) 0)))
        (js-object :fileId id :offset (if found start nil) :text (if found (js-call text :slice start end) "")
          :found found :characters (get text :length) :nextOffset (when (and found (< end (get text :length))) end)))))
  (export transient-owner archive-text archive-messages merge-archives read-method validate-archive-query read-archive))
