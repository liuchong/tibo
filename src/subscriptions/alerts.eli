(module tibo.subscriptions.alerts
  (import "node:crypto" createHash)
  (import "../platform/host.eli" Date Promise)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/privacy.eli" public-text)
  (import "../platform/util.eli" iso ms utc fail)
  (defun alert-key (kind identity)
    (str "alert-" (js-call (js-call (js-call (createHash "sha256") :update (str kind ":" identity)) :digest "hex") :slice 0 40)))
  (defasync enqueue-alert (kind identity text &optional evidence-at expires-at)
    (await (state-transaction "alert-feed" (async ()
      (let* ((key (alert-key kind identity)) (old (await (read-state key)))
        (feed (or (await (read-state "alert-feed")) (js-object :schemaVersion 1 :items (js-array))))
        (items (get feed :items)))
        (unless old
          (setq old (js-object :schemaVersion 1 :key key :kind kind :at (iso (Date/now)) :text (public-text text)
            :evidenceAt (or evidence-at (iso (Date/now))) :expiresAt expires-at))
          (await (write-state key old)))
        ;; A crash after writing the immutable message is repaired by replay.
        (unless (js-call items :some (lambda (item) (= (get item :key) key)))
          (js-call items :push (js-object :key key :at (get old :at))))
        (put feed :items items) (await (write-state "alert-feed" feed)) old)))))
  (defasync pending-alerts ()
    (let* ((feed (or (await (read-state "alert-feed")) (js-object :items (js-array))))
      (monitor (or (await (read-state "realtime-monitor")) (js-object)))
      (alerts (await (Promise/all (js-call (get feed :items) :map (lambda (i) (read-state (get i :key))))))))
      (js-call alerts :filter (lambda (a) (and a
        (or (= (get a :kind) "confirmed")
          (and (> (ms (get a :expiresAt)) (Date/now))
            (or (not (get monitor :lastConfirmedAt)) (> (ms (get a :evidenceAt)) (ms (get monitor :lastConfirmedAt)))))))))))
  (defun confirmed-global? (event)
    (and (get event :global) (get event :verified) (= (get event :provenance) "primary")
      (not (get event :observed)) (not (get event :banked)) (not (get event :automaticWeekly))))
  (defasync confirm-alert (event)
    (await (enqueue-alert "confirmed" (get event :id)
      (str "**✅ Codex 已重置确认**\n\n• 完成公告：" (utc (get event :at))
        "\n• Tibo 原文：" (get event :text)
        "\n• [原始来源](https://x.com/thsottiaux/status/" (get event :id) ")"))))
  (defasync forecast-alert (result seen-promises high-cycle)
    (let* ((signals (get result :signals)) (promise (get signals :promise)) (prob (get result :forecast))
      (global (get signals :lastGlobal)) (cycle (if global (get global :id) "unknown"))
      (firm (and promise (get promise :primary) (= (get promise :kind) "global")
        (not (get promise :fulfilled)) (not (get promise :withdrawn))
        (> (ms (get promise :targetAt)) (ms (get (get result :snapshot) :now)))
        (not (js-call seen-promises :includes (get promise :postId)))))
      (high (and (not (= (get prob :available) false))
        (or (>= (get prob :p24) 70) (>= (get prob :p48) 85)) (not (= cycle high-cycle)))))
      (when (or firm high)
        (await (enqueue-alert (if firm "promise" "high-probability")
          (if firm (get promise :postId) cycle)
          (str "**🔔 Codex 重置预警**\n\n" (if firm "发现明确的 global 重置时间承诺。" "近期重置概率已达到预警阈值。")
            "\n\n" (get result :report))
          (if firm (get promise :at) (get (get result :snapshot) :now))
          (if firm (get promise :targetAt) (iso (+ (Date/now) 3600000))))))
      (js-object :promiseId (when firm (get promise :postId)) :highCycle (when high cycle))))
  (export alert-key enqueue-alert pending-alerts confirmed-global? confirm-alert forecast-alert))
