(module tibo.subscriptions.registry
  (import "node:crypto" createHash randomUUID)
  (import "../platform/host.eli" Date RegExp Set)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "./schedule.eli" next-slot)
  (import "../platform/util.eli" fail iso)
  (import "../platform/time.eli" time-settings local-time zone-label)
  (defconst subscription-items
    (js-array
      (js-object :id "daily" :label "每日定点预测" :detail "每天09:00、21:00定点预测报告"
        :aliases (js-array "daily" "bulletin" "report" "schedule" "每日预测" "定点报告" "早晚报告" "日常预测" "每日定点" "每日报告"))
      (js-object :id "promise" :label "明确承诺预警" :detail "发现明确global重置时间承诺时实时预警"
        :aliases (js-array "promise" "commitment" "明确承诺" "承诺预警" "重置承诺" "预告预警"))
      (js-object :id "probability" :label "高概率重置预警" :detail "预测达到24h≥70%或48h≥85%时实时预警"
        :aliases (js-array "probability" "high-probability" "prob" "高概率" "高概率预警" "概率预警"))
      (js-object :id "confirmed" :label "已重置确认" :detail "核实官方global重置完成公告时独立确认"
        :aliases (js-array "confirmed" "confirm" "reset-confirmed" "已重置确认" "重置确认" "完成确认"))))
  (defun all-subscription-items ()
    (js-call subscription-items :map (lambda (item) (get item :id))))
  (defun alert-subscription-items ()
    (js-array "promise" "probability" "confirmed"))
  (defun alert-item (kind)
    (cond ((= kind "promise") "promise")
          ((= kind "high-probability") "probability")
          ((= kind "confirmed") "confirmed")
          (t kind)))
  (defun parse-subscription-items (&optional raw)
    (if (or (nullish? raw) (= (js-call (str raw) :trim) ""))
      (all-subscription-items)
      (let* ((parts (js-call (js-call (js-call (str raw) :split (new RegExp "[,，、+/]+"))
               :map (lambda (s) (js-call s :trim))) :filter (lambda (s) (> (get s :length) 0))))
             (chosen (new Set)))
        (when (= (get parts :length) 0) (fail "订阅项目不合法"))
        (js-call parts :forEach (lambda (part)
          (let ((lower (js-call part :toLowerCase)))
            (cond
              ((js-call (js-array "all" "全部" "所有" "全部通知") :includes lower)
                (js-call (all-subscription-items) :forEach (lambda (id) (js-call chosen :add id))))
              ((js-call (js-array "alerts" "alert" "重置预警" "预警" "仅重置预警" "仅预警与确认") :includes lower)
                (js-call (alert-subscription-items) :forEach (lambda (id) (js-call chosen :add id))))
              ((js-call (js-array "warnings" "warning" "warnings-only" "仅预警") :includes lower)
                (js-call (js-array "promise" "probability") :forEach (lambda (id) (js-call chosen :add id))))
              (t
                (let ((found (js-call subscription-items :find (lambda (item)
                        (or (= (get item :id) lower)
                            (js-call (get item :aliases) :some (lambda (a) (= (js-call a :toLowerCase) lower))))))))
                  (unless found (fail "订阅项目不合法"))
                  (js-call chosen :add (get found :id))))))))
        (let ((ordered (js-call (all-subscription-items) :filter (lambda (id) (js-call chosen :has id)))))
          (when (= (get ordered :length) 0) (fail "订阅项目不合法"))
          ordered))))
  (defun member-items (member)
    (if (not (and member (get member :active)))
      (js-array)
      (let ((raw (get member :items)))
        (if (and (Array/isArray raw) (> (get raw :length) 0))
          (js-call (all-subscription-items) :filter (lambda (id) (js-call raw :includes id)))
          (all-subscription-items)))))
  (defun same-items? (a b)
    (and (= (get a :length) (get b :length))
         (js-call a :every (lambda (id idx) (= id (get b idx))))))
  (defun describe-items (items)
    (let ((all (all-subscription-items)) (alerts (alert-subscription-items)))
      (cond ((same-items? items all) "全部通知（每日定点预测、明确承诺预警、高概率重置预警、已重置确认）")
            ((same-items? items alerts) "仅重置预警与已重置确认（明确承诺预警、高概率重置预警、已重置确认；不含每日定点预测）")
            (t (js-call (js-call (js-call subscription-items :filter (lambda (item) (js-call items :includes (get item :id))))
                 :map (lambda (item) (get item :label))) :join "、")))))
  (defun digest (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun valid-owner? (context)
    (and context (= (get context :authenticated) t) (not (= (get context :transport) "cli"))
      (js-call (js-array "transport" "account" "actor") :every (lambda (key)
        (let ((value (get context key)))
          (and (= (value-type value) "string") (> (get value :length) 0) (<= (get value :length) 200)))))))
  (defun namespace-key (transport account)
    (str "subscriptions-" (js-call (digest (JSON/stringify (js-array transport account))) :slice 0 40)))
  (defasync registry (transport account)
    (let ((state (or (await (read-state (namespace-key transport account))) (js-object :schemaVersion 2 :members (js-array))))
          (valid-ids (all-subscription-items)))
      (unless (and (js-call (js-array 1 2) :includes (get state :schemaVersion)) (Array/isArray (get state :members)))
        (fail "订阅档案不可读"))
      (when (= (get state :schemaVersion) 1)
        (put state :schemaVersion 2)
        (put state :members (js-call (get state :members) :map (lambda (m)
          (Object/assign (js-object) m (js-object :kind "dm" :id (get m :actor)))))))
      (unless (and
        (js-call (get state :members) :every (lambda (m)
          (and m (js-call (js-array "dm" "group") :includes (get m :kind))
            (= (value-type (get m :id)) "string") (> (get (get m :id) :length) 0) (<= (get (get m :id) :length) 200)
            (or (not (= transport "lark")) (js-call (new RegExp (if (= (get m :kind) "group") "^oc_[A-Za-z0-9]+$" "^ou_[A-Za-z0-9]+$")) :test (get m :id)))
            (or (= (get m :kind) "group") (= (get m :actor) (get m :id)))
            (= (value-type (get m :active)) "boolean") (= (value-type (get m :revision)) "string")
            (or (not (Object/hasOwn m "items"))
                (and (Array/isArray (get m :items))
                     (js-call (get m :items) :every (lambda (id) (js-call valid-ids :includes id))))))))
        (= (get (new Set (js-call (get state :members) :map (lambda (m) (str (get m :kind) ":" (get m :id))))) :size)
           (get (get state :members) :length))) (fail "订阅档案不可读"))
      (js-call (get state :members) :forEach (lambda (m)
        (when (and (get m :active) (not (Array/isArray (get m :items))))
          (put m :items (all-subscription-items)))))
      state))
  (defasync active-recipients (transport account &optional item)
    (js-call (get (await (registry transport account)) :members) :filter
      (lambda (m) (and (get m :active) (or (not item) (js-call (member-items m) :includes item))))))
  (defasync active-subscribers (transport account &optional item)
    (js-call (await (active-recipients transport account item)) :filter (lambda (m) (= (get m :kind) "dm"))))
  (defasync still-recipient? (transport account kind id revision &optional item)
    (js-call (get (await (registry transport account)) :members) :some
      (lambda (m) (and (= (get m :kind) kind) (= (get m :id) id) (get m :active) (= (get m :revision) revision)
        (or (not item) (js-call (member-items m) :includes item))))))
  (defasync still-subscribed? (transport account actor revision &optional item)
    (await (still-recipient? transport account "dm" actor revision item)))
  (defasync sync-group-subscriptions (transport account groups)
    (unless (and (Array/isArray groups) (js-call groups :every (lambda (id)
      (and (= (value-type id) "string") (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test id)))))
      (fail "通知群必须明确配置"))
    (await (state-transaction (namespace-key transport account) (async ()
      (let* ((state (await (registry transport account))) (members (get state :members))
             (previous (get state :configuredGroups (js-array))) (changed false))
        (js-call members :forEach (lambda (m)
          (when (and (= (get m :kind) "group") (get m :active) (= (get m :source) "config")
                     (js-call previous :includes (get m :id)) (not (js-call groups :includes (get m :id))))
            (put m :active false) (put m :updatedAt (iso (Date/now))) (setq changed t))))
        (js-call groups :forEach (lambda (id)
          (let ((m (js-call members :find (lambda (m) (and (= (get m :kind) "group") (= (get m :id) id))))))
            (when (not (js-call previous :includes id))
              (unless m (setq m (js-object :kind "group" :id id :source "config")) (js-call members :push m))
              (unless (get m :active)
                (put m :source "config") (put m :active t) (put m :items (all-subscription-items))
                (put m :revision (randomUUID)) (put m :updatedAt (iso (Date/now))) (setq changed t))))))
        (put state :configuredGroups (Array/from (new Set groups)))
        ;; Persist the normalized schema, even when upgrading only private subscriptions.
        (await (write-state (namespace-key transport account) state))
        (js-object :changed changed :groups (get groups :length)))))))
  (defasync group-subscription (transport account id active &optional raw-items)
    (unless (and (= transport "lark") (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test id)) (fail "群订阅目标无效"))
    (let ((items (parse-subscription-items raw-items)))
      (await (state-transaction (namespace-key transport account) (async ()
        (let* ((state (await (registry transport account))) (members (get state :members))
               (m (js-call members :find (lambda (m) (and (= (get m :kind) "group") (= (get m :id) id))))))
          (unless m (setq m (js-object :kind "group" :id id)) (js-call members :push m))
          (if active
            (let ((current (member-items m)))
              (when (or (not (get m :active)) (not (same-items? current items)) (not (get m :revision)))
                (put m :active t) (put m :items items) (put m :revision (randomUUID)) (put m :updatedAt (iso (Date/now)))))
            (let* ((current (member-items m))
                   (remaining (if (same-items? items (all-subscription-items)) (js-array)
                     (js-call current :filter (lambda (x) (not (js-call items :includes x)))))))
              (if (> (get remaining :length) 0)
                (when (not (same-items? current remaining))
                  (put m :active t) (put m :items remaining) (put m :revision (randomUUID)) (put m :updatedAt (iso (Date/now))))
                (when (or (get m :active) (not (get m :revision)))
                  (put m :active false) (put m :items (js-array)) (put m :revision (or (get m :revision) (randomUUID))) (put m :updatedAt (iso (Date/now)))))))
          (put m :source "command")
          (await (write-state (namespace-key transport account) state))))))))
  (defasync group-subscription-status (transport account id)
    (let* ((member (js-call (await (active-recipients transport account)) :find (lambda (m) (and (= (get m :kind) "group") (= (get m :id) id)))))
           (items (member-items member)))
      (js-object :ok t :text (str "**群报告订阅**\n"
        (if member (str "目标群当前已订阅。\n• 订阅项目：" (describe-items items)) "目标群当前未订阅。")
        (if (and member (not (js-call items :includes "daily")))
          "\n• 每日定点报告：未包含（仅推送所选实时通知）。"
          (str "\n• 周期：" (zone-label (get (time-settings) :scheduleZone)) "每天09:00、21:00。"))
        "\n• 另有高概率/明确承诺预警与独立已重置确认。"
        "\n• 可选项目：all（全部）、alerts（仅重置预警与确认）、daily（仅每日定点）、promise（明确承诺预警）、probability（高概率预警）、confirmed（已重置确认）。"))))
  (defasync subscription-command (name context &optional raw-items)
    (if (or (not (valid-owner? context))
            (and (= (get context :transport) "lark")
              (not (and (js-call (js-array "p2p" "group") :includes (get context :conversationType))
                (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test (get context :scope ""))
                (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test (get context :actor ""))))))
      (js-object :ok false :text "订阅需要可私聊的本人身份，请在已接入的IM中使用；CLI和MCP不能指定收件人。")
      (let ((requested (parse-subscription-items raw-items)) (all-ids (all-subscription-items)))
        (await (state-transaction (namespace-key (get context :transport) (get context :account)) (async ()
          (let* ((state (await (registry (get context :transport) (get context :account))))
                 (member (js-call (get state :members) :find (lambda (m) (and (= (get m :kind) "dm") (= (get m :id) (get context :actor))))))
                 (active (and member (get member :active))) (current (member-items member))
                 (all? (same-items? requested all-ids)) (changed false) (message ""))
            (cond ((= name "subscribe")
                    (if (and active (same-items? current requested))
                      (setq message (if all? "已经订阅，无需重复订阅。" (str "已经订阅相同项目（" (describe-items requested) "），无需重复订阅。")))
                      (if active
                        (progn
                          (put member :items requested) (put member :revision (randomUUID)) (put member :updatedAt (iso (Date/now)))
                          (setq changed t message (str "已更新订阅，当前订阅项目：" (describe-items requested) "。")))
                        (progn
                          (unless member (setq member (js-object :kind "dm" :id (get context :actor) :actor (get context :actor))) (js-call (get state :members) :push member))
                          (put member :active t) (put member :items requested) (put member :revision (randomUUID)) (put member :updatedAt (iso (Date/now)))
                          (setq changed t message (if all? "已订阅，早晚报告、实时重置预警和已重置确认将私聊推送给你。"
                            (str "已订阅（" (describe-items requested) "），匹配通知将私聊推送给你。")))))))
                  ((= name "unsubscribe")
                    (if (not active)
                      (setq message "当前未订阅。")
                      (if all?
                        (progn
                          (put member :active false) (put member :items (js-array)) (put member :updatedAt (iso (Date/now)))
                          (setq changed t active false message "已退订，后续订阅通知不再私聊推送；正在发送的消息可能已无法撤回。"))
                        (let ((remaining (js-call current :filter (lambda (x) (not (js-call requested :includes x))))))
                          (if (= (get remaining :length) (get current :length))
                            (setq message (str "当前未订阅该项目，现有订阅保持不变：" (describe-items current) "。"))
                            (if (> (get remaining :length) 0)
                              (progn
                                (put member :active t) (put member :items remaining) (put member :revision (randomUUID)) (put member :updatedAt (iso (Date/now)))
                                (setq changed t message (str "已退订：" (describe-items requested) "；当前保留订阅：" (describe-items remaining) "。")))
                              (progn
                                (put member :active false) (put member :items (js-array)) (put member :updatedAt (iso (Date/now)))
                                (setq changed t active false message "已退订全部已选项目，后续订阅通知不再私聊推送。"))))))))
                  (t (setq message (if active (str "当前已订阅。\n• 订阅项目：" (describe-items current)) "当前未订阅。"))))
            (when changed (await (write-state (namespace-key (get context :transport) (get context :account)) state)))
            (let ((effective-items (member-items member)))
              (js-object :ok t :text (str "**私聊报告订阅**\n" message
                (if (or (= name "subscribe") (and (and member (get member :active)) (not (= name "unsubscribe"))))
                  (str
                    (if (js-call effective-items :includes "daily")
                      (str "\n• 周期：" (zone-label (get (time-settings) :scheduleZone)) "每天09:00、21:00。\n• 下次定点：" (zone-label (get (time-settings) :scheduleZone)) " " (local-time (next-slot (iso (Date/now))) (get (time-settings) :scheduleZone))
                        "；定点报告从下一定点开始，实时通知从订阅后生效。")
                      "\n• 每日定点报告：未包含（仅推送所选实时通知，从订阅后生效）。")
                    "\n• 另有高概率/明确承诺预警与独立已重置确认。\n• 所有人收到同一份通知，不因订阅人数重新计算。") "")
                "\n• 可选项目：all（全部）、alerts（仅重置预警与确认）、daily（仅每日定点）、promise（明确承诺预警）、probability（高概率预警）、confirmed（已重置确认）。"
                "\n查看：subscription / 订阅状态；取消：unsubscribe / 退订。"))))))))))
  (export subscription-items all-subscription-items alert-subscription-items alert-item parse-subscription-items member-items describe-items
    subscription-command namespace-key active-subscribers still-subscribed? active-recipients still-recipient? sync-group-subscriptions group-subscription group-subscription-status))
