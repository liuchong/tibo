(module tibo.subscriptions.registry
  (import "node:crypto" createHash randomUUID)
  (import "../platform/host.eli" Date RegExp Set)
  (import "../platform/state.eli" read-state write-state with-lock)
  (import "./schedule.eli" next-slot)
  (import "../platform/util.eli" fail iso beijing)
  (defun digest (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun valid-owner? (context)
    (and context (= (get context :authenticated) t) (not (= (get context :transport) "cli"))
      (js-call (js-array "transport" "account" "actor") :every (lambda (key)
        (let ((value (get context key)))
          (and (= (value-type value) "string") (> (get value :length) 0) (<= (get value :length) 200)))))))
  (defun namespace-key (transport account)
    (str "subscriptions-" (js-call (digest (JSON/stringify (js-array transport account))) :slice 0 40)))
  (defasync registry (transport account)
    (let ((state (or (await (read-state (namespace-key transport account))) (js-object :schemaVersion 2 :members (js-array)))))
      (unless (and (js-call (js-array 1 2) :includes (get state :schemaVersion)) (Array/isArray (get state :members)))
        (fail "订阅档案不可读"))
      (when (= (get state :schemaVersion) 1)
        (put state :schemaVersion 2)
        (put state :members (js-call (get state :members) :map (lambda (m)
          (Object/assign (js-object) m (js-object :kind "dm" :id (get m :actor)))))))
      (unless (and
        (js-call (get state :members) :every (lambda (m)
          (and m (js-call (js-array "dm" "group") :includes (get m :kind))
            (= (value-type (get m :id)) "string") (> (get (get m :id) :length) 0) (<= (get (get m :id) :length) 200)
            (or (not (= transport "lark")) (js-call (new RegExp (if (= (get m :kind) "group") "^oc_[A-Za-z0-9]+$" "^ou_[A-Za-z0-9]+$")) :test (get m :id)))
            (or (= (get m :kind) "group") (= (get m :actor) (get m :id)))
            (= (value-type (get m :active)) "boolean") (= (value-type (get m :revision)) "string"))))
        (= (get (new Set (js-call (get state :members) :map (lambda (m) (str (get m :kind) ":" (get m :id))))) :size)
           (get (get state :members) :length))) (fail "订阅档案不可读")) state))
  (defasync active-recipients (transport account)
    (js-call (get (await (registry transport account)) :members) :filter (lambda (m) (get m :active))))
  (defasync active-subscribers (transport account)
    (js-call (await (active-recipients transport account)) :filter (lambda (m) (= (get m :kind) "dm"))))
  (defasync still-recipient? (transport account kind id revision)
    (js-call (get (await (registry transport account)) :members) :some
      (lambda (m) (and (= (get m :kind) kind) (= (get m :id) id) (get m :active) (= (get m :revision) revision)))))
  (defasync still-subscribed? (transport account actor revision)
    (await (still-recipient? transport account "dm" actor revision)))
  (defasync sync-group-subscriptions (transport account groups)
    (unless (and (Array/isArray groups) (js-call groups :every (lambda (id)
      (and (= (value-type id) "string") (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test id)))))
      (fail "通知群必须明确配置"))
    (await (with-lock (namespace-key transport account) (async ()
      (let* ((state (await (registry transport account))) (members (get state :members))
             (previous (get state :configuredGroups (js-array))) (changed false))
        (js-call members :forEach (lambda (m)
          (when (and (= (get m :kind) "group") (get m :active) (= (get m :source) "config")
                     (js-call previous :includes (get m :id)) (not (js-call groups :includes (get m :id))))
            (put m :active false) (put m :updatedAt (iso (Date/now))) (setq changed t))))
        (js-call groups :forEach (lambda (id)
          (let ((m (js-call members :find (lambda (m) (and (= (get m :kind) "group") (= (get m :id) id))))))
            (when (not (js-call previous :includes id))
              (unless m (setq m (js-object :kind "group" :id id :source "config")) (js-call members :push m))
              (unless (get m :active)
                (put m :source "config") (put m :active t) (put m :revision (randomUUID)) (put m :updatedAt (iso (Date/now))) (setq changed t))))))
        (put state :configuredGroups (Array/from (new Set groups)))
        ;; Persist the normalized schema, even when upgrading only private subscriptions.
        (await (write-state (namespace-key transport account) state))
        (js-object :changed changed :groups (get groups :length)))))))
  (defasync group-subscription (transport account id active)
    (unless (and (= transport "lark") (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test id)) (fail "群订阅目标无效"))
    (await (with-lock (namespace-key transport account) (async ()
      (let* ((state (await (registry transport account))) (members (get state :members))
             (m (js-call members :find (lambda (m) (and (= (get m :kind) "group") (= (get m :id) id))))))
        (unless m (setq m (js-object :kind "group" :id id)) (js-call members :push m))
        (when (or (not (= (get m :active) active)) (not (get m :revision)))
          (put m :active active) (put m :revision (randomUUID)) (put m :updatedAt (iso (Date/now))))
        (put m :source "command")
        (await (write-state (namespace-key transport account) state)))))))
  (defasync group-subscription-status (transport account id)
    (let ((active (js-call (await (active-recipients transport account)) :some (lambda (m) (and (= (get m :kind) "group") (= (get m :id) id))))))
      (js-object :ok t :text (str "**群定点订阅**\n" (if active "目标群当前已订阅。" "目标群当前未订阅。") "\n• 周期：北京时间每天09:00、21:00。"))))
  (defasync subscription-command (name context)
    (if (or (not (valid-owner? context))
            (and (= (get context :transport) "lark")
              (not (and (js-call (js-array "p2p" "group") :includes (get context :conversationType))
                (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test (get context :scope ""))
                (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test (get context :actor ""))))))
      (js-object :ok false :text "订阅需要可私聊的本人身份，请在已接入的IM中使用；CLI和MCP不能指定收件人。")
      (await (with-lock (namespace-key (get context :transport) (get context :account)) (async ()
        (let* ((state (await (registry (get context :transport) (get context :account))))
               (member (js-call (get state :members) :find (lambda (m) (and (= (get m :kind) "dm") (= (get m :id) (get context :actor))))))
               (active (and member (get member :active))) (changed false) (message ""))
          (cond ((= name "subscribe")
                  (setq message (if active "已经订阅，无需重复订阅。" "已订阅，定点报告将私聊推送给你。"))
                  (unless active
                    (unless member (setq member (js-object :kind "dm" :id (get context :actor) :actor (get context :actor))) (js-call (get state :members) :push member))
                    (put member :active t) (put member :revision (randomUUID)) (put member :updatedAt (iso (Date/now))) (setq changed t)))
                ((= name "unsubscribe")
                  (setq message (if active "已退订，后续定点报告不再私聊推送；正在发送的消息可能已无法撤回。" "当前未订阅。"))
                  (when active (put member :active false) (put member :updatedAt (iso (Date/now))) (setq changed t)))
                (t (setq message (if active "当前已订阅。" "当前未订阅。"))))
          (when changed (await (write-state (namespace-key (get context :transport) (get context :account)) state)))
          (js-object :ok t :text (str "**定点私聊订阅**\n" message
            (if (or (= name "subscribe") (and active (not (= name "unsubscribe"))))
              (str "\n• 周期：北京时间每天09:00、21:00。\n• 下次定点：北京时间 " (beijing (next-slot (iso (Date/now))))
                "；订阅从下一个定点开始。\n• 所有人收到同一份报告，不因订阅人数重新计算。") "")
            "\n查看：subscription / 订阅状态；取消：unsubscribe / 退订。"))))))))
  (export subscription-command namespace-key active-subscribers still-subscribed? active-recipients still-recipient? sync-group-subscriptions group-subscription group-subscription-status))
