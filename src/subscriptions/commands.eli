(module tibo.subscriptions.commands
  (import "../platform/host.eli" RegExp)
  (import "../commands/admin.eli" is-admin manage)
  (import "../im/authority.eli" group-admin?)
  (import "./registry.eli" subscription-command group-subscription-status)
  (defasync subscription-query (name args context)
    (if (= (get args :target "personal") "personal")
      (if (get args :chatId) (js-object :ok false :text "个人订阅不能指定收件人；群订阅请明确使用 group 参数。")
        (await (subscription-command name context)))
      (if (not (and (or (is-admin context) (group-admin? context)) (= (get context :transport) "lark")))
        (js-object :ok false :text (if (= (get (or context (js-object)) :groupRoleState) "unavailable")
          "本次未能核实群管理身份，请稍后重试。" "请由本群群主或群管理员申请并二次确认本群订阅。个人订阅直接使用 subscribe。"))
        (let ((id (or (get args :chatId) (when (= (get context :conversationType) "group") (get context :scope)))))
          (if (and (not (is-admin context)) (not (= id (get context :scope))))
            (js-object :ok false :text "群主或群管理员只能在目标群内管理本群订阅。")
          (if (not (and (= (value-type id) "string") (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test id)))
            (js-object :ok false :text "请指定目标群：subscribe group 群ID；在目标群内可省略群ID。" )
            (if (= name "subscription") (await (group-subscription-status (get context :transport) (get context :account) id))
              (await (manage (if (= name "subscribe") "subscribe-group" "unsubscribe-group") (js-object :chatId id) context)))))))))
  (export subscription-query))
