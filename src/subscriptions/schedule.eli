(module tibo.subscriptions.schedule
  (import "../platform/time.eli" time-settings local-vector)
  (import "../platform/util.eli" iso ms)
  (defun slot-at (now)
    (let* ((zone (get (time-settings) :scheduleZone)) (v (local-vector now zone))
      (hour (get v :hour)) (minute (get v :minute)))
      (when (and (or (= hour 9) (= hour 21)) (= minute 0))
        (let ((target (iso (* (Math/floor (/ (ms now) 60000)) 60000))))
          (js-object :key (str (js-call target :slice 0 10) "-" hour) :at target)))))
  (defun next-slot (now)
    (let ((cursor (* (+ (Math/floor (/ (ms now) 60000)) 1) 60000)) (end (+ (ms now) 172800000)) (found nil)
      (zone (get (time-settings) :scheduleZone)))
      (while (and (not found) (<= cursor end))
        (let ((v (local-vector cursor zone)))
          (when (and (= (get v :minute) 0) (or (= (get v :hour) 9) (= (get v :hour) 21))) (setq found (iso cursor))))
        (setq cursor (+ cursor 60000))) found))
  (export slot-at next-slot))
