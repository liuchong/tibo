(module tibo.subscriptions.schedule
  (import "../platform/host.eli" Number)
  (import "../platform/util.eli" beijing iso ms)
  (defun slot-at (now)
    (let* ((local (beijing now)) (hour (Number (js-call local :slice 6 8))) (minute (Number (js-call local :slice 9 11))))
      (when (and (or (= hour 9) (= hour 21)) (= minute 0))
        (let ((target (iso (- (ms now) (+ (* minute 60000) (% (ms now) 60000))))))
          (js-object :key (str (js-call target :slice 0 10) "-" hour) :at target)))))
  (defun next-slot (now)
    (let* ((time (ms now)) (local (+ time 28800000)) (day (* (Math/floor (/ local 86400000)) 86400000))
           (morning (- (+ day 32400000) 28800000)) (evening (+ morning 43200000)))
      (iso (cond ((< time morning) morning) ((< time evening) evening) (t (+ morning 86400000))))))
  (export slot-at next-slot))
