(module tibo.oracle-news
  (import "./host.eli" Date RegExp Number Promise fetch AbortSignal)
  (import "./html.eli" parse-html by-tag html-text attr)
  (import "./research.eli" xml-field)
  (import "./search.eli" run-search official-url?)
  (import "./state.eli" read-state write-state with-lock)
  (import "./util.eli" fail matches match iso canonical-text)
  (import "./privacy.eli" public-text)
  (defun recent-date? (at now)
    (and (Number/isFinite (Date/parse at)) (<= (Date/parse at) now) (>= (Date/parse at) (- now 2592000000))))
  (defun news-from (body vendor now)
    (let ((out (js-array)))
      (if (= vendor "openai")
        (js-call (js-call (Array/from (js-call body :matchAll (new RegExp "<item(?:\\s[^>]*)?>[\\s\\S]*?</item>" "gi"))) :slice 0 40) :forEach (lambda (m)
          (let* ((item (get m 0)) (date (xml-field item "pubDate")) (url (xml-field item "link")) (title (xml-field item "title")))
            (when (and (recent-date? date now) (official-url? url) (matches "codex|chatgpt|model|devday|gpt" title) (not (matches "customer|frees up|scales|grow with" title)))
              (js-call out :push (js-object :id (str vendor "-" (get out :length)) :text (public-text title 300) :at (iso (Date/parse date)) :url url :provenance "official-news"))))))
        (js-call (by-tag (parse-html body) "a") :forEach (lambda (a)
          (let* ((href (attr a "href" "")) (text (canonical-text (html-text a)))
            (date (match "(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\s+[0-9]{1,2},?\\s+[0-9]{4}" text)))
            (when (and (matches "^/news/[a-z0-9-]+$" href) date (recent-date? (str (get date 0) " UTC") now) (matches "claude|anthropic" text))
              (js-call out :push (js-object :id (str vendor "-" (get out :length)) :text (public-text text 350)
                :at (iso (Date/parse (str (get date 0) " UTC"))) :url (str "https://www.anthropic.com" href) :provenance "official-news-index")))))))
      (js-call (js-call out :sort (lambda (a b) (- (Date/parse (get b :at)) (Date/parse (get a :at))))) :slice 0 2)))
  (defasync official-news (vendor now)
    (try
      (let* ((url (if (= vendor "openai") "https://openai.com/news/rss.xml" "https://www.anthropic.com/news"))
        (r (await (fetch url (js-object :redirect "manual" :signal (AbortSignal/timeout 2500))))))
        (unless (get r :ok) (fail "news-unavailable"))
        (let ((body (await (js-call r :text))))
          (when (> (get body :length) 2000000) (fail "news-too-large"))
          (news-from body vendor now)))
      (catch error (js-array))))
  (defasync search-news (vendor)
    (try (await (run-search (js-object :queries (js-array
      (js-object :engine (if (= vendor "openai") "google" "baidu") :query (if (= vendor "openai") "OpenAI ChatGPT model announcement" "Anthropic Claude model announcement"))))
      2500 (if (= vendor "openai") "openai.com" "anthropic.com")))
      (catch error (js-object :documents (js-array) :engines (js-array)))))
  (defasync oracle-news (search-enabled)
    (try
      (await (with-lock "oracle-news" (async ()
        (let* ((now (Date/now)) (cached (await (read-state "oracle-news"))))
          (if (and cached (> (get cached :until) now) (= (get cached :searchEnabled) search-enabled))
            (Object/assign (js-object) cached (js-object :documents (js-call (get cached :documents) :filter (lambda (d) (or (not (get d :at)) (recent-date? (get d :at) now)))) :cached t))
            (let* ((rows (await (Promise/all (js-array (official-news "openai" now) (official-news "anthropic" now)
              (if search-enabled (search-news "openai") (js-object :documents (js-array) :engines (js-array)))
              (if search-enabled (search-news "anthropic") (js-object :documents (js-array) :engines (js-array)))))))
              (documents (js-call (get rows 0) :concat (get rows 1)))
              (engines (js-call (get (get rows 2) :engines) :concat (get (get rows 3) :engines))))
              ;; Dated announcements take priority; undated search pages cannot be called latest news.
              (when (= (get documents :length) 0)
                (setq documents (js-call (js-call (get (get rows 2) :documents) :concat (get (get rows 3) :documents)) :slice 0 2)))
              (let ((result (js-object :documents documents :engines engines :searchEnabled search-enabled :at (iso now)
                :until (+ now (if (> (get documents :length) 0) 1800000 300000)))))
                (await (write-state "oracle-news" result)) result)))))))
      (catch error (js-object :documents (js-array) :engines (js-array)))))
  (export news-from oracle-news))
