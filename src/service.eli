(module tibo.service
  (import "node:process" :default process)
  (import "node:os" homedir)
  (import "node:path" join basename)
  (import "node:fs/promises" mkdir readFile writeFile rename chmod unlink copyFile)
  (import "node:child_process" spawnSync)
  (import "node:timers/promises" setTimeout)
  (import "./host.eli" Date)
  (import "node:fs" constants)
  (import "./config.eli" config-path parse-config)
  (import "./state.eli" state-root)
  (import "./util.eli" fail)
  (defconst label "com.liuchong.tibo")
  (defun paths (&optional kind)
    (let ((home (homedir)) (name (if (= kind "lark") "tibo-lark" "tibo"))
          (service-label (if (= kind "lark") "com.liuchong.tibo.lark" label)))
      (js-object :binary (join home ".local" "lib" "tibo" name) :label service-label
        :command (if (= kind "lark") "run" "daemon") :log (if (= kind "lark") "lark" "daemon")
        :binaryDir (join home ".local" "lib" "tibo") :config (config-path)
        :configDir (join home ".config" "tibo") :state (join home ".local" "state" "tibo")
        :agents (join home "Library" "LaunchAgents") :plist (join home "Library" "LaunchAgents" (str service-label ".plist")))))
  (defun domain () (str "gui/" (js-call process :getuid)))
  (defun target (p) (str (domain) "/" (get p :label label)))
  (defun xml (text) (js-call (js-call (js-call (str text) :replaceAll "&" "&amp;") :replaceAll "<" "&lt;") :replaceAll ">" "&gt;"))
  (defun plist (p)
    (str "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\"><dict>"
      "<key>Label</key><string>" (get p :label label) "</string><key>ProgramArguments</key><array><string>" (xml (get p :binary)) "</string><string>" (get p :command "daemon") "</string></array>"
      "<key>WorkingDirectory</key><string>" (xml (get p :state)) "</string><key>EnvironmentVariables</key><dict><key>TIBO_CONFIG_FILE</key><string>" (xml (get p :config)) "</string></dict>"
      "<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer><key>ExitTimeOut</key><integer>90</integer>"
      "<key>StandardOutPath</key><string>" (xml (join (get p :state) (str (get p :log "daemon") ".stdout.log"))) "</string>"
      "<key>StandardErrorPath</key><string>" (xml (join (get p :state) (str (get p :log "daemon") ".stderr.log"))) "</string></dict></plist>\n"))
  (defun launchctl (args &optional allow-failure)
    (let ((result (spawnSync "/bin/launchctl" args (js-object :encoding "utf8" :timeout 15000 :maxBuffer 100000))))
      (unless (or allow-failure (= (get result :status) 0)) (fail "launchctl 操作失败，请用 service status 查看服务状态")) result))
  (defasync unload (p)
    (launchctl (js-array "bootout" (target p)) t)
    (let ((deadline (+ (Date/now) 30000)))
      (while (and (< (Date/now) deadline) (= (get (launchctl (js-array "print" (target p)) t) :status) 0))
        (await (setTimeout 250)))
      (when (= (get (launchctl (js-array "print" (target p)) t) :status) 0) (fail "旧后台服务尚未退出，请稍后重试"))))
  (defasync register (path)
    ;; launchd can finish unregistering shortly after bootout/print returns.
    (let ((deadline (+ (Date/now) 15000)) (started false))
      (while (and (not started) (< (Date/now) deadline))
        (setq started (= (get (launchctl (js-array "bootstrap" (domain) path) t) :status) 0))
        (unless started (await (setTimeout 500))))
      (unless started (fail "后台服务注册失败，请检查 service status 与 plist"))))
  (defasync service (command &optional kind)
    (unless (= (get process :platform) "darwin") (fail "自动安装仅支持 macOS；其他系统可运行 tibo daemon"))
    (let ((p (paths kind)))
      (cond
        ((= command "install")
          (when (or (= (basename (get process :execPath)) "bun") (= (basename (get process :execPath)) "node"))
            (fail "请先 bun run compile，再用编译后的可执行文件 service install"))
          (await (mkdir (get p :binaryDir) (js-object :recursive t :mode 448)))
          (await (mkdir (get p :configDir) (js-object :recursive t :mode 448)))
          (await (mkdir (get p :state) (js-object :recursive t :mode 448)))
          (await (mkdir (get p :agents) (js-object :recursive t)))
          (let ((existing ""))
            (try (setq existing (await (readFile (get p :config) "utf8"))) (catch error (unless (= (get error :code) "ENOENT") (fail "配置文件不可读"))))
            (let ((values (parse-config existing)))
              (unless (get values :DEEPSEEK_API_KEY)
                (when (get (get process :env) :DEEPSEEK_API_KEY) (put values :DEEPSEEK_API_KEY (get (get process :env) :DEEPSEEK_API_KEY))))
              (unless (Object/hasOwn values "TIBO_AI_FEATURES") (put values :TIBO_AI_FEATURES "signals,search,research,forecast,review,brief,router,translate,answer,repair"))
              (unless (get values :TIBO_LOCAL_ADMIN_UID) (put values :TIBO_LOCAL_ADMIN_UID (str (js-call process :getuid))))
              (unless (get values :TIBO_AI_WEIGHT) (put values :TIBO_AI_WEIGHT "0.2"))
              (unless (get values :TIBO_DAEMON_INTERVAL) (put values :TIBO_DAEMON_INTERVAL "900"))
              (unless (get values :TIBO_STATE_DIR) (put values :TIBO_STATE_DIR (get p :state)))
              (let ((lines (js-call (Object/keys values) :map (lambda (key) (str key "=" (get values key))))))
                (await (writeFile (str (get p :config) ".tmp") (str (js-call lines :join "\n") "\n") (js-object :mode 384)))
                (await (chmod (str (get p :config) ".tmp") 384)) (await (rename (str (get p :config) ".tmp") (get p :config))))))
          (let ((names (js-array "ledger.json" "experience.json")) (index 0))
            (while (< index (get names :length))
              (let ((name (get names index)))
                (try (await (copyFile (join (state-root) name) (join (get p :state) name) (get constants :COPYFILE_EXCL)))
                  (catch error (unless (or (= (get error :code) "ENOENT") (= (get error :code) "EEXIST")) (fail "历史数据初始化失败")))))
              (setq index (+ index 1))))
          (await (unload p))
          (unless (= (get process :execPath) (get p :binary))
            (await (copyFile (get process :execPath) (str (get p :binary) ".new")))
            (await (chmod (str (get p :binary) ".new") 493)) (await (rename (str (get p :binary) ".new") (get p :binary))))
          (await (writeFile (get p :plist) (plist p) (js-object :mode 384)))
          (await (register (get p :plist)))
          (js-object :state "installed" :label (get p :label) :paths p))
        ((= command "restart") (launchctl (js-array "kickstart" "-k" (target p))) (js-object :state "restarted" :label (get p :label)))
        ((= command "status") (let ((result (launchctl (js-array "print" (target p)) t)))
          (js-object :loaded (= (get result :status) 0) :launchd (get result :stdout "") :paths p)))
        ((= command "uninstall")
          (await (unload p))
          (try (await (unlink (get p :plist))) (catch error (unless (= (get error :code) "ENOENT") (throw error))))
          (js-object :state "uninstalled" :preserved "配置、二进制、历史和日志保留"))
        (t (fail "service 命令：install / restart / status / uninstall")))))
  (export service paths plist))
