(module tibo.cli
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "node:process" :default process)
  (import "./engine.eli" run-report judge observe load-snapshot reset-status)
  (import "./history.eli" summarize-history)
  (import "./mcp.eli" start-mcp)
  (import "./config.eli" load-config)
  (import "./ai-runtime.eli" ai-status)
  (import "./daemon.eli" start-daemon)
  (import "./service.eli" service)
  (import "./commands.eli" resolve-query execute-query fixed-query help-text)
  (import "./admin.eli" cli-context)
  (import "./state.eli" with-lock read-state)
  (import "./util.eli" json fail ms)
  (defconst help "tibo query \"固定指令\" / ask \"自然语言提问\"\ntibo \"自然语言提问\"（未识别为CLI命令时自动ask）\ntibo commands\ntibo posts [--limit N] [--hours N] [--keyword TEXT] [--offline]\ntibo banked / signals / stats [--offline]\ntibo forecast [--json] [--no-ai] [--offline] [--snapshot FILE]\ntibo status [--since ISO-UTC] [--offline] [--snapshot FILE]\ntibo history [--offline] [--snapshot FILE]\ntibo evaluate [--snapshot FILE]\ntibo ai-status / diagnose（本地只读）\ntibo clear-history / clear-experience / reset-ai（先申请）\ntibo confirm ID / cancel ID\ntibo daemon [--once] / daemon-status\ntibo service install|restart|status|uninstall\ntibo mcp\n\n核心无需API key；AI各功能可选且失败自动降级。业务查询与本地维护命令分开，远程不开放维护命令。默认配置 ~/.config/tibo/config.env，环境变量优先。")
  (defconst cli-commands (js-array "forecast" "status" "history" "posts" "banked" "signals" "stats" "help" "--help" "-h"
    "query" "ask" "commands" "evaluate" "ai-status" "clear-history" "clear-experience" "reset-ai" "ai-reset" "confirm" "cancel"
    "diagnose" "daemon" "daemon-status" "service" "mcp"))
  (defun parse-args (argv)
    (if (and (> (get argv :length) 0) (not (js-call cli-commands :includes (get argv 0))))
      ;; Preserve the whole question, including tokens resembling CLI options.
      (js-object :command "ask" :question (js-call argv :join " "))
      (let ((options (js-object :command (get argv 0 "forecast"))) (index 1))
      (while (< index (get argv :length))
        (let ((arg (get argv index)))
          (cond ((or (= (get options :command) "ask") (= (get options :command) "query"))
                  (put options :question (js-call (js-call argv :slice 1) :join " ")) (setq index (get argv :length)))
                ((and (js-call (js-array "confirm" "cancel") :includes (get options :command)) (= index 1)) (put options :id arg))
                ((= arg "--json") (put options :json t))
                ((= arg "--offline") (put options :offline t))
                ((= arg "--no-ai") (put options :noAi t))
                ((= arg "--once") (put options :once t))
                ((js-call arg :startsWith "|") (put options :pipelineText (js-call (js-call argv :slice index) :join " ")) (setq index (get argv :length)))
                ((and (= (get options :command) "service") (= index 1)) (put options :serviceCommand arg))
                ((js-call (js-array "--limit" "--hours" "--keyword" "--postId") :includes arg)
                  (setq index (+ index 1))
                  (unless (get argv index) (fail "查询参数缺少值"))
                  (put options (js-call arg :slice 2) (if (or (= arg "--keyword") (= arg "--postId")) (get argv index) (Number (get argv index)))))
                ((or (= arg "--snapshot") (= arg "--since"))
                  (setq index (+ index 1))
                  (unless (get argv index) (fail (str arg " 缺少值")))
                  (put options (if (= arg "--snapshot") "snapshotPath" "since") (get argv index)))
                (t (fail (str "未知参数：" arg)))))
        (setq index (+ index 1)))
      options)))
  (defasync main ()
    (try
      (await (load-config))
      (let* ((args (parse-args (js-call (get process :argv) :slice 2))) (command (get args :command)) (context (cli-context)))
        (put args :context context)
        (cond ((and (not (get args :pipelineText)) (or (= command "help") (= command "--help") (= command "-h"))) (print (str (help-text context) "\n\n本地运行维护：\n" help)))
              ((= command "mcp") (await (start-mcp)))
              ((= command "ai-status") (print (json (await (ai-status)))))
              ((= command "diagnose") (print (json (js-object :lastQuery (await (read-state "diagnostics-cli"))
                :lastDaemon (await (read-state "diagnostics-daemon")) :ai (await (ai-status))))))
              ((js-call (js-array "clear-history" "clear-experience" "reset-ai" "ai-reset" "confirm" "cancel") :includes command)
                (let ((response (await (execute-query (js-object :command (if (= command "ai-reset") "reset-ai" command)
                  :args (if (get args :id) (js-object :id (get args :id)) (js-object))) args))))
                  (print (get response :text)) (unless (get response :ok) (put process :exitCode 2))))
              ((= command "daemon") (await (start-daemon (get args :once))))
              ((= command "daemon-status") (print (json (await (read-state "daemon")))))
              ((= command "service") (print (json (await (service (get args :serviceCommand "status"))))))
              ((or (= command "ask") (= command "query"))
                (let ((response (await (execute-query (await (resolve-query (get args :question "") context)) args))))
                  (print (get response :text)) (unless (get response :ok) (put process :exitCode 2))))
              ((and (get args :pipelineText) (js-call (js-array "forecast" "status" "history" "commands" "help" "--help" "-h") :includes command))
                (let* ((params (js-object)) (name (if (js-call (js-array "commands" "help" "--help" "-h") :includes command) "help" command)))
                  (when (= name "status") (when (get args :since) (put params :since (get args :since))))
                  (when (= name "history") (when (Object/hasOwn args "limit") (put params :limit (get args :limit))))
                  (let ((response (await (execute-query (js-object :command name :args params) args))))
                    (print (get response :text)) (unless (get response :ok) (put process :exitCode 2)))))
              ((= command "commands") (print (help-text context)))
              ((js-call (js-array "posts" "banked" "signals" "stats") :includes command)
                (let ((params (js-object)))
                  (js-call (js-array "limit" "hours" "keyword" "postId") :forEach (lambda (key) (when (Object/hasOwn args key) (put params key (get args key)))))
                  (let ((response (await (execute-query (js-object :command command :args params) args))))
                    (print (get response :text)) (unless (get response :ok) (put process :exitCode 2)))))
              ((= command "forecast")
                (await (with-lock "cli-report" (async ()
                  (let ((result (await (run-report args))))
                    (print (if (get args :json) (json result) (get result :report))))))))
              ((= command "evaluate")
                (let ((result (judge (await (load-snapshot (get args :snapshotPath) t)))))
                  (print (json (js-object :model (get (get result :forecast) :model)
                    :experience (await (read-state "experience")))))))
              ((or (= command "status") (= command "history"))
                (let ((result (observe (await (load-snapshot (get args :snapshotPath) (get args :offline))))))
                  (when (get args :since) (ms (get args :since)))
                  (print (json (if (= command "status") (reset-status result (get args :since))
                               (js-object :history (if (get (get result :signals) :lastGlobal) (summarize-history (get result :events) (get (get result :snapshot) :now)) nil) :events (get result :events)))))))
              (t (fail (str "未知命令：" command)))))
      (catch error (console/error (str "tibo: " (get error :message "执行失败"))) (put process :exitCode 1))))
  (main)
  (export parse-args main))
