(module tibo.util
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (defconst hour-ms 3600000)
  (defconst day-ms 86400000)
  (defun fail (message) (throw (new Error message)))
  (defun matches (pattern text) (js-call (new RegExp pattern "i") :test text))
  (defun match (pattern text) (js-call (new RegExp pattern "i") :exec text))
  (defun clean (text) (js-call (js-call (str text) :replace (new RegExp "[\\r\\n]+" "g") " ") :trim))
  (defun canonical-text (text) (js-call (js-call (str (or text "")) :replace (new RegExp "\\s+" "g") " ") :trim))
  (defun ms (value)
    (let ((n (Date/parse value)))
      (if (Number/isFinite n) n (fail (str "Invalid UTC timestamp: " value)))))
  (defun iso (value) (js-call (new Date value) :toISOString))
  (defun utc (value) (str "UTC " (js-call (js-call (iso (ms value)) :slice 5 16) :replace "T" " ")))
  (defun beijing (value) (js-call (js-call (iso (+ (ms value) (* 8 hour-ms))) :slice 5 16) :replace "T" " "))
  (defun days (duration) (/ duration day-ms))
  (defun decimal (value) (js-call value :toFixed 2))
  (defun values (items) (js-call items :join "、"))
  (defun sorted (items key)
    (js-call (js-call items :slice) :sort
      (lambda (a b) (- (ms (get a key)) (ms (get b key))))))
  (defun last-item (items) (get items (- (get items :length) 1) nil))
  (defun recent (at now hours) (and (<= (ms at) (ms now)) (>= (ms at) (- (ms now) (* hours hour-ms)))))
  (defun unknown (items text) (js-call items :push text))
  (defun clamp (value) (Math/max 0 (Math/min 100 (Math/round value))))
  (defun json (value) (JSON/stringify value nil 2))
  (export hour-ms day-ms fail matches match clean canonical-text ms iso utc beijing days decimal values sorted last-item recent unknown clamp json))
