(module tibo.search
  (import "./host.eli" Date RegExp URL fetch AbortSignal encodeURIComponent)
  (import "node:crypto" createHash)
  (import "./html.eli" parse-html by-tag html-text attr)
  (import "./state.eli" read-state write-state with-lock)
  (import "./privacy.eli" public-text private-question?)
  (import "./util.eli" fail matches clean iso)
  (defun official-url? (url)
    (try (let ((u (new URL url)))
      (and (= (get u :protocol) "https:") (= (get u :port) "") (= (get u :username) "") (= (get u :password) "")
        (js-call (js-array "openai.com" "www.openai.com" "help.openai.com" "status.openai.com") :includes (get u :hostname))))
      (catch error false)))
  (defun validate-plan (value)
    (unless (and value (Array/isArray (get value :queries)) (<= (get (get value :queries) :length) 2)
      (js-call (Object/keys value) :every (lambda (k) (= k "queries")))) (fail "搜索计划不合法"))
    (js-object :queries (js-call (get value :queries) :map (lambda (q)
      (unless (and q (= (value-type (get q :query)) "string") (>= (get (get q :query) :length) 4) (<= (get (get q :query) :length) 100)
        (js-call (js-array "google" "baidu") :includes (get q :engine)) (matches "codex|重置|额度" (get q :query))
        (not (private-question? (get q :query))) (= (public-text (get q :query) 100) (get q :query))
        (not (matches "https?://|@|site:|[<>]" (get q :query)))
        (js-call (Object/keys q) :every (lambda (k) (or (= k "query") (= k "engine"))))) (fail "搜索参数不合法"))
      (js-object :engine (get q :engine) :query (get q :query))))))
  (defasync get-page (url &optional timeout)
    (let ((response (await (fetch url (js-object :redirect "manual" :signal (AbortSignal/timeout (or timeout 6000))
      :headers (js-object :user-agent "Mozilla/5.0 (compatible; Tibo public evidence reader)"))))))
      (unless (get response :ok) (fail "页面未成功返回"))
      (let ((text (await (js-call response :text))))
        (when (> (get text :length) 2000000) (fail "页面超限")) text)))
  (defun links-from (html engine)
    (when (matches "<title[^>]*>[^<]*(?:验证码|安全验证|captcha|unusual traffic)|id=\"captcha\"" html) (fail "搜索验证页面"))
    (let ((links (js-array)))
      (js-call (by-tag (parse-html html) "a") :forEach (lambda (a)
        (let ((url (attr a "href")))
          (when url
            (try
              (when (matches "^/url\\?" url) (setq url (or (js-call (get (new URL url "https://www.google.com") :searchParams) :get "q") (js-call (get (new URL url "https://www.google.com") :searchParams) :get "url"))))
              (when (and url (or (official-url? url) (and (= engine "baidu") (matches "^https://www\\.baidu\\.com/link\\?" url)))
                (not (js-call links :includes url))) (js-call links :push url))
              (catch error nil))))))
      (js-call links :slice 0 4)))
  (defasync resolve-baidu (url &optional timeout)
    (if (official-url? url) url
      (let ((r (await (fetch url (js-object :redirect "manual" :signal (AbortSignal/timeout (or timeout 4000)))))))
        (let ((target (js-call (get r :headers) :get "location")))
          (unless (and (>= (get r :status) 300) (< (get r :status) 400) target (official-url? target)) (fail "搜索跳转目标不可用")) target))))
  (defasync search-one (engine query &optional timeout)
    (validate-plan (js-object :queries (js-array (js-object :engine engine :query query))))
    (let* ((key (str "search-" (js-call (js-call (js-call (createHash "sha256") :update (str engine ":" query)) :digest "hex") :slice 0 32))))
      (await (with-lock key (async ()
        (let ((cached (await (read-state key))))
          (if (and cached (> (get cached :until) (Date/now))) (Object/assign (js-object) cached (js-object :cached t))
            (let ((outcome nil))
              (try
                (let* ((q (str query " site:openai.com"))
                  (url (if (= engine "google") (str "https://www.google.com/search?q=" (encodeURIComponent q)) (str "https://www.baidu.com/s?wd=" (encodeURIComponent q))))
                  (links (links-from (await (get-page url timeout)) engine)))
                  (setq outcome (js-object :engine engine :state (if (> (get links :length) 0) "ok" "empty") :links links :until (+ (Date/now) 21600000))))
                (catch error (setq outcome (js-object :engine engine :state "unavailable" :links (js-array) :until (+ (Date/now) 3600000)))))
              (await (write-state key outcome)) outcome))))))))
  (defasync run-search (plan &optional timeout)
    (let ((queries (get (validate-plan plan) :queries)) (documents (js-array)) (outcomes (js-array)) (seen (js-array)) (budget 2)
      (deadline (+ (Date/now) (or timeout 12000))))
      ;; One bounded batch, never a recursive agent or arbitrary URL fetcher.
      (let ((rows (await (Promise/all (js-call queries :map (async (q) (await (search-one (get q :engine) (get q :query) (Math/max 1 (Math/min 6000 (- deadline (Date/now))))))))))))
        (js-call rows :forEach (lambda (row) (js-call outcomes :push (js-object :engine (get row :engine) :state (get row :state) :cached (get row :cached false)))))
        (let ((i 0))
          (while (< i (get rows :length))
            (let ((row (get rows i)) (j 0))
              (while (and (> budget 0) (> (- deadline (Date/now)) 500) (< j (get (get row :links) :length)))
                (let ((link (get (get row :links) j)))
                  (unless (js-call seen :includes link)
                    (js-call seen :push link) (setq budget (- budget 1))
                    (try
                      (let* ((url (await (resolve-baidu link (Math/max 1 (Math/min 4000 (- deadline (Date/now)))))))
                        (id (str "page-" (js-call (js-call (js-call (createHash "sha256") :update url) :digest "hex") :slice 0 16)))
                        (cached (await (read-state id))))
                        (if (and cached (> (get cached :until) (Date/now))) (js-call documents :push (get cached :document))
                          (let* ((root (parse-html (await (get-page url (Math/max 1 (Math/min 6000 (- deadline (Date/now))))))))
                            (text (public-text (html-text (or (get (by-tag root "main") 0) (get (by-tag root "article") 0) root)) 1800)))
                            (when (and (> (get text :length) 80) (matches "codex|usage|rate limit|reset" text))
                              (let ((document (js-object :id id :type "page" :url url :text text :at nil :provenance "official-page")))
                                (await (write-state id (js-object :until (+ (Date/now) 21600000) :document document)))
                                (js-call documents :push document))))))
                      (catch error nil))))
                (setq j (+ j 1))))
            (setq i (+ i 1)))))
      (js-object :documents documents :engines outcomes)))
  (export official-url? validate-plan links-from search-one run-search))
