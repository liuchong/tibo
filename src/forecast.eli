(module tibo.forecast
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "./util.eli" ms hour-ms day-ms clamp days recent fail)
  (defun baseline (all recent key)
    (let ((a (get all key)) (b (get recent key)))
      (cond ((and (not (nullish? a)) (not (nullish? b))) (/ (+ a b) 2))
            ((not (nullish? b)) b) ((not (nullish? a)) a) (t nil))))
  (defun forecast (snapshot history signals)
    (let* ((now (get snapshot :now)) (all (get history :all)) (recent-sample (get history :recent))
           (base24 (baseline all recent-sample "p24")) (base48 (baseline all recent-sample "p48"))
           (p24 (or base24 0)) (p48 (or base48 0))
           (promise (get signals :promise)) (banked (get signals :lastBanked))
           (active (and promise (not (get promise :fulfilled)) (= (get promise :kind) "global")
                        (>= (- (ms (get promise :targetAt)) (ms now)) (* -6 hour-ms))))
           (primary (and active (get promise :primary)))
           (compensation (get signals :compensation))
           (reasons (js-array)) (confidence "低"))
      (when (and (nullish? base24) (nullish? base48))
        (fail "条件样本为 0，无法给出历史基线概率"))
      ;; Policy v1: equal all/recent baseline weight. Numeric adjustments are explicit,
      ;; conservative implementation choices, not claims that the skill has a formula.
      (when active
        (setq confidence "中")
        (let ((until (- (ms (get promise :targetAt)) (ms now))))
          (when (and (>= until (* -6 hour-ms)) (<= until (* 24 hour-ms)))
            (setq p24 (Math/max p24 (if primary 90 75))
                  p48 (Math/max p48 (if primary 95 85))))
          (when (and (> until (* 24 hour-ms)) (<= until (* 48 hour-ms)))
            (setq p48 (Math/max p48 (if primary 90 75))))
          (js-call reasons :push (if (> until (* 48 hour-ms)) "明确承诺在 48h 窗口之外，本窗口不加权"
              (if primary "原帖明确 global 承诺上调（含约 6h 落地宽限）" "存档明确承诺上调；主页未核实，降低承诺权重")))
          (when (and primary (> until (* -6 hour-ms))) (setq confidence "高"))))
      (when (and compensation (not active))
        (setq p24 (+ p24 (if (get compensation :primary) 10 5))
              p48 (+ p48 (if (get compensation :primary) 15 10)) confidence "中")
        (js-call reasons :push "Tibo 未消耗的事故补偿暗示温和上调；不与同一明确承诺重复计权"))
      (when (and banked (get banked :verifiedBanked) (recent (get banked :at) now 24) (not active) (not compensation))
        (setq p24 (* p24 0.65))
        (js-call reasons :push "近期已发 banked，仅温和降低 24h 权重；不移动 global 时钟"))
      (when (and promise (not (get promise :fulfilled)) (not active) (= (get promise :kind) "global"))
        (js-call reasons :push "承诺已超过落地宽限且未核实兑现，本次不给旧承诺继续加权"))
      (when (and promise (get promise :fulfilled)) (js-call reasons :push "旧承诺已消耗，权重归零"))
      (when (= (get reasons :length) 0) (js-call reasons :push "无可核实的新 global 信号，保留条件基线"))
      (setq p24 (clamp p24) p48 (Math/max p24 (clamp p48)))
      (js-object :policyVersion "1.0" :p24 p24 :p48 p48 :base24 base24 :base48 base48
       :confidence confidence :reasons reasons :mode "rules")))
  (export baseline forecast))
