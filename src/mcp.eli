(module tibo.mcp
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "node:process" :default process)
  (import "./engine.eli" run-report judge observe load-snapshot reset-status)
  (import "./state.eli" with-lock)
  (import "./history.eli" summarize-history)
  (import "./util.eli" json fail ms)
  (defconst tools
    (js-array
      (js-object :name "codex_reset_forecast" :description "根据公开证据与本地历史计算24/48h global历史概率；返回独立报告。"
        :inputSchema (js-object :type "object" :properties (js-object) :additionalProperties false)
        :annotations (js-object :readOnlyHint t :openWorldHint t))
      (js-object :name "codex_reset_status" :description "观测最近global公告；区分已核实完成与站点记录，不推断个人账户刷新。"
        :inputSchema (js-object :type "object" :properties (js-object :since (js-object :type "string" :format "date-time")) :additionalProperties false)
        :annotations (js-object :readOnlyHint t :openWorldHint t))
      (js-object :name "codex_reset_history" :description "读取重新采集的历史、条件样本和banked到global间隔。"
        :inputSchema (js-object :type "object" :properties (js-object :offset (js-object :type "integer" :minimum 0) :limit (js-object :type "integer" :minimum 1 :maximum 100)) :additionalProperties false)
        :annotations (js-object :readOnlyHint t :openWorldHint t))))
  (defasync handle-tool (request)
    (try
      (let* ((params (get request :params)) (name (get params :name)) (args (get params :arguments (js-object))))
        (when (js-call (Object/keys args) :some (lambda (k) (not (if (= name "codex_reset_status") (= k "since")
          (if (= name "codex_reset_history") (or (= k "offset") (= k "limit")) false))))) (fail "未知参数"))
        (cond
          ((= name "codex_reset_forecast")
            (let ((result (await (with-lock "mcp-report" (async () (await (run-report (js-object :channel "mcp" :snapshotPath (get (get process :env) :TIBO_SNAPSHOT)))))))))
              (js-object :content (js-array (js-object :type "text" :text (get result :report))))))
          ((or (= name "codex_reset_status") (= name "codex_reset_history"))
            (let* ((result (observe (await (load-snapshot (get (get process :env) :TIBO_SNAPSHOT)))))
                   (since (get args :since)) (offset (get args :offset 0)) (limit (get args :limit 50)))
              (when since (ms since))
              (unless (and (Number/isInteger offset) (>= offset 0) (Number/isInteger limit) (>= limit 1) (<= limit 100)) (fail "分页参数非法"))
              (js-object :content (js-array (js-object :type "text" :text
                (json (if (= name "codex_reset_status") (reset-status result since)
                  (js-object :history (summarize-history (get result :events) (get (get result :snapshot) :now)) :total (get (get result :events) :length)
                    :events (js-call (get result :events) :slice offset (+ offset limit))))))))))
          (t (fail "未知工具"))))
      (catch error (js-object :isError t :content (js-array (js-object :type "text" :text (get error :message "判断失败")))))))
  (defun rpc-error (id code message) (js-object :jsonrpc "2.0" :id id :error (js-object :code code :message message)))
  (defasync dispatch (request state)
    (let ((method (get request :method)) (id (get request :id)))
      (cond
        ((= method "initialize")
          (if (not (= (get state :phase) 0)) (rpc-error id -32600 "Already initialized")
            (progn (put state :phase 1)
              (js-object :jsonrpc "2.0" :id id :result
                (js-object :protocolVersion "2025-11-25" :capabilities (js-object :tools (js-object))
                  :serverInfo (js-object :name "tibo" :version "0.1.0"))))))
        ((= method "ping") (js-object :jsonrpc "2.0" :id id :result (js-object)))
        ((not (= (get state :phase) 2)) (rpc-error id -32002 "Client must initialize first"))
        ((= method "tools/list") (js-object :jsonrpc "2.0" :id id :result (js-object :tools tools)))
        ((= method "tools/call")
          (let ((params (get request :params)))
            (if (or (not params) (not (= (value-type (get params :name)) "string"))
                    (not (= (value-type (get params :arguments (js-object))) "object"))
                    (Array/isArray (get params :arguments)))
              (rpc-error id -32602 "Invalid tool parameters")
              (if (not (js-call tools :some (lambda (tool) (= (get tool :name) (get params :name)))))
                (rpc-error id -32602 "Unknown tool")
                (js-object :jsonrpc "2.0" :id id :result (await (handle-tool request)))))))
        (t (rpc-error id -32601 "Method not found")))))
  (defasync start-mcp ()
    (let ((state (js-object :phase 0)) (queue (Promise/resolve nil)) (pending "")
          (cancelled (new Set)) (inflight (new Set)) (count 0))
      (new Promise (lambda (resolve reject)
        (let ((send (lambda (response) (js-call (get process :stdout) :write (str (JSON/stringify response) "\n"))))
              (line-handler nil))
          (setq line-handler (lambda (line)
            (try
              (let* ((request (JSON/parse line)) (id (get request :id)) (has-id (and request (Object/hasOwn request "id"))))
                (unless (and (= (value-type request) "object") (not (Array/isArray request))
                             (= (get request :jsonrpc) "2.0") (= (value-type (get request :method)) "string")
                             (or (not has-id) (= (value-type id) "string") (and (= (value-type id) "number") (Number/isFinite id))))
                  (funcall send (rpc-error nil -32600 "Invalid request")) (fail "Rejected request"))
                (if (not has-id)
                  (cond ((= (get request :method) "notifications/cancelled")
                          (let ((target (get (get request :params) :requestId)))
                            (when (js-call inflight :has target) (js-call cancelled :add target))))
                        ((= (get request :method) "notifications/initialized")
                          (setq queue (js-call queue :then (lambda () (when (= (get state :phase) 1) (put state :phase 2)))))))
                  (if (or (>= count 32) (js-call inflight :has id)) (funcall send (rpc-error id -32000 "Busy or duplicate request id"))
                    (progn
                      (setq count (+ count 1)) (js-call inflight :add id)
                      (setq queue (js-call queue :then (async ()
                        (try
                          (unless (js-call cancelled :has id)
                            (let ((response (await (dispatch request state))))
                              (unless (js-call cancelled :has id) (funcall send response))))
                          (catch error (unless (js-call cancelled :has id) (funcall send (rpc-error id -32603 "Internal error"))))
                          (finally (setq count (- count 1)) (js-call inflight :delete id) (js-call cancelled :delete id))))))))))
              (catch error
                (unless (= (get error :message) "Rejected request") (funcall send (rpc-error nil -32700 "Parse error")))))))
          (js-call (get process :stdin) :setEncoding "utf8")
          (js-call (get process :stdin) :on "data" (lambda (chunk)
            (setq pending (str pending chunk))
            (let ((index (js-call pending :indexOf "\n")))
              (while (>= index 0)
                (let ((line (js-call pending :slice 0 index)))
                  (if (> (get line :length) 1048576) (funcall send (rpc-error nil -32600 "Message too large"))
                    (when (> (get (js-call line :trim) :length) 0) (funcall line-handler line))))
                (setq pending (js-call pending :slice (+ index 1)) index (js-call pending :indexOf "\n")))
              (when (> (get pending :length) 1048576)
                (funcall send (rpc-error nil -32600 "Message too large"))
                (js-call (get process :stdin) :destroy) (funcall reject (new Error "MCP message too large"))))))
          (js-call (get process :stdin) :on "end" (lambda ()
            (when (> (get (js-call pending :trim) :length) 0) (funcall send (rpc-error nil -32700 "Unterminated message")))
            (js-call queue :then resolve reject)))
          (js-call (get process :stdin) :on "error" reject))))))
  (export tools handle-tool dispatch start-mcp))
