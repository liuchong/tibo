(module tibo.evidence.public-posts
  (import "../platform/host.eli" URL BigInt Number encodeURIComponent)
  (import "./html.eli" parse-html by-class by-tag html-text)
  (import "./transport.eli" request-json)
  (import "../platform/util.eli" matches iso recent canonical-text fail)
  ;; A fixed provenance boundary, not a model-generated list of trusted people.
  (defconst accounts (js-array "openai" "openaidevs"))
  (defun post-address (url)
    (try
      (let* ((u (new URL url)) (parts (js-call (get u :pathname) :split "/"))
        (author (js-call (get parts 1 "") :toLowerCase)) (id (get parts 3 "")))
        (when (and (= (get u :protocol) "https:") (= (get u :port) "") (= (get u :username) "") (= (get u :password) "")
          (js-call (js-array "x.com" "twitter.com" "www.twitter.com") :includes (get u :hostname))
          (js-call accounts :includes author) (= (get parts 2) "status") (= (get parts :length) 4)
          (matches "^[0-9]{16,20}$" id))
          (js-object :author author :id id :url (str "https://x.com/" author "/status/" id))))
      (catch error nil)))
  (defun parse-public-post (data address now)
    (let* ((matched (post-address (get data :url "")))
      (author (get address :author)) (id (get address :id))
      (root (parse-html (get data :html ""))) (quote (get (by-class root "twitter-tweet") 0))
      (text (canonical-text (html-text (get (by-tag (or quote (js-object)) "p") 0))))
      (at (iso (Number (+ (bit-shift-right (BigInt id) (BigInt 22)) (BigInt "1288834974657"))))))
      (unless (and matched (= (get matched :author) author) (= (get matched :id) id)
        (matches (str "^https://(?:x|twitter)\\.com/" author "/?$") (get data :author_url ""))
        (recent at now 48) (> (get text :length) 20) (<= (get text :length) 1800)
        (not (matches "…(?:\\s*https?://[^ ]+)?$" text))
        (matches "codex" text) (matches "reset|usage|rate.?limit|quota|compensat|outage|incident|restor|degrad" text)
        (not (matches "\\b(?:my|our personal|my personal) (?:account|usage|quota)\\b" text)))
        (fail "补充原帖作者、时间或业务证据不足"))
      (js-object :id (str "public-post-" id) :type "post" :at at :text text :url (get address :url)
        :author author :provenance "official-post")))
  (defasync fetch-public-post (url now timeout)
    (let ((address (post-address url)))
      (unless address (fail "补充原帖不在固定来源范围内"))
      (parse-public-post (await (request-json (str "https://publish.x.com/oembed?omit_script=true&url="
        (encodeURIComponent (get address :url))) (js-object :redirect "manual") timeout)) address now)))
  (export post-address parse-public-post fetch-public-post))
