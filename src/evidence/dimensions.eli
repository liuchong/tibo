(module tibo.evidence.dimensions
  (import "../platform/host.eli" Map)
  (import "../platform/util.eli" ms hour-ms sorted last-item canonical-text)
  (import "./post-context.eli" active-programme linked-reset-context)
  (import "./day-plan.eli" programme-choice)
  (import "./post-features.eli" local-row)
  (import "./research.eli" documents-from)
  (defconst dimension-names (js-array "before_last_reset" "after_last_reset" "last_48h" "last_24h" "latest_three" "latest_anchored_24h" "official_context"))
  (defun window-coverage (snapshot from through)
    (if (and from through
      (js-call (js-call (get snapshot :coverages (js-array)) :concat
        (if (get snapshot :coverage) (js-array (get snapshot :coverage)) (js-array))) :some (lambda (c)
        (try (and (get c :audited) (get c :postsComplete)
          (<= (ms (get c :from)) from) (>= (ms (get c :through)) through)
          (<= (ms (get c :through)) (ms (get snapshot :now)))) (catch error false))))) "audited" "unknown"))
  (defun dimension-input (result)
    (let* ((snapshot (get result :snapshot)) (now (get snapshot :now)) (clock (ms now))
      (global (get (get result :signals) :lastGlobal))
      (confirmed-global (last-item (sorted (js-call (get result :events (js-array)) :filter (lambda (e) (and (get e :global) (not (get e :presumed))))) "at")))
      (boundary-event (if (and global (get global :presumed)) confirmed-global global))
      (boundary (when boundary-event (ms (get boundary-event :at))))
      (promise (get (get result :signals) :promise))
      (cycle-promise-at (when (and promise (get promise :primary) (= (get promise :kind) "global")
        (or (not (get promise :fulfilled)) (get promise :presumed))) (ms (get promise :at))))
      (unique (new Map)) (windows (js-array)) (documents (documents-from snapshot)))
      (js-call (get snapshot :posts) :forEach (lambda (post)
        (when (<= (ms (get post :at)) clock) (js-call unique :set (get post :id) post))))
      (let* ((visible (sorted (Array/from (js-call unique :values)) "at")) (latest (last-item visible))
        (anchor (when latest (ms (get latest :at))))
        (programme (active-programme visible now boundary-event))
        (posts (js-call visible :map (lambda (post)
          (let* ((post-plan (active-programme visible (get post :at)))
            (p (Object/assign (js-object) post (linked-reset-context post visible post-plan)))
            (parent (when (get p :parentId) (js-call unique :get (get p :parentId))))
            (choice (programme-choice p post-plan visible)))
            (when (and parent (= (get parent :provenance) "primary") (< (ms (get parent :at)) (ms (get p :at))))
              (put p :parentText (get parent :text)) (put p :parentAuthor (get parent :author)) (put p :parentProvenance "primary"))
            (when (and cycle-promise-at (= (get p :author) "thsottiaux") (= (get p :provenance) "primary")
              (not (get p :truncated)) (> (ms (get p :at)) cycle-promise-at))
              (put p :cyclePromiseContext t)
              (unless (get p :resetContextScope) (put p :resetContextScope "global")))
            (put p :programmeChoice choice)
            ;; Only public source fields leave the ledger; discovery URLs,
            ;; collection errors and machine configuration never enter prompts.
            (Object/fromEntries (js-call (Object/entries p) :filter (lambda (pair)
              (js-call (js-array "id" "at" "author" "text" "provenance" "truncated" "contextMissing"
                "parentId" "parentText" "parentAuthor" "parentProvenance" "quoteText"
                "resetContextVerified" "resetContextText" "resetContextPostIds" "resetContextAt" "resetContextScope"
                "resetContextBasis" "programmePostId" "programmeText" "programmeChoice" "cyclePromiseContext") :includes (get pair 0)))))))))
        (specs (js-array
          (js-array "before_last_reset" nil boundary)
          (js-array "after_last_reset" boundary clock)
          (js-array "last_48h" (- clock (* 48 hour-ms)) clock)
          (js-array "last_24h" (- clock (* 24 hour-ms)) clock)
          (js-array "latest_three" nil anchor)
          (js-array "latest_anchored_24h" (when anchor (- anchor (* 24 hour-ms))) anchor))))
        (js-call specs :forEach (lambda (spec)
          (let* ((name (get spec 0)) (from (get spec 1)) (through (get spec 2))
            (selected (cond
              ((= name "before_last_reset") (if boundary (js-call posts :filter (lambda (p) (< (ms (get p :at)) boundary))) (js-array)))
              ((= name "after_last_reset") (if boundary (js-call posts :filter (lambda (p) (> (ms (get p :at)) boundary))) posts))
              ((= name "latest_three") (js-call posts :slice -3))
              (t (js-call posts :filter (lambda (p) (and from through (>= (ms (get p :at)) from) (<= (ms (get p :at)) through))))))))
            (js-call windows :push (js-object :name name :fromEpochMs from :throughEpochMs through :count (get selected :length)
              :coverage (window-coverage snapshot from through)
              :ids (js-call selected :map (lambda (p) (get p :id))))))))
        (js-call windows :push (js-object :name "official_context" :count (get documents :length)
          :coverage "available-sources" :ids (js-call documents :map (lambda (d) (get d :id)))))
        (js-object :contract "dimensions-2" :now now :timeBucket (Math/floor (/ clock (* 5 60000)))
          :posts posts :windows windows :documents documents :programme programme
          :lastGlobal (when global (js-object :id (get global :id) :at (get global :at) :verified (get global :verified) :presumed (get global :presumed false)))
          :temporal (Object/fromEntries (js-call (Object/entries (get (get result :forecast) :temporal)) :filter
            (lambda (pair) (js-call (js-array "policy" "events" "recent" "elapsedMs" "elapsedHours" "elapsedDays" "now") :includes (get pair 0)))))
          :promise (get (get result :signals) :promise)))))
  (defun native-assessment (input)
    (let* ((rows (js-call (get input :posts) :map (lambda (p) (local-row p))))
      (promise (get input :promise))
      (active (and promise (get promise :primary) (not (get promise :fulfilled)) (not (get promise :withdrawn))))
      (ids (when active (js-array (get promise :postId) (get promise :parentId))))
      (scores (js-call (get input :windows) :map (lambda (window)
        (let ((support 0) (opposition 0) (commitment 0) (imminence 0) (refs (js-array)))
          (js-call (get window :ids) :forEach (lambda (id)
            (let* ((post (js-call (get input :posts) :find (lambda (p) (= (get p :id) id))))
              (row (js-call rows :find (lambda (r) (= (get r :postId) id)))))
              (when (and post active (js-call ids :includes id))
                (when (< support 1) (setq refs (js-array)))
                (setq support 1 commitment 1 imminence 1)
                (js-call refs :unshift (js-object :postId id :quote (js-call (canonical-text (get post :text)) :slice 0 180))))
              (when row (js-call (get row :claims) :forEach (lambda (claim)
                (when (and (= (get claim :kind) "negation") active (> (ms (get claim :at)) (ms (get promise :at))))
                  (setq opposition 1))
                (when (and (= support 0) (js-call (js-array "hint" "promise" "programme") :includes (get claim :kind)))
                  (setq support 0.35 commitment 0.2 imminence 0.2)
                  (js-call refs :push (js-object :postId id :quote (get claim :quote))))))))))
          (js-object :name (get window :name) :support support :opposition opposition :commitment commitment
            :imminence imminence :citations (js-call refs :slice 0 4)))))))
      (js-object :dimensions scores :rows rows :aiRows 0 :ruleRows (get rows :length) :calls (js-array) :state "fallback")))
  (export dimension-names dimension-input native-assessment))
