(module tibo.evidence.sources
  (import "../platform/host.eli" Date Promise Map encodeURIComponent)
  (import "./html.eli" parse-html by-tag by-class html-text)
  (import "./transport.eli" request request-json)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "./timeline.eli" timeline-from-posts)
  (import "./reset-text.eli" completed?)
  (import "./post-events.eli" events-from-posts)
  (import "./post-context.eli" post-context)
  (import "./post-body.eli" expand-post)
  (import "./post-thread.eli" collect-threads)
  (import "./post-links.eli" enrich-post-links)
  (import "./research.eli" documents-from)
  (import "./x-page.eli" parse-primary snowflake-time)
  (import "./cache.eli" cached-sources)
  (import "../platform/util.eli" fail canonical-text ms iso matches sorted last-item unknown utc)
  (defun parse-embed (data id now)
    (unless (and (matches "^https://(?:x|twitter)\\.com/thsottiaux/?$" (get data :author_url ""))
                 (matches (str "^https://(?:x|twitter)\\.com/thsottiaux/status/" id "(?:\\?|$)") (get data :url "")))
      (fail "X 原文作者或帖子ID不匹配"))
    (let* ((root (parse-html (get data :html "")))
           (quote (get (by-class root "twitter-tweet") 0))
           (text (canonical-text (html-text (get (by-tag (or quote (js-object)) "p") 0))))
           (at (snowflake-time id)))
      (unless (and (> (get text :length) 0) (<= (ms at) (ms now))) (fail "X 嵌入内容或时间不合法"))
      (js-object :id id :at at :text text :author "thsottiaux" :url (get data :url)
        :provenance "primary" :cachedAt now :via "official-oembed" :truncated (matches "…(?:\\s*https?://[^ ]+)?$" text))))
  (defasync collect-one (name url now &optional offline)
    (try
      (when offline (fail "离线模式：未请求"))
      (js-object :name name :url url :ok t :fetched t :at now :body (await (request url)))
      (catch error (js-object :name name :url url :ok false :at now :error (get error :message "抓取失败")))))
  (defun merge-posts (cached primary)
    (let ((items (new Map)))
      (js-call cached :forEach (lambda (p) (js-call items :set (get p :id) p)))
      (js-call primary :forEach (lambda (p)
        (let ((old (js-call items :get (get p :id))))
          ;; An unchanged discovery fragment must not refresh original verification
          ;; metadata or overwrite a previously restored full body.
          (when (reusable-original? old p)
            (setq p (Object/assign (js-object) old (Object/fromEntries (js-call (Object/entries p) :filter (lambda (pair)
              (js-call (js-array "parentId" "parentRelationProvenance" "quotedPostId" "quotedRelationProvenance" "referenceMetadataVerified" "linkContext")
                :includes (get pair 0))))))))
          (when (and (not (and old (get old :expandedFromPrimary)
                       (or (and (= (get p :provenance) "archive") (not (get p :expandedFromPrimary)))
                         (and (get p :truncated) (= (get old :primaryExcerpt) (get p :text))))))
            (or (not old) (= (get p :provenance) "primary") (get p :expandedFromPrimary) (not (= (get old :provenance) "primary"))))
            (js-call items :set (get p :id) (Object/assign (js-object) (or old (js-object)) p))))))
      (sorted (Array/from (js-call items :values)) "at")))
  (defun reusable-original? (old discovered)
    (and old (= (get old :provenance) "primary") (= (get old :author) "thsottiaux")
      (get old :cachedAt) (not (get old :truncated))
      (or (= (get old :text) (get discovered :text))
        (and (get discovered :truncated)
          (let ((prefix (js-call (get (js-call (get discovered :text) :split "…") 0) :trim)))
            (and (>= (get prefix :length) 40) (js-call (get old :text) :startsWith prefix)))))))
  (defun merge-events (old fresh)
    (let ((items (new Map)))
      (js-call old :forEach (lambda (e) (js-call items :set (get e :id) e)))
      (js-call fresh :forEach (lambda (e) (js-call items :set (get e :id) (Object/assign (js-object) (js-call items :get (get e :id)) e))))
      (sorted (Array/from (js-call items :values)) "at")))
  (defun merge-documents (old fresh now)
    (let ((items (new Map)))
      (js-call old :forEach (lambda (d)
        (js-call items :set (str (get d :url) "|" (get d :at) "|" (get d :status "")) d)))
      (js-call fresh :forEach (lambda (d)
        (let* ((key (str (get d :url) "|" (get d :at) "|" (get d :status "")))
          (previous (js-call items :get key)))
          (js-call items :set key (Object/assign (js-object) d
            (js-object :firstSeenAt (if previous (get previous :firstSeenAt now) now) :lastSeenAt now))))))
      (sorted (Array/from (js-call items :values)) "at")))
  (defasync collect-fresh (&optional clock offline)
    (let* ((now (or clock (iso (Date/now)))) (unknowns (js-array))
           (ledger (or (await (read-state "ledger")) (js-object)))
           (urls (js-array (js-array "status" "https://status.openai.com/api/v2/incidents.json")
                          (js-array "news" "https://openai.com/news/rss.xml")
                          (js-array "primary" "https://x.com/thsottiaux")))
           (sources (await (Promise/all (js-call urls :map (lambda (pair) (collect-one (get pair 0) (get pair 1) now offline))))))
           (fresh-original false) (posts (get ledger :posts (js-array))) (events (get ledger :events (js-array))))
      (try
        (unless (get (get sources 2) :ok) (fail (get (get sources 2) :error)))
        (setq posts (merge-posts posts (parse-primary (get (get sources 2) :body) now)) fresh-original t)
        (catch error (put (get sources 2) :ok false)
          (when (get (get sources 2) :fetched) (put (get sources 2) :error "主页未返回可解析原帖"))
          (unknown unknowns (str "Tibo 主页：" (get error :message) "；保留本地证据"))))
      (js-call sources :forEach (lambda (source)
        (when (and (get source :ok) (js-call (js-array "status" "news") :includes (get source :name)))
          (try
            (if (= (get source :name) "status")
              (unless (Array/isArray (get (JSON/parse (get source :body)) :incidents)) (fail "状态数据结构失配"))
              (unless (matches "<rss\\b[\\s\\S]*<channel\\b" (get source :body)) (fail "新闻数据结构失配")))
            (catch error (put source :ok false) (put source :error "官方资料结构无法解析"))))))
      (unless offline
        (let ((threads (await (collect-threads posts events now))))
          (when (> (get (get threads :posts) :length) 0)
            (setq posts (merge-posts posts (get threads :posts)) fresh-original t))
          (when (> (get (get threads :source) :attempted) 0)
            (js-call sources :push (get threads :source))))
        (let* ((global (last-item (sorted (js-call events :filter (lambda (e) (and (get e :global) (<= (ms (get e :at)) (ms now))))) "at")))
               (context (post-context posts now global))
               ;; Upgrade a bounded number of known historical deadline posts;
               ;; successful originals become permanent and need no next fetch.
               (historical (js-call (js-call (sorted (get ledger :posts (js-array)) "at") :filter (lambda (p)
                 (and (= (get p :author) "thsottiaux") (matches "^[0-9]{16,20}$" (get p :id ""))
                   (= (get p :provenance) "archive") (<= (ms (get p :at)) (ms now))
                   (matches "global.*reset|reset.*global" (get p :text))
                   (matches "today|tomorrow|EOD|end of (?:the )?day" (get p :text))
                   (not (completed? (get p :text)))))) :slice -2))
               (candidates (js-call (get context :posts) :concat (js-call historical :filter (lambda (p)
                 (not (js-call (get context :posts) :some (lambda (chosen) (= (get chosen :id) (get p :id)))))))))
               (reused (js-call candidates :filter (lambda (p)
                 (reusable-original? (js-call (get ledger :posts (js-array)) :find (lambda (old) (= (get old :id) (get p :id)))) p))))
               (pending (js-call candidates :filter (lambda (p) (not (js-call reused :includes p)))))
               (checks (await (Promise/all (js-call pending :map
                 (async (p)
                   (try (await (expand-post (parse-embed (await (request-json (str "https://publish.x.com/oembed?omit_script=true&url=" (encodeURIComponent (get p :url))))) (get p :id) now)))
                     (catch error (unknown unknowns (str "X 原文核实 " (get p :id) "：" (get error :message))) nil))))))))
          (let ((verified (js-call checks :filter (lambda (p) (not (nullish? p))))))
            (js-call sources :push (js-object :name "oembed" :ok (> (+ (get verified :length) (get reused :length)) 0)
              :fetched (> (get verified :length) 0) :at now :reused (get reused :length)
              :attempted (get pending :length) :verified (get verified :length) :selection (get context :selection)
              :error (if (> (+ (get verified :length) (get reused :length)) 0) nil "原文核实不可用")))
            (when (> (get verified :length) 0) (setq fresh-original t))
            (setq posts (merge-posts posts verified)))))
      (unless offline
        (let ((enriched (await (enrich-post-links posts now))))
          (unless (= enriched posts) (setq fresh-original t))
          (setq posts enriched)))
      (setq events (merge-events events (js-call (events-from-posts posts) :map (lambda (event)
        (let ((known (js-call (get ledger :events (js-array)) :find (lambda (old) (= (get old :id) (get event :id))))))
          (if (= (get (or known (js-object)) :completionBasis) "semantic-evidence-agreement") known
            (progn (unless known (put event :tentative t)) event)))))))
      (js-call sources :forEach (lambda (source)
        (unless (get source :ok) (unknown unknowns (str (get source :name) "：" (get source :error))))))
      (unknown unknowns "官方公开页面不保证覆盖全部历史及回复帖；原文核实不代表个人账户生效")
      (unknown unknowns "新闻基础源为官方 RSS，额外搜索执行情况单列；历史公告可能有遗漏")
      (when (get ledger :now) (unknown unknowns (str "本地历史累计到 " (utc (get ledger :now)) "；旧证据不代表本次采集成功")))
      (let ((documents (documents-from (js-object :now now :sources sources))))
      (unless offline
        (when (or fresh-original (> (get documents :length) 0) (> (get events :length) (get (get ledger :events (js-array)) :length)))
          (await (state-transaction "ledger" (async ()
            (let ((latest (or (await (read-state "ledger")) (js-object))))
              (await (write-state "ledger" (Object/assign (js-object) latest (js-object :schemaVersion 1 :now now
                :events (merge-events (get latest :events (js-array)) events)
                :posts (merge-posts (get latest :posts (js-array)) posts)
                :timeline (merge-events (get latest :timeline (js-array)) (timeline-from-posts posts events))
                :documents (merge-documents (get latest :documents (js-array)) documents now))))))))))))
      (js-object :schemaVersion 1 :now now :events events :posts posts :cachedAt nil
        :timeline (merge-events (get ledger :timeline (js-array)) (timeline-from-posts posts events))
        :localLedgerAt (get ledger :now) :coverage (get ledger :coverage) :coverages (get ledger :coverages (js-array))
        :crossChecks (js-array) :sources sources :unknowns unknowns)))
  (defasync collect-sources (&optional clock offline)
    (let ((now (or clock (iso (Date/now)))))
      (await (cached-sources now offline (async () (await (collect-fresh now offline)))))))
  (export parse-primary parse-embed snowflake-time collect-sources merge-posts merge-events merge-documents events-from-posts))
