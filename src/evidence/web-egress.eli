;; One fixed public-network proxy for native HTTP and isolated browser reads.
(module tibo.evidence.web-egress
  (import "node:http" :default http)
  (import "node:net" :default net)
  (import "../platform/host.eli" Promise Buffer Error)
  (import "./web-policy.eli" public-url resolve-public)
  (defconst gateway (js-object :pending nil :server nil :url nil :active 0 :clients 0))
  (defasync connect-tunnel (request client head)
    (let ((peer nil))
      (try
        (let* ((u (public-url (str "https://" (get request :url))))
          (host (js-call (get u :hostname) :replaceAll "[" "")))
          (setq host (js-call host :replaceAll "]" ""))
          (let ((address (await (resolve-public host))))
            (when (or (get client :destroyed) (>= (get gateway :active) 32)) (throw (new Error "page-capacity")))
            (put gateway :active (+ (get gateway :active) 1))
            (setq peer (js-call net :createConnection (js-object :host (get address :address) :port 443 :family (get address :family))))
            (js-call peer :unref)
            (let ((bytes 0))
              (js-call peer :on "data" (lambda (chunk)
                (setq bytes (+ bytes (get chunk :length)))
                (when (> bytes 12000000) (js-call peer :destroy) (js-call client :destroy)))))
            (js-call peer :setTimeout 18000 (lambda () (js-call peer :destroy) (js-call client :destroy)))
            (js-call peer :once "connect" (lambda ()
              (js-call client :write "HTTP/1.1 200 Connection Established\r\n\r\n")
              (when (> (get head :length) 0) (js-call peer :write head))
              (js-call client :pipe peer) (js-call peer :pipe client)))
            (js-call peer :on "error" (lambda (error) (js-call client :destroy)))
            (js-call peer :once "close" (lambda () (put gateway :active (Math/max 0 (- (get gateway :active) 1))) (js-call client :destroy)))
            (js-call client :once "close" (lambda () (js-call peer :destroy)))))
        (catch error (unless (get client :destroyed)
          (js-call client :end "HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"))))))
  (defasync plain-request (request response)
    (let ((upstream nil))
      (try
        (unless (= (get request :method) "GET") (throw (new Error "page-method")))
        (let* ((u (public-url (get request :url))) (address (await (resolve-public (get u :hostname)))))
          (unless (= (get u :protocol) "http:") (throw (new Error "page-protocol")))
          (setq upstream (js-call http :request (js-object :hostname (get address :address) :port 80
            :family (get address :family) :path (str (get u :pathname) (get u :search)) :method "GET"
            :headers (js-object :host (get u :host) :user-agent "tibo public page reader" :connection "close"
              :if-none-match (get (get request :headers) :if-none-match "")
              :if-modified-since (get (get request :headers) :if-modified-since "")))
            (lambda (incoming)
              (let ((bytes 0))
                (js-call response :writeHead (get incoming :statusCode) (get incoming :headers))
                (js-call incoming :on "data" (lambda (chunk)
                  (setq bytes (+ bytes (get chunk :length)))
                  (when (> bytes 2000000) (js-call incoming :destroy) (js-call response :destroy))))
                (js-call incoming :on "error" (lambda (error) (js-call response :destroy)))
                (js-call incoming :pipe response)))))
          (js-call upstream :on "error" (lambda (error)
            (unless (get response :headersSent) (js-call response :writeHead 502)) (js-call response :end)))
          (js-call upstream :setTimeout 8000 (lambda () (js-call upstream :destroy)))
          (js-call response :once "close" (lambda () (js-call upstream :destroy)))
          (js-call upstream :end))
        (catch error (unless (get response :headersSent) (js-call response :writeHead 403)) (js-call response :end)))))
  (defasync egress-proxy ()
    (unless (get gateway :pending)
      (put gateway :pending (new Promise (lambda (resolve reject)
        (let ((server (js-call http :createServer)))
          (put gateway :server server)
          (js-call server :on "request" plain-request)
          (js-call server :on "connect" connect-tunnel)
          (js-call server :on "connection" (lambda (socket)
            (put gateway :clients (+ (get gateway :clients) 1))
            (js-call socket :once "close" (lambda () (put gateway :clients (Math/max 0 (- (get gateway :clients) 1)))))
            (when (> (get gateway :clients) 64) (js-call socket :destroy))
            (js-call socket :unref)
            (js-call socket :on "error" (lambda (error) nil))
            (js-call socket :setTimeout 20000 (lambda () (js-call socket :destroy)))))
          (js-call server :once "error" reject)
          (js-call server :listen 0 "127.0.0.1" (lambda ()
            (js-call server :unref)
            (put gateway :url (str "http://127.0.0.1:" (get (js-call server :address) :port)))
            (resolve (get gateway :url)))))))))
    (await (get gateway :pending)))
  (defun close-egress ()
    (when (get gateway :server) (js-call (get gateway :server) :close))
    (put gateway :server nil) (put gateway :pending nil) (put gateway :url nil))
  (export egress-proxy close-egress))
