(module tibo.evidence.web-page
  (import "node:crypto" createHash)
  (import "node:process" :default process)
  (import "../platform/host.eli" Date Promise URL Number Reflect fetch AbortSignal Buffer)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" iso fail matches)
  (import "./web-policy.eli" public-url)
  (import "./web-egress.eli" egress-proxy)
  (import "./page-extract.eli" extract-page)
  (import "./page-render.eli" render-page)
  (import "./web-search.eli" search-web)
  (defun page-hash (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defasync load-page (address options)
    (let ((url (get (public-url address) :href)) (redirects 0) (result nil))
      (while (not result)
        (public-url url)
        (when (get options :signal) (js-call (get options :signal) :throwIfAborted))
        (let* ((response (await (fetch url (js-object :proxy (await (egress-proxy)) :redirect "manual" :credentials "omit"
          :signal (get options :signal)
          :headers (Object/assign (js-object :user-agent "Mozilla/5.0 (compatible; Tibo public page reader)"
            :accept "text/html,text/plain,text/markdown;q=0.9") (get options :headers (js-object)))))))
          (status (get response :status)) (headers (Object/fromEntries (js-call (get response :headers) :entries))))
          (cond ((and (>= status 300) (< status 400) (not (= status 304)))
            (when (get response :body) (await (js-call (get response :body) :cancel)))
            (setq redirects (+ redirects 1))
            (when (> redirects 5) (fail "page-redirect-limit"))
            (unless (get headers :location) (fail "page-redirect-location"))
            (setq url (get (public-url (get (new URL (get headers :location) url) :href)) :href)))
            ((or (= status 304) (>= status 400)
              (not (matches "^(?:text/(?:html|plain|markdown)|application/xhtml\\+xml)(?:;|$)" (get headers :content-type "text/html"))))
              (when (get response :body) (await (js-call (get response :body) :cancel)))
              (setq result (js-object :status status :url url :headers headers :body "")))
            (t
              (when (> (Number (get headers :content-length "0")) 2000000)
                (when (get response :body) (await (js-call (get response :body) :cancel))) (fail "page-size-limit"))
              (let ((reader (js-call (get response :body) :getReader)) (chunks (js-array)) (bytes 0) (done false))
                (try
                  (while (not done)
                    (let ((part (await (js-call reader :read))))
                      (setq done (get part :done))
                      (unless done
                        (setq bytes (+ bytes (get (get part :value) :byteLength)))
                        (when (> bytes 2000000) (fail "page-size-limit"))
                        (js-call chunks :push (get part :value)))))
                  (finally (await (js-call reader :cancel))))
                (setq result (js-object :status status :url url :headers headers
                  :body (js-call (Buffer/concat chunks) :toString "utf8")))))))) result))
  (defasync collect-page (url saved options)
    (setq saved (or saved (js-object)))
    (let* ((at (iso (Date/now))) (timeout (Math/max 1 (Math/min 18000 (get options :timeout 18000))))
      (signal (if (get options :signal) (AbortSignal/any (js-array (get options :signal) (AbortSignal/timeout timeout))) (AbortSignal/timeout timeout)))
      (end (+ (Date/now) timeout)) (result nil) (validators (js-object)))
      (when (get saved :etag) (put validators :if-none-match (get saved :etag)))
      (when (get saved :modified) (put validators :if-modified-since (get saved :modified)))
      (try
        (js-call signal :throwIfAborted)
        (let* ((response (await (funcall (or (get options :load) load-page) url
          (js-object :headers validators :signal (AbortSignal/any (js-array signal (AbortSignal/timeout (Math/min timeout 8000))))))))
          (status (get response :status)) (headers (get response :headers (js-object)))
          (ctype (get headers :content-type "text/html")) (final (get (public-url (get response :url url)) :href)))
          (cond ((= status 304)
            (unless (get saved :page) (fail "page-304-without-body"))
            (setq result (Object/assign (js-object) (get saved :page) (js-object :fetchedAt at :revalidated t))))
            ((or (= status 403) (= status 429) (= status 401))
              (setq result (js-object :state "blocked" :reason "access-denied" :finalUrl final)))
            ((not (and (>= status 200) (< status 300))) (fail "page-http-unavailable"))
            ((not (matches "^(?:text/(?:html|plain|markdown)|application/xhtml\\+xml)(?:;|$)" ctype))
              (setq result (js-object :state "unsupported" :reason "content-type" :finalUrl final)))
            (t
              (let ((body (get response :body "")))
                (when (> (get body :length) 2000000) (fail "page-size-limit"))
                (setq result (if (matches "^text/(?:plain|markdown)" ctype)
                  (js-object :state (if (> (get body :length) 0) "ok" "partial") :title "" :author "" :publishedAt nil
                    :text (js-call body :slice 0 24000) :truncated (> (get body :length) 24000))
                  (await (extract-page body final))))
                (put result :mode "http")
                (when (and (not (= (get options :allowRender) false)) (= (get result :state) "partial") (not (matches "^text/(?:plain|markdown)" ctype))
                  (or (get options :render) (not (= (get (get process :env) :TIBO_WEB_RENDER "1") "0")))
                  (> (- end (Date/now)) 300))
                  (try
                    (let* ((rendered (await (funcall (or (get options :render) render-page) final
                      (Math/min 12000 (- end (Date/now))) signal)))
                      (render-url (if (= (value-type rendered) "string") final (get rendered :url final)))
                      (render-body (if (= (value-type rendered) "string") rendered (get rendered :body "")))
                      (page (await (extract-page render-body (get (public-url render-url) :href)))))
                      (when (> (get (get page :text) :length) (get (get result :text "") :length))
                        (setq result page) (put result :mode "webview") (setq final render-url)))
                    (catch error (put result :reason "render-unavailable"))))
                (put result :finalUrl final))))
          (put result :etag (get headers :etag)) (put result :modified (get headers :last-modified)))
        (catch error
          (setq result (js-object :state (if (matches "^page-(?:url|address-blocked)$" (get error :message "")) "blocked" "unavailable")
            :reason (if (matches "^page-(?:url|address-blocked)$" (get error :message "")) "address-blocked" "fetch-unavailable")))))
      (Object/assign (js-object :url url :finalUrl url :title "" :author "" :publishedAt nil :text ""
        :fetchedAt at :mode "http" :provenance "page-content" :truncated false) result)))
  (defasync read-page (address &optional options)
    (setq options (or options (js-object)))
    (let* ((url (get (public-url address) :href)) (key (str "web-page-" (page-hash (str "page-1:" url)))))
      (await (state-transaction key (async ()
        (let ((saved (or (await (read-state key)) (js-object))))
          (if (and saved (> (get saved :until) (Date/now)))
            (Object/assign (js-object) (get saved :page) (js-object :cached t))
            (let* ((page (await (collect-page url saved options))) (etag (get page :etag)) (modified (get page :modified)))
              (Reflect/deleteProperty page "etag") (Reflect/deleteProperty page "modified")
              (when (> (get (get page :text) :length) 0)
                (let ((body-key (str "web-body-" (page-hash (str url "\n" (get page :text))))))
                  (unless (await (read-state body-key)) (await (write-state body-key page)))
                  nil))
              (await (write-state key (js-object :page page :etag (or etag (get saved :etag)) :modified (or modified (get saved :modified))
                :until (+ (Date/now) (if (= (get page :state) "ok") 1800000 60000))))) page)))) 24000))))
  (defasync read-search (query &optional read)
    (let* ((search (await (search-web query))) (pages (js-array)))
      (when (and (not (= read false)) (= (get search :state) "ok"))
        (let* ((controller (AbortSignal/timeout 18000)) (rows (js-call (js-call (js-call (get search :results) :filter (lambda (row)
            (not (matches "\\.(?:pdf|zip|exe|dmg|mp[34]|png|jpe?g)(?:[?#]|$)" (get row :url))))) :sort
            (lambda (a b)
              (- (if (matches "https?://(?:docs|help|support)\\.|/(?:docs|documentation|support)/" (get b :url)) 1 0)
                 (if (matches "https?://(?:docs|help|support)\\.|/(?:docs|documentation|support)/" (get a :url)) 1 0)))) :slice 0 2)))
          (setq pages (await (Promise/all (js-call rows :map (async (row)
            (try (await (read-page (get row :url) (js-object :signal controller)))
              (catch error (js-object :url (get row :url) :state "unavailable" :text "" :reason "fetch-unavailable"))))))))))
      (Object/assign (js-object) search (js-object :pages pages))))
  (export load-page collect-page read-page read-search))
