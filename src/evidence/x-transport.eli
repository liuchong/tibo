(module tibo.evidence.x-transport
  (import "../platform/host.eli" Date Number URL fetch)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" fail)
  (defun x-url? (url)
    (try (js-call (js-array "x.com" "twitter.com" "publish.x.com" "publish.twitter.com") :includes (get (new URL url) :hostname))
      (catch error false)))
  (defun retry-until (headers now fallback)
    (let* ((raw (js-call headers :get "retry-after")) (seconds (Number raw))
      (date (Date/parse raw)) (reset (* (Number (js-call headers :get "x-rate-limit-reset")) 1000)))
      (Math/max (+ now fallback)
        (if (and raw (Number/isFinite seconds) (>= seconds 0)) (+ now (* seconds 1000))
          (if (Number/isFinite date) date 0))
        (if (Number/isFinite reset) reset 0))))
  (defasync guarded-fetch (url settings)
    (await (state-transaction "x-request-budget" (async ()
      (let* ((now (Date/now)) (state (or (await (read-state "x-request-budget")) (js-object)))
        (hits (js-call (get state :hits (js-array)) :filter (lambda (at) (> at (- now 300000)))))
        (until (get state :until 0)))
        (when (> until now) (fail "X 请求冷却中，保留已核实原文"))
        (when (>= (get hits :length) 20) (fail "X 本地请求预算已用尽，稍后检查"))
        (js-call hits :push now) (put state :hits hits)
        (await (write-state "x-request-budget" state))
        (try
          (let* ((response (await (fetch url settings))) (status (get response :status))
            (failed (or (= status 429) (= status 403) (>= status 500))))
            (if failed
              (let* ((count (+ (get state :failures 0) 1))
                (delay (Math/min 21600000 (* (cond ((= status 429) 900000) ((= status 403) 1800000) (t 30000))
                  (Math/pow 2 (Math/min 6 (- count 1)))))))
                (put state :failures count) (put state :status status)
                (put state :until (retry-until (get response :headers) (Date/now) delay)))
              (progn (put state :failures 0) (put state :status status) (put state :until 0)))
            (await (write-state "x-request-budget" state)) response)
          (catch error
            (let ((count (+ (get state :failures 0) 1)))
              (put state :failures count) (put state :status "network")
              (put state :until (+ (Date/now) (Math/min 900000 (* 30000 (Math/pow 2 (Math/min 5 (- count 1)))))))
              (await (write-state "x-request-budget" state))) (throw error))))) 120000)))
  (export x-url? guarded-fetch retry-until))
