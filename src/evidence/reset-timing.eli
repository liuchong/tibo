(module tibo.evidence.reset-timing
  (import "../platform/host.eli" Number)
  (import "../platform/util.eli" matches match fail hour-ms day-ms)
  (defconst stances (js-array "commitment" "expectation" "intention" "possibility" "conditional" "negated" "unknown"))
  (defconst windows (js-array "within-hours" "within-days" "today" "tomorrow" "soon" "this-week" "next-week" "unspecified"))
  (defun expectation-stance (text)
    (let ((stance nil))
      (js-call (js-call text :split ".") :forEach (lambda (sentence)
        (when (matches "reset" sentence)
          (cond ((matches "aim|hop(?:e|ing)|intend|planning" sentence) (setq stance "intention"))
            ((matches "expect|anticipat|probably|likely|should" sentence) (setq stance "expectation"))
            ((matches "\\b(?:might|may|could)\\b" sentence) (setq stance "possibility")))))) stance))
  (defun negative-expectation? (text)
    (and (matches "reset" text) (matches "don[’']t expect|do not expect|unlikely|no chance|not likely|not expecting|not planning|not aiming" text)))
  (defun direct-commitment? (text)
    ;; An unqualified announcement is not weakened merely because the model
    ;; describes its future tense as an expectation. Qualifiers stay semantic.
    (and (not (expectation-stance text)) (not (negative-expectation? text))
      (not (matches "\\b(?:if|either|might|may|could|would|not|never)\\b" text))
      (or (matches "^\\s*(?:a\\s+)?(?:global|full)\\s+reset\\s+(?:(?:is\\s+)?landing\\b|lands\\b|will\\s+(?:land|happen|arrive)\\b|is\\s+going\\s+to\\s+(?:land|happen|arrive)\\b)" text)
        (matches "^\\s*(?:lands|landing|drops|arriving)\\s+(?:today|tomorrow|by\\b|before\\b|within\\b|in\\s+[0-9])" text))))
  (defun local-timing (kind text time)
    (when (and time (js-call (js-array "promise" "hint" "programme" "negation") :includes kind))
      (let* ((relative (match "(?:within|next|in)\\s+(?:the\\s+)?([0-9]{1,3})\\s*(hours?|days?)" time))
        (zone (match "\\b(PST|PDT|PT|UTC)\\b" time)))
        (js-object :stance (cond ((= kind "negation") "negated") ((= kind "programme") "conditional")
          ((expectation-stance text) (expectation-stance text)) ((= kind "promise") "commitment") (t "possibility"))
          :window (cond (relative (if (matches "hour" (get relative 2)) "within-hours" "within-days"))
            ((matches "tomorrow" time) "tomorrow") ((matches "today|EOD|midnight|end of (?:the )?day" time) "today")
            ((matches "next week" time) "next-week") ((matches "this week" time) "this-week")
            ((matches "soon|shortly|moment|imminent|few hours" time) "soon") (t "unspecified"))
          :amount (when relative (Number (get relative 1))) :zone (if zone (js-call (get zone 1) :toUpperCase) "unknown")))))
  (defun checked-timing (timing time quote)
    (when timing
      (unless (and timing time (js-call quote :includes time)
        (js-call stances :includes (get timing :stance)) (js-call windows :includes (get timing :window))
        (js-call (js-array "PST" "PDT" "PT" "UTC" "unknown") :includes (get timing :zone))
        (js-call (Object/keys timing) :every (lambda (key) (js-call (js-array "stance" "window" "amount" "zone") :includes key))))
        (fail "post-timing-schema"))
      (let ((amount (get timing :amount)) (zone (get timing :zone)))
        (unless (or (= amount nil) (and (Number/isInteger amount) (> amount 0)
          (<= amount (if (= (get timing :window) "within-days") 30 720)))) (fail "post-timing-amount"))
        ;; A semantic category can be approximate. A numeric duration or timezone
        ;; must be explicit in the quoted time phrase before resolving a clock.
        (when (and amount (not (and (js-call (js-array "within-hours" "within-days") :includes (get timing :window))
          (matches (str "\\b" amount "\\s*" (if (= (get timing :window) "within-hours") "hours?" "days?") "\\b") time))))
          (setq amount nil))
        (when (and (not (= zone "unknown")) (not (matches (str "\\b" zone "\\b") time))) (setq zone "unknown"))
        (Object/assign (js-object) timing (js-object :amount amount :zone zone)))))
  (defun timing-lifetime (timing)
    (setq timing (or timing (js-object)))
    ;; Retention is a context lifetime, not a promised deadline or probability.
    (cond ((and (get timing :amount) (= (get timing :window) "within-hours")) (* (get timing :amount) hour-ms))
      ((and (get timing :amount) (= (get timing :window) "within-days")) (* (get timing :amount) day-ms))
      ((= (get timing :window) "next-week") (* 14 day-ms)) ((= (get timing :window) "this-week") (* 7 day-ms))
      (t (* 48 hour-ms))))
  (export local-timing checked-timing expectation-stance negative-expectation? direct-commitment? timing-lifetime))
