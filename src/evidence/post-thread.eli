(module tibo.evidence.post-thread
  (import "../platform/host.eli" Promise)
  (import "../platform/util.eli" ms recent matches sorted)
  (import "./reset-text.eli" completed? routine-reset?)
  (import "./x-page.eli" parse-primary)
  (import "./transport.eli" request)
  ;; A post body is immutable cache material; its visible conversation is not.
  ;; Read a bounded set of official detail pages, without recursive crawling.
  (defasync collect-threads (posts events now)
    (let* ((globals (js-call events :filter (lambda (e) (and (get e :global) (<= (ms (get e :at)) (ms now))))))
      (last-at (js-call globals :reduce (lambda (latest e) (Math/max latest (ms (get e :at)))) 0))
      (roots (js-call (js-call (sorted posts "at") :filter (lambda (p)
        (and (= (get p :author) "thsottiaux") (matches "^[0-9]{16,20}$" (get p :id ""))
          (recent (get p :at) now 48) (> (ms (get p :at)) last-at)
          (not (get p :truncated)) (matches "reset" (get p :text))
          (not (completed? (get p :text))) (not (routine-reset? (get p :text)))))) :slice -2))
      (pages (await (Promise/all (js-call roots :map (async (p)
        (try
          (let ((rows (parse-primary (await (request (str "https://x.com/thsottiaux/status/" (get p :id)) nil 6000)) now)))
            (js-object :ok t :posts (js-call rows :filter (lambda (row)
              (and (>= (ms (get row :at)) (ms (get p :at))) (recent (get row :at) now 48))))))
          (catch error (js-object :ok false :posts (js-array)))))))))
      (found (js-call pages :flatMap (lambda (page) (get page :posts)))))
      (js-object :posts found :source (js-object :name "threads" :at now
        :ok (js-call pages :some (lambda (page) (get page :ok)))
        :fetched (js-call pages :some (lambda (page) (get page :ok)))
        :attempted (get roots :length) :discovered (get found :length)
        :error (if (= (get roots :length) 0) "无待查询的重置线程" "部分或全部官方线程可能不可读")))))
  (export collect-threads))
