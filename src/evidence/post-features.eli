(module tibo.evidence.post-features
  (import "../platform/host.eli" Number)
  (import "../platform/util.eli" fail matches match ms hour-ms iso canonical-text)
  (import "./reset-text.eli" completed? conditional-reset? routine-reset?)
  (defconst feature-contract "post-claims-1")
  (defconst kinds (js-array "promise" "hint" "incident" "programme" "progress" "release" "completion" "negation" "other"))
  (defconst subjects (js-array "codex-usage" "chatgpt-work-usage" "product-change" "personal-task" "unknown"))
  (defconst scopes (js-array "global" "banked" "partial" "unknown"))
  (defconst statements (js-array "future" "completed" "conditional" "negated" "unknown"))
  (defun includes? (values value) (js-call values :includes value))
  (defun reset-scope (text)
    (cond ((matches "banked|reset card" text) "banked")
      ((matches "\\bonly\\b|subset|some (?:users|accounts)|pro\\s*500" text) "partial")
      ((matches "\\bglobal\\b|\\bfull reset\\b|resets? all propagated|(?:all|every) (?:paid )?(?:users|accounts)|reset.*across.*(?:codex|chatgpt)" text) "global")
      (t "unknown")))
  (defun subject-of (text)
    (cond ((and (matches "inbox zero|clean filters|email|mailbox" text) (not (matches "reset|usage limit" text))) "personal-task")
      ((and (matches "reset|usage|quota|rate.?limit" text) (not (routine-reset? text)))
        (if (matches "chatgpt|work" text) "chatgpt-work-usage" "codex-usage"))
      ((and (matches "codex|chatgpt" text) (matches "outage|incident|disruption|latency|overcount|blocked.*request|degrad" text)) "codex-usage")
      ((matches "ship|release|launch|update|improv" text) "product-change") (t "unknown")))
  (defun time-text (text)
    (let ((m (match "(?:today|tomorrow)\\s+(?:at\\s+)?[0-9]{1,2}(?::[0-9]{2})?\\s*(?:am|pm)\\s*(?:PST|PDT|PT)|\\bby\\s+(?:(?:today|tomorrow)[’']?s?\\s+)?(?:EOD|(?:the\\s+)?end of (?:the\\s+)?day)(?:\\s+(?:today|tomorrow))?(?:\\s+(?:PST|PDT|PT))?\\b|\\btomorrow\\b|\\btoday\\b|\\bnext week\\b|(?:over|for)\\s+(?:the\\s+)?next\\s+[0-9]{1,2}\\s+days" text)))
      (when m (get m 0))))
  (defun local-kind (post)
    (let* ((text (get post :text)) (subject (subject-of text)))
      (cond ((= subject "personal-task") "other")
        ((completed? text) "completion")
        ((and (matches "reset" text) (matches "no (?:global |full |new )?reset|not.*reset|cannot|can't|won't|won’t|can’t" text)) "negation")
        ((conditional-reset? text) (if (matches "(?:each|every) day|next [0-9]+ days" text) "programme" "promise"))
        ((and (matches "reset" text) (matches "will|we.ll|landing|\\bby\\b|tomorrow|today|promis" text)) "promise")
        ((and (matches "reset" text) (not (routine-reset? text))) "hint")
        ((matches "outage|incident|disruption|latency|overcount|blocked.*request|degrad" text) "incident")
        ((matches "\\bday\\s+[0-9]+|roundup" text) "progress")
        ((matches "ship|release|launch|update|improv" text) "release") (t "other"))))
  (defun checked-claim (claim post index)
    (let* ((text (canonical-text (get post :text))) (quote (get claim :quote))
      (kind (get claim :kind)) (subject (get claim :subject)) (scope (get claim :scope))
      (statement (get claim :statement)) (time (get claim :timeText))
      (context-missing (or (get post :contextMissing false)
        (and (get post :parentId) (= (get (get post :parentText "") :length) 0))
        (matches "^(?:All fixed|Confirmed landed|Vote|To calibrate)[.! ]*$" text))))
      (unless (and claim (includes? kinds kind) (includes? subjects subject) (includes? scopes scope)
        (includes? statements statement) (= (value-type (get claim :contextMissing)) "boolean")
        (= (value-type quote) "string") (<= (get quote :length) 220)
        (or (= kind "other") (>= (get quote :length) 4))
        (js-call text :includes quote)
        (or (= time nil) (and (= (value-type time) "string") (> (get time :length) 0)
          (<= (get time :length) 100) (js-call text :includes time)))) (fail "post-feature-schema"))
      ;; A quote proves provenance, not its subject or reset scope. Unsupported
      ;; assertions are rejected or weakened, never promoted by model confidence.
      (when (and (= (subject-of text) "personal-task") (not (= kind "other"))) (fail "post-feature-personal-task"))
      (when (and (includes? (js-array "promise" "hint" "programme" "completion" "negation") kind)
        (or (not (matches "reset" quote)) (routine-reset? text))) (fail "post-feature-unrelated-reset"))
      (when (and (= kind "completion") (or (not (completed? quote)) (get post :truncated) context-missing))
        (fail "post-feature-unconfirmed-completion"))
      (when (and (= kind "incident") (not (matches "outage|incident|disruption|latency|overcount|blocked.*request|degrad" quote)))
        (fail "post-feature-unrelated-incident"))
      (when (and (= kind "progress") (not (matches "\\bday\\s+[0-9]+|roundup" quote))) (fail "post-feature-unrelated-progress"))
      (when (and (= kind "promise") (not (conditional-reset? text))
        (or (completed? text) (matches "no (?:global |full |new )?reset|not.*reset|cannot|can't|won't|won’t|can’t" text)
          (not (matches "will|we.ll|landing|\\bby\\b|tomorrow|today|promis|next week" quote))))
        (fail "post-feature-unconfirmed-promise"))
      (when (and (= kind "promise") (conditional-reset? text)) (setq statement "conditional"))
      (when (= kind "programme")
        (unless (and (conditional-reset? text) (matches "(?:each|every)\\s+day|next [0-9]+ days" text)) (fail "post-feature-unconfirmed-programme"))
        (setq statement "conditional"))
      (when (= kind "completion") (setq statement "completed"))
      (when (= kind "negation")
        (unless (matches "no (?:global |full |new )?reset|not.*reset|cannot|can't|won't|won’t|can’t" quote) (fail "post-feature-unconfirmed-negation"))
        (setq statement "negated"))
      (let ((actual (reset-scope text)))
        (when (or (not (= actual "unknown")) (= scope "global")) (setq scope actual)))
      (when (or context-missing (get claim :contextMissing) (get post :truncated))
        (setq context-missing t)
        (when (= scope "global") (setq scope "unknown")))
      (when (not (= (subject-of text) "unknown")) (setq subject (subject-of text)))
      (when (and time (not (js-call quote :includes time))) (setq time nil))
      (js-object :postId (get post :id) :claimIndex index :kind kind :subject subject :scope scope :statement statement
        :quote quote :quoteStart (js-call text :indexOf quote) :quoteEnd (+ (js-call text :indexOf quote) (get quote :length))
        :timeText time :contextMissing (not (not context-missing)) :at (get post :at)
        :provenance (get post :provenance) :extractorVersion feature-contract)))
  (defun local-row (post)
    (let* ((text (canonical-text (get post :text))) (kind (local-kind post))
      (quote (js-call text :slice 0 220))
      (claim (js-object :kind kind :subject (subject-of text) :scope (reset-scope text)
        :statement (cond ((= kind "completion") "completed") ((= kind "negation") "negated")
          ((includes? (js-array "promise" "programme") kind) (if (conditional-reset? text) "conditional" "future")) (t "unknown"))
        :quote quote :timeText (time-text text) :contextMissing false)))
      ;; Local rules must pass the same semantic checks. If the useful claim is
      ;; beyond the bounded excerpt, keep unknown rather than invent a reading.
      (try (js-object :postId (get post :id) :claims (js-array (checked-claim claim post 0)) :extractor "rules-1")
        (catch error (js-object :postId (get post :id) :claims (js-array) :extractor "rules-1" :incomplete t)))))
  (defun validate-rows (value posts)
    (unless (and value (Array/isArray (get value :rows)) (<= (get (get value :rows) :length) 4)
      (js-call (Object/keys value) :every (lambda (key) (= key "rows")))) (fail "post-feature-response"))
    (let ((rows (js-array)) (rejected (js-array)))
      (js-call posts :forEach (lambda (post)
        (let ((matches-id (js-call (get value :rows) :filter (lambda (r) (= (get r :postId) (get post :id))))))
          (try
            (unless (= (get matches-id :length) 1) (fail "post-feature-missing-row"))
            (let* ((row (get matches-id 0)) (claims (get row :claims)))
              (unless (and (Array/isArray claims) (<= (get claims :length) 2)
                (js-call (Object/keys row) :every (lambda (k) (includes? (js-array "postId" "claims") k)))) (fail "post-feature-row"))
              (js-call rows :push (js-object :postId (get post :id) :extractor feature-contract
                :claims (js-call claims :map (lambda (c index)
                  (when (js-call (Object/keys c) :some (lambda (k)
                    (not (includes? (js-array "kind" "subject" "scope" "statement" "quote" "timeText" "contextMissing") k))))
                    (fail "post-feature-fields"))
                  (checked-claim c post index))))))
            (catch error (js-call rejected :push (get post :id)))))))
      ;; A batch can preserve unrelated valid rows; invalid rows use rules and
      ;; are not permanently cached. Total failure still trips the task circuit.
      (when (= (get rows :length) 0) (fail "post-feature-no-valid-row"))
      (js-object :rows rows :rejected rejected)))
  (export feature-contract checked-claim local-row validate-rows reset-scope subject-of time-text))
