(module tibo.evidence.post-context
  (import "./reset-text.eli" completed? conditional-reset? routine-reset?)
  (import "./reset-timing.eli" local-timing timing-lifetime)
  (import "./post-features.eli" time-text reset-scope)
  (import "./day-plan.eli" programme-choice)
  (import "../platform/host.eli" Number)
  (import "../platform/util.eli" ms iso day-ms recent match matches sorted last-item)
  ;; Keep a declared programme for its lifetime, not just a sliding news window.
  ;; A progress day is a label, never a negative reset outcome or a daily hazard.
  (defun active-programme (posts now &optional global)
    (let ((programme nil) (visible (sorted (js-call posts :filter (lambda (p) (<= (ms (get p :at)) (ms now)))) "at")))
      (js-call visible :forEach (lambda (p)
        (let* ((text (get p :text)) (duration (match "(?:over|for)\\s+(?:the\\s+)?next\\s+([0-9]{1,2})\\s+days\\b" text))
          (n (if duration (Number (get duration 1)) 0)) (expires (+ (ms (get p :at)) (* n day-ms))))
          (when (and (> n 0) (<= n 90) (< (ms now) expires) (conditional-reset? text)
            (matches "(?:each|every)\\s+day" text) (matches "improv|ship|update" text))
            (setq programme (js-object :postId (get p :id) :at (get p :at) :expiresAt (iso expires) :days n
              :provenance (get p :provenance) :truncated (get p :truncated false)
              :consumedByGlobal (not (not (and global (>= (ms (get global :at)) (ms (get p :at))))))))))))
      (when programme
        (let ((days (js-array)))
          (js-call visible :forEach (lambda (p)
            (when (>= (ms (get p :at)) (ms (get programme :at)))
              (let* ((m (match "\\b(?:roundup\\s+of\\s+)?day\\s+([0-9]{1,2})(?:\\.[0-9]+)?\\b" (get p :text)))
                (n (if m (Number (get m 1)) 0))
                (entry (js-call days :find (lambda (d) (= (get d :day) n)))))
                (when (and (> n 0) (<= n (get programme :days))
                  (not (matches "tomorrow[\\s\\S]*day|next[\\s\\S]*day\\s+[0-9]" (get p :text))))
                  (unless entry (setq entry (js-object :day n)) (js-call days :push entry))
                  ;; Prefer a day's roundup over its individual release fragments.
                  (when (or (not (get entry :roundup)) (matches "roundup\\s+of\\s+day" (get p :text)))
                    (put entry :postId (get p :id))
                    (put entry :roundup (matches "roundup\\s+of\\s+day" (get p :text)))))))))
          (put programme :observedDays (js-call (js-call days :map (lambda (d) (get d :day))) :sort (lambda (a b) (- a b))))
          (put programme :progressPostIds (js-call (js-call (js-call days :sort (lambda (a b) (- (get a :day) (get b :day)))) :slice -2) :map (lambda (d) (get d :postId))))))
      programme))
  (defun post-context (posts now &optional global)
    (let* ((programme (active-programme posts now global))
      (visible (sorted (js-call posts :filter (lambda (p) (<= (ms (get p :at)) (ms now)))) "at"))
      (latest (last-item visible)) (ranked (js-array)))
      (js-call visible :forEach (lambda (p)
        (let* ((text (get p :text)) (fresh (recent (get p :at) now 48))
          (unconsumed (or (not global) (> (ms (get p :at)) (ms (get global :at)))))
          (retained (and unconsumed (matches "reset" text)
            (< (ms now) (+ (ms (get p :at)) (timing-lifetime (local-timing "hint" text (time-text text)))))))
          (score 0) (reason "recent-context"))
          (cond ((and programme (= (get p :id) (get programme :postId)))
                 (setq score 600 reason "active-programme"))
                ((and fresh unconsumed (matches "reset|banked|reset card" text))
                 (setq score (if (or (completed? text) (matches "landing|tomorrow|today|will reset" text)) 700 500) reason "reset-signal"))
                (retained (setq score 490 reason "retained-timing-context"))
                ((and fresh unconsumed (matches "outage|incident|latency|overcount|compensat|blocked.*request" text))
                 (setq score 450 reason "incident-signal"))
                ((and fresh unconsumed (get p :parentId) (js-call visible :some (lambda (parent)
                  (and (= (get parent :id) (get p :parentId)) (<= (ms (get parent :at)) (ms (get p :at)))
                    (= (get parent :provenance) "primary") (not (get parent :truncated)) (matches "reset" (get parent :text))))))
                 (setq score 480 reason "reset-reply-context"))
                ((and programme (js-call (get programme :progressPostIds) :includes (get p :id)))
                 (setq score 400 reason "programme-progress"))
                ((and fresh (completed? text)) (setq score 300 reason "completed-context"))
                ((and fresh (matches "launch|release|milestone|rolling out" text)) (setq score 100 reason "release-context")))
          (when (or fresh (> score 0)) (js-call ranked :push (js-object :post p :score score :reason reason))))))
      ;; Reserve the latest post; remaining slots favour evidence, then recency.
      (let* ((ordered (js-call ranked :sort (lambda (a b)
        (let ((difference (- (get b :score) (get a :score))))
          (if (= difference 0) (- (ms (get (get b :post) :at)) (ms (get (get a :post) :at))) difference)))))
        (latest-row (when latest (js-call ordered :find (lambda (r) (= (get (get r :post) :id) (get latest :id))))))
        (chosen (js-call (js-call ordered :filter (lambda (r) (not (= r latest-row)))) :slice 0 (if latest-row 7 8))))
        (when latest-row
          (when (= (get latest-row :score) 0) (put latest-row :reason "latest-post"))
          (js-call chosen :push latest-row))
        (setq chosen (js-call chosen :sort (lambda (a b) (- (ms (get (get a :post) :at)) (ms (get (get b :post) :at))))))
        (js-object :programme programme :posts (js-call chosen :map (lambda (r)
          (let* ((p (Object/assign (js-object) (get r :post)))
            (parent (when (get p :parentId) (js-call visible :find (lambda (item)
              (and (= (get item :id) (get p :parentId)) (= (get item :author) "thsottiaux")
                (= (get item :provenance) "primary") (not (get item :truncated)) (<= (ms (get item :at)) (ms (get p :at)))))))))
            (when (get p :parentId)
              (put p :parentText (if parent (get parent :text) ""))
              (put p :parentAuthor (when parent "thsottiaux")) (put p :parentProvenance (when parent "primary")))
            (Object/assign p (linked-reset-context p visible programme)) p)))
          :selection (js-call chosen :map (lambda (r) (js-object :postId (get (get r :post) :id) :reason (get r :reason))))
          :recentCount (get (js-call visible :filter (lambda (p) (recent (get p :at) now 48))) :length)))))
  (defun linked-reset-context (post posts programme)
    (let* ((plan (when programme (js-call posts :find (lambda (p) (= (get p :id) (get programme :postId))))))
      (cursor post) (chain (js-array)) (result (js-object)) (depth 0))
      (while (and cursor (< depth 3) (= (get cursor :author) "thsottiaux")
        (= (get cursor :provenance) "primary") (not (get cursor :truncated)))
        (let* ((quoted (= (get cursor :quotedRelationProvenance) "official-page-data"))
          (id (if quoted (get cursor :quotedPostId)
            (when (= (get cursor :parentRelationProvenance) "official-page-data") (get cursor :parentId))))
          (parent (when id (js-call posts :find (lambda (p)
            (and (= (get p :id) id) (= (get p :author) "thsottiaux") (= (get p :provenance) "primary")
              (not (get p :truncated)) (< (ms (get p :at)) (ms (get cursor :at))))))))
          (scope (when parent (reset-scope (get parent :text))))
          (campaign (and parent plan (= (get plan :provenance) "primary") (not (get plan :truncated))
            (<= (ms (get plan :at)) (ms (get parent :at))) (matches "full reset" (get plan :text))
            (js-call (get programme :progressPostIds) :includes (get parent :id))
            (not (conditional-reset? (get parent :text))) (not (completed? (get parent :text)))
            (programme-choice parent programme posts))))
          (setq depth (+ depth 1))
          (when parent (js-call chain :push (get parent :id)))
          (cond ((and parent (matches "reset" (get parent :text))
            (not (routine-reset? (get parent :text))) (not (completed? (get parent :text)))
            (not (matches "\\b(?:not|never|cancelled|canceled|withdrawn)\\b|won[’']t|cannot|can[’']t" (get parent :text)))
            (not (conditional-reset? (get parent :text))))
              (setq result (js-object :resetContextVerified t :resetContextPostIds chain
                :resetContextAt (get parent :at) :resetContextText (get parent :text)
                :resetContextScope (if (and campaign (= scope "unknown")) "global" scope)
                :resetContextBasis (if campaign "declared-full-reset-programme" "verified-reference-chain")
                :programmePostId (when campaign (get plan :id)) :programmeText (when campaign (get plan :text))))
              (when (= depth 1)
                (if quoted (Object/assign result (js-object :quoteText (get parent :text)))
                  (Object/assign result (js-object :parentText (get parent :text) :parentAuthor "thsottiaux" :parentProvenance "primary"))))
              (setq cursor nil))
            ((and parent (time-text (get parent :text)) (not (routine-reset? (get parent :text)))
              (not (matches "\\b(?:not|never|cancelled|canceled|withdrawn)\\b|won[’']t|cannot|can[’']t" (get parent :text)))
              (not (completed? (get parent :text))) (not (conditional-reset? (get parent :text)))) (setq cursor parent))
            (t (setq cursor nil))))) result))
  (defun completion-context (post posts)
    (linked-reset-context post posts (active-programme posts (get post :at))))
  (export active-programme post-context linked-reset-context completion-context))
