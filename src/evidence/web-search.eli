;; Fixed search transports. Result URLs are citations, never fetch targets.
(module tibo.evidence.web-search
  (import "node:crypto" createHash)
  (import "../platform/host.eli" Date URL RegExp Promise encodeURIComponent)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/privacy.eli" public-text source-free-text)
  (import "../platform/util.eli" fail iso clean matches)
  (import "./transport.eli" request)
  (import "./html.eli" parse-html by-tag html-text attr decode-entities)
  (defun public-link? (address)
    (try (let ((u (new URL address)))
      (and (= (get u :protocol) "https:") (= (get u :port) "") (= (get u :username) "") (= (get u :password) "")
        (= (source-free-text address) address)
        (matches "^[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}$" (get u :hostname))
        (not (matches "^(?:localhost|.*\\.local|.*\\.localhost|www\\.google\\.com|www\\.baidu\\.com|www\\.bing\\.com)$" (get u :hostname)))))
      (catch error false)))
  (defun safe-query (query)
    (unless (and (= (value-type query) "string") (>= (get query :length) 3) (<= (get query :length) 200)
      (= (public-text query 200) query) (not (matches "https?://|[<>]" query))) (fail "search-query"))
    (clean query))
  (defun rss-field (item name)
    (let ((m (js-call (new RegExp (str "<" name "(?:\\s[^>]*)?>([\\s\\S]*?)</" name ">") "i") :exec item)))
      (if m (decode-entities (js-call (get m 1) :replace (new RegExp "^<!\\[CDATA\\[([\\s\\S]*)\\]\\]>$") "$1")) "")))
  (defun search-results (body engine)
    (when (matches "<title[^>]*>\\s*(?:百度安全验证|安全验证|验证码|captcha|unusual traffic)\\s*</title>|id=[\"'](?:captcha|challenge-form)[\"']|/httpservice/retry/enablejs|location\\.replace\\(location\\.href\\.replace" body)
      (fail "search-gate"))
    (let* ((root (parse-html body)) (rows (js-array)))
      (if (= engine "bing")
        (js-call (Array/from (js-call body :matchAll (new RegExp "<item(?:\\s[^>]*)?>([\\s\\S]*?)</item>" "gi"))) :forEach (lambda (row)
          (let* ((item (get row 1)) (url (clean (rss-field item "link")))
            (title (html-text (parse-html (rss-field item "title")))) (snippet (html-text (parse-html (rss-field item "description")))))
            (when (and (public-link? url) (> (get title :length) 0))
              (js-call rows :push (js-object :title (public-text title 240) :url url :snippet (public-text snippet 600)
                :provenance "search-summary"))))))
        (js-call (by-tag root "a") :forEach (lambda (a)
          (let ((url (attr a "href")) (title (html-text a)))
            (when url
              (try
                (when (matches "^/url\\?" url)
                  (let ((params (get (new URL url "https://www.google.com") :searchParams)))
                    (setq url (or (js-call params :get "q") (js-call params :get "url")))))
                (when (and (= engine "duckduckgo") (matches "^(?://duckduckgo\\.com|https://duckduckgo\\.com)/l/\\?" url))
                  (setq url (js-call (get (new URL url "https://duckduckgo.com") :searchParams) :get "uddg")))
                (when (and (public-link? url) (> (get title :length) 8)
                  (or (not (= engine "duckduckgo")) (matches "\\bresult__a\\b" (attr a "class"))))
                  (js-call rows :push (js-object :title (public-text title 240) :url url :snippet "" :provenance "search-summary")))
                (catch error nil)))))))
      (let ((seen (js-array)))
        (js-call (js-call rows :filter (lambda (r)
          (unless (js-call seen :includes (get r :url))
            (js-call seen :push (get r :url)) t))) :slice 0 4))))
  (defasync search-engine (engine query &optional timeout)
    (safe-query query)
    (unless (js-call (js-array "google" "baidu" "duckduckgo" "bing") :includes engine) (fail "search-engine"))
    (let ((key (str "web-search-" (js-call (js-call (createHash "sha256") :update (str "web-1:" engine ":" query)) :digest "hex"))))
      (await (state-transaction key (async ()
        (let ((saved (await (read-state key))))
          (if (and saved (> (get saved :until) (Date/now))) (Object/assign (js-object) saved (js-object :cached t))
            (let ((row nil))
              (try
                (let* ((address (str (cond ((= engine "google") "https://www.google.com/search?gbv=1&q=")
                  ((= engine "baidu") "https://www.baidu.com/s?wd=")
                  ((= engine "duckduckgo") "https://html.duckduckgo.com/html/?q=") (t "https://www.bing.com/search?format=rss&q=")) (encodeURIComponent query)))
                  (results (search-results (await (request address (js-object :redirect "manual") (or timeout 4000))) engine)))
                  (setq row (js-object :engine engine :state (if (> (get results :length) 0) "ok" "empty") :results results
                    :at (iso (Date/now)) :until (+ (Date/now) (if (> (get results :length) 0) 900000 60000)))))
                (catch error (setq row (js-object :engine engine :state "unavailable" :results (js-array)
                  :at (iso (Date/now)) :until (+ (Date/now) 60000)))))
              (await (write-state key row)) row))))))))
  (defasync search-web (query &optional timeout)
    (safe-query query)
    (let* ((end (+ (Date/now) (or timeout 8000)))
      (rows (await (Promise/all (js-call (js-array "google" "baidu") :map
        (lambda (engine) (search-engine engine query (Math/max 1 (Math/min 4000 (- end (Date/now))))))))))
      (results (js-call (get (or (js-call rows :find (lambda (r) (= (get r :state) "ok"))) (js-object :results (js-array))) :results) :slice)))
      (let ((fallbacks (js-array "duckduckgo" "bing")) (i 0))
        (while (and (= (get results :length) 0) (< i (get fallbacks :length)) (> (- end (Date/now)) 100))
          (let ((fallback (await (search-engine (get fallbacks i) query (Math/max 1 (Math/min 3000 (- end (Date/now))))))))
            (js-call rows :push fallback) (setq results (get fallback :results)))
          (setq i (+ i 1))))
      (js-object :state (if (> (get results :length) 0) "ok" "unavailable") :query query :results results
        :at (get (or (js-call rows :find (lambda (r) (= (get r :state) "ok"))) (js-object)) :at)
        :engines
        (js-call rows :map (lambda (r) (js-object :engine (get r :engine) :state (get r :state) :cached (get r :cached false)))))))
  (export safe-query public-link? search-results search-engine search-web))
