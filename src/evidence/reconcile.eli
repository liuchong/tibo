(module tibo.evidence.reconcile
  (import "node:crypto" createHash)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" ms sorted canonical-text)
  (defun semantic-event? (event post)
    (and post (= (get event :completionBasis) "semantic-evidence-agreement")
      (>= (get event :semanticVotes 0) 2) (= (get event :state) "completed")
      (= (get post :author) "thsottiaux") (= (get post :provenance) "primary") (not (get post :truncated))
      (= (get event :at) (get post :at)) (= (value-type (get event :completionQuote)) "string")
      (>= (get (get event :completionQuote) :length) 4)
      (js-call (canonical-text (get post :text)) :includes (get event :completionQuote))))
  (defun related-event? (event post refs posts)
    (and (= (get event :state) "completed") (get event :global)
      (or (js-call refs :includes (get event :id))
        (js-call (get event :evidencePostIds (js-array)) :some (lambda (id)
          (let ((source (js-call posts :find (lambda (p) (= (get p :id) id)))))
            (and source (js-call refs :includes id)
              (< (- (ms (get post :at)) (ms (get source :at))) 345600000)
              (>= (ms (get event :at)) (ms (get source :at))))))))))
  (defun reconcile-value (snapshot batch)
    (let* ((copy (JSON/parse (JSON/stringify snapshot))) (posts (get copy :posts))
      (events (get copy :events)) (timeline (get copy :timeline (js-array)))
      (pending (get copy :pendingConfirmations (js-array))) (accepted (js-array)) (changed false))
      (js-call (sorted (get batch :claims (js-array)) "at") :forEach (lambda (claim)
        (let* ((post (js-call posts :find (lambda (p) (= (get p :id) (get claim :postId)))))
          (refs (get claim :contextPostIds (js-array)))
          (valid (and post (get claim :semanticValidated) (get claim :semanticAgreed) (>= (get claim :votes 0) 2)
            (= (get claim :kind) "completion") (= (get claim :statement) "completed") (= (get claim :scope) "global")
            (js-call (js-array "codex-usage" "chatgpt-work-usage") :includes (get claim :subject))
            (not (get claim :contextMissing)) (= (get post :author) "thsottiaux") (= (get post :provenance) "primary")
            (not (get post :truncated)) (<= (ms (get post :at)) (ms (get copy :now)))
            (= (value-type (get claim :quote)) "string") (>= (get (get claim :quote) :length) 4)
            (js-call (canonical-text (get post :text)) :includes (get claim :quote))
            (js-call refs :every (lambda (id) (js-call posts :some (lambda (p)
              (and (= (get p :id) id) (<= (ms (get p :at)) (ms (get post :at))))))))))
          (previous (when valid (js-call events :find (lambda (e)
            (or (= (get e :id) (get post :id)) (related-event? e post refs posts))))))
          (event nil) (event-changed false))
          (when (and post (get claim :semanticAgreed) (get claim :semanticValidated)
            (= (get claim :scope) "global") (= (get post :provenance) "primary")
            (js-call (js-array "codex-usage" "chatgpt-work-usage") :includes (get claim :subject))
            (not (get claim :contextMissing)) (not (get post :truncated))
            (not (= (get post :semanticRole) (get claim :kind))))
            (put post :semanticRole (get claim :kind)) (setq changed t))
          (when valid
            (if (and previous (not (= (get previous :id) (get post :id))))
              (unless (get post :sameResetAs) (put post :sameResetAs (get previous :id)) (setq changed t))
              (progn
                (setq event (js-object :id (get post :id) :at (get post :at) :url (get post :url)
                  :global t :banked false :observed false :tentative false :state "completed" :provenance "primary"
                  :completionBasis "semantic-evidence-agreement" :semanticVotes (get claim :votes)
                  :completionQuote (get claim :quote) :evidencePostIds refs))
                (if previous
                  (unless (semantic-event? previous post) (Object/assign previous event) (setq event-changed t))
                  (progn (js-call events :push event) (setq event-changed t)))
                (when event-changed
                  (setq changed t)
                  (unless (js-call pending :some (lambda (e) (= (get e :id) (get post :id))))
                    (js-call pending :push (Object/assign (js-object) event (js-object :text (get post :text) :verified t)))))
                (let ((row (js-call timeline :find (lambda (e) (= (get e :id) (get post :id))))))
                  (if row (when event-changed (Object/assign row event (js-object :kind "global" :eventId (get post :id))))
                    (js-call timeline :push (Object/assign (js-object) event (js-object :kind "global" :eventId (get post :id))))))))
            (js-call accepted :push (get post :id))))))
      (put copy :events (sorted events "at")) (put copy :timeline (sorted timeline "at"))
      (put copy :pendingConfirmations pending)
      (when changed (put copy :semanticRevision (get batch :revision)))
      (js-object :snapshot copy :changed changed :acceptedEventIds accepted :revision (get batch :revision))))
  (defasync reconcile-reset-facts (snapshot batch &optional options)
    (setq options (or options (js-object)))
    (if (get options :persist)
      (await (state-transaction "ledger" (async ()
        (let* ((current (or (await (read-state "ledger" (get options :directory))) snapshot))
          (merged (Object/assign (js-object) snapshot current))
          (result (reconcile-value merged batch)))
          (when (get result :changed)
            (await (write-state "ledger" (get result :snapshot) (get options :directory)))) result)) 30000 (get options :directory)))
      (reconcile-value snapshot batch)))
  (export semantic-event? reconcile-value reconcile-reset-facts))
