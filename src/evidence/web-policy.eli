(module tibo.evidence.web-policy
  (import "node:dns/promises" lookup)
  (import "node:net" isIP)
  (import "node:timers" setTimeout clearTimeout)
  (import "../platform/host.eli" URL Promise RegExp Number Error fetch AbortSignal encodeURIComponent parseInt)
  (import "../platform/privacy.eli" public-text)
  (import "../platform/util.eli" fail matches)
  (defun public-ip? (ip)
    (setq ip (js-call ip :toLowerCase))
    (cond ((= (isIP ip) 4)
      (let* ((v (js-call (js-call ip :split ".") :map (lambda (n) (Number n)))) (a (get v 0)) (b (get v 1)) (c (get v 2)))
        (not (or (= a 0) (= a 10) (= a 127) (>= a 224)
          (and (= a 100) (>= b 64) (<= b 127)) (and (= a 169) (= b 254))
          (and (= a 172) (>= b 16) (<= b 31)) (and (= a 192) (= b 168))
          (and (= a 192) (= b 0) (or (= c 0) (= c 2))) (and (= a 192) (= b 88) (= c 99))
          (and (= a 198) (or (= b 18) (= b 19) (and (= b 51) (= c 100))))
          (and (= a 203) (= b 0) (= c 113))))))
      ((= (isIP ip) 6) (and (matches "^[23][0-9a-f]{3}:" ip)
        (not (and (= (get (js-call ip :split ":") 0) "2001")
          (< (parseInt (str "0" (get (js-call ip :split ":") 1)) 16) 512)))
        (not (matches "^(?:2001:db8:|2002:)" ip)))) (t false)))
  (defun public-url (address)
    (unless (and (= (value-type address) "string") (> (get address :length) 0) (<= (get address :length) 2048)
      (= (public-text address 2048) address)) (fail "page-url"))
    (let* ((u (new URL address)) (host (js-call (get u :hostname) :replace (new RegExp "^\\[|\\]$" "g") "")))
      (unless (and (js-call (js-array "http:" "https:") :includes (get u :protocol))
        (= (get u :port) "") (= (get u :username) "") (= (get u :password) "")
        (not (matches "^(?:localhost|.*\\.(?:localhost|local|internal|test|invalid))\\.?$" host))
        (if (> (isIP host) 0) (public-ip? host) (matches "^[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}\\.?$" host)))
        (fail "page-address-blocked"))
      (put u :hash "") u))
  (defasync public-dns (host)
    (let* ((response (await (fetch (str "https://dns.google/resolve?type=A&edns_client_subnet=0.0.0.0/0&name=" (encodeURIComponent host))
      (js-object :redirect "error" :signal (AbortSignal/timeout 3500) :headers (js-object :accept "application/dns-json")))))
      (body (await (js-call response :text))))
      (unless (and (get response :ok) (< (get body :length) 64000)) (fail "page-dns-unavailable"))
      (let* ((data (JSON/parse body)) (answers (get data :Answer (js-array)))
        (rows (js-call (js-call answers :filter (lambda (r) (= (get r :type) 1))) :map
          (lambda (r) (js-object :address (get r :data) :family 4)))))
        (unless (and (= (get data :Status) 0) (> (get rows :length) 0)
          (js-call rows :every (lambda (r) (public-ip? (get r :address))))) (fail "page-address-blocked")) rows)))
  (defasync resolve-public (host &optional resolver)
    (let ((timer nil))
      (try
        (let ((rows (await (Promise/race (js-array
          (if (> (isIP host) 0) (Promise/resolve (js-array (js-object :address host :family (isIP host))))
            (funcall (or resolver lookup) host (js-object :all t :verbatim t)))
          (new Promise (lambda (resolve reject) (setq timer (setTimeout (lambda () (reject (new Error "page-dns-timeout"))) 4000)))))))))
          ;; Some system VPN resolvers return benchmark-range virtual addresses.
          ;; Resolve those names through a fixed authenticated DNS service instead
          ;; of accepting the virtual range as public network destinations.
          (when (and (not resolver) (> (get rows :length) 0)
            (js-call rows :every (lambda (r) (matches "^198\\.(?:18|19)\\." (get r :address)))))
            (setq rows (await (public-dns host))))
          (unless (and (> (get rows :length) 0) (<= (get rows :length) 64)
            (js-call rows :every (lambda (row) (public-ip? (get row :address))))) (fail "page-address-blocked"))
          (or (js-call rows :find (lambda (r) (= (get r :family) 4))) (get rows 0)))
        (finally (when timer (clearTimeout timer))))))
  (defun page-links (text &optional limit)
    (let ((rows (js-array)))
      (js-call (Array/from (js-call (or text "") :matchAll (new RegExp "https?://[^\\s<>\"'）)\\]}]+" "gi"))) :forEach (lambda (m)
        (try (let ((url (get (public-url (js-call (get m 0) :replace (new RegExp "[，。；,;]+$") "")) :href)))
          (unless (js-call rows :includes url) (js-call rows :push url))) (catch error nil))))
      (js-call rows :slice 0 (or limit 8))))
  (export public-ip? public-url resolve-public page-links))
