;; Read a small data-only subset of the official page's serialized records.
;; No script, function, property access or call is ever evaluated.
(module tibo.evidence.x-data
  (import "../platform/host.eli" RegExp Map Number)
  (import "../platform/util.eli" fail matches canonical-text)
  (defun whitespace (s)
    (while (and (< (get s :i) (get (get s :text) :length))
      (matches "\\s" (get (get s :text) (get s :i)))) (put s :i (+ (get s :i) 1))))
  (defun token (s pattern)
    (whitespace s)
    (let ((m (js-call (new RegExp (str "^(?:" pattern ")")) :exec (js-call (get s :text) :slice (get s :i)))))
      (unless m (fail "x-data-token")) (put s :i (+ (get s :i) (get (get m 0) :length))) (get m 0)))
  (defun string-value (s)
    (let ((start (get s :i)) (escaped false) (done false))
      (put s :i (+ start 1))
      (while (and (not done) (< (get s :i) (get (get s :text) :length)))
        (let ((c (get (get s :text) (get s :i))))
          (put s :i (+ (get s :i) 1))
          (cond (escaped (setq escaped false)) ((= c "\\") (setq escaped t)) ((= c "\"") (setq done t)))))
      (unless done (fail "x-data-string"))
      (JSON/parse (js-call (get s :text) :slice start (get s :i)))))
  (defun data-value (s depth)
    (whitespace s) (put s :nodes (+ (get s :nodes) 1))
    (when (or (> depth 64) (> (get s :nodes) 20000)) (fail "x-data-budget"))
    (let* ((c (get (get s :text) (get s :i))) (value nil))
      (cond ((= c "\"") (setq value (string-value s)))
        ((= c "$")
          (let* ((ref (token s "\\$R\\[[0-9]+\\]")) (id (js-call ref :slice 3 -1)))
            (whitespace s)
            (if (= (get (get s :text) (get s :i)) "=")
              (progn (put s :i (+ (get s :i) 1)) (setq value (data-value s (+ depth 1))) (js-call (get s :refs) :set id value))
              (setq value (js-call (get s :refs) :get id)))))
        ((or (= c "{") (= c "["))
          (let* ((object (= c "{")) (end (if object "}" "]"))
            (row (if object (Object/create nil) (js-array))) (done false))
            (put s :i (+ (get s :i) 1))
            (while (not done)
              (whitespace s)
              (if (= (get (get s :text) (get s :i)) end) (setq done t)
                (if object
                  (let ((key (if (= (get (get s :text) (get s :i)) "\"") (string-value s) (token s "[A-Za-z_$][A-Za-z0-9_$]*"))))
                    (token s ":") (put row key (data-value s (+ depth 1))))
                  (js-call row :push (data-value s (+ depth 1)))))
              (whitespace s)
              (if (= (get (get s :text) (get s :i)) end) (setq done t) (token s ",")))
            (put s :i (+ (get s :i) 1)) (setq value row)))
        ((= c "!") (setq value (= (token s "![01]") "!0")))
        ((or (= c "t") (= c "f")) (setq value (= (token s "true|false") "true")))
        ((matches "[0-9-]" (or c "")) (setq value (Number (token s "-?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?"))))
        (t (token s "null|void 0|undefined") (setq value nil))) value))
  (defun official-relations (html posts)
    (let* ((refs (new Map)) (rows (new Map))
      (starts (js-call (Array/from (js-call html :matchAll
        (new RegExp "\\$R\\[[0-9]+\\]=\\{(?:\"?__isTweetResult\"?:\"Tweet\",)?\"?__typename\"?:\"Tweet\"," "g"))) :slice 0 256)))
      ;; New pages wrap the GraphQL response in a JSON string inside Result.Ok.
      ;; Decode data only, then feed the same author/body verified Tweet reader.
      (js-call (Array/from (js-call html :matchAll
        (new RegExp "\\$R\\[[0-9]+\\]=\\{kind:\"Result.Ok\",value:" "g"))) :forEach (lambda (start)
        (try
          (let* ((s (js-object :text html :i (get start :index) :nodes 0 :refs refs))
            (wrapper (data-value s 0)) (raw (get wrapper :value))
            (data (when (and (= (value-type raw) "string") (< (get raw :length) 4000000)) (JSON/parse raw)))
            (budget (js-object :nodes 0)))
            (walk-records data posts rows budget 0))
          (catch error nil))))
      (js-call starts :forEach (lambda (start)
        (try
          (let* ((s (js-object :text html :i (get start :index) :nodes 0 :refs refs))
            (tweet (data-value s 0)) (id (get tweet :rest_id))
            (post (js-call posts :find (lambda (p) (= (get p :id) id))))
            (user (get (get (get tweet :core (js-object)) :user_results (js-object)) :result (js-object)))
            (parent (get tweet :reply_to_results (js-object)))
            (quoted (get tweet :quoted_tweet_results (js-object)))
            (quoted-tweet (get quoted :result (js-object)))
            (quoted-user (get (get (get quoted-tweet :core (js-object)) :user_results (js-object)) :result (js-object)))
            (parent-user (get (get tweet :reply_to_user_results (js-object)) :result (js-object))))
            (when (and post (= (get (get user :core (js-object)) :screen_name) "thsottiaux")
              (= (canonical-text (get (get tweet :details (js-object)) :full_text "")) (canonical-text (get post :text))))
              (let ((relation (js-object :referenceMetadataVerified t)))
                (when (and (matches "^[0-9]{16,20}$" (get parent :rest_id ""))
                  (= (get (get parent-user :core (js-object)) :screen_name) "thsottiaux"))
                  (put relation :parentId (get parent :rest_id)) (put relation :parentRelationProvenance "official-page-data"))
                (when (and (matches "^[0-9]{16,20}$" (get quoted :rest_id ""))
                  (= (get quoted :rest_id) (get quoted-tweet :rest_id))
                  (= (get (get quoted-user :core (js-object)) :screen_name) "thsottiaux"))
                  (put relation :quotedPostId (get quoted :rest_id)) (put relation :quotedRelationProvenance "official-page-data"))
                (js-call rows :set id (Object/assign (js-object) (js-call rows :get id) relation)))))
          (catch error nil)))) rows))
  (defun walk-records (value posts rows budget depth)
    (put budget :nodes (+ (get budget :nodes) 1))
    (when (and value (= (value-type value) "object") (< depth 64) (< (get budget :nodes) 30000))
      (when (= (get value :__typename) "Tweet")
        ;; Reuse the typed literal parser and its author/body validation; the
        ;; JSON serialization cannot contain executable syntax.
        (let* ((literal (str "$R[0]={__typename:\"Tweet\","
                  (js-call (JSON/stringify (Object/fromEntries (js-call (Object/entries value) :filter
                    (lambda (pair) (not (= (get pair 0) "__typename")))))) :slice 1)))
          (found (official-relations literal posts)))
          (js-call found :forEach (lambda (relation id) (js-call rows :set id relation)))))
      (js-call (Object/values value) :forEach (lambda (child)
        (walk-records child posts rows budget (+ depth 1))))))
  (export official-relations))
