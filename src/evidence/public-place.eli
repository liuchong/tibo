(module tibo.evidence.public-place
  (import "node:crypto" createHash)
  (import "../platform/host.eli" Date Number encodeURIComponent)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/privacy.eli" public-text)
  (import "../platform/util.eli" fail iso matches)
  (import "./transport.eli" request-json)
  (defun place-name (text)
    (unless (and (= (value-type text) "string") (>= (get (js-call text :trim) :length) 2)
      (<= (get text :length) 120) (= (public-text text 120) text) (not (matches "https?://|[<>]" text))) (fail "place-query"))
    (js-call text :trim))
  (defun valid-point? (lat lon)
    (and (Number/isFinite lat) (Number/isFinite lon) (<= (Math/abs lat) 90) (<= (Math/abs lon) 180)))
  (defasync cached-public (identity ttl collect)
    (let ((key (str "public-place-" (js-call (js-call (createHash "sha256") :update (str "place-1:" identity)) :digest "hex"))))
      (await (state-transaction key (async ()
        (let ((saved (await (read-state key))) (value nil))
          (if (and saved (> (get saved :until) (Date/now)))
            (Object/assign (js-object) (get saved :value) (js-object :cached t))
            (progn
              (setq value (try (await (funcall collect)) (catch error (js-object :state "unavailable" :at (iso (Date/now))))))
              (await (write-state key (js-object :until (+ (Date/now) (if (= (get value :state) "ok") ttl 30000)) :value value))) value)))) 12000))))
  (defasync place-query (query &optional limit country)
    (setq query (place-name query))
    (when country (unless (matches "^[A-Z]{2}$" country) (fail "place-country")))
    (let ((row (await (cached-public (str "geo:" query ":" (or country "")) 86400000 (async ()
      (let* ((body (await (request-json (str "https://geocoding-api.open-meteo.com/v1/search?count=3&language=zh&name=" (encodeURIComponent query) (if country (str "&countryCode=" country) "")) nil 5000)))
        (rows (js-call (js-call (js-call (get body :results (js-array)) :filter (lambda (p) (or (not country) (= (get p :country_code) country)))) :slice 0 3) :map (lambda (p)
          (unless (and (valid-point? (get p :latitude) (get p :longitude)) (= (value-type (get p :name)) "string")) (fail "place-schema"))
          (js-object :name (public-text (get p :name) 120) :latitude (get p :latitude) :longitude (get p :longitude)
            :country (public-text (get p :country "") 100) :countryCode (get p :country_code) :region (public-text (get p :admin1 "") 120)
            :timezone (get p :timezone) :sourceUrl (when (Number/isInteger (get p :id)) (str "https://www.geonames.org/" (get p :id) "/")))))))
        (js-object :state (if (> (get rows :length) 0) "ok" "empty") :query query :places rows :at (iso (Date/now))
          :attribution "Open-Meteo / GeoNames" :sourceUrl "https://open-meteo.com/en/docs/geocoding-api")))))))
      (when (get row :places) (put row :places (js-call (get row :places) :slice 0 (or limit 3)))) row))
  (defasync weather-at (point days)
    (unless (and (valid-point? (get point :latitude) (get point :longitude)) (Number/isInteger days) (>= days 1) (<= days 7)) (fail "weather-query"))
    (await (cached-public (str "weather:" (get point :latitude) ":" (get point :longitude) ":" days) 600000 (async ()
      (let* ((body (await (request-json (str "https://api.open-meteo.com/v1/forecast?latitude=" (get point :latitude)
        "&longitude=" (get point :longitude) "&timezone=auto&forecast_days=" days
        "&current=temperature_2m,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max") nil 5000)))
        (daily (get body :daily)) (current (get body :current)))
        (unless (and daily (Array/isArray (get daily :time)) (> (get (get daily :time) :length) 0) current
          (Number/isFinite (get current :temperature_2m))) (fail "weather-schema"))
        (js-object :state "ok" :at (iso (Date/now)) :timezone (get body :timezone) :current current
          :days (js-call (js-call (get daily :time) :slice 0 days) :map (lambda (date i)
            (js-object :date date :code (get (get daily :weather_code (js-array)) i)
              :maxC (get (get daily :temperature_2m_max (js-array)) i) :minC (get (get daily :temperature_2m_min (js-array)) i)
              :rainPercent (get (get daily :precipitation_probability_max (js-array)) i))))
          :sourceUrl "https://open-meteo.com/" :attribution "Open-Meteo"))))))
  (export place-name valid-point? place-query weather-at))
