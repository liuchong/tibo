(module tibo.evidence.x-page
  (import "../platform/host.eli" Number BigInt RegExp)
  (import "./html.eli" parse-html by-tag html-text attr)
  (import "../platform/util.eli" fail canonical-text ms iso match matches sorted)
  (defun snowflake-time (id)
    (unless (matches "^[0-9]{16,20}$" id) (fail "Invalid X post ID"))
    (iso (Number (+ (bit-shift-right (BigInt id) (BigInt 22)) (BigInt "1288834974657")))))
  ;; Quoted articles are separate posts, never part of their parent's body.
  ;; Embedded scripts are inert data: neither executed nor required for parsing.
  (defun own-nodes (node predicate)
    (let ((result (js-array)))
      (js-call (get node :children (js-array)) :forEach (lambda (child)
        (when (and (= (value-type child) "object") (not (= (get child :tag) "article")))
          (when (funcall predicate child) (js-call result :push child))
          (setq result (js-call result :concat (own-nodes child predicate)))))) result))
  (defun parse-primary (html now)
    (let ((root (parse-html html)) (posts (js-array)) (ids (js-array)))
      (js-call (by-tag root "article") :forEach (lambda (element)
        (let* ((profile (get (own-nodes element (lambda (n) (and (= (get n :tag) "a")
          (matches "^(?:https://(?:x|twitter)\\.com)?/[A-Za-z0-9_]+/?$" (or (attr n "href") ""))))) 0))
          (link (get (own-nodes element (lambda (n) (and (= (get n :tag) "a")
          (matches "^(?:https://(?:x|twitter)\\.com)?/thsottiaux/status/[0-9]{16,20}(?:[/?]|$)" (or (attr n "href") ""))))) 0))
          (id (match "/thsottiaux/status/([0-9]{16,20})" (or (attr link "href") "")))
          (time (get (own-nodes element (lambda (n) (= (get n :tag) "time"))) 0))
          (body (get (own-nodes element (lambda (n)
            (or (= (attr n "data-testid") "tweetText")
              (and (= (get n :tag) "div") (= (attr n "dir") "auto")
                (matches "(?:^| )text-body(?: |$)" (or (attr n "class") ""))
                (matches "(?:^| )whitespace-pre-wrap(?: |$)" (or (attr n "class") "")))))) 0))
          (raw (canonical-text (html-text body)))
          (truncated (matches "(?:Show more|显示更多|查看更多|展开)$|…(?:\\s*https?://[^ ]+)?$" raw))
          (text (canonical-text (js-call raw :replace (new RegExp "\\s*(?:Show more|显示更多|查看更多|展开)$" "i") "…"))))
          (when (and id (or (not profile) (matches "^(?:https://(?:x|twitter)\\.com)?/thsottiaux/?$" (attr profile "href")))
            (> (get text :length) 0) (not (js-call ids :includes (get id 1))))
            (let ((at (or (attr time "datetime") (snowflake-time (get id 1)))))
              (when (<= (ms at) (ms now))
                (js-call ids :push (get id 1))
                (js-call posts :push (js-object :id (get id 1) :at at :text text :author "thsottiaux"
                  :url (str "https://x.com/thsottiaux/status/" (get id 1)) :provenance "primary"
                  :via "official-page" :cachedAt now :truncated truncated))))))))
      (when (= (get posts :length) 0) (fail "X 抓取未返回可识别的原帖"))
      (sorted posts "at")))
  (export snowflake-time parse-primary))
