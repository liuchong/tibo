(module tibo.evidence.cache
  (import "../platform/host.eli" Date Number)
  (import "node:crypto" createHash)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" ms)
  (defconst ttl-ms 120000)
  (defconst retry-ms 15000)
  (defasync ledger-signature ()
    (let ((ledger (or (await (read-state "ledger")) (js-object))))
      (js-call (js-call (createHash "sha256") :update (JSON/stringify
        (js-object :events (get ledger :events (js-array)) :posts (get ledger :posts (js-array))))) :digest "hex")))
  (defun valid-snapshot? (snapshot)
    (and snapshot (= (get snapshot :schemaVersion) 1)
      (js-call (js-array "events" "posts" "sources" "unknowns") :every (lambda (key) (Array/isArray (get snapshot key))))
      (Number/isFinite (ms (get snapshot :now)))))
  (defun copy-snapshot (snapshot now state started ttl)
    (let ((copy (JSON/parse (JSON/stringify snapshot))))
      ;; Observation time advances; source and original verification times do not.
      (put copy :now now)
      (put copy :collectionReuse (js-object :state state :collectedAt (get snapshot :now)
        :ttlMs ttl :waitMs (- (Date/now) started)))
      (when (= state "cached")
        (js-call (get copy :sources) :forEach (lambda (s)
          (put s :fetched false) (put s :cached t)
          (when (= (get s :name) "oembed")
            (put s :reused (+ (get s :reused 0) (get s :verified 0)))
            (put s :attempted 0) (put s :verified 0))))) copy))
  (defasync cached-sources (now offline generate)
    (if offline (await (funcall generate))
      (let ((started (Date/now)))
        (await (state-transaction "source-cache" (async ()
          (let* ((tag (try (await (ledger-signature)) (catch error nil)))
            (saved (try (await (read-state "source-cache")) (catch error nil)))
            (hit (try (and tag saved (= (get saved :schemaVersion) 1) (= (get saved :signature) tag)
              (Number/isFinite (get saved :startedAt)) (<= (get saved :startedAt) (Date/now))
              (Number/isFinite (get saved :expiresAt)) (> (get saved :expiresAt) (Date/now))
              (valid-snapshot? (get saved :snapshot)) (<= (ms (get (get saved :snapshot) :now)) (ms now)))
              (catch error false))))
            (if hit (copy-snapshot (get saved :snapshot) now "cached" started (get saved :ttlMs))
              (let* ((collected (Date/now)) (snapshot (await (funcall generate)))
                (healthy (js-call (get snapshot :sources) :some (lambda (s) (and (= (get s :name) "primary") (get s :ok)))))
                (ttl (if healthy ttl-ms retry-ms))
                ;; A slow failed request still needs a short recovery cooldown.
                (until (+ (if healthy collected (Date/now)) ttl))
                (after (try (await (ledger-signature)) (catch error nil))))
                (when (and after (< (Date/now) until))
                  (try (await (write-state "source-cache" (js-object :schemaVersion 1 :signature after
                    :startedAt collected :expiresAt until :ttlMs ttl :snapshot snapshot))) (catch error nil)))
                (copy-snapshot snapshot now "fresh" started ttl))))) 120000)))))
  (export cached-sources ttl-ms retry-ms))
