(module tibo.evidence.page-extract
  (import "../platform/host.eli" HTMLRewriter RegExp)
  (import "./html.eli" parse-html by-tag select html-text attr)
  (import "../platform/privacy.eli" public-text)
  (import "../platform/util.eli" clean matches)
  (defun tidy-page-text (text)
    (js-call (js-call (js-call text :replace (new RegExp "[ \\t]+" "g") " ")
      :replace (new RegExp " *\\n *" "g") "\n") :replace (new RegExp "\\n{3,}" "g") "\n\n"))
  (defun node-text (node)
    (if (= (value-type node) "string") node
      (let* ((tag (get node :tag "")) (parts (js-call (get node :children (js-array)) :map node-text))
        (text (js-call parts :join "")))
        (cond ((= tag "br") "\n")
          ((matches "^(?:p|h[1-6]|div|section|article|main|pre|blockquote|tr|ul|ol)$" tag) (str "\n\n" text "\n\n"))
          ((= tag "li") (str "\n• " text)) ((or (= tag "td") (= tag "th")) (str text " | ")) (t text)))))
  (defun candidate-score (node)
    (let* ((text (html-text node)) (n (get text :length))
      (linked (js-call (by-tag node "a") :reduce (lambda (sum a) (+ sum (get (html-text a) :length))) 0))
      (density (/ linked (Math/max 1 n))) (tag (get node :tag))
      (punct (get (or (js-call text :match (new RegExp "[。！？.!?;；]" "g")) (js-array)) :length))
      (factor (cond ((= tag "article") 2.3) ((or (= tag "main") (= (attr node "role") "main")) 1.9)
        ((matches "article|content|post|entry|markdown|document" (str (attr node "class") " " (attr node "id"))) 1.3)
        ((= tag "body") 0.65) (t 1))))
      (* n (Math/pow (Math/max 0 (- 1 density)) 2) factor
        (+ 1 (Math/min 0.4 (/ punct (Math/max 1 n)))))))
  (defasync extract-page (html url)
    (let ((title "") (metadata (js-object)) (ld (js-array)) (current ""))
      (let ((reader (new HTMLRewriter)))
        (js-call reader :on "title" (js-object :text (lambda (part) (setq title (str title (get part :text))))))
        (js-call reader :on "script[type='application/ld+json']" (js-object
          :element (lambda (element) (setq current "") (js-call ld :push ""))
          :text (lambda (part)
            (when (< (get current :length) 100000) (setq current (str current (get part :text)))
              (put ld (- (get ld :length) 1) current)))))
        (js-call reader :transform html))
      (js-call ld :forEach (lambda (text)
        (try
          (let* ((parsed (JSON/parse text)) (rows (if (Array/isArray parsed) parsed (get parsed :@graph (js-array parsed)))))
            (js-call rows :forEach (lambda (row)
              (when (and row (matches "Article|BlogPosting|TechArticle" (JSON/stringify (get row :@type ""))))
                (let ((author (get row :author)))
                  (when (Array/isArray author) (setq author (get author 0)))
                  (put metadata :author (if (= (value-type author) "string") author (get (or author (js-object)) :name ""))))
                (put metadata :publishedAt (get row :datePublished))
                (put metadata :headline (get row :headline ""))
                (when (= (value-type (get row :articleBody)) "string") (put metadata :articleBody (get row :articleBody)))))))
          (catch error nil))))
      (let* ((stripper (new HTMLRewriter))
        (ignored "script,style,noscript,nav,footer,header,aside,form,button,iframe,object,embed,svg,canvas,[hidden],[aria-hidden='true'],[role='navigation'],[role='banner'],[role='complementary'],[class*='newsletter'],[id*='newsletter'],[class*='subscribe'],[data-ad]"))
        (js-call stripper :on ignored (js-object :element (lambda (element) (js-call element :remove))))
        (let* ((root (parse-html (js-call stripper :transform html)))
          (candidates (select root (lambda (node) (or (matches "^(?:article|main|section|div|body)$" (get node :tag)) (= (attr node "role") "main")))))
          (winner nil) (score 0) (text "") (state "ok"))
          (js-call candidates :forEach (lambda (node)
            (let ((value (candidate-score node))) (when (> value score) (setq score value winner node)))))
          (setq text (js-call (tidy-page-text (node-text (or winner root))) :trim))
          (when (and (< (get text :length) 120) (get metadata :articleBody)) (setq text (get metadata :articleBody)))
          (setq title (clean (if (= (clean title) "") (get metadata :headline "") title)))
          (when (or (matches "^(?:just a moment|access denied|attention required|security verification|百度安全验证|安全验证|访问受限|登录知乎)" title)
            (and (< (get text :length) 400) (matches "verify (?:that )?you are human|enable javascript and cookies|请完成安全验证|请开启 JavaScript|扫码登录后|请先登录后" text)))
            (setq state "blocked" text ""))
          (when (and (= state "ok") (< (get text :length) 120)) (setq state "partial"))
          (js-object :state state :url url :title (public-text title 300)
            :author (public-text (get metadata :author "") 160)
            :publishedAt (let ((value (get metadata :publishedAt)))
              (when (and (= (value-type value) "string") (matches "^20[0-9]{2}-[0-9]{2}-[0-9]{2}" value)) (js-call value :slice 0 40)))
            :text (public-text (js-call text :slice 0 24000) 24000) :truncated (> (get text :length) 24000))))))
  (export tidy-page-text node-text candidate-score extract-page))
