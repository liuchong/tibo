;; Independent of keyword sensitivity. Capacity is reserved atomically before
;; AI or send I/O, so parallel workers and restarts cannot reopen the budget.
(module tibo.im.reply-policy
  (import "../platform/host.eli" Date)
  (import "../platform/state.eli" read-state write-state)
  (import "./serial.eli" room-transaction)
  (import "./context.eli" digest group-context? room-key)
  (import "./triggers.eli" keywords)
  (defun active (replies now window)
    (js-call replies :filter (lambda (r) (and (> (get r :at) (- now window)) (not (= (get r :state) "released"))))))
  (defun evaluate-reply (replies context kind text now activity)
    (let* ((all (active replies now 3600000)) (actor (digest (get context :actor)))
      (mine (js-call all :filter (lambda (r) (= (get r :actor) actor))))
      (ambient (js-call all :filter (lambda (r) (= (get r :kind) "ambient"))))
      (reactions (js-call all :filter (lambda (r) (= (get r :kind) "reaction"))))
      (topics (js-call (keywords text) :map (lambda (p) (get p :name)))) (content (digest (js-call (js-call text :trim) :toLowerCase)))
      (busy (>= activity 12)) (reason nil))
      (setq reason (cond
        ((or (>= (get (active all now 60000) :length) 6) (>= (get (active all now 600000) :length) 24)) "room-budget")
        ((or (>= (get (active mine now 60000) :length) 3) (>= (get (active mine now 600000) :length) 10)) "person-budget")
        ((and (not (= kind "prayer")) (js-call (active mine now 30000) :some (lambda (r) (= (get r :content) content)))) "repeat-request")
        ((and (= kind "prayer") (js-call (active mine now 15000) :some (lambda (r) (= (get r :kind) "prayer")))) "prayer-spacing")
        ((and (= kind "reaction") (>= (get (active reactions now 600000) :length) 2)) "reaction-budget")
        ((and (= kind "reaction") (> (get (active reactions now 120000) :length) 0)) "reaction-spacing")
        ((and (= kind "reaction") (js-call (active mine now 600000) :some (lambda (r) (= (get r :kind) "reaction")))) "reaction-person")
        ((and (= kind "reaction") (js-call (active reactions now 300000) :some (lambda (r)
          (js-call topics :some (lambda (name) (js-call (get r :topics (js-array)) :includes name)))))) "reaction-topic")
        ((and (= kind "ambient") (js-call (active all now 45000) :some (lambda (r) (not (= (get r :kind) "ambient"))))) "direct-conversation")
        ((and (= kind "ambient") (or (>= (get (active ambient now 600000) :length) 2) (>= (get ambient :length) 6))) "ambient-budget")
        ((and (= kind "ambient") (js-call (active ambient now (if busy 240000 120000)) :some (lambda (r) t))) (if busy "busy-room" "ambient-spacing"))
        ((and (= kind "ambient") (or (>= (get (js-call (active mine now 300000) :filter (lambda (r) (= (get r :kind) "ambient"))) :length) 1)
          (>= (get (js-call mine :filter (lambda (r) (= (get r :kind) "ambient"))) :length) 3))) "ambient-person")
        ((and (= kind "ambient") (js-call (active ambient now 300000) :some (lambda (r)
          (js-call topics :some (lambda (name) (js-call (get r :topics (js-array)) :includes name)))))) "topic-spacing")
        ((and (= kind "ambient") (js-call (active all now 600000) :some (lambda (r) (= (get r :content) content)))) "repeat-discussion")
        (t nil)))
      (js-object :accepted (not reason) :reason (or reason "allowed") :kind kind :pressure (if busy "busy" "normal"))))
  (defasync reply-permit (context id kind text activity &optional reserve)
    (if (not (group-context? context)) (js-object :accepted t :reason "direct-channel" :kind kind)
      (try
        (await (room-transaction (room-key "im-replies-" context) (async ()
          (let* ((key (room-key "im-replies-" context)) (now (Date/now))
            (state (or (await (read-state key)) (js-object :replies (js-array) :decisions (js-array))))
            (event (digest id)) (replies (js-call (get state :replies) :filter (lambda (r) (> (get r :at) (- now 3600000)))))
            (decisions (js-call (get state :decisions) :filter (lambda (r) (> (get r :at) (- now 600000)))))
            (previous (js-call decisions :find (lambda (r) (= (get r :id) event))))
            (reserved (js-call replies :find (lambda (r) (= (get r :id) event))))
            (decision (if previous (get previous :decision)
              (if reserved (js-object :accepted false :reason "consumed-event" :kind kind)
                (evaluate-reply replies context kind text now activity)))))
            (when (and reserve (not previous))
              (when (get decision :accepted)
                (js-call replies :push (js-object :id event :at now :actor (digest (get context :actor)) :kind kind :state "reserved"
                  :content (digest (js-call (js-call text :trim) :toLowerCase)) :topics (js-call (keywords text) :map (lambda (p) (get p :name))))))
              (js-call decisions :push (js-object :id event :at now :decision decision))
              (await (write-state key (js-object :replies (js-call replies :slice -256) :decisions (js-call decisions :slice -512))))) decision))))
        (catch error (js-object :accepted false :reason "reply-policy-unavailable" :kind kind)))))
  (defasync settle-reply (context id outcome)
    (when (group-context? context)
      (try
        (await (room-transaction (room-key "im-replies-" context) (async ()
          (let* ((key (room-key "im-replies-" context)) (state (await (read-state key)))
            (row (js-call (get state :replies (js-array)) :find (lambda (r) (= (get r :id) (digest id))))))
            (when row
              ;; Unknown outcomes keep capacity; only a proven no-send releases it.
              (put row :state (cond ((= outcome "sent") "sent")
                ((js-call (js-array "rejected" "failed-before-send") :includes outcome) "released") (t "uncertain")))
              (await (write-state key state)))))))
        (catch error nil))))
  (export evaluate-reply reply-permit settle-reply))
