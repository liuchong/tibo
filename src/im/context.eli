;; A bounded, anonymous group conversation buffer; never a source of commands
;; or forecast evidence. Observation does not imply permission to reply.
(module tibo.im.context
  (import "node:crypto" createHash)
  (import "../platform/host.eli" Date RegExp Number)
  (import "../platform/state.eli" read-state write-state)
  (import "./serial.eli" room-transaction)
  (import "../platform/privacy.eli" public-text private-question?)
  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defun group-context? (context)
    (and context (= (get context :authenticated) t) (= (get context :conversationType) "group")
      (js-call (js-array "transport" "account" "scope" "actor") :every (lambda (key)
        (and (= (value-type (get context key)) "string") (> (get (get context key) :length) 0) (<= (get (get context key) :length) 200))))))
  (defun room-key (prefix context)
    (str prefix (js-call (digest (JSON/stringify (js-array (get context :transport) (get context :account) (get context :scope)))) :slice 0 40)))
  (defun safe-message (text)
    (if (or (not (= (value-type text) "string")) (private-question? text)) ""
      (js-call (js-call (public-text text 500) :replace
        (new RegExp "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}|\\b1[3-9][0-9]{9}\\b|@_user_[0-9]+|香客[0-9]+" "g") "[已隐藏]") :trim)))
  (defun prompt-history (messages)
    (let ((remaining 1000))
      (if (not (Array/isArray messages)) (js-array)
        (js-call (js-call (js-call messages :slice -6) :map (lambda (row)
          (setq row (or row (js-object)))
          (let ((text (js-call (safe-message (get row :text)) :slice 0 (Math/min 180 remaining))))
            (setq remaining (- remaining (get text :length)))
            (js-object :text text :sameSpeaker (= (get row :sameSpeaker) t))))) :filter (lambda (row) (> (get (get row :text) :length) 0))))))
  (defasync remember-message (context id text at)
    (when (group-context? context)
      (try
        (await (room-transaction (room-key "im-context-" context) (async ()
          (let* ((now (Date/now)) (stamp (Date/parse at)) (key (room-key "im-context-" context))
            (state (or (await (read-state key)) (js-object :messages (js-array) :traffic (js-array))))
            (event (digest id)) (traffic (js-call (get state :traffic) :filter (lambda (r) (> (get r :at) (- now 600000)))))
            (messages (js-call (get state :messages) :filter (lambda (r) (> (get r :at) (- now 600000)))))
            (material (safe-message text)) (sequence (+ (get state :sequence 0) 1)))
            (when (and (Number/isFinite stamp) (> stamp (- now 300000)) (<= stamp (+ now 60000))
              (not (js-call traffic :some (lambda (r) (= (get r :id) event)))))
              (js-call traffic :push (js-object :id event :at stamp :sequence sequence))
              (when (> (get material :length) 0)
                (js-call messages :push (js-object :id event :at stamp :sequence sequence :actor (digest (get context :actor)) :text material)))
              (await (write-state key (js-object :sequence sequence :messages (js-call messages :slice -48) :traffic (js-call traffic :slice -128)))))))))
        (catch error nil))))
  (defasync conversation-context (context question id at)
    (let ((empty (js-object :messages (js-array) :activity 0)))
      (if (not (group-context? context)) empty
        (try
          (let* ((now (Date/now)) (stamp (Date/parse at)) (event (digest id)) (actor (digest (get context :actor)))
            (state (or (await (read-state (room-key "im-context-" context))) (js-object)))
            (current (js-call (get state :traffic (js-array)) :find (lambda (r) (= (get r :id) event))))
            (sequence (get (or current (js-object)) :sequence 9007199254740991))
            (rows (js-call (js-call (get state :messages (js-array)) :filter (lambda (r)
              (and (> (get r :at) (- now 300000)) (<= (get r :at) stamp) (< (get r :sequence 0) sequence) (not (= (get r :id) event))))) :slice -6)))
            (js-object :activity (get (js-call (get state :traffic (js-array)) :filter (lambda (r) (> (get r :at) (- now 120000)))) :length)
              :messages (prompt-history (js-call rows :map (lambda (r) (js-object :text (get r :text) :sameSpeaker (= (get r :actor) actor)))))))
          (catch error empty)))))
  (export digest group-context? room-key safe-message prompt-history remember-message conversation-context))
