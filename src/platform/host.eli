;; Host symbols only. Business code remains in ordinary Eliscript forms.
(module tibo.host
  (defconst Error (js* "globalThis.Error"))
  (defconst Date (js* "globalThis.Date"))
  (defconst Promise (js* "globalThis.Promise"))
  (defconst RegExp (js* "globalThis.RegExp"))
  (defconst Map (js* "globalThis.Map"))
  (defconst Set (js* "globalThis.Set"))
  (defconst Number (js* "globalThis.Number"))
  (defconst Intl (js* "globalThis.Intl"))
  (defconst fetch (js* "globalThis.fetch"))
  (defconst AbortSignal (js* "globalThis.AbortSignal"))
  (defconst AbortController (js* "globalThis.AbortController"))
  (defconst BigInt (js* "globalThis.BigInt"))
  (defconst Uint8Array (js* "globalThis.Uint8Array"))
  (defconst TextEncoder (js* "globalThis.TextEncoder"))
  (defconst TextDecoder (js* "globalThis.TextDecoder"))
  (defconst WebSocket (js* "globalThis.WebSocket"))
  (defconst URL (js* "globalThis.URL"))
  (defconst URLSearchParams (js* "globalThis.URLSearchParams"))
  (defconst encodeURIComponent (js* "globalThis.encodeURIComponent"))
  (defconst parseInt (js* "globalThis.parseInt"))
  (export Error Date Promise RegExp Map Set Number Intl fetch AbortSignal AbortController BigInt Uint8Array TextEncoder TextDecoder WebSocket URL URLSearchParams encodeURIComponent parseInt))
