(module tibo.platform.history-seed
  (import "./host.eli" Date Map URL RegExp)
  (import "node:path" resolve dirname join)
  (import "node:fs/promises" readFile writeFile rename mkdir realpath)
  (import "node:crypto" createHash randomUUID)
  (import "./state.eli" read-state write-state state-root)
  (import "./transaction.eli" state-transaction)
  (import "./util.eli" fail matches ms iso sorted json)
  ;; This module is local installation/maintenance only. No business entry
  ;; imports it, and no dataset is imported or embedded in executable code.
  (defun official-url (value id)
    (try
      (let ((u (new URL value)))
        (when (and (= (get u :protocol) "https:") (= (get u :username) "") (= (get u :password) "") (= (get u :port) "")
          (js-call (js-array "x.com" "twitter.com") :includes (get u :hostname))
          (matches "^[0-9]{16,20}$" id) (= (get u :pathname) (str "/thsottiaux/status/" id)))
          (str "https://x.com/thsottiaux/status/" id))) (catch error nil)))
  (defun public-text (text)
    (unless (= (value-type text) "string") (fail "历史原文字段无效"))
    (js-call text :replace (new RegExp "https?://[^\\s<>]+" "g")
      (lambda (url) (if (matches "^https://(?:(?:x|twitter)\\.com/|t\\.co/|(?:www\\.)?openai\\.com/)" url) url ""))))
  (defun fields (value names)
    (Object/fromEntries (js-call (js-call names :filter (lambda (key) (Object/hasOwn value key)))
      :map (lambda (key) (js-array key (get value key))))))
  (defun public-row (row kind)
    (let* ((id (get row :id)) (url (official-url (get row :url) id)))
      (when url
        (ms (get row :at))
        (let ((copy (fields row (if (= kind "posts")
          (js-array "id" "at" "author" "provenance" "cachedAt" "truncated" "parentId" "parentRelationProvenance"
            "quotedPostId" "quotedRelationProvenance" "referenceMetadataVerified" "sameResetAs")
          (js-array "id" "at" "global" "banked" "observed" "provenance" "kind" "state" "completionBasis" "completionPostIds" "timeBasis" "replacesEventIds" "eventId")))))
          (put copy :url url)
          (when (= kind "posts")
            (unless (= (get row :author) "thsottiaux") (fail "历史帖子作者无效"))
            (put copy :text (public-text (get row :text)))) copy))))
  (defun public-ledger (value)
    (unless (and (= (get value :schemaVersion) 1) (Array/isArray (get value :events)) (Array/isArray (get value :posts)))
      (fail "历史 ledger 格式无效"))
    (ms (get value :now))
    (let ((result (js-object :schemaVersion 1 :now (get value :now) :documents (js-array))))
      (js-call (js-array "events" "posts" "timeline") :forEach (lambda (key)
        (let ((rows (js-call (get value key (js-array)) :map (lambda (row) (public-row row key)))))
          (put result key (sorted (js-call rows :filter (lambda (row) (not (nullish? row)))) "at"))))) result))
  (defun validate-seed (value)
    (let ((copy (public-ledger value)))
      (js-call (js-array "events" "posts" "timeline") :forEach (lambda (key)
        (let ((seen (new Map)) (rows (get value key (js-array))))
          (unless (= (get rows :length) (get (get copy key) :length)) (fail "历史条目必须有匹配的官方原帖地址"))
          (js-call rows :forEach (lambda (row)
            (when (or (js-call seen :has (get row :id)) (> (ms (get row :at)) (ms (get value :now)))) (fail "历史ID重复或时间超前"))
            (js-call seen :set (get row :id) t)
            (when (= key "events")
              (unless (and (= (value-type (get row :global)) "boolean") (= (value-type (get row :banked)) "boolean"))
                (fail "历史事件类型无效")))
            (when (= key "posts")
              (unless (and (> (get (get row :text) :length) 0) (<= (get (get row :text) :length) 20000)) (fail "历史原文长度无效")))))))) copy))
  (defun merge-rows (seed current)
    (let ((items (new Map)))
      (js-call seed :forEach (lambda (row) (js-call items :set (get row :id) row)))
      (js-call current :forEach (lambda (row)
        (let ((seed-row (js-call items :get (get row :id))) (copy (Object/assign (js-object) row)))
          (when seed-row
            (js-call (js-array "sameResetAs" "replacesEventIds") :forEach (lambda (key)
              (when (and (Object/hasOwn seed-row key) (not (Object/hasOwn copy key))) (put copy key (get seed-row key))))))
          (js-call items :set (get row :id) copy))))
      (sorted (Array/from (js-call items :values)) "at")))
  (defun merge-history (current seed)
    (setq current (or current (js-object)))
    (let ((merged (Object/assign (js-object) (or current (js-object)))))
      (put merged :schemaVersion 1)
      (put merged :now (if (and (get current :now) (> (ms (get current :now)) (ms (get seed :now)))) (get current :now) (get seed :now)))
      (js-call (js-array "events" "posts" "timeline") :forEach (lambda (key)
        (put merged key (merge-rows (get seed key (js-array)) (get current key (js-array))))))
      (unless (get merged :documents) (put merged :documents (js-array))) merged))
  (defasync load-seed (path)
    (let ((text (await (readFile path "utf8"))))
      (when (> (get text :length) 8000000) (fail "安装历史文件过大"))
      (validate-seed (JSON/parse text))))
  (defasync install-history (path &optional directory)
    (let* ((seed (await (load-seed path)))
      (tag (js-call (js-call (createHash "sha256") :update (json seed)) :digest "hex")))
      ;; Match the monitor -> ledger lock order, and acknowledge historical
      ;; confirmations before a live monitor can interpret them as new resets.
      (await (state-transaction "realtime-monitor" (async ()
        (let ((result (await (state-transaction "ledger" (async ()
          (let* ((current (or (await (read-state "ledger" directory)) (js-object))) (merged (merge-history current seed))
            (result (js-object :state "history-initialized" :sha256 tag
              :addedEvents (- (get (get merged :events) :length) (get (get current :events (js-array)) :length))
              :addedPosts (- (get (get merged :posts) :length) (get (get current :posts (js-array)) :length))
              :addedTimeline (- (get (get merged :timeline) :length) (get (get current :timeline (js-array)) :length)))))
            (await (write-state "ledger" merged directory))
            (await (write-state "history-install" (Object/assign (js-object :at (iso (Date/now))) result) directory)) result))
          30000 directory))))
          (let ((monitor (await (read-state "realtime-monitor" directory))))
            (when monitor
              (let ((known (get monitor :confirmedIds (js-array))))
                (js-call (get seed :posts) :forEach (lambda (event)
                  (when (not (js-call known :includes (get event :id)))
                    (js-call known :push (get event :id)))))
                (put monitor :confirmedIds known)
                (await (write-state "realtime-monitor" monitor directory))))) result))
        30000 directory))))
  (defasync export-history (path &optional directory)
    (let* ((target (resolve path)) (active (resolve (state-root directory) "ledger.json"))
      (real-target (try (await (realpath target)) (catch error target))))
      (when (or (= target active) (= real-target active)) (fail "导出文件不能覆盖运行时 ledger"))
      (let ((value (await (state-transaction "ledger"
        (async ()
          (let ((value (public-ledger (or (await (read-state "ledger" directory)) (fail "没有可导出的历史")))))
            ;; Old imported type labels are not evidence of completion. Keep
            ;; them in public posts/timeline unless the runtime confirmed them.
            (put value :events (js-call (get value :events) :filter (lambda (e)
              (and (not (js-call (get value :posts) :some (lambda (p)
                  (and (= (get p :id) (get e :id)) (get p :sameResetAs)))))
                (or (= (get e :state) "completed") (js-call (get value :timeline) :some (lambda (row)
                  (and (= (get row :id) (get e :id)) (= (get row :state) "completed")))))))))
            (validate-seed value)))
        30000 directory))))
        (await (mkdir (dirname target) (js-object :recursive t)))
        (let ((temp (join (dirname target) (str ".history-" (randomUUID) ".tmp"))))
          (await (writeFile temp (str (json value) "\n") (js-object :mode 384)))
          (await (rename temp target)))
        (js-object :state "history-exported" :events (get (get value :events) :length)
          :posts (get (get value :posts) :length) :timeline (get (get value :timeline) :length)))))
  (export public-ledger validate-seed merge-history load-seed install-history export-history))
