(module tibo.platform.config
  (import "node:process" :default process)
  (import "node:os" homedir)
  (import "node:path" join)
  (import "node:fs/promises" readFile)
  (import "./host.eli" RegExp)
  (import "./util.eli" fail)
  (defun config-path () (or (get (get process :env) :TIBO_CONFIG_FILE) (join (homedir) ".config" "tibo" "config.env")))
  (defun parse-config (text)
    (when (> (get text :length) 16000) (fail "配置文件过大"))
    (let ((values (js-object)))
      (js-call (js-call text :split "\n") :forEach (lambda (line)
        (let ((line (js-call line :trim)))
          (unless (or (= line "") (js-call line :startsWith "#"))
            (let ((match (js-call (new RegExp "^([A-Z][A-Z0-9_]*)=(.*)$") :exec line)))
              (unless match (fail "配置文件格式应为 KEY=VALUE"))
              (let ((key (get match 1)) (value (js-call (get match 2) :trim)))
                (unless (or (= key "DEEPSEEK_API_KEY") (js-call key :startsWith "TIBO_")) (fail "配置文件包含不支持的变量"))
                (when (and (>= (get value :length) 2)
                           (or (and (js-call value :startsWith "\"") (js-call value :endsWith "\""))
                               (and (js-call value :startsWith "'") (js-call value :endsWith "'"))))
                  (setq value (js-call value :slice 1 -1)))
                (put values key value)))))))
      values))
  (defasync load-config ()
    (try
      (let ((values (parse-config (await (readFile (config-path) "utf8")))) (env (get process :env)))
        (js-call (Object/keys values) :forEach (lambda (key)
          (when (nullish? (get env key)) (put env key (get values key))))) t)
      (catch error (if (= (get error :code) "ENOENT") false (fail "本地配置不可读或格式错误")))))
  (export config-path parse-config load-config))
