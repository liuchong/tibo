(module tibo.platform.time
  (import "node:process" :default process)
  (import "./host.eli" Intl Date Map Number)
  (import "./util.eli" ms fail)
  (defconst formatters (new Map))
  (defun valid-zone (zone)
    (try (new Intl/DateTimeFormat "en-CA" (js-object :timeZone zone)) zone
      (catch error (fail "时区配置无效，请使用 IANA 时区名称"))))
  (defun time-settings ()
    (let* ((env (get process :env)) (base (valid-zone (or (get env :TIBO_TIMEZONE) "UTC"))))
      (js-object :displayZone base :forecastZone (valid-zone (or (get env :TIBO_FORECAST_TIMEZONE) base))
        :scheduleZone (valid-zone (or (get env :TIBO_SCHEDULE_TIMEZONE) base)))))
  (defun local-vector (at &optional zone)
    (setq zone (or zone (get (time-settings) :displayZone)))
    (let* ((epoch (if (= (value-type at) "number") at (ms at)))
      (formatter (js-call formatters :get zone)) (parts (js-object)))
      (unless formatter
        (setq formatter (new Intl/DateTimeFormat "en-CA" (js-object :timeZone (valid-zone zone)
          :year "numeric" :month "2-digit" :day "2-digit" :hour "2-digit" :minute "2-digit" :hourCycle "h23")))
        (when (> (get formatters :size) 32) (js-call formatters :clear))
        (js-call formatters :set zone formatter))
      (js-call (js-call formatter :formatToParts (new Date epoch)) :forEach (lambda (part)
        (put parts (get part :type) (get part :value))))
      (let* ((date (str (get parts :year) "-" (get parts :month) "-" (get parts :day)))
        (day (Number (get parts :day))) (hour (% (Number (get parts :hour)) 24)))
        (js-object :epochMs epoch :date date :weekday (js-call (new Date (str date "T12:00:00Z")) :getUTCDay)
          :dayOfMonth day :monthPhase (Math/min 2 (Math/floor (/ (- day 1) 10)))
          :hour hour :minute (Number (get parts :minute)) :hourBucket (Math/floor (/ hour 3))))))
  (defun local-time (at &optional zone)
    (let ((v (local-vector at zone)))
      (str (js-call (get v :date) :slice 5) " " (js-call (str (get v :hour)) :padStart 2 "0") ":"
        (js-call (str (get v :minute)) :padStart 2 "0"))))
  (defun zone-label (zone) (if (= zone "Asia/Shanghai") "北京时间" zone))
  (export time-settings local-vector local-time zone-label))
