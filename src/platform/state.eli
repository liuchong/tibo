(module tibo.platform.state
  (import "./host.eli" RegExp Number)
  (import "node:process" :default process)
  (import "node:fs/promises" mkdir readFile writeFile rename rm)
  (import "node:path" resolve join)
  (import "node:crypto" randomUUID)
  (import "./util.eli" fail json)
  (defun state-root (&optional directory)
    (let ((root (if (= (value-type directory) "string") directory (get (get process :env) :TIBO_STATE_DIR))))
      (resolve (if (and root (> (get root :length) 0)) root ".tibo"))))
  (defun state-file (key &optional directory)
    (unless (js-call (new RegExp "^[a-zA-Z0-9_-]{1,100}$") :test key) (fail "Invalid state key"))
    (join (state-root directory) (str key ".json")))
  (defasync read-state (key &optional directory)
    (try (JSON/parse (await (readFile (state-file key directory) "utf8")))
      (catch error (if (= (get error :code) "ENOENT") nil (fail (str "状态文件不可读：" key))))))
  (defasync write-state (key value &optional directory)
    (await (mkdir (state-root directory) (js-object :recursive t :mode 448)))
    (let* ((path (state-file key directory)) (temp (str path "." (randomUUID) ".tmp")))
      (try
        (await (writeFile temp (json value) (js-object :mode 384)))
        (await (rename temp path))
        (finally (await (rm temp (js-object :force t)))))))
  (defasync with-lock (key operation &optional directory)
    (await (mkdir (state-root directory) (js-object :recursive t :mode 448)))
    (let ((lock (str (state-file key directory) ".lock")))
      (try (await (mkdir lock))
        (catch error
          (let ((owner nil) (dead false))
            (try (setq owner (JSON/parse (await (readFile (join lock "owner.json") "utf8")))) (catch error nil))
            (when (and owner (Number/isInteger (get owner :pid)) (> (get owner :pid) 0))
              (try (js-call process :kill (get owner :pid) 0)
                (catch error (when (= (get error :code) "ESRCH") (setq dead t)))))
            (unless dead (fail (str "已有实例运行或无法确认锁的所有者：" key)))
            ;; Atomic rename claims a dead owner's lock; never remove a live lock.
            (let ((stale (str lock ".stale-" (randomUUID))) (recovery (str lock ".recovery")))
              (await (mkdir recovery))
              (try
                (let ((current (JSON/parse (await (readFile (join lock "owner.json") "utf8")))))
                  (unless (= (get current :pid) (get owner :pid)) (fail "锁所有者已变化")))
                (await (rename lock stale)) (await (rm stale (js-object :recursive t)))
                (await (mkdir lock))
                (finally (await (rm recovery (js-object :recursive t)))))))))
      (try
        (await (writeFile (join lock "owner.json") (json (js-object :pid (get process :pid))) (js-object :mode 384)))
        (await (funcall operation))
        (finally (await (rm lock (js-object :recursive t :force t)))))))
  (export state-root read-state write-state with-lock))
