(module tibo.presentation.report
  (import "../platform/privacy.eli" public-text)
  (import "./forecast-evidence.eli" report-evidence report-reasons)
  (import "../platform/util.eli" ms hour-ms)
  (import "../platform/time.eli" time-settings local-time zone-label)
  (import "../forecast/card.eli" card-advice)
  (defun render-report (result &optional previous title-time horizon)
    (let* ((snapshot (get result :snapshot)) (now (get snapshot :now)) (prob (get result :forecast))
      (global (get (get result :signals) :lastGlobal)) (available (not (= (get prob :available) false)))
      (zone (get (time-settings) :displayZone))
      (rows (report-evidence result))
      (lines (js-array (str "**Codex 重置预测｜" (zone-label zone) " " (local-time (or title-time now) zone) "**") "" "**概率**" "")))
      (unless (= horizon "48") (js-call lines :push (str "• 24h：" (get prob :p24) "%")))
      (unless (= horizon "24") (js-call lines :push (str "• 48h：" (get prob :p48) "%（含24h）")))
      (js-call lines :push (str "• 上次重置：" (if (and global (get global :verified) (not (get global :observed)))
        (str (zone-label zone) " " (local-time (get global :at) zone) "，距今 " (js-call (/ (- (ms now) (ms (get global :at))) hour-ms) :toFixed 1) " 小时") "未核实")))
      (js-call lines :push (str "• 重置卡：" (get (card-advice prob) :text)))
      (js-call lines :push "" "**参考消息**" "")
      (if (= (get rows :length) 0) (js-call lines :push "• 未见可用的相关原始消息。")
        (js-call rows :forEach (lambda (row)
          (js-call lines :push (str "• " (str (zone-label zone) " " (local-time (get row :at) zone)) "｜" (get row :author) "：" (get row :summary)
            "｜[原始来源](" (get row :url) ")")))))
      (js-call lines :push "" "**判断理由**" "")
      (js-call (report-reasons result rows) :forEach (lambda (reason) (js-call lines :push (str "• " reason))))
      (public-text (js-call lines :join "\n"))))
  (export render-report))
