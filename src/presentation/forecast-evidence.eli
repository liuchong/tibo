(module tibo.presentation.forecast-evidence
  (import "../platform/host.eli" RegExp)
  (import "../platform/privacy.eli" public-text source-free-text)
  (import "../evidence/research.eli" documents-from)
  (import "../evidence/public-posts.eli" post-address)
  (import "../evidence/reset-text.eli" completed? conditional-reset?)
  (import "../platform/util.eli" ms recent canonical-text matches)
  (defun short-quote (text)
    (let ((plain (canonical-text (public-text text))))
      (setq plain (js-call plain :replaceAll (new RegExp "https?://\\S+" "g") ""))
      (str "“" (js-call plain :slice 0 95) (if (> (get plain :length) 95) "…" "") "”")))
  (defun tibo-summary (text kind)
    (cond ((= kind "completed") "宣布本次重置已处理。")
      ((= kind "programme") "未来每日交付明显改进或完整重置，未指定下一次重置日期。")
      ((= kind "conditional") "提出改进或重置的条件计划，没有保证某天重置。")
      ((= kind "promise") (str "预告重置：" (short-quote text)))
      ((= kind "compensation") (str "涉及额度补救：" (short-quote text)))
      ((= kind "banked") (str "涉及手动额度卡：" (short-quote text)))
      ((= kind "hint") (str "表达重置意向：" (short-quote text)))
      ((= kind "progress") (cond ((and (matches "won.t unship" text) (matches "see you tomorrow for day" text)) "确认改进保留，并预告后续计划进展。")
        ((matches "won.t unship" text) "确认保留本次改进。") (t "预告下一日的计划进展，未承诺重置。")))
      (t (short-quote text))))
  (defun tibo-row (post now kind priority)
    (when (and post (= (get post :author) "thsottiaux") (matches "^[0-9]{16,20}$" (get post :id ""))
      (js-call (js-array "primary" "archive") :includes (get post :provenance))
      (try (<= (ms (get post :at)) (ms now)) (catch error false)) (> (get (get post :text "") :length) 0))
      (js-object :id (get post :id) :at (get post :at) :author "Tibo" :text (get post :text) :kind kind :priority priority
        :url (str "https://x.com/thsottiaux/status/" (get post :id)) :summary (tibo-summary (get post :text) kind))))
  (defun document-row (doc now global)
    (let* ((type (get doc :type)) (url (get doc :url "")) (text (get doc :text ""))
      (active (and (= type "incident") (js-call (js-array "investigating" "identified" "monitoring") :includes (get doc :status))))
      (address (when (= type "post") (post-address url))))
      (when (and (get doc :at) (try (recent (get doc :at) now 48) (catch error false))
        (= (source-free-text text) text) (= (public-text url) url)
        (matches "codex" text) (matches "reset|usage|quota|rate.?limit|compensat|outage|incident|error|restor|degrad" text)
        (or active (not global) (> (ms (get doc :at)) (ms (get global :at))))
        (or (and (= type "incident") (= (get doc :provenance) "official-status")
              (matches "^https://status\\.openai\\.com/incidents/[A-Za-z0-9_-]+$" url))
            (and (= type "release") (= (get doc :provenance) "official-release")
              (matches "^https://(?:www\\.)?openai\\.com/[A-Za-z0-9/_-]+/?$" url))
            (and address (= (get doc :provenance) "official-post") (= (get doc :author) (get address :author)))))
        (js-object :id (get doc :id) :at (get doc :at) :text text :url url
          :author (if address (str "@" (get address :author)) "OpenAI")
          :kind (if active "active-incident" "background") :priority 50
          :summary (str (cond ((= type "incident") (if active "Codex 服务事故仍在处理中：" "Codex 服务恢复公告："))
              ((= type "release") "Codex 额度相关发布：") (t "相关原帖：")) (short-quote text))))))
  (defun report-evidence (result)
    (let* ((snapshot (get result :snapshot)) (now (get snapshot :now)) (signals (get result :signals))
      (global (get signals :lastGlobal)) (programme (get signals :programme)) (promise (get signals :promise))
      (posts (get snapshot :posts)) (rows (js-array)) (used (js-array)) (ids (js-array))
      (links (get (get (get (get (get result :ai (js-object)) :features (js-object)) :research (js-object)) :value (js-object)) :links (js-array))))
      (js-call posts :forEach (lambda (post)
        (let* ((id (get post :id)) (after (or (not global) (> (ms (get post :at)) (ms (get global :at)))))
          (current (recent (get post :at) now 48)) (kind nil) (priority 70))
          (cond ((and global (= id (get global :id)) (get global :verified) (not (get global :observed)) (not (get post :truncated))) (setq kind "completed" priority 120))
            ((and promise (= id (get promise :postId)) (not (get promise :fulfilled)))
              (setq kind (if (= (get promise :kind) "banked") "banked" "promise") priority 130))
            ((and programme (= id (get programme :postId))) (setq kind "programme" priority 100))
            ((and current after (get signals :compensation) (= id (get (get signals :compensation) :postId))) (setq kind "compensation" priority 110))
            ((and current after (js-call (get signals :hints (js-array)) :some (lambda (hint) (= id (get hint :postId)))))
              (setq kind (cond ((matches "banked|reset card" (get post :text)) "banked")
                ((conditional-reset? (get post :text)) "conditional") (t "hint")) priority 110))
            ((and current after (not (get post :truncated)) (matches "reset|(?:codex.*(?:usage|quota|limit|outage|incident|error|compensat))" (get post :text))
              (not (completed? (get post :text)))) (setq kind "related"))
            ((and current after programme (matches "won.t unship|see you tomorrow for day" (get post :text))) (setq kind "progress" priority 80)))
          (when kind (let ((row (tibo-row post now kind priority))) (when row (js-call rows :push row)))))))
      (when (and global (get global :verified) (not (get global :observed)) (not (js-call rows :some (lambda (r) (= (get r :id) (get global :id))))))
        (let ((row (tibo-row (Object/assign (js-object :author "thsottiaux") global) now "completed" 120)))
          (when row (js-call rows :push row))))
      (let ((documents (js-call (documents-from snapshot) :concat (get (get result :ai (js-object)) :documents (js-array)))))
        (js-call documents :forEach (lambda (doc) (let ((row (document-row doc now global))) (when row (js-call rows :push row))))))
      (setq rows (js-call rows :sort (lambda (a b)
        (if (= (get a :priority) (get b :priority)) (- (ms (get b :at)) (ms (get a :at))) (- (get b :priority) (get a :priority))))))
      (setq rows (js-call rows :filter (lambda (row)
        (if (or (js-call used :includes (get row :url))
            (js-call links :some (lambda (link) (and (= (get link :relation) "same-event")
              (or (and (= (get link :fromId) (get row :id)) (js-call ids :includes (get link :toId)))
                  (and (= (get link :toId) (get row :id)) (js-call ids :includes (get link :fromId)))))))) false
          (progn (js-call used :push (get row :url)) (js-call ids :push (get row :id)) t)))))
      (let* ((primary (js-call rows :filter (lambda (r) (= (get r :author) "Tibo"))))
        (extra (js-call rows :filter (lambda (r) (not (= (get r :author) "Tibo"))))))
        (if (> (get extra :length) 0) (js-call (js-call primary :slice 0 3) :concat (js-call extra :slice 0 (- 4 (Math/min 3 (get primary :length)))))
          (js-call primary :slice 0 4)))))
  (defun report-reasons (result rows)
    (let* ((signals (get result :signals)) (prob (get result :forecast)) (global (get signals :lastGlobal))
      (kinds (js-call rows :map (lambda (r) (get r :kind)))) (reasons (js-array))
      (promise (get signals :promise)) (programme (get signals :programme)))
      (cond ((and promise (js-call kinds :includes "promise") (< (ms (get promise :targetAt)) (ms (get (get result :snapshot) :now))))
          (js-call reasons :push "此前预告时间已过，尚未见对应完成公告，不能视为新的按时承诺。"))
        ((and promise (not (get promise :fulfilled)) (js-call kinds :includes "promise"))
          (js-call reasons :push "已有带时间的重置预告；实际落地仍需完成公告确认。"))
        ((js-call kinds :includes "compensation") (js-call reasons :push "出现额度补救线索，但尚不能确认会以全局重置兑现。"))
        ((js-call kinds :includes "conditional") (js-call reasons :push "出现改进或重置的条件计划，仍有重置机会，但没有指定日期。"))
        ((js-call kinds :includes "hint") (js-call reasons :push "Tibo 表达重置意向，但没有承诺具体时间。"))
        ((and programme (js-call kinds :includes "programme")) (js-call reasons :push "每日改进或重置计划仍在进行，后续仍有机会，但未指定下一次重置日期。"))
        ((js-call kinds :includes "active-incident") (js-call reasons :push "官方确认 Codex 服务事故仍在处理中，尚未确认重置补偿。"))
        ((js-call kinds :includes "banked") (js-call reasons :push "近期出现手动额度卡消息，不能视为下一次全局重置预告。")))
      (cond ((= (get prob :available) false) (js-call reasons :push "数值判断所需的历史依据不足，暂不估计重置概率。"))
        ((and global (not (get global :verified))) (js-call reasons :push "上次重置的完成原文尚未确认，当前判断的不确定性较大。"))
        ((get (get result :cycle) :justReset)
          (js-call reasons :push (if (js-call kinds :includes "promise") "刚完成一次重置；新的预告仍需核实具体对象与兑现情况。"
            "刚完成一次重置，之前的线索已兑现；本次未见新的明确重置承诺。")))
        ((js-call kinds :includes "promise") (js-call reasons :push "预告不等于已完成，仍须留意是否延期或改变交付方式。"))
        (t (js-call reasons :push "本次未见新的明确重置承诺，暂缺能明显提高近期预期的证据。")))
      (let* ((ai (get result :ai (js-object)))
        (proposal (get (get (get ai :features (js-object)) :forecast (js-object)) :value (js-object)))
        (reason (canonical-text (get proposal :reason "")))
        (refs (get proposal :citations (js-array))))
        (when (and (= (get prob :mode) "ai-blend") (> (get ai :weight 0) 0)
          (> (get reason :length) 0) (<= (get reason :length) 100) (= (public-text reason) reason)
          (not (matches "算法|模型|权重|基线|token|API|采集|搜索|概率.*%|[\\r\\n]" reason))
          (> (get refs :length) 0) (js-call refs :every (lambda (ref)
            (js-call rows :some (lambda (row) (= (get row :id) (get ref :postId)))))))
          (put reasons 0 reason)))
      (js-call reasons :slice 0 2)))
  (export report-evidence report-reasons))
