(module tibo.presentation.business
  (import "../platform/host.eli" RegExp)
  (import "./report.eli" render-report)
  (import "../platform/util.eli" utc)
  (defun event-text (event)
    (if (not event) "未见可用记录"
      (str (utc (get event :at)) "｜" (if (get event :global) "global" "banked") "｜"
        (if (get event :verified) (if (= (get event :provenance) "primary") "已核实完成公告" "存档完成公告，全文未由官方接口核实") (if (get event :verifiedBanked) "已核实发卡原文" "存档记录，未逐条核实"))
        (if (get event :text) (str "｜" (get event :text)) ""))))
  (defun post-text (post)
    (str (utc (get post :at)) "｜" (if (= (get post :provenance) "primary") "原文已核实" "存档原文") "\n"
      (get post :text) (if (get post :truncated) "\n[来源正文已截断，完整内容请查看原帖]" "")
      "\n" (if (js-call (new RegExp "^[0-9]{15,20}$") :test (get post :id)) (str "https://x.com/thsottiaux/status/" (get post :id)) "")))
  (defun public-forecast (result horizon &optional title-time)
    (render-report result nil title-time horizon))
  (export event-text post-text public-forecast))
