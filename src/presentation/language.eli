(module tibo.presentation.language
  (import "../platform/host.eli" Intl)
  (import "../platform/util.eli" matches)
  (defconst language-names (new Intl/DisplayNames (js-array "en") (js-object :type "language" :fallback "none")))
  (defun language (value)
    (when (= (value-type value) "string")
      (let ((s (js-call value :toLowerCase)))
        (cond ((js-call (js-array "zh" "cn" "zh-cn" "zh-hans" "chinese" "mandarin" "中文" "汉语" "汉文" "国语" "普通话" "简体中文") :includes s) "zh")
              ((js-call (js-array "zh-tw" "zh-hant" "繁體中文" "繁体中文") :includes s) "zh-TW")
              ((js-call (js-array "en" "english" "英语" "英文") :includes s) "en")
              (t (when (and (<= (get s :length) 35)
                (matches "^[a-z]{2,3}(?:-[a-z]{4})?(?:-(?:[a-z]{2}|[0-9]{3}))?$" s))
                (try
                  (let* ((tag (get (Intl/getCanonicalLocales s) 0)) (base (get (js-call tag :split "-") 0)))
                    (when (and (not (js-call (js-array "und" "mul" "zxx") :includes base))
                      (js-call language-names :of tag)) tag))
                  (catch error nil))))))))
  (defun detect-language (text)
    ;; Only the message is evidence. Never inspect locale, TZ, OS or actor identity.
    (cond ((matches "[ぁ-ゖァ-ヺ]" text) "ja") ((matches "[가-힣]" text) "ko")
          ((matches "[一-鿿]" text) "zh") ((matches "[А-Яа-яЁё]" text) "ru") ((matches "[؀-ۿ]" text) "ar")
          ((matches "\\b(bonjour|merci|pouvez|français)\\b" text) "fr")
          ((matches "\\b(hola|puedes|español|últimos)\\b" text) "es")
          ((matches "\\b(bitte|kannst|deutsch)\\b" text) "de") (t "en")))
  (defun notice (lang kind)
    (let ((localized (get (js-object
      :ja (js-array "AI処理を一時的に利用できません。元の結果を保持しています。" "未対応のパイプまたは引数です。helpをご確認ください。" "管理操作にパイプは使えません。固定コマンドを単独で送信してください。" "自然言語の問い合わせを一時的に利用できません。固定コマンドかhelpをご利用ください。")
      :ko (js-array "AI 처리를 일시적으로 사용할 수 없습니다. 원본 결과를 유지했습니다." "지원하지 않는 파이프 또는 매개변수입니다. help를 확인하세요." "관리 작업에는 파이프를 사용할 수 없습니다. 고정 명령을 따로 보내세요." "자연어 질의를 일시적으로 사용할 수 없습니다. 고정 명령 또는 help를 사용하세요.")
      :fr (js-array "Le traitement IA est temporairement indisponible. Le résultat original est conservé." "Pipeline ou paramètres non pris en charge. Consultez help." "Les opérations administratives ne peuvent pas être traitées par pipeline. Envoyez une commande explicite séparément." "Les requêtes en langage naturel sont temporairement indisponibles. Utilisez une commande fixe ou help.")
      :es (js-array "El procesamiento de IA no está disponible temporalmente. Se conserva el resultado original." "Pipeline o parámetros no admitidos. Consulta help." "Las operaciones administrativas no admiten pipelines. Envía el comando por separado." "Las consultas en lenguaje natural no están disponibles temporalmente. Usa un comando fijo o help.")
      :de (js-array "Die KI-Verarbeitung ist vorübergehend nicht verfügbar. Das ursprüngliche Ergebnis bleibt erhalten." "Nicht unterstützte Pipeline oder Parameter. Bitte help verwenden." "Administrative Schreibaktionen erlauben keine Pipeline. Bitte den Befehl separat senden." "Natürlichsprachige Anfragen sind vorübergehend nicht verfügbar. Bitte einen festen Befehl oder help verwenden.")
      :pt (js-array "O processamento de IA está temporariamente indisponível. O resultado original foi preservado." "Pipeline ou parâmetros não suportados. Consulte help." "Operações administrativas não aceitam pipelines. Envie o comando separadamente." "Consultas em linguagem natural estão temporariamente indisponíveis. Use um comando fixo ou help.")
      :ru (js-array "Обработка ИИ временно недоступна. Исходный результат сохранён." "Неподдерживаемый конвейер или параметры. Используйте help." "Административные операции не поддерживают конвейеры. Отправьте отдельную команду." "Запросы на естественном языке временно недоступны. Используйте фиксированную команду или help.")
      :ar (js-array "معالجة الذكاء الاصطناعي غير متاحة مؤقتًا. تم الاحتفاظ بالنتيجة الأصلية." "مسار معالجة أو معاملات غير مدعومة. راجع help." "لا تدعم العمليات الإدارية مسارات المعالجة. أرسل الأمر منفردًا." "الاستعلامات باللغة الطبيعية غير متاحة مؤقتًا. استخدم أمرًا ثابتًا أو help.")
      :zh-TW (js-array "AI處理暫時出了問題，已保留原始結果。" "不支援此管道或參數，請查看幫助。" "管理員寫操作不支援AI管道，請單獨傳送固定指令。" "語意查詢暫時出了問題，請使用固定指令或幫助。")) lang)))
    (if localized (get localized (cond ((= kind "ai") 0) ((= kind "unsupported") 1) ((= kind "write") 2) (t 3)))
    (if (= lang "zh")
      (cond ((= kind "ai") "AI处理暂时出了问题，已保留原始结果。") ((= kind "unsupported") "不支持此管道或参数，请查看帮助。")
            ((= kind "write") "管理员写操作不支持AI管道，请单独发送固定指令。") ((= kind "answer") "AI问答暂时不可用，请使用固定查询或帮助。") (t "语义查询暂时出了问题，请使用固定指令或帮助。"))
      (cond ((= kind "ai") "AI processing is temporarily unavailable; the original result is preserved.")
            ((= kind "unsupported") "Unsupported pipeline or parameters. Please check help.")
            ((= kind "write") "Administrator writes cannot be piped. Send an explicit command separately.")
            ((= kind "answer") "AI answers are temporarily unavailable. Please use a fixed query or help.")
            (t "Semantic queries are temporarily unavailable. Please use a fixed command or help."))))))
  (export language detect-language notice))
