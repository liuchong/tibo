(module tibo.presentation.pipeline
  (import "../platform/host.eli" Date RegExp)
  (import "../ai/repair.eli" repair-input)
  (import "../platform/privacy.eli" public-text)
  (import "../platform/util.eli" fail)
  (import "./language.eli" language detect-language notice)
  (import "./syntax.eli" pipe-catalog validate-stages)
  (import "./text.eli" translate-text answer-text)
  (defun english-posts (text)
    ;; The source bodies are already English. Only localize the fixed UI labels.
    (setq text (js-call text :replace (new RegExp "^\\*\\*Tibo X 发言\\*\\*" "m") "**Tibo X posts**"))
    (setq text (js-call text :replace (new RegExp "^(UTC [^\\n]+)｜原文已核实$" "gm") "$1 | Original verified"))
    (setq text (js-call text :replace (new RegExp "^(UTC [^\\n]+)｜存档原文$" "gm") "$1 | Archived original"))
    (setq text (js-call text :replace (new RegExp "^\\[来源正文已截断，完整内容请查看原帖\\]$" "gm") "[Source text is truncated; see the original post for full content]"))
    (setq text (js-call text :replace (new RegExp "^此范围的公开记录中未见匹配发言。$" "gm") "No matching posts in the available public records for this range."))
    (js-call text :replace (new RegExp "^公开来源可能漏帖；存档内容不等于实时核实。$" "gm") "Public sources may miss posts; archived content is not real-time verification."))
  (defasync present (response query options capabilities)
    (let* ((original (public-text (get response :text))) (text original) (stages (get query :pipeline (js-array)))
      (semantic (get query :semantic false)) (lang (or (language (get query :language)) (language (get options :messageLanguage)) (detect-language (get query :question ""))))
      (deadline (+ (Date/now) 30000)) (failed false)
      (english-original (and (= lang "en") (= (get query :command) "posts") (Array/isArray (get response :sourceLanguages))
        (js-call (get response :sourceLanguages) :every (lambda (l) (= l "en")))))
      (no-ai (or (get options :noAi) (get (get query :args (js-object)) :noAi))))
      (put response :originalText original)
      ;; Explicit pipelines decide their output. Automatic bilingual rendering is
      ;; only for successful semantic queries, and never for write acknowledgments.
      (when (and semantic (get response :ok) (= (get stages :length) 0) (not (= (get query :command) "ask"))
        (or (= (get query :command) "posts") (not (= (detect-language original) lang))))
        (if english-original (setq text (english-posts original))
        (let ((translated (if no-ai nil (await (translate-text original lang)))))
          (if (and translated (get translated :value))
            (setq text (if (= (get query :command) "posts")
              (str (get (get translated :value) :text) "\n\n**" (if (= lang "zh") "原文" "Original") "**\n" original)
              (get (get translated :value) :text))) (setq failed t)))))
      (let ((i 0))
        (while (and (get response :ok) (not failed) (< i (get stages :length)))
          (let* ((stage (get stages i)) (name (get stage :name)) (remaining (- deadline (Date/now))))
            (when (= name "pending")
              (let* ((fragment (get stage :fragment)) (known (get (js-call fragment :split (new RegExp "\\s+")) 0))
                (known-spec (js-call pipe-catalog :find (lambda (s) (= (get s :name) known))))
                (repaired (await (repair-input fragment lang (if known-spec (js-array known-spec) pipe-catalog)
                  (lambda (s)
                    (validate-stages (js-array s))
                    (when (and known-spec (not (= (get s :name) known))) (fail "repair-changed-command")) s)
                  (Object/assign (js-object) options (js-object :noAi no-ai)) (if known-spec known nil) remaining))))
                (if repaired (setq stage repaired name (get repaired :name) remaining (- deadline (Date/now))) (setq failed t))))
            (unless failed
            (if (= name "original") (setq text original)
              (let* ((target (if (= name "translate") (language (get stage :language)) (detect-language (get stage :instruction))))
                (out (if (or no-ai (< remaining 500)) nil
                  (if (= name "translate") (await (translate-text text target (Math/min 15000 remaining)))
                    (await (answer-text (get stage :instruction) text target capabilities (Math/min 15000 remaining) (get options :context)))))))
                (setq lang target)
                (if (and out (get out :value)) (setq text (get (get out :value) :text)) (setq failed t))))))
          (setq i (+ i 1))))
      (when (> (get text :length) 15000) (setq text original failed t))
      (when failed (setq text (str text "\n\n" (notice lang "ai"))))
      (put response :text (public-text text)) (put response :partial failed) response))
  (export present))
