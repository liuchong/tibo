(module tibo.presentation.syntax
  (import "../platform/host.eli" RegExp)
  (import "../platform/privacy.eli" public-text source-free-text private-question?)
  (import "../platform/util.eli" fail matches)
  (import "./language.eli" language)
  (defconst pipe-catalog (js-array
    (js-object :name "translate" :params "language" :languages (js-object :format "BCP47" :examples (js-array "zh" "en" "ja" "de" "ko" "mn" "mn-Mong" "bo" "hi" "sw") :scope "Recognized languages with optional script/region; examples are not a whitelist") :purpose "Translate the preceding result; preserve facts, numbers, UTC times and links")
    (js-object :name "ask" :params "instruction" :purpose "One bounded AI request about preceding text: explain, summarize, translate or answer; no tools or writes")
    (js-object :name "original" :params "none" :purpose "Restore original command output without AI")))
  (defun validate-stages (stages &optional deferred)
    (unless (and (Array/isArray stages) (<= (get stages :length) 3)) (fail "pipeline-count"))
    (js-call stages :forEach (lambda (s)
      (unless (and s (= (value-type s) "object") (not (Array/isArray s))) (fail "pipeline-schema"))
      (let ((name (get s :name)))
        (cond ((and deferred (= name "pending"))
          (unless (and (= (get (Object/keys s) :length) 2) (= (value-type (get s :fragment)) "string")
            (> (get (get s :fragment) :length) 0) (<= (get (get s :fragment) :length) 800)
            (not (private-question? (get s :fragment))) (= (public-text (get s :fragment) 800) (source-free-text (get s :fragment)))) (fail "pipeline-schema")))
          ((= name "original") (unless (= (get (Object/keys s) :length) 1) (fail "original-args")))
          ((= name "translate") (unless (and (= (get (Object/keys s) :length) 2) (Object/hasOwn s "language") (language (get s :language))) (fail "translation-language")))
          ((= name "ask") (unless (and (= (get (Object/keys s) :length) 2) (Object/hasOwn s "instruction")
            (= (value-type (get s :instruction)) "string") (> (get (get s :instruction) :length) 0) (<= (get (get s :instruction) :length) 800)
            (not (private-question? (get s :instruction))) (= (public-text (get s :instruction) 800) (source-free-text (get s :instruction)))) (fail "ask-args")))
          (t (fail "unknown-pipe")))))) stages)
  (defun parse-stage (p)
    (let* ((m (js-call (new RegExp "^(\\S+)(?:\\s+([\\s\\S]*))?$") :exec p)) (name (get m 1)) (arg (get m 2 "")))
      (cond ((= name "original") (unless (= arg "") (fail "original-args")) (js-object :name name))
        ((= name "translate") (unless (language arg) (fail "translation-language")) (js-object :name name :language (language arg)))
        ((= name "ask") (unless (and (> (get arg :length) 0) (<= (get arg :length) 800) (not (private-question? arg))) (fail "ask-args"))
          (js-object :name name :instruction (public-text arg 800)))
        (t (fail "unknown-pipe")))))
  (defun parse-pipeline (text &optional deferred)
    (unless (and (= (value-type text) "string") (<= (get text :length) 2400)) (fail "pipeline-size"))
    (let ((parts (js-array)) (part "") (quote "") (escape false) (i 0))
      (while (< i (get text :length))
        (let ((c (get text i)))
          (cond (escape (setq part (str part c) escape false))
                ((= c "\\") (setq part (str part c) escape t))
                ((not (= quote "")) (setq part (str part c)) (when (= quote c) (setq quote "")))
                ((and (or (= c "\"") (= c "'"))
                  (or (= i 0) (matches "\\s|\\|" (get text (- i 1))))) (setq quote c part (str part c)))
                ((= c "|") (js-call parts :push (js-call part :trim)) (setq part ""))
                (t (setq part (str part c)))))
        (setq i (+ i 1)))
      (unless (= quote "") (fail "pipeline-quotes"))
      (js-call parts :push (js-call part :trim))
      (unless (and (<= (get parts :length) 4) (js-call parts :every (lambda (p) (> (get p :length) 0)))) (fail "pipeline-count"))
      (js-object :base (get parts 0) :stages (js-call (js-call parts :slice 1) :map (lambda (p)
        (try (parse-stage p)
          (catch error
            (unless (and deferred (<= (get p :length) 800) (not (private-question? p)) (= (public-text p 800) (source-free-text p))) (throw error))
            (js-object :name "pending" :fragment p))))))))
  (export pipe-catalog validate-stages parse-pipeline))
