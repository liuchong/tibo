(module tibo.privacy
  (import "node:process" :default process)
  (import "node:os" homedir hostname userInfo)
  (import "./host.eli" RegExp)
  (defun public-text (input &optional limit)
    (let ((text (str (or input ""))) (env (get process :env)))
      (js-call (js-array "DEEPSEEK_API_KEY" "TIBO_LARK_APP_ID" "TIBO_LARK_APP_SECRET" "TIBO_LARK_BOT_OPEN_ID" "TIBO_LARK_CHAT_IDS" "TIBO_LARK_ADMIN_OPEN_IDS" "TIBO_STATE_DIR" "TIBO_CONFIG_FILE" "USER" "LOGNAME")
        :forEach (lambda (key)
          (let ((value (get env key)))
            (when (and value (> (get value :length) 1))
              (js-call (js-call value :split ",") :forEach (lambda (part)
                (when (> (get part :length) 1) (setq text (js-call text :replaceAll part "[已隐藏]")))))))))
      (js-call (js-array (homedir) (js-call process :cwd) (hostname) (get (userInfo) :username)) :forEach (lambda (value)
        (when (> (get value :length) 1) (setq text (js-call text :replaceAll value "[已隐藏]")))))
      (setq text (js-call text :replace (new RegExp "sk-[A-Za-z0-9_-]{8,}|Bearer\\s+[A-Za-z0-9._-]{8,}|(?:oc|ou|cli)_[A-Za-z0-9]{6,}" "gi") "[已隐藏]"))
      (setq text (js-call text :replace (new RegExp "(?:/Users/|/home/|/etc/|/var/|/tmp/|~/)[^\\s\"'<>，；。]*|[A-Z]:\\\\[^\\s\"'<>，；。]+" "g") "[已隐藏]"))
      (setq text (js-call text :replace (new RegExp "deepseek(?:[-/][A-Za-z0-9.-]+)?|api\\.deepseek\\.com|(?:[0-9]{1,3}\\.){3}[0-9]{1,3}" "gi") "[已隐藏]"))
      (js-call text :slice 0 (or limit 16000))))
  (defun private-question? (text)
    (js-call (new RegExp "(?:api.?key|密钥|密码|token|用户名|主机|服务器|运行环境|配置文件|安装目录|工作目录|系统提示|提示词|模型名称|模型名|哪个模型|什么模型|用的模型|deepseek|hostname|environment|system prompt|daemon|service|/Users/|/home/|/etc/|sk-[A-Za-z0-9_-]{8,})" "i") :test text))
  (export public-text private-question?))
