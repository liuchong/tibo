(module tibo.availability
  (import "./models.eli" eligible)
  (import "./research.eli" documents-from)
  (import "./util.eli" ms hour-ms)
  (defun information (snapshot signals history)
    (let* ((sources (get snapshot :sources)) (posts (get snapshot :posts))
      (current (js-call posts :filter (lambda (p) (and (<= (ms (get p :at)) (ms (get snapshot :now)))
        (>= (ms (get p :at)) (- (ms (get snapshot :now)) (* 48 hour-ms)))))))
      (documents (documents-from snapshot))
      (primary (js-call current :filter (lambda (p) (= (get p :provenance) "primary"))))
      (archive (js-call sources :find (lambda (s) (= (get s :name) "archive"))))
      (global (get signals :lastGlobal)) (missing (js-array)))
      (js-call (js-array (js-array "status" "官方事故资料") (js-array "news" "官方发布资料")) :forEach (lambda (pair)
        (unless (js-call sources :some (lambda (s) (and (= (get s :name) (get pair 0)) (get s :ok))))
          (js-call missing :push (get pair 1)))))
      (unless (> (get primary :length) 0) (js-call missing :push "近48h已核实原帖"))
      (unless (and archive (get archive :ok)) (js-call missing :push "实时历史发现源"))
      (js-object :history (cond ((not history) "不足") ((and archive (get archive :ok)) "实时采集") (t "本地或快照历史"))
        :clockReliable (not (not (and global (get global :verified) (not (get global :observed)))))
        :primaryPosts (get primary :length) :archivePosts (- (get current :length) (get primary :length))
        :officialDocuments (get documents :length)
        :activeIncident (js-call documents :some (lambda (d) (and (= (get d :type) "incident") (not (= (get d :status) "resolved")))))
        :recentRelease (js-call documents :some (lambda (d) (= (get d :type) "release"))) :missing missing
        :historyFresh (not (not (and archive (get archive :ok)))) :experienceUnavailable (get snapshot :experienceUnavailable false)
        :usableIntervals (if history (get (eligible (get history :intervals)) :length) 0)
        :sourceFailures (js-call (js-call sources :filter (lambda (s) (not (get s :ok)))) :map (lambda (s) (get s :name))))))
  (defun usage-text (info)
    (str "历史：" (get info :history) "；近48h核实原帖 " (get info :primaryPosts) "条、存档帖 " (get info :archivePosts)
      "条；" (if (get info :clockReliable) "等待时钟有完成原文" "等待时钟未核实，停用条件等待模型")
      (if (> (get (get info :missing) :length) 0) (str "；缺少：" (js-call (get info :missing) :join "、")) "")
      (if (get info :experienceUnavailable) "；预测经验暂不可用，保留历史算法" "")))
  (export information usage-text))
