;; Program-owned prefetch, then one answer. No model tool dispatcher.
(module tibo.capabilities.read
  (import "node:process" :default process)
  (import "../platform/host.eli" Date RegExp Intl)
  (import "../platform/privacy.eli" public-text private-question?)
  (import "../platform/util.eli" iso clean matches)
  (import "../evidence/service-status.eli" service-status)
  (import "../evidence/web-search.eli" search-web)
  (import "./calculate.eli" calculate)
  (defun turn-text (turn)
    (let ((text (get turn :content "")))
      (try (let ((data (JSON/parse text))) (or (get data :question) (get data :text) text))
        (catch error text))))
  (defun requests-for (question thread)
    (let* ((followup (and thread (matches "^(?:你|您|那|再|请|帮我|麻烦)?\\s*(?:查查|查一下|查一查|搜一下|搜索一下|继续查|check(?: it)?|look it up|search(?: it)?)[。.!！?？\\s]*$" question)))
      (history (if followup (js-call (js-call (get thread :messages (js-array)) :slice -6) :map turn-text) (js-array)))
      (topic (if followup (js-call history :join "\n") question))
      (status (and (matches "openai|opanai|open ai|chatgpt|codex" topic)
        (matches "状态|挂了|宕机|故障|恢复|是否可用|正常|outage|status|down|working" topic)
        (or (not (matches "重置|额度|刷新|reset|quota|weekly" topic))
          (matches "\\bapi\\b|挂了|宕机|故障|outage|down" topic))))
      (search (and (not status) (matches "搜索|搜一下|搜一搜|查一下|查查|查一查|最新|新闻|\\bsearch\\b|look up|latest|news" question)))
      (expression (js-call (js-call question :replace (new RegExp "^(?:(?:请|帮我|麻烦)?(?:计算|算一下|算算)|calculate|calc|what is)\\s*[:：]?" "i") "") :replace
        (new RegExp "\\s*(?:等于多少|是多少|=|[?？])\\s*$") ""))
      (math (and (matches "^[\\s0-9.eE()+*/%^\\-]+$" expression) (matches "[+*/%^()-]" expression)))
      (clock (matches "现在几点|当前时间|UTC时间|北京时间|what time|current time" question))
      (query (when search (clean (js-call (if followup topic question) :replace
        (new RegExp "^(?:请|帮我|麻烦|你)?\\s*(?:搜索|搜一下|搜一搜|查一下|查查|查一查|search(?: for)?|look up)\\s*[:：]?" "i") "")))))
      (js-object :status status :searchQuery (when (and query (> (get query :length) 2)) (js-call query :slice 0 180))
        :expression (when math expression) :clock clock)))
  (defun builtin-question? (question)
    (let ((request (requests-for question nil)))
      (not (not (or (get request :status) (get request :expression) (get request :clock)
        (and (get request :searchQuery)
          (matches "^(?:请|帮我|麻烦|你)?\\s*(?:搜索|搜一下|搜一搜|查一下|查查|查一查|search(?: for)?|look up)\\s*[:：]?" question)))))))
  (defun fallback-text (facts lang)
    (let ((parts (js-array)) (zh (= lang "zh")))
      (when (get facts :calculation)
        (let ((c (get facts :calculation)))
          (js-call parts :push (if (= (get c :state) "ok")
            (str (get c :expression) " = " (get c :value))
            (if zh "算式未能计算，请检查括号、运算符和数值范围。" "The expression could not be calculated; check operators, parentheses and numeric range.")))))
      (when (get facts :clock)
        (js-call parts :push (str "UTC: " (get facts :nowUtc) "\n" (if zh "北京时间：" "Beijing time: ") (get facts :beijingTime))))
      (when (get facts :serviceStatus)
        (let ((s (get facts :serviceStatus)))
          (js-call parts :push (if (= (get s :state) "ok")
            (str (if zh "OpenAI 官方状态：" "OpenAI official status: ") (get s :status)
              "\n" (if (get s :incidentsKnown)
                (if (= (get (get s :incidents) :length) 0) (if zh "未见进行中的事故。" "No active incidents reported.") "")
                (if zh "事故列表暂未核实。" "Incident list not verified."))
              "\n" (js-call (js-call (get s :incidents) :map (lambda (i) (str "• " (get i :name) " — " (get i :status)))) :join "\n")
              "\n" (js-call (js-call (js-call (get s :components) :filter (lambda (c) (matches "api|codex|chatgpt|chat completions|responses" (get c :name)))) :map
                (lambda (c) (str "• " (get c :name) " — " (get c :status)))) :join "\n")
              "\n" (if zh "查询时间：" "Checked at: ") (get s :at) "\nhttps://status.openai.com/"
              "\n" (if zh "这是官方服务状态，不代表每个账户或网络都正常。" "Official service status does not establish the health of every account or network."))
            (if zh "官方状态暂未查到，不能确认故障或恢复。https://status.openai.com/" "Official status is unavailable; an outage or recovery is not confirmed. https://status.openai.com/")))))
      (when (get facts :search)
        (let ((s (get facts :search)))
          (js-call parts :push (if (= (get s :state) "ok")
            (str (if zh "搜索结果（摘要，未读取原页）：" "Search results (summaries; original pages not fetched):")
              "\n" (js-call (js-call (get s :results) :map (lambda (r) (str "• [" (get r :title) "](" (get r :url) ")\n" (get r :snippet)))) :join "\n"))
            (if zh "本次搜索暂未取得可用资料，未确认新的事实。" "Search is unavailable; no new facts were confirmed.")))))
      (js-call parts :join "\n\n")))
  (defasync prepare-facts (question lang &optional thread offline)
    (let* ((request (requests-for question thread))
      (facts (js-object)) (private (private-question? question)))
      (when (and (not private) (get request :expression))
        (try (put facts :calculation (js-object :state "ok" :expression (get request :expression) :value (calculate (get request :expression))))
          (catch error (put facts :calculation (js-object :state "invalid")))))
      (when (and (not private) (get request :clock))
        (put facts :clock t) (put facts :nowUtc (iso (Date/now)))
        (put facts :beijingTime (js-call (new Intl/DateTimeFormat "sv-SE" (js-object :timeZone "Asia/Shanghai" :dateStyle "short" :timeStyle "medium")) :format (new Date (Date/now)))))
      (when (and (not private) (get request :status))
        (put facts :request (js-object :kind "service-status" :subject "OpenAI 官方服务状态"))
        (put facts :serviceStatus (if offline (js-object :state "unavailable")
          (Object/fromEntries (js-call (Object/entries (await (service-status))) :filter
            (lambda (row) (not (js-call (js-array "cached" "until") :includes (get row 0)))))))))
      (when (and (not private) (get request :searchQuery))
        (put facts :search (if (or offline (= (get (get process :env) :TIBO_CHAT_SEARCH "1") "0")) (js-object :state "unavailable")
          (try (let ((found (await (search-web (get request :searchQuery)))))
            (js-object :state (get found :state) :query (get found :query) :results (get found :results) :at (get found :at)))
            (catch error (js-object :state "unavailable"))))))
      (js-object :facts facts :text (fallback-text facts lang))))
  (export requests-for builtin-question? prepare-facts fallback-text))
