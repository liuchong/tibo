;; Fixed methods consume validated data, never the phrasing of a question.
(module tibo.capabilities.read
  (import "node:process" :default process)
  (import "../evidence/service-status.eli" service-status service-history)
  (import "../evidence/web-page.eli" read-page read-search)
  (import "./calculate.eli" calculate)
  (import "./general.eli" clock-at date-difference date-add convert-unit)
  (import "../evidence/public-place.eli" place-query)
  (import "./geo.eli" place-distance place-weather)
  (defconst builtin-names (js-array "service-status" "service-history" "search" "read-page" "calculate" "time" "date-diff" "date-add" "convert" "place" "weather" "distance"))
  (defun public-status (s)
    (Object/fromEntries (js-call (Object/entries s) :filter (lambda (row) (not (js-call (js-array "cached" "until") :includes (get row 0)))))))
  (defun render-page-text (page zh)
    (let ((state (get page :state)))
      (str (cond ((= state "ok") (if zh "已读取网页正文" "Page content retrieved"))
        ((= state "partial") (if zh "仅取得部分网页内容" "Partial page content"))
        ((= state "blocked") (if zh "网页访问受限，未取得正文" "Page access blocked; content not retrieved"))
        ((= state "unsupported") (if zh "暂不支持此内容类型" "Unsupported content type"))
        (t (if zh "本次未取得网页正文" "Page content unavailable")))
        (if (> (get (get page :title "") :length) 0) (str "\n**" (get page :title) "**") "")
        (if (get page :fetchedAt) (str "｜" (get page :fetchedAt)) "")
        (if (> (get (get page :text "") :length) 0) (str "\n" (get page :text)) "")
        (if (get page :truncated) (if zh "\n正文较长，仅展示前段。" "\nLong content; the beginning is shown.") "")
        (if (get page :finalUrl) (str "\n" (get page :finalUrl)) ""))))
  (defun render-read (name data lang)
    (let ((zh (= lang "zh")))
      (if (and (not (= (get data :state) "ok")) (not (= name "read-page")))
        (if zh "本次资料或计算暂不可用，未确认结果。" "This data or calculation is unavailable; no result is confirmed.")
        (cond
          ((= name "service-status")
            (str "**OpenAI " (if zh "官方服务状态" "official service status") "**\n" (get data :status)
              "\n" (js-call (js-call (get data :components) :map (lambda (c) (str "• " (get c :name) " — " (get c :status)))) :join "\n")
              "\n" (if (get data :incidentsKnown)
                (if (= (get (get data :incidents) :length) 0) (if zh "未见进行中的事故。" "No active incidents reported.")
                  (js-call (js-call (get data :incidents) :map (lambda (i) (str "• " (get i :name) " — " (get i :status)))) :join "\n"))
                (if zh "事故列表暂未核实。" "Incident list not verified."))
              "\n" (get data :at) "\nhttps://status.openai.com/"))
          ((= name "service-history")
            (str "**OpenAI " (if zh "服务事故历史" "service incident history") "**\n"
              (js-call (js-call (get data :incidents) :map (lambda (i)
                (str "• " (get i :createdAt (get i :updatedAt)) "｜" (get i :name) "｜" (get i :status)
                  "\n" (get i :url) "\n" (js-call (js-call (get i :updates) :map (lambda (u) (str (get u :at) "｜" (get u :status) "｜" (get u :text)))) :join "\n")))) :join "\n\n")
              "\n" (if zh "范围为官方返回的最近一页，可能不覆盖完整历史；本次读取：" "Only the latest official page is covered; checked at: ") (get data :at)))
          ((= name "search") (str (if zh "搜索资料：" "Search evidence:") "\n"
            (js-call (js-call (get data :results) :map (lambda (r)
              (let ((page (js-call (get data :pages (js-array)) :find (lambda (p) (= (get p :url) (get r :url))))))
                (str "• [" (get r :title) "](" (get r :url) ")\n"
                  (if page (render-page-text page zh)
                    (str (if zh "仅搜索摘要/标题：" "Search summary/title only: ") (get r :snippet ""))))))) :join "\n\n")))
          ((= name "read-page") (render-page-text data zh))
          ((= name "calculate") (str (get data :expression) " = " (get data :value)))
          ((= name "time") (str "UTC: " (get data :utc) "\n" (get data :timezone) ": " (get data :local)))
          ((= name "date-diff") (str (get data :from) " → " (get data :to) "\n" (get data :seconds) " s = " (get data :hours) " h = " (get data :days) " d"))
          ((= name "date-add") (str (get data :from) " + " (get data :amount) " " (get data :unit) " → " (get data :utc)
            "\n" (get data :timezone) ": " (get data :local) "｜" (get data :weekday)))
          ((= name "place") (str (js-call (js-call (get data :places) :map (lambda (p)
            (str "• " (get p :name) "｜" (get p :region) "｜" (get p :country) "｜" (get p :latitude) "," (get p :longitude)
              "｜" (get p :timezone) "\n" (get p :sourceUrl "")))) :join "\n") "\nOpen-Meteo / GeoNames｜" (get data :at)))
          ((= name "distance") (str (get (get data :from) :name) " → " (get (get data :to) :name) "：" (get data :kilometers) " km\n" (get data :description)))
          ((= name "weather") (str (get (get data :place) :name) "｜" (get (get data :place) :country "") "｜" (get data :timezone)
            "\n当前温度 " (get (get data :current) :temperature_2m) " °C｜风速 " (get (get data :current) :wind_speed_10m) " km/h"
            "\n" (js-call (js-call (get data :days) :map (lambda (d) (str (get d :date) "｜" (get d :minC) "–" (get d :maxC)
              " °C｜降水概率 " (get d :rainPercent) "%｜WMO天气码 " (get d :code)))) :join "\n")
            "\nOpen-Meteo｜" (get data :at) "\n" (get data :sourceUrl)))
          ((= name "convert") (str (get data :value) " " (get data :from) " = " (get data :result) " " (get data :to)))))))
  (defasync run-read (query lang &optional offline)
    (let* ((name (get query :command)) (a (get query :args)) (data nil))
      (try
        (setq data (cond
          ((= name "service-status") (if offline (js-object :state "unavailable") (public-status (await (service-status)))))
          ((= name "service-history") (if offline (js-object :state "unavailable") (await (service-history (get a :limit) (get a :days) (get a :component)))))
          ((= name "search") (if (or offline (= (get (get process :env) :TIBO_CHAT_SEARCH "1") "0")) (js-object :state "unavailable")
            (await (read-search (get a :query) (get a :read)))))
          ((= name "read-page") (if offline (js-object :state "unavailable" :url (get a :url) :text "") (await (read-page (get a :url)))))
          ((= name "calculate") (js-object :state "ok" :expression (get a :expression) :value (calculate (get a :expression))))
          ((= name "time") (Object/assign (js-object :state "ok") (clock-at (get a :timezone) (get a :at))))
          ((= name "date-diff") (Object/assign (js-object :state "ok") (date-difference (get a :from) (get a :to))))
          ((= name "date-add") (Object/assign (js-object :state "ok") (date-add (get a :from) (get a :amount) (get a :unit) (get a :timezone))))
          ((= name "place") (if offline (js-object :state "unavailable") (await (place-query (get a :query) (get a :limit) (get a :country)))))
          ((= name "weather") (if offline (js-object :state "unavailable") (await (place-weather (get a :place) (get a :days) (get a :country)))))
          ((= name "distance") (await (place-distance (get a :from) (get a :to) offline (get a :fromCountry) (get a :toCountry))))
          ((= name "convert") (Object/assign (js-object :state "ok") (convert-unit (get a :value) (get a :from) (get a :to))))))
        (catch error (setq data (js-object :state "unavailable"))))
      (js-object :ok (= (get data :state) "ok") :text (render-read name data lang) :data data)))
  (export builtin-names run-read render-read render-page-text))
