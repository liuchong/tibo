;; Fixed methods consume validated data, never the phrasing of a question.
(module tibo.capabilities.read
  (import "node:process" :default process)
  (import "../evidence/service-status.eli" service-status service-history)
  (import "../evidence/web-search.eli" search-web)
  (import "./calculate.eli" calculate)
  (import "./general.eli" clock-at date-difference convert-unit)
  (defconst builtin-names (js-array "service-status" "service-history" "search" "calculate" "time" "date-diff" "convert"))
  (defun public-status (s)
    (Object/fromEntries (js-call (Object/entries s) :filter (lambda (row) (not (js-call (js-array "cached" "until") :includes (get row 0)))))))
  (defun render-read (name data lang)
    (let ((zh (= lang "zh")))
      (if (not (= (get data :state) "ok"))
        (if zh "本次资料或计算暂不可用，未确认结果。" "This data or calculation is unavailable; no result is confirmed.")
        (cond
          ((= name "service-status")
            (str "**OpenAI " (if zh "官方服务状态" "official service status") "**\n" (get data :status)
              "\n" (js-call (js-call (get data :components) :map (lambda (c) (str "• " (get c :name) " — " (get c :status)))) :join "\n")
              "\n" (if (get data :incidentsKnown)
                (if (= (get (get data :incidents) :length) 0) (if zh "未见进行中的事故。" "No active incidents reported.")
                  (js-call (js-call (get data :incidents) :map (lambda (i) (str "• " (get i :name) " — " (get i :status)))) :join "\n"))
                (if zh "事故列表暂未核实。" "Incident list not verified."))
              "\n" (get data :at) "\nhttps://status.openai.com/"))
          ((= name "service-history")
            (str "**OpenAI " (if zh "服务事故历史" "service incident history") "**\n"
              (js-call (js-call (get data :incidents) :map (lambda (i)
                (str "• " (get i :createdAt (get i :updatedAt)) "｜" (get i :name) "｜" (get i :status)
                  "\n" (get i :url) "\n" (js-call (js-call (get i :updates) :map (lambda (u) (str (get u :at) "｜" (get u :status) "｜" (get u :text)))) :join "\n")))) :join "\n\n")
              "\n" (if zh "范围为官方返回的最近一页，可能不覆盖完整历史；本次读取：" "Only the latest official page is covered; checked at: ") (get data :at)))
          ((= name "search") (str (if zh "搜索结果（摘要，未读取原页）：" "Search results (summaries, original pages not fetched):") "\n"
            (js-call (js-call (get data :results) :map (lambda (r) (str "• [" (get r :title) "](" (get r :url) ")\n" (get r :snippet)))) :join "\n")))
          ((= name "calculate") (str (get data :expression) " = " (get data :value)))
          ((= name "time") (str "UTC: " (get data :utc) "\n" (get data :timezone) ": " (get data :local)))
          ((= name "date-diff") (str (get data :from) " → " (get data :to) "\n" (get data :seconds) " s = " (get data :hours) " h = " (get data :days) " d"))
          ((= name "convert") (str (get data :value) " " (get data :from) " = " (get data :result) " " (get data :to)))))))
  (defasync run-read (query lang &optional offline)
    (let* ((name (get query :command)) (a (get query :args)) (data nil))
      (try
        (setq data (cond
          ((= name "service-status") (if offline (js-object :state "unavailable") (public-status (await (service-status)))))
          ((= name "service-history") (if offline (js-object :state "unavailable") (await (service-history (get a :limit) (get a :days) (get a :component)))))
          ((= name "search") (if (or offline (= (get (get process :env) :TIBO_CHAT_SEARCH "1") "0")) (js-object :state "unavailable")
            (let ((result (await (search-web (get a :query)))))
              (js-object :state (get result :state) :query (get result :query) :results (get result :results) :at (get result :at)))))
          ((= name "calculate") (js-object :state "ok" :expression (get a :expression) :value (calculate (get a :expression))))
          ((= name "time") (Object/assign (js-object :state "ok") (clock-at (get a :timezone) (get a :at))))
          ((= name "date-diff") (Object/assign (js-object :state "ok") (date-difference (get a :from) (get a :to))))
          ((= name "convert") (Object/assign (js-object :state "ok") (convert-unit (get a :value) (get a :from) (get a :to))))))
        (catch error (setq data (js-object :state "unavailable"))))
      (js-object :ok (= (get data :state) "ok") :text (render-read name data lang) :data data)))
  (export builtin-names run-read render-read))
