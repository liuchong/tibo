(module tibo.capabilities.geo
  (import "../platform/host.eli" RegExp Number Promise)
  (import "../platform/util.eli" fail)
  (import "../evidence/public-place.eli" place-query weather-at valid-point? place-name)
  (defasync resolve-point (text &optional offline country)
    (let ((m (js-call (new RegExp "^\\s*([+-]?[0-9]+(?:\\.[0-9]+)?)\\s*,\\s*([+-]?[0-9]+(?:\\.[0-9]+)?)\\s*$") :exec text)))
      (if m
        (let ((lat (Number (get m 1))) (lon (Number (get m 2))))
          (unless (valid-point? lat lon) (fail "coordinates-range"))
          (js-object :name text :latitude lat :longitude lon :selection "provided-coordinates"))
        (let ((result (if offline (js-object :state "unavailable") (await (place-query text nil country)))))
          (unless (= (get result :state) "ok") (fail "place-unavailable"))
          (Object/assign (js-object) (get (get result :places) 0) (js-object :selection "first-ranked-city"))))))
  (defun great-circle-km (a b)
    (let* ((r (/ Math/PI 180)) (lat1 (* r (get a :latitude))) (lat2 (* r (get b :latitude)))
      (dlat (- lat2 lat1)) (dlon (* r (- (get b :longitude) (get a :longitude))))
      (h (+ (Math/pow (Math/sin (/ dlat 2)) 2) (* (Math/cos lat1) (Math/cos lat2) (Math/pow (Math/sin (/ dlon 2)) 2)))))
      (* 6371 2 (Math/asin (Math/sqrt (Math/min 1 (Math/max 0 h)))))))
  (defasync place-distance (from to &optional offline from-country to-country)
    (let* ((points (await (Promise/all (js-array (resolve-point from offline from-country) (resolve-point to offline to-country)))))
      (a (get points 0)) (b (get points 1)))
      (js-object :state "ok" :from a :to b :kilometers (/ (Math/round (* (great-circle-km a b) 10)) 10)
        :kind "great-circle" :description "城市参考点之间的球面距离，非驾车路线")))
  (defasync place-weather (place days &optional country)
    (let* ((point (await (resolve-point place nil country))) (weather (await (weather-at point days))))
      (Object/assign (js-object) weather (js-object :place point))))
  (export resolve-point great-circle-km place-distance place-weather))
