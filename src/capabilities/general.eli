(module tibo.capabilities.general
  (import "../platform/host.eli" Date Number Intl RegExp)
  (import "../platform/util.eli" fail iso)
  (defconst units (js-object
    :m (js-array "length" 1) :km (js-array "length" 1000) :cm (js-array "length" 0.01) :mm (js-array "length" 0.001)
    :in (js-array "length" 0.0254) :ft (js-array "length" 0.3048) :mi (js-array "length" 1609.344)
    :kg (js-array "mass" 1) :g (js-array "mass" 0.001) :lb (js-array "mass" 0.45359237)
    :s (js-array "duration" 1) :min (js-array "duration" 60) :h (js-array "duration" 3600) :d (js-array "duration" 86400)
    :B (js-array "data" 1) :bit (js-array "data" 0.125) :KB (js-array "data" 1000) :MB (js-array "data" 1000000) :GB (js-array "data" 1000000000)
    :KiB (js-array "data" 1024) :MiB (js-array "data" 1048576) :GiB (js-array "data" 1073741824)
    :C (js-array "temperature" 1) :F (js-array "temperature" 1) :K (js-array "temperature" 1)))
  (defun date-value (text)
    (unless (and (= (value-type text) "string")
      (js-call (new RegExp "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z)?$") :test text)) (fail "date-format"))
    (let ((n (Date/parse text)))
      (unless (and (Number/isFinite n) (= (js-call (iso n) :slice 0 10) (js-call text :slice 0 10))) (fail "date-value")) n))
  (defun clock-at (timezone &optional at)
    (let* ((n (if at (date-value at) (Date/now)))
      (formatter (new Intl/DateTimeFormat "sv-SE" (js-object :timeZone timezone :dateStyle "short" :timeStyle "medium"))))
      (js-object :utc (iso n) :timezone (get (js-call formatter :resolvedOptions) :timeZone) :local (js-call formatter :format (new Date n)))))
  (defun date-difference (from to)
    (let ((seconds (/ (- (date-value to) (date-value from)) 1000)))
      (js-object :from from :to to :seconds seconds :hours (/ seconds 3600) :days (/ seconds 86400))))
  (defun date-add (from amount unit timezone)
    (unless (and (Number/isInteger amount) (<= (Math/abs amount) 36600)) (fail "date-add-range"))
    (let* ((factor (get (js-object :seconds 1000 :minutes 60000 :hours 3600000 :days 86400000 :weeks 604800000) unit))
      (n (date-value from)))
      (unless factor (fail "date-add-unit"))
      (let* ((at (iso (+ n (* amount factor)))) (clock (clock-at timezone at))
        (weekday (js-call (new Intl/DateTimeFormat "en-US" (js-object :timeZone timezone :weekday "long")) :format (new Date at))))
        (Object/assign clock (js-object :from from :amount amount :unit unit :weekday weekday)))))
  (defun convert-unit (input from to)
    (unless (and (= (value-type input) "string")
      (js-call (new RegExp "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$") :test input)) (fail "convert-number"))
    (let* ((value (Number input)) (a (get units from)) (b (get units to)) (result nil))
      (unless (and (Number/isFinite value) a b (= (get a 0) (get b 0))) (fail "convert-dimension"))
      (if (= (get a 0) "temperature")
        (let ((kelvin (cond ((= from "C") (+ value 273.15)) ((= from "F") (+ (* (- value 32) (/ 5 9)) 273.15)) (t value))))
          (when (< kelvin 0) (fail "convert-temperature"))
          (setq result (cond ((= to "C") (- kelvin 273.15)) ((= to "F") (+ (* (- kelvin 273.15) (/ 9 5)) 32)) (t kelvin))))
        (setq result (/ (* value (get a 1)) (get b 1))))
      (unless (and (Number/isFinite result) (<= (Math/abs result) 1e100)) (fail "convert-range"))
      (js-object :value value :from from :to to :result (Number (js-call result :toPrecision 15)))))
  (export units date-value clock-at date-difference date-add convert-unit))
