(module tibo.capabilities.calculate
  (import "../platform/host.eli" RegExp Number)
  (import "../platform/util.eli" fail)
  (defun peek (state) (get (get state :tokens) (get state :pos)))
  (defun take (state)
    (let ((token (peek state))) (put state :pos (+ (get state :pos) 1)) token))
  (defun primary (state)
    (let ((token (take state)))
      (if (= token "(")
        (let ((depth (+ (get state :depth) 1)))
          (when (> depth 32) (fail "calculation-depth"))
          (put state :depth depth)
          (let ((value (sum state)))
            (unless (= (take state) ")") (fail "calculation-parenthesis"))
            (put state :depth (- depth 1)) value))
        (progn
          (unless (and token (js-call (new RegExp "^(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$") :test token))
            (fail "calculation-number"))
          (Number token)))))
  (defun power (state)
    (let ((value (primary state)))
      (when (js-call (js-array "^" "**") :includes (peek state))
        (take state) (let ((exponent (unary state)))
          (when (> (Math/abs exponent) 1000) (fail "calculation-exponent"))
          (setq value (Math/pow value exponent)))) value))
  (defun unary (state)
    (cond ((= (peek state) "+") (take state) (unary state))
      ((= (peek state) "-") (take state) (- (unary state)))
      (t (power state))))
  (defun product (state)
    (let ((value (unary state)))
      (while (js-call (js-array "*" "/" "%") :includes (peek state))
        (let ((op (take state)) (right (unary state)))
          (setq value (cond ((= op "*") (* value right)) ((= op "/") (/ value right)) (t (% value right)))))) value))
  (defun sum (state)
    (let ((value (product state)))
      (while (js-call (js-array "+" "-") :includes (peek state))
        (let ((op (take state)) (right (product state))) (setq value (if (= op "+") (+ value right) (- value right))))) value))
  (defun calculate (expression)
    (unless (and (= (value-type expression) "string") (> (get expression :length) 0) (<= (get expression :length) 256))
      (fail "calculation-input"))
    (let* ((compact (js-call expression :replace (new RegExp "\\s+" "g") ""))
      (tokens (or (js-call expression :match (new RegExp "(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|\\*\\*|[()+*/%^\\-]" "g")) (js-array)))
      (state (js-object :tokens tokens :pos 0 :depth 0)))
      (unless (and (> (get tokens :length) 0) (<= (get tokens :length) 128) (= (js-call tokens :join "") compact)) (fail "calculation-tokens"))
      (let ((value (sum state)))
        (unless (and (= (get state :pos) (get tokens :length)) (Number/isFinite value) (<= (Math/abs value) 1e100)) (fail "calculation-result"))
        (if (Object/is value -0) 0 value))))
  (export calculate))
