(module tibo.app.daemon
  (import "node:process" :default process)
  (import "node:timers" setTimeout clearTimeout)
  (import "../platform/host.eli" Date Number Promise)
  (import "./engine.eli" run-report)
  (import "../platform/state.eli" write-state with-lock)
  (import "../platform/util.eli" iso fail)
  (defasync start-daemon (&optional once)
    (let* ((seconds (Number (get (get process :env) :TIBO_DAEMON_INTERVAL "900")))
           (stopping false) (timer nil) (wake nil) (cycles 0) (failures 0))
      (unless (and (Number/isInteger seconds) (>= seconds 60) (<= seconds 86400)) (fail "TIBO_DAEMON_INTERVAL 必须为60..86400秒"))
      (let ((stop (lambda () (setq stopping t) (when timer (clearTimeout timer)) (when wake (funcall wake nil)))))
        (js-call process :on "SIGTERM" stop) (js-call process :on "SIGINT" stop)
        (try
          (await (with-lock "daemon-instance" (async ()
            (console/error "tibo-daemon: 启动，只采集和保存报告，未启用消息投递")
            (while (not stopping)
              (let ((started (iso (Date/now))) (outcome (js-object :pid (get process :pid) :state "collecting" :startedAt (iso (Date/now)))))
                (await (write-state "daemon" outcome))
                (try
                  (let ((result (await (with-lock "daemon-report" (async () (await (run-report (js-object :channel "daemon"))))))))
                    (setq cycles (+ cycles 1) failures 0)
                    (put outcome :state "ready") (put outcome :p24 (get (get result :forecast) :p24)) (put outcome :p48 (get (get result :forecast) :p48))
                    (put outcome :ai (get result :ai))
                    (await (write-state "daemon-latest" (js-object :at (get (get result :snapshot) :now) :report (get result :report))))
                    (console/error (str "tibo-daemon: 完成 " started " " (get outcome :p24) "%/" (get outcome :p48) "%")))
                  (catch error
                    (setq failures (+ failures 1)) (put outcome :state "degraded")
                    (put outcome :error "采集或本地状态失败；保留上一次报告")
                    (console/error "tibo-daemon: 本轮失败，保留历史与上次报告，下个周期继续")))
                (put outcome :finishedAt (iso (Date/now))) (put outcome :cycles cycles) (put outcome :consecutiveFailures failures)
                (put outcome :nextRunAt (iso (+ (Date/now) (* seconds 1000))))
                (await (write-state "daemon" outcome)))
              (when once (setq stopping t))
              (unless stopping
                (await (new Promise (lambda (resolve reject)
                  (setq wake resolve timer (setTimeout resolve (* seconds 1000))))))
                (setq wake nil timer nil)))
            (await (write-state "daemon-stopped" (js-object :pid (get process :pid) :at (iso (Date/now)))))
            (console/error "tibo-daemon: 已停止"))))
          (finally (when timer (clearTimeout timer))
            (js-call process :removeListener "SIGTERM" stop) (js-call process :removeListener "SIGINT" stop))))))
  (export start-daemon))
