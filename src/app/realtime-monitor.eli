(module tibo.app.realtime-monitor
  (import "node:crypto" createHash)
  (import "../platform/host.eli" Date Number)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" iso ms)
  (import "../evidence/sources.eli" collect-sources)
  (import "./engine.eli" observe run-report)
  (import "../subscriptions/alerts.eli" confirmed-global? confirm-alert forecast-alert)
  (defun post-signature (snapshot)
    (let ((rows (js-call (get snapshot :posts) :filter (lambda (p) (= (get p :provenance) "primary")))))
      (js-call (js-call (createHash "sha256") :update (JSON/stringify
        (js-object :policy "reset-completion-2" :posts
          (js-call rows :map (lambda (p) (js-array (get p :id) (get p :text) (get p :truncated false)
            (get p :parentId) (get p :parentRelationProvenance) (get p :quotedPostId) (get p :quotedRelationProvenance))))))) :digest "hex")))
  (defasync watch-tick (maintenance-seconds &optional collect generate)
    (await (state-transaction "realtime-monitor" (async ()
      (let* ((state (or (await (read-state "realtime-monitor")) (js-object :schemaVersion 1)))
        (snapshot (if collect (await (funcall collect)) (await (collect-sources))))
        (observed (observe snapshot)) (first (not (get state :initializedAt)))
        (tag (post-signature snapshot)) (changed (not (= tag (get state :postSignature))))
        (known (get state :confirmedIds (js-array))) (seen (get state :promiseIds (js-array)))
        (confirmations (js-call (get observed :events) :filter confirmed-global?))
        (generated false) (result nil))
        (if first
          (progn
            (put state :initializedAt (iso (Date/now)))
            (setq known (js-call (js-call (get observed :events) :filter (lambda (e) (get e :global)))
              :map (lambda (e) (get e :id))))
            (when (get (get observed :signals) :promise)
              (js-call seen :push (get (get (get observed :signals) :promise) :postId)))
            (put state :confirmedIds known) (put state :promiseIds seen)
            (await (write-state "realtime-monitor" state)))
          (let ((i 0))
            (while (< i (get confirmations :length))
              (let ((event (get confirmations i)))
                (unless (js-call known :includes (get event :id))
                  (await (confirm-alert event)) (js-call known :push (get event :id))))
              (setq i (+ i 1)))))
        ;; Persist completed confirmations before optional forecast AI work.
        (when (> (get confirmations :length) 0)
          (put state :lastConfirmedAt (get (get confirmations (- (get confirmations :length) 1)) :at)))
        (put state :confirmedIds known) (await (write-state "realtime-monitor" state))
        (when (or first changed (>= (- (Date/now) (get state :lastForecastAt 0)) (* maintenance-seconds 1000)))
          (setq result (if generate (await (funcall generate snapshot))
            (await (run-report (js-object :channel "daemon")))))
          (setq generated t)
          (unless first
            (let ((alert (await (forecast-alert result seen (get state :highCycle)))))
              (when (get alert :promiseId) (js-call seen :push (get alert :promiseId)))
              (when (get alert :highCycle) (put state :highCycle (get alert :highCycle)))))
          (put state :lastForecastAt (Date/now))
          (await (write-state "daemon-latest" (js-object :at (get (get result :snapshot) :now) :report (get result :report)))))
        (put state :promiseIds seen) (put state :postSignature tag) (put state :checkedAt (iso (Date/now)))
        (put state :changed changed) (put state :generated generated)
        (let ((rate (or (await (read-state "x-request-budget")) (js-object))))
          (put state :nextCheckAt (iso (Math/max (+ (Date/now) 300000) (get rate :until 0))))
          (put state :sourceCooldownUntil (when (> (get rate :until 0) (Date/now)) (iso (get rate :until)))))
        (await (write-state "realtime-monitor" state))
        (js-object :state state :result result))))))
  (export watch-tick post-signature))
