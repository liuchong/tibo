;; Cache only public forecast generation. Human text, identity, language and
;; transport delivery are never keys or values of this shared cache.
(module tibo.app.forecast-cache
  (import "../platform/host.eli" Date Promise Number)
  (import "node:crypto" createHash randomUUID)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" ms iso)
  (import "../ai/runtime.eli" config)
  (import "../forecast/journal.eli" cases)
  (defconst ttl-ms 120000)
  (defconst features (js-array "signals" "search" "research" "forecast" "review" "brief"))
  (defun digest (value) (js-call (js-call (createHash "sha256") :update (JSON/stringify value)) :digest "hex"))
  (defasync invalidation ()
    (get (or (await (read-state "forecast-cache-revision")) (js-object)) :version "initial"))
  (defasync invalidate-forecast ()
    (await (write-state "forecast-cache-revision" (js-object :version (randomUUID)))))
  (defun configuration (no-ai)
    (if no-ai "native" (let ((cfg (config)))
      (digest (js-object :identity (get cfg :identity) :weight (get cfg :weight)
        :features (js-call features :filter (lambda (name) (js-call (get cfg :features) :includes name))))))))
  (defun valid-result? (result)
    (let* ((snapshot (get (or result (js-object)) :snapshot (js-object)))
      (prob (get (or result (js-object)) :forecast (js-object))))
      (and (= (get snapshot :schemaVersion) 1)
        (js-call (js-array "events" "posts" "sources" "unknowns") :every (lambda (key) (Array/isArray (get snapshot key))))
        (Array/isArray (get result :events)) (get result :signals) (get result :cycle)
        (or (= (get prob :available) false) (and (Number/isInteger (get prob :p24)) (Number/isInteger (get prob :p48))
          (>= (get prob :p24) 0) (<= (get prob :p48) 100) (>= (get prob :p48) (get prob :p24)))))))
  (defasync signature (no-ai)
    (let* ((cfg (config)) (now (Date/now))
      (states (await (Promise/all (js-call (js-array "ledger" "experience" "forecast-journal" "ai") :map read-state))))
      (ledger (or (get states 0) (js-object))) (experience (or (get states 1) (js-object)))
      (journal (or (get states 2) (js-object))) (ai (or (get states 3) (js-object)))
      (enabled (js-call features :filter (lambda (name) (js-call (get cfg :features) :includes name))))
      (circuit (lambda (row) (js-object :blocked (> (get row :until 0) now)
        :until (get row :until 0) :status (get row :status) :outputPolicy (get row :outputPolicy)))))
      (digest (js-object :policy "forecast-cache-1" :noAi no-ai
        :revision (await (invalidation))
        :ledger (js-object :events (get ledger :events (js-array)) :posts (get ledger :posts (js-array)))
        :accuracy (get experience :accuracy) :cases (cases (get journal :reports (js-array)))
        :ai (unless no-ai (js-object :identity (get cfg :identity) :features enabled :weight (get cfg :weight)
          :epoch (get ai :epoch) :provider (funcall circuit (get ai :provider (js-object)))
          :circuits (js-call enabled :map (lambda (name)
            (js-array name (funcall circuit (get (get ai :features (js-object)) name (js-object))))))))))))
  (defun reuse-result (result state started)
    (let ((copy (JSON/parse (JSON/stringify result))) (now (Date/now)))
      (put copy :reuse (js-object :state state :collectedAt (get (get copy :snapshot) :now)
        :ttlMs ttl-ms :ageMs (Math/max 0 (- now (ms (get (get copy :snapshot) :now))))
        :waitMs (- now started) :generationTiming (get copy :timing)))
      (when (= state "cached") (put copy :timing (js-object :collectionMs 0 :analysisMs 0))) copy))
  (defasync cached-forecast (options generate)
    (let* ((started (Date/now)) (no-ai (not (not (get options :noAi))))
      (key (if no-ai "forecast-cache-native" "forecast-cache-ai")))
      ;; Explicit data and fixed schedule slots always own their own generation.
      (if (or (get options :snapshotPath) (get options :offline) (get options :titleTime)
        (= (get options :channel) "schedule")) (await (funcall generate))
        (await (state-transaction key (async ()
          (let* ((tag (try (await (signature no-ai)) (catch error nil)))
            (settings (configuration no-ai))
            (revision (try (await (invalidation)) (catch error nil)))
            (saved (try (await (read-state key)) (catch error nil)))
            (now (Date/now))
            (hit (try (and tag saved (= (get saved :schemaVersion) 1) (= (get saved :signature) tag)
              (Number/isFinite (get saved :expiresAt)) (> (get saved :expiresAt) now)
              (valid-result? (get saved :result))
              (let ((age (- now (ms (get (get (get saved :result) :snapshot) :now)))))
                (and (>= age 0) (< age ttl-ms)))) (catch error false))))
            (if hit (reuse-result (get saved :result) "cached" started)
              (let* ((result (await (funcall generate))) (finished (Date/now))
                (until (+ (ms (get (get result :snapshot) :now)) ttl-ms))
                (after (try (await (signature no-ai)) (catch error nil))))
                ;; Changes made by collection are included in the saved identity;
                ;; an administrative invalidation during generation is not.
                (when (and after revision (> until finished) (= settings (configuration no-ai))
                  (= revision (try (await (invalidation)) (catch error nil))))
                  (try (await (write-state key (js-object :schemaVersion 1 :signature after
                    :expiresAt until :finishedAt (iso finished) :result result))) (catch error nil)))
                (reuse-result result "fresh" started))))) 120000)))))
  (export cached-forecast invalidate-forecast ttl-ms))
