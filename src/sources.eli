(module tibo.sources
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal BigInt encodeURIComponent)
  (import "./html.eli" parse-html by-tag by-class select html-text attr)
  (import "./transport.eli" request request-json)
  (import "./state.eli" read-state write-state with-lock)
  (import "./signals.eli" completed?)
  (import "./util.eli" fail clean canonical-text ms iso matches match sorted recent unknown utc last-item)
  (defconst archive-url "https://aiidelist.com/codex-reset")
  (defun text-of (node class) (html-text (get (by-class node class) 0)))
  (defun first-attr (node tag attribute) (attr (get (by-tag node tag) 0) attribute))
  (defun source-link (node) (attr (get (by-tag node "a") 0) "href"))
  (defun parse-archive (html now)
    (let* ((root (parse-html html)) (events (js-array)) (posts (js-array))
           (cache-match (match "fetchedAt:\"([^\"]+)\"" html))
           (cache-at (if cache-match (get cache-match 1) nil)))
      (js-call (by-class root "cr-x-post") :forEach
        (lambda (element)
          (let* ((url (attr (get (by-class element "cr-x-post-x") 0) "href"))
                 (id-match (match "/thsottiaux/status/([0-9]+)" (or url ""))))
            (when id-match
              (js-call posts :push (js-object :id (get id-match 1) :at (first-attr element "time" "datetime")
               :text (text-of element "cr-x-post-text") :quoteText (text-of element "cr-x-post-quote") :url url :author "thsottiaux"
               :provenance "archive" :cachedAt cache-at))))))
      (js-call (by-class root "cr-event") :forEach
        (lambda (element)
          (let* ((labels (text-of element "cr-event-labels"))
                 (global (matches "Global" labels)) (banked (matches "Banked" labels)))
            (when (or global banked)
              (js-call events :push (js-object :id (attr element "id") :at (first-attr element "time" "datetime")
                :global global :banked banked :observed (matches "Community observation" labels)
                :compensation (matches "Compensation" labels) :summary (html-text (get (by-tag element "h3") 0))
                :scope (html-text (get (by-tag (get (by-class element "cr-event-body") 0 (js-object)) "p") 0))
                :url (source-link (get (by-class element "cr-event-sources") 0 (js-object)))
                :provenance "archive" :sourceUrl archive-url))))))
      (when (< (get events :length) 2) (fail "历史页面结构失配，无法统计"))
      (let ((count-match (match "([0-9]+) matching announcements" (html-text root))))
        (unless count-match (fail "历史页面缺少完整性计数"))
        (when (not (= (Number (get count-match 1)) (get events :length))) (fail "历史页面记录不完整")))
      (js-object :events (sorted events "at") :posts (sorted posts "at") :cachedAt cache-at :fetchedAt now)))
  (defun parse-primary (html now)
    (let ((root (parse-html html)) (posts (js-array)))
      (js-call (by-tag root "article") :forEach
        (lambda (element)
          (let* ((link (get (select element (lambda (n) (and (= (get n :tag) "a")
                                (matches "/thsottiaux/status/[0-9]+" (or (attr n "href") ""))))) 0))
                 (id (match "/thsottiaux/status/([0-9]+)" (or (attr link "href") "")))
                 (at (first-attr element "time" "datetime"))
                 (text (html-text (get (select element (lambda (n) (= (attr n "data-testid") "tweetText"))) 0))))
            (when (and id at (> (get text :length) 0))
              (ms at)
              (js-call posts :push (js-object :id (get id 1) :at at :text text :author "thsottiaux"
               :url (str "https://x.com/thsottiaux/status/" (get id 1)) :provenance "primary" :cachedAt now))))))
      (when (= (get posts :length) 0) (fail "X 抓取未返回带时间的原帖"))
      posts))
  (defun snowflake-time (id)
    (unless (matches "^[0-9]{16,20}$" id) (fail "Invalid X post ID"))
    (iso (Number (+ (bit-shift-right (BigInt id) (BigInt 22)) (BigInt "1288834974657")))))
  (defun parse-embed (data id now)
    (unless (and (matches "^https://(?:x|twitter)\\.com/thsottiaux/?$" (get data :author_url ""))
                 (matches (str "^https://(?:x|twitter)\\.com/thsottiaux/status/" id "(?:\\?|$)") (get data :url "")))
      (fail "X 原文作者或帖子ID不匹配"))
    (let* ((root (parse-html (get data :html "")))
           (quote (get (by-class root "twitter-tweet") 0))
           (text (canonical-text (html-text (get (by-tag (or quote (js-object)) "p") 0))))
           (at (snowflake-time id)))
      (unless (and (> (get text :length) 0) (<= (ms at) (ms now))) (fail "X 嵌入内容或时间不合法"))
      (js-object :id id :at at :text text :author "thsottiaux" :url (get data :url)
        :provenance "primary" :cachedAt now :via "official-oembed" :truncated (matches "…(?:\\s*https?://[^ ]+)?$" text))))
  (defasync collect-one (name url now &optional offline)
    (try
      (when offline (fail "离线模式：未请求"))
      (js-object :name name :url url :ok t :fetched t :at now :body (await (request url)))
      (catch error (js-object :name name :url url :ok false :at now :error (get error :message "抓取失败")))))
  (defun merge-posts (cached primary)
    (let ((items (new Map)))
      (js-call cached :forEach (lambda (p) (js-call items :set (get p :id) p)))
      (js-call primary :forEach (lambda (p)
        (let ((old (js-call items :get (get p :id))))
          (when (or (not old) (= (get p :provenance) "primary") (not (= (get old :provenance) "primary")))
            (js-call items :set (get p :id) (Object/assign (js-object) (or old (js-object)) p))))))
      (sorted (Array/from (js-call items :values)) "at")))
  (defun merge-events (old fresh)
    (let ((items (new Map)))
      (js-call old :forEach (lambda (e) (js-call items :set (get e :id) e)))
      (js-call fresh :forEach (lambda (e) (js-call items :set (get e :id) e)))
      (sorted (Array/from (js-call items :values)) "at")))
  (defun events-from-posts (posts)
    (let ((result (js-array)))
      (js-call posts :forEach (lambda (p)
        (let* ((text (get p :text)) (global (completed? text))
               (banked (and (matches "banked|reset card" text) (matches "added|granted|available|issued" text)
                            (not (matches "will|tomorrow|not |no " text)))))
          (when (or global banked)
            (js-call result :push (js-object :id (get p :id) :at (get p :at) :global global :banked banked
              :observed false :url (get p :url) :scope "以原文对象为准" :provenance (get p :provenance)))))))
      result))
  (defasync collect-sources (&optional clock offline)
    (let* ((now (or clock (iso (Date/now)))) (unknowns (js-array))
           (ledger (or (await (read-state "ledger")) (js-object)))
           (urls (js-array (js-array "archive" archive-url)
                          (js-array "status" "https://status.openai.com/api/v2/incidents.json")
                          (js-array "news" "https://openai.com/news/rss.xml")
                          (js-array "primary" "https://x.com/thsottiaux")))
           (sources (await (Promise/all (js-call urls :map (lambda (pair) (collect-one (get pair 0) (get pair 1) now offline))))))
           (archive nil) (fresh-original false) (posts (get ledger :posts (js-array))) (events (get ledger :events (js-array))))
      (try
        (unless (get (get sources 0) :ok) (fail (get (get sources 0) :error)))
        (setq archive (parse-archive (get (get sources 0) :body) now))
        (setq posts (merge-posts posts (get archive :posts)) events (merge-events events (get archive :events)))
        (catch error (put (get sources 0) :ok false)
          (when (get (get sources 0) :fetched) (put (get sources 0) :error "历史页面解析失败，保留本地证据"))
          (unknown unknowns (str "历史发现源：" (get error :message) "；保留本地证据"))))
      (try
        (unless (get (get sources 3) :ok) (fail (get (get sources 3) :error)))
        (setq posts (merge-posts posts (parse-primary (get (get sources 3) :body) now)) fresh-original t)
        (catch error (put (get sources 3) :ok false)
          (when (get (get sources 3) :fetched) (put (get sources 3) :error "主页未返回可解析原帖"))
          (unknown unknowns (str "Tibo 主页：" (get error :message)))))
      (js-call sources :forEach (lambda (source)
        (when (and (get source :ok) (js-call (js-array "status" "news") :includes (get source :name)))
          (try
            (if (= (get source :name) "status")
              (unless (Array/isArray (get (JSON/parse (get source :body)) :incidents)) (fail "状态数据结构失配"))
              (unless (matches "<rss\\b[\\s\\S]*<channel\\b" (get source :body)) (fail "新闻数据结构失配")))
            (catch error (put source :ok false) (put source :error "官方资料结构无法解析"))))))
      (unless offline
        (let* ((candidates (js-call (js-call posts :filter (lambda (p) (recent (get p :at) now 48))) :slice -8))
               (checks (await (Promise/all (js-call candidates :map
                 (async (p)
                   (try (parse-embed (await (request-json (str "https://publish.x.com/oembed?omit_script=true&url=" (encodeURIComponent (get p :url))))) (get p :id) now)
                     (catch error (unknown unknowns (str "X 原文核实 " (get p :id) "：" (get error :message))) nil))))))))
          (let ((verified (js-call checks :filter (lambda (p) (not (nullish? p))))))
            (js-call sources :push (js-object :name "oembed" :ok (> (get verified :length) 0) :fetched (> (get verified :length) 0) :at now
              :attempted (get candidates :length) :verified (get verified :length) :error (if (> (get verified :length) 0) nil "原文核实不可用")))
            (when (> (get verified :length) 0) (setq fresh-original t))
            (setq posts (merge-posts posts verified)))))
      (setq events (merge-events events (events-from-posts posts)))
      (js-call sources :forEach (lambda (source)
        (unless (get source :ok) (unknown unknowns (str (get source :name) "：" (get source :error))))))
      (unknown unknowns "公开主页/存档不能保证覆盖全部新帖；原文核实不代表个人账户生效")
      (unknown unknowns "新闻基础源为官方 RSS，额外搜索执行情况单列；历史公告可能有遗漏")
      (when (get ledger :now) (unknown unknowns (str "本地历史累计到 " (utc (get ledger :now)) "；旧证据不代表本次采集成功")))
      (when (and archive (get archive :cachedAt)) (unknown unknowns (str "存档缓存 " (utc (get archive :cachedAt)))))
      (unless offline
        (when (or archive fresh-original)
          (await (with-lock "ledger" (async ()
            (let ((latest (or (await (read-state "ledger")) (js-object))))
              (await (write-state "ledger" (js-object :schemaVersion 1 :now now
                :events (merge-events (get latest :events (js-array)) events)
                :posts (merge-posts (get latest :posts (js-array)) posts))))))))))
      (js-object :schemaVersion 1 :now now :events events :posts posts :cachedAt (if archive (get archive :cachedAt) nil)
        :crossChecks (js-array) :sources sources :unknowns unknowns)))
  (export parse-archive parse-primary parse-embed snowflake-time collect-sources merge-posts merge-events events-from-posts))
