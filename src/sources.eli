(module tibo.sources
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "node:process" :default process)
  (import "cheerio" load)
  (import "./transport.eli" request request-json scrape)
  (import "./util.eli" fail clean ms iso matches match sorted recent unknown utc)
  (defconst archive-url "https://aiidelist.com/codex-reset")
  (defun text-of ($ element selector) (clean (js-call (js-call (funcall $ element) :find selector) :text)))
  (defun attr-of ($ element selector attribute) (js-call (js-call (funcall $ element) :find selector) :attr attribute))
  (defun parse-archive (html now)
    (let* (($ (load html)) (events (js-array)) (posts (js-array))
           (cache-match (match "fetchedAt:\"([^\"]+)\"" html))
           (cache-at (if cache-match (get cache-match 1) nil)))
      (js-call (funcall $ "article.cr-x-post") :each
        (lambda (index element)
          (let* ((url (attr-of $ element "a.cr-x-post-x" "href"))
                 (id-match (match "/status/([0-9]+)" (or url ""))))
            (when id-match
              (js-call posts :push (js-object :id (get id-match 1) :at (attr-of $ element "time" "datetime")
               :text (text-of $ element ".cr-x-post-text") :quoteText (text-of $ element ".cr-x-post-quote p") :url url :author "thsottiaux"
               :provenance "archive" :cachedAt cache-at))))))
      (js-call (funcall $ "article.cr-event") :each
        (lambda (index element)
          (let* ((node (funcall $ element)) (labels (text-of $ element ".cr-event-labels"))
                 (global (matches "Global" labels)) (banked (matches "Banked|banked" labels)))
            (when (or global banked)
              (js-call events :push (js-object :id (js-call node :attr "id") :at (attr-of $ element "time" "datetime")
                :global global :banked banked :observed (matches "Community observation" labels)
                :compensation (matches "Compensation" labels) :summary (text-of $ element "h3")
                :scope (text-of $ element ".cr-event-body > p") :url (attr-of $ element ".cr-event-sources a" "href")
                :provenance "archive"))))))
      (when (< (get events :length) 2) (fail "历史页面结构失配，无法统计"))
      ;; Verify that server rendering has not truncated the history.
      (let ((count-match (match "([0-9]+) matching announcements" (js-call (funcall $ "body") :text))))
        (when (and count-match (not (= (Number (get count-match 1)) (get events :length))))
          (fail "历史页面记录不完整")))
      (js-object :events (sorted events "at") :posts (sorted posts "at") :cachedAt cache-at :fetchedAt now)))
  (defun parse-primary (html now)
    (let* (($ (load html)) (posts (js-array)))
      (js-call (funcall $ "article") :each
        (lambda (i element)
          (let* ((url (attr-of $ element "a[href*='/thsottiaux/status/']" "href"))
                 (id (match "/thsottiaux/status/([0-9]+)" (or url "")))
                 (at (attr-of $ element "time" "datetime"))
                 (text (text-of $ element "[data-testid='tweetText']")))
            (when (and id at (> (get text :length) 0))
              (js-call posts :push (js-object :id (get id 1) :at at :text text :author "thsottiaux"
               :url (str "https://x.com/thsottiaux/status/" (get id 1)) :provenance "primary" :cachedAt now))))))
      (when (= (get posts :length) 0) (fail "X 抓取未返回带时间的原帖"))
      posts))
  (defasync primary-posts (now)
    (let ((key (get (get process :env) :FIRECRAWL_API_KEY)))
      (parse-primary (if (and key (> (get key :length) 0)) (get (await (scrape "https://x.com/thsottiaux")) :html "")
                        (await (request "https://x.com/thsottiaux"))) now)))
  (defasync collect-one (name url now)
    (try
      (js-object :name name :url url :ok t :at now :body (await (request url)))
      (catch error (js-object :name name :url url :ok false :at now :error (get error :message "抓取失败")))))
  (defun cross-check (source expected now)
    (if (not (get source :ok))
      (js-object :name (get source :name) :verified false :reason "抓取失败")
      (let* (($ (load (get source :body)))
             (at (js-call (funcall $ "[data-reset-at]") :attr "data-reset-at")))
        (if at
          (js-object :name (get source :name) :verified t :lastGlobalAt at
                     :agrees (= (ms at) (ms expected)) :at now)
          (js-object :name (get source :name) :verified false :reason "页面没有可核对的重置时间，动态数据未核实")))))
  (defun firecrawl-configured? ()
    (let ((key (get (get process :env) :FIRECRAWL_API_KEY))) (and key (> (get key :length) 0))))
  (defasync collect-sources (&optional clock)
    ;; Capture the UTC clock BEFORE any fetch. No site countdown supplies time.
    (let* ((now (or clock (iso (Date/now)))) (unknowns (js-array))
           (urls (js-array
             (js-array "archive" archive-url)
             (js-array "cross-model" "https://codex-reset.com")
             (js-array "cross-banked" "https://codex.lunarwerx.com")
             (js-array "official-banked" "https://help.openai.com/en/articles/20001498")
             (js-array "status" "https://status.openai.com/api/v2/incidents.json")
             (js-array "reddit" "https://www.reddit.com/r/codex/new.json?limit=50")))
           (sources (await (Promise/all (js-call urls :map (lambda (pair) (collect-one (get pair 0) (get pair 1) now))))))
           (archive-source (get sources 0))
           (archive nil) (primary (js-array)))
      (unless (get archive-source :ok) (fail (str "历史源不可用：" (get archive-source :error))))
      (setq archive (parse-archive (get archive-source :body) now))
      (try (setq primary (await (primary-posts now)))
        (catch error (unknown unknowns (str "Tibo 主页：" (get error :message)))))
      (js-call sources :forEach
        (lambda (source)
          (unless (get source :ok) (unknown unknowns (str (get source :name) "：" (get source :error))))))
      (let* ((globals (js-call (get archive :events) :filter (lambda (e) (and (get e :global) (<= (ms (get e :at)) (ms now))))))
             (latest (get globals (- (get globals :length) 1)))
             (checks (js-array (cross-check (get sources 1) (get latest :at) now)
                               (cross-check (get sources 2) (get latest :at) now))))
        (put archive :crossChecks checks)
        (js-call checks :forEach
          (lambda (check)
            (when (or (not (get check :verified)) (not (get check :agrees)))
              (unknown unknowns (str "交叉核对 " (get check :name) "："
                (get check :reason "重置时间与历史源不一致，未采纳")))))))
      (let ((cached-at (get archive :cachedAt)))
        (if cached-at
          (unknown unknowns (str "Tibo 存档缓存 " (utc cached-at) "；无法确认其后是否有新帖"))
          (unknown unknowns "Tibo 存档缓存时间未核实")))
      (unless (firecrawl-configured?) (unknown unknowns "Firecrawl 近 24h 新闻搜索：未配置"))
      (when (firecrawl-configured?)
        (try
          (let ((key (get (get process :env) :FIRECRAWL_API_KEY)))
            (js-call sources :push (js-object :name "news" :ok t :at now :body
              (JSON/stringify (await (request-json "https://api.firecrawl.dev/v2/search"
                (js-object :method "POST" :headers (js-object :authorization (str "Bearer " key) :content-type "application/json")
                 :body (JSON/stringify (js-object :query "Codex reset OpenAI incident" :limit 5 :tbs "qdr:d")))))))))
          (catch error (unknown unknowns (str "Firecrawl 新闻：" (get error :message))))))
      (js-object :schemaVersion 1 :now now :events (get archive :events)
       :posts (sorted (merge-posts (get archive :posts) primary) "at")
       :cachedAt (get archive :cachedAt) :crossChecks (get archive :crossChecks) :sources sources :unknowns unknowns)))
  (defun merge-posts (cached primary)
    (let ((items (new Map)))
      (js-call cached :forEach (lambda (p) (js-call items :set (get p :id) p)))
      (js-call primary :forEach (lambda (p) (js-call items :set (get p :id) p)))
      (Array/from (js-call items :values))))
  (export parse-archive parse-primary collect-sources merge-posts cross-check))
