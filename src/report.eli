(module tibo.report
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "./availability.eli" usage-text)
  (import "./util.eli" utc beijing clean days decimal values ms hour-ms last-item)
  (defun bullet (label text) (str "• " label "：" (clean text)))
  (defun ratios (sample) (str (get sample :a) "/" (get sample :n) "、" (get sample :b) "/" (get sample :n)))
  (defun promise-text (promise)
    (cond ((not promise) "未核实（已读原文未识别，完整性未核实）")
          (t (str "有（" (get promise :scope) "，" (utc (get promise :targetAt)) "，"
                  (if (get promise :fulfilled) "已消耗" "尚未确认兑现") "）"))))
  (defun describe-incident (snapshot signals)
    (let* ((source (js-call (get snapshot :sources) :find (lambda (s) (= (get s :name) "status"))))
           (global (get signals :lastGlobal)) (incidents (js-array)))
      (if (and source (get source :ok))
        (try
          (setq incidents (get (JSON/parse (get source :body)) :incidents (js-array)))
          (let ((relevant (js-call incidents :filter
                (lambda (i) (and (>= (ms (get i :updated_at)) (- (ms (get snapshot :now)) (* 48 hour-ms)))
                                (<= (ms (get i :updated_at)) (ms (get snapshot :now)))
                                (js-call (get i :components (js-array)) :some (lambda (c) (matches-codex (get c :name "")))))))))
            (if (> (get relevant :length) 0)
              (str "有（已核实：" (values (js-call relevant :map (lambda (i) (get i :name)))) "）；事故本身不等于补偿重置")
              "无（状态页近 48h 无带 Codex 组件的事故；未标注组件的事故未核实）"))
          (catch error "未核实（状态页结构失配）"))
        "未核实")))
  (defun matches-codex (text) (js-call (new RegExp "codex" "i") :test text))
  (defun render-numeric-report (result &optional previous title-time)
    (let* ((snapshot (get result :snapshot)) (history (get result :history)) (signals (get result :signals))
           (prob (get result :forecast)) (now (get snapshot :now)) (posts (get snapshot :posts))
           (latest (last-item posts)) (global (get signals :lastGlobal)) (banked (get signals :lastBanked))
           (promise (get signals :promise)) (samples (get history :intervals))
           (recent-intervals (js-call samples :slice -8))
           (catalyst (last-item (get signals :catalysts)))
           (unknowns (js-call (get snapshot :unknowns) :slice))
           (lines (js-array)))
      (when (and global (not (= (get global :provenance) "primary")))
        (js-call unknowns :push "最新 global 原文由存档保留，未实时核实；个人账户是否生效未知"))
      (when (and global (not (get global :verified)))
        (js-call unknowns :push "最新 global 仅为存档分类/观测；原帖完成措辞尚未确认，不能证明你的账户已刷新"))
      (when (< (get (get history :all) :n) 10) (js-call unknowns :push "条件样本小，历史频率不等于真实概率"))
      (when (and banked (not (get banked :verifiedBanked))) (js-call unknowns :push "最近 banked 尚未核对原文，仅见站点记录"))
      (js-call lines :push (str "**Codex 重置判断｜北京时间 " (beijing (or title-time now)) "**"))
      (js-call lines :push "**结论**")
      (js-call lines :push (bullet "24h 内 global 重置概率" (str (get prob :p24) "%")))
      (js-call lines :push (bullet "48h 内 global 重置概率（含 24h）" (str (get prob :p48) "%")))
      (js-call lines :push (bullet "置信度" (get prob :confidence)))
      (js-call lines :push "**客观数据**")
      (js-call lines :push (bullet "Tibo 最新一条"
        (if latest (str (utc (get latest :at)) "｜" (get latest :text)) "未核实")))
      (js-call lines :push (bullet "上次 global" (str (utc (get global :at)) "，距今 " (decimal (get history :elapsedDays))
        " 天。明确承诺：" (promise-text promise) "；" (if (and promise (get promise :fulfilled)) "旧信号权重归零" "前次重置前的旧信号不重复计权"))))
      (js-call lines :push (bullet "近期 global 间隔（天）"
        (str (values (js-call recent-intervals :map (lambda (i) (decimal (days (get i :duration)))))) "，"
          (utc (get history :start)) " 起共 " (get history :count) " 个（含存档观测）")))
      (js-call lines :push (bullet "条件样本" (str "已等 " (decimal (get history :elapsedDays)) " 天后，24h 内 "
        (get (get history :all) :a) "/" (get (get history :all) :n) "，48h 内 " (get (get history :all) :b) "/" (get (get history :all) :n)
        "；最近 12 个间隔 " (ratios (get history :recent)))))
      (js-call lines :push (bullet "最近一次 banked"
        (if banked (str (utc (get banked :at)) "，来源：" (if (get banked :verifiedBanked) "Tibo 原帖" "仅站点观测")
          "；不移动 global 时钟，不重复计算已消耗承诺") "无（历史记录中未见）")))
      (js-call lines :push (bullet "事故" (describe-incident snapshot signals)))
      (js-call lines :push (bullet "催化"
        (if catalyst (str "发布/里程碑（" (get catalyst :text) "）；" (if (get catalyst :consumed) "已被前次 reset 或 banked 消耗" "未确认已消耗；不自动等同 global 承诺")) "未核实（已读近 48h 原文未识别，完整性未核实）")))
      (js-call lines :push "**概率推导**")
      (js-call lines :push (bullet "24h" (str (Math/round (get prob :base24)) "% 历史模型 → " (values (get prob :reasons)) " → " (get prob :p24) "%")))
      (js-call lines :push (bullet "48h" (str (Math/round (get prob :base48)) "% 历史模型 → " (values (get prob :reasons)) " → " (get prob :p48) "%")))
      (js-call lines :push (bullet "信号判断" (str (get prob :signal) "；证据强度 " (get prob :signalStrength) "；与历史概率分开")))
      (js-call lines :push (bullet "模型验证" (str "可用 " (get (get prob :model) :usableIntervals) " 个间隔，排除 "
        (get (get prob :model) :excludedIntervals) " 个观测间隔；逐步回测 " (get (get (get prob :model) :evaluation) :n)
        " 个时点（窗口相关，非线上成绩）；未证明概率已校准")))
      (js-call lines :push (str "**未核实项**：" (if (= (get unknowns :length) 0) "无" (values unknowns))))
      (js-call lines :push "**执行摘要**")
      (js-call lines :push (bullet "关键数据点" (str (get prob :p24) "%/" (get prob :p48) "%；距上次 global "
        (decimal (get history :elapsedDays)) " 天；Tibo 最新一条：" (if latest (str (utc (get latest :at)) "｜" (get latest :text)) "未核实"))))
      (js-call lines :push (bullet "变化趋势"
        (if previous (str "较 " (utc (get previous :now)) "，24h " (- (get prob :p24) (get previous :p24))
          " 个百分点、48h " (- (get prob :p48) (get previous :p48)) " 个百分点；根据本次时钟、条件样本与新信号重新判断") "无上一次数据")))
      (js-call lines :push (bullet "下次跟进" "检查 Tibo 新原帖与原文对象/时间；检查 global 完成回帖；区分 banked 卡与自动重置；核对 Codex 事故及补偿说明"))
      (when (get result :ai)
        (let* ((ai (get result :ai)) (features (get ai :features)))
          (js-call lines :push "**AI 辅助（模型推断，非核实事实）**")
          (js-call (Object/keys features) :forEach (lambda (name)
            (let ((feature (get features name)))
              (js-call lines :push (bullet name (str (get feature :state)
                (if (get feature :reason) (str "；" (get feature :reason)) "")
                (if (get feature :retryAt) (str "；最早重试 " (utc (get feature :retryAt))) "")))))))
          (let ((semantic (get features :signals)) (proposal (get features :forecast)) (brief (get features :brief)))
            (let ((research (get features :research)) (review (get features :review)))
              (when (and research (get research :value))
                (js-call lines :push (bullet "资料调研" (str (get (get (get research :value) :facts) :length) "条引用事实、"
                  (get (get (get research :value) :links) :length) "条事件关联；类别与关联是AI推断，不修改global时钟"))))
              (when (and review (get review :value))
                (js-call lines :push (bullet "建议复核" (if (get (get review :value) :accept) "本次建议通过复核，仍未校准" "本次建议被拒绝，保留自有算法")))))
            (when (get semantic :value)
              (js-call (get (get semantic :value) :items) :forEach (lambda (item)
                (js-call lines :push (bullet "原帖解读" (str (get item :kind) "｜" (get item :summary) "｜" (get item :postId) "｜" (get item :quote)))))))
            (when (get proposal :value)
              (js-call lines :push (bullet "概率建议" (str "自有算法 " (get (get ai :baseline) :p24) "%/" (get (get ai :baseline) :p48)
                "%；AI " (get (get proposal :value) :p24) "%/" (get (get proposal :value) :p48) "%；权重 " (Math/round (* 100 (get ai :weight))) "%；" (get (get proposal :value) :reason)))))
            (when (get brief :value)
              (js-call lines :push (bullet "辅助摘要" (get (get brief :value) :summary)))
              (js-call lines :push (bullet "辅助跟进" (values (get (get brief :value) :followups))))))))
      (js-call lines :join "\n")))
  (defun render-report (result &optional previous title-time)
    (if (not (= (get (get result :forecast) :available) false)) (render-numeric-report result previous title-time)
      (let* ((snapshot (get result :snapshot)) (global (get (get result :signals) :lastGlobal)) (latest (last-item (get snapshot :posts))))
        (str "**Codex 重置判断｜北京时间 " (beijing (or title-time (get snapshot :now))) "**\n"
          "• 24h / 48h：暂无法估计；至少需要3个可用global间隔。\n"
          "• " (usage-text (get (get result :forecast) :information)) "。\n"
          "• 最近global：" (if global (utc (get global :at)) "未核实") "。\n"
          "• 最新原帖：" (if latest (str (utc (get latest :at)) "｜" (get latest :text) "\n" (get latest :url "")) "未核实") "\n"
          "• 已降级为证据展示；未拿到数据不代表没有重置。banked不移动global时钟，个人账户生效未知。"))))
  (export render-report describe-incident))
