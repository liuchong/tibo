(module tibo.commands
  (import "../ai/repair.eli" init-repair-budget)
  (import "../prayer/oracle.eli" oracle-trigger? oracle-reply)
  (import "../presentation/language.eli" language detect-language notice)
  (import "../presentation/syntax.eli" pipe-catalog parse-pipeline validate-stages)
  (import "../presentation/pipeline.eli" present)
  (import "../platform/util.eli" fail)
  (import "./catalog.eli" catalog visible-catalog canonical validate-query definition)
  (import "./parser.eli" fixed-query)
  (import "./router.eli" resolve-query repair-command)
  (import "./help.eli" help-text)
  (import "./execute.eli" execute-core)
  (import "../presentation/business.eli" public-forecast)
  (defasync execute-query (query &optional options)
    (setq options (or options (js-object)))
    (init-repair-budget options)
    (try
      (unless (and query (= (value-type query) "object") (not (Array/isArray query))
        (js-call (Object/keys query) :every (lambda (key) (js-call (js-array "command" "args" "pipeline" "language" "semantic" "question") :includes key)))) (fail "query-schema"))
      (validate-stages (get query :pipeline (js-array)) (= (get options :humanInput) t))
      (when (Object/hasOwn query "question") (unless (and (= (value-type (get query :question)) "string") (<= (get (get query :question) :length) 800)) (fail "query-question")))
      (when (Object/hasOwn query "semantic") (unless (= (value-type (get query :semantic)) "boolean") (fail "query-semantic")))
      (when (Object/hasOwn query "language") (unless (language (get query :language)) (fail "query-language")))
      (catch error (setq query (js-object :command "pipeline-error" :args (js-object)))))
    (when (get options :pipelineText)
      (try (put query :pipeline (get (parse-pipeline (str "result " (get options :pipelineText)) (= (get options :humanInput) t)) :stages))
        (catch error (setq query (js-object :command "pipeline-error" :args (js-object))))))
    (let* ((name (get query :command)) (stages (get query :pipeline (js-array)))
      (lang (or (language (get query :language)) (language (get options :messageLanguage)) (detect-language (get query :question (get (get query :args (js-object)) :question "")))))
      (spec (definition name)))
      (cond ((= name "pipeline-error") (js-object :ok false :text (notice lang "unsupported")))
        ((and (> (get stages :length) 0) (and spec (get spec :admin)))
          (js-object :ok false :text (notice lang "write")))
        (t
          (let* ((base (js-object :command name :args (get query :args (js-object)))))
            ;; Recover validation only, before invoking any business operation.
            ;; Runtime I/O errors and permission denials are never retried by AI.
            (when (and spec (not (get spec :admin)))
              (try (validate-query base)
                (catch error
                  (let ((repaired (when (get options :inputText) (await (repair-command (get options :inputText) (get options :context) options)))))
                    (if (and repaired (= (get repaired :command) name)) (setq base repaired) (throw error))))))
          (let* (
            (response (await (execute-core base (Object/assign (js-object) options (js-object :language lang))))))
            (when (and (get response :ok) (not (= name "ask")) (not (and spec (get spec :admin)))
                       (oracle-trigger? (get query :question (get options :inputText ""))))
              (let ((extra (await (oracle-reply (get query :question (get options :inputText "")) lang (get options :noAi)))))
                (put response :text (str (get response :text) "\n\n" (get extra :text)))))
            (when (and (not (= lang "zh")) (js-call (js-array "semantic-error" "semantic-disabled" "unsupported") :includes name))
              (put response :text (notice lang (if (= name "unsupported") "unsupported" "semantic"))))
            (if (and spec (get spec :admin)) response
              (await (present response query options (js-object :commands (visible-catalog (get options :context) t) :pipes pipe-catalog))))))))))
  (export catalog visible-catalog canonical validate-query fixed-query resolve-query execute-query public-forecast help-text))
