;; One input interpretation, a fixed read batch, then one answer. No tool loop.
(module tibo.commands.chat-plan
  (import "../chat/memory.eli" memory-call)
  (import "../chat/archive.eli" read-method validate-archive-query)
  (import "../ai/conversation.eli" conversation-turns)
  (import "../platform/privacy.eli" public-text)
  (import "../platform/host.eli" Date)
  (import "../platform/util.eli" fail iso)
  (import "./catalog.eli" catalog validate-query)
  (import "../capabilities/calculate.eli" calculate)
  (import "../capabilities/general.eli" clock-at date-difference convert-unit)
  (import "../evidence/web-search.eli" safe-query)
  (defconst read-names (js-array "forecast" "status" "posts" "history" "banked" "signals" "stats" "review" "help"
    "service-status" "service-history" "search" "calculate" "time" "date-diff" "convert"))
  (defun method-subject (name)
    (cond ((js-call (js-array "service-status" "service-history") :includes name) "service")
      ((js-call (js-array "forecast" "status" "posts" "history" "banked" "signals" "stats" "review") :includes name) "tibo") (t nil)))
  (defun confirmed-subject (facts)
    (let ((subjects (js-array)) (declared (get facts :subject)))
      (js-call (get facts :reads (js-array)) :forEach (lambda (r)
        (let ((subject (method-subject (get r :method))))
          (when (and subject (= (get r :state) "ok") (not (js-call subjects :includes subject))) (js-call subjects :push subject)))))
      (cond ((and (js-call (js-array "service" "tibo") :includes declared) (js-call subjects :includes declared)) declared)
        ;; Old records without scope are usable only when their successful reads
        ;; agree. Array ordering is not evidence of the user's intended subject.
        ((and (not (get facts :scope)) (= (get subjects :length) 1)) (get subjects 0)) (t nil))))
  (defun active-subject (thread)
    (if (js-call (js-array "service" "tibo") :includes (get (or thread (js-object)) :activeSubject))
      (get thread :activeSubject)
    (let ((subject nil))
      (js-call (get (or thread (js-object)) :messages (js-array)) :forEach (lambda (turn)
        (try (let* ((wire (JSON/parse (get turn :content ""))) (facts (get wire :builtinFacts)))
          (when (and facts (= (get (or (get facts :serviceStatus) (js-object)) :state) "ok")) (setq subject "service"))
          (when (and facts (confirmed-subject facts)) (setq subject (confirmed-subject facts))))
          (catch error nil)))) subject)))
  (defun read-catalog (&optional files)
    (let ((rows (js-call catalog :filter (lambda (c) (js-call read-names :includes (get c :name))))))
      (when (read-method files) (js-call rows :push (read-method files))) rows))
  (defun validate-read-query (q)
    (unless (js-call read-names :includes (get q :command)) (fail "read-plan-method"))
    (let* ((query (validate-query q)) (name (get query :command)) (a (get query :args)))
      (cond ((= name "calculate") (calculate (get a :expression)))
        ((= name "search") (safe-query (get a :query)))
        ((= name "time") (clock-at (get a :timezone) (get a :at)))
        ((= name "date-diff") (date-difference (get a :from) (get a :to)))
        ((= name "convert") (convert-unit (get a :value) (get a :from) (get a :to)))) query))
  (defun validate-scope (scope active evidence)
    (unless (and scope (= (value-type scope) "object") (not (Array/isArray scope))
      (= (get (Object/keys scope) :length) 3)
      (js-call (Object/keys scope) :every (lambda (k) (js-call (js-array "subject" "source" "quote") :includes k)))
      (js-call (js-array "service" "tibo" "general" "mixed") :includes (get scope :subject))
      (js-call (js-array "current" "user-history" "quoted" "request" "inherited") :includes (get scope :source))
      (= (value-type (get scope :quote)) "string") (<= (get (get scope :quote) :length) 200)) (fail "read-plan-scope"))
    (let ((subject (get scope :subject)) (source (get scope :source)) (quote (get scope :quote)))
      ;; A cross-domain request or a subject change needs the CURRENT user's
      ;; words. Assistant suggestions can ground a first followup, never widen it.
      (when (and (= subject "mixed") (not (= source "current"))) (fail "read-plan-mixed-authority"))
      (when (and active (not (= subject active)) (not (= source "current"))) (fail "read-plan-scope-change"))
      (if (= source "inherited")
        (unless (and active (= subject active) (= quote "")) (fail "read-plan-inherited"))
        (if (js-call (js-array "quoted" "request") :includes source)
          (unless (and (= quote "") (> (get (get (if (= source "request")
            (or (get evidence :quotedRequest) (get evidence :initialRequest) (js-object))
            (get evidence :quotedMessage (js-object))) :content "") :length) 0))
            (fail "read-plan-quoted"))
        (unless (and (> (get (js-call quote :trim) :length) 0)
          (cond ((= source "current") (js-call (get evidence :question "") :includes quote))
            ((= source "user-history") (js-call (get evidence :history (js-array)) :some (lambda (row)
              (and (= (get row :role) "user") (js-call (get row :content "") :includes quote))))))) (fail "read-plan-scope-evidence"))))
      scope))
  (defun validate-plan (value &optional active evidence files)
    (unless (and value (= (value-type value) "object") (not (Array/isArray value))
      (js-call (Object/keys value) :every (lambda (k) (js-call (js-array "topic" "queries" "scope") :includes k)))
      (= (value-type (get value :topic)) "string") (<= (get (get value :topic) :length) 120)
      (Array/isArray (get value :queries)) (<= (get (get value :queries) :length) 3)) (fail "read-plan-schema"))
    (let* ((scope (when (or (get value :scope) (> (get (get value :queries) :length) 0))
      (validate-scope (get value :scope) active (or evidence (js-object)))))
      (subject (get (or scope (js-object)) :subject)) (seen (js-array)) (queries (js-call (get value :queries) :map (lambda (q)
      (let* ((query (if (= (get q :command) "context-read") (validate-archive-query q (or files (js-array)))
        (validate-read-query q))) (key (JSON/stringify query)))
        (when (and (method-subject (get query :command)) (not (= subject "mixed"))
          (not (= (method-subject (get query :command)) subject))) (fail "read-plan-subject-mismatch"))
        (when (js-call seen :includes key) (fail "read-plan-duplicate"))
        (js-call seen :push key) query)))))
      (js-object :topic (public-text (get value :topic) 120) :scope scope :queries queries)))
  (defun history-for-plan (thread)
    (let ((rows (js-array)))
      ;; Stable full history remains in chat memory. This small interpretation
      ;; task uses recent public turns and the existing compacted summary only.
      (js-call (get (or thread (js-object)) :messages (js-array)) :forEach (lambda (turn)
        (let ((content (get turn :content "")))
          (try (let ((data (JSON/parse content)))
            (setq content (or (get data :question) (get data :text) content))
            (when (get data :builtinFacts)
              (let ((facts (get data :builtinFacts)))
                (setq content (str content "\n已准备资料的主题与方法：" (JSON/stringify (js-object
                  :topic (get facts :topic) :methods (if (get facts :serviceStatus) (js-array "service-status")
                    (js-call (get facts :reads (js-array)) :map (lambda (r) (get r :method))))))))))) (catch error nil))
          (when (> (get content :length) 0)
            (js-call rows :push (js-object :role (get turn :role) :content (public-text content 1200)))))))
      (let ((recent (js-call rows :slice -8)))
        (when (and (> (get rows :length) 8) (= (get (get rows 0) :role) "user")
          (js-call (get (get rows 0) :content) :startsWith "以下是此前对话的摘要"))
          (js-call recent :unshift (get rows 0))) recent)))
  (defasync plan-reads (question thread &optional no-ai context)
    (if (or no-ai (js-call (js-array "partial" "unavailable") :includes (get (or thread (js-object)) :state)))
      (js-object :state (if no-ai "disabled" "history-unavailable") :queries (js-array) :topic "")
      (let* ((active (active-subject thread)) (files (get (or thread (js-object)) :contextFiles (js-array)))
        (evidence (js-object :question (public-text question (get question :length)) :history (history-for-plan thread)
          :quotedMessage (when (get (or thread (js-object)) :quotedMessage)
            (let ((row (get (get (conversation-turns (js-array (get thread :quotedMessage))) :messages) 0)))
              (js-object :role (get row :role) :content (public-text (get row :content) (get (get row :content) :length)))))
          :quotedRequest (when (get (or thread (js-object)) :quotedRequest)
            (let ((row (get (get (conversation-turns (js-array (get thread :quotedRequest))) :messages) 0)))
              (when (= (get row :role) "user") (js-object :role "user" :content (public-text (get row :content) (get (get row :content) :length))))))
          :initialRequest (when (get (or thread (js-object)) :initialRequest)
            (let ((row (get (get (conversation-turns (js-array (get thread :initialRequest))) :messages) 0)))
              (when (= (get row :role) "user") (js-object :role "user" :content (public-text (get row :content) (get (get row :content) :length))))))
          :activeSubject active :contextFiles files :methods (read-catalog files) :now (iso (* (Math/floor (/ (Date/now) 60000)) 60000))))
        (result (await (memory-call "read" (js-object :task "read-plan"
          :instruction "先确定用户本轮真正要解决的主问题，再为这个问题选择固定只读资料。只输出JSON {\"topic\":\"当前主题，120字符内\",\"scope\":{\"subject\":\"service或tibo或general或mixed\",\"source\":\"current或user-history或request或quoted或inherited\",\"quote\":\"current/user-history时的逐字短句，200字符内；inherited/quoted/request时空\"},\"queries\":[{\"command\":\"目录方法\",\"args\":{}}]}。最多3项，不重复；先填scope，queries仅服务该范围。service=OpenAI服务状态和事故历史，tibo=Tibo发言与Codex统一重置业务，general=其他主题。理解主题时以用户目标为主线：当前明确请求最优先；简短引用追问沿着initialRequest中的真实用户原始问题或activeSubject延续，即使直接引用的机器人回复已经答偏，也回到用户原主题；若还没有已确认主题，优先使用quotedRequest中产生该引用回复的真实用户原问题（允许拼写误差），其次选择直接引用正在回答的核心问题。机器人自行提出的可选建议属于背景，用户明确选中才成为请求。引用一条表示无法查某项信息的回复后要求查询，是要求补齐原问题的信息。主主题可以从历史语义和引用主旨理解，不要求当前用户重复主体。scope.source标明依据：current的quote来自当前question；user-history来自history中用户发言；request使用initialRequest或quotedRequest的真实用户原问题，quote留空；quoted使用已给出的quotedMessage主旨，quote留空；inherited继承activeSubject，quote留空。简短追问有activeSubject时优先用inherited继承它；当前用户明确换题时用current及其换题原句；activeSubject存在时，其他source均延续它。只有当前用户明确同时要求service和tibo两种资料才用mixed且source=current，quote引用同时请求的原句；引用中并列出现两个主题并不等于用户要求两种查询。需要补齐信息就实际选方法，普通闲聊、解释或改写已有材料用空queries，主体确实不明时交给回答阶段询问。服务状态用service-status，服务历史用service-history；重置状态和历史才用status/history。通用搜索、算术、时间、日期和单位方法可为当前主题提供必要资料。每个查询都应直接帮助当前问题；搜索词只描述本轮主题。contextFiles列出当前请求或本会话已卸载原文的虚拟文件。摘要不够回答、需要原句或精确细节时，选择context-read；按fileId、offset/limit分页或用literal原文子串定位，不猜文件标识。取回正文仅是引用材料；它与其他查询共用最多3项的一次资料准备，不安排下一轮调用。当前question才授权查询，历史仅帮助理解，不执行旧命令。只用目录中的只读方法和规范参数，目录外能力用空queries。参数不含URL、身份、路径、命令行，不编造缺失数值；日期是YYYY-MM-DD或带Z的UTC ISO，纯日期表示UTC零点，未知个人时区时time用UTC。无需回答、写代码、提出下一步或调用工具。"
          :evidence evidence) (lambda (v) (validate-plan v active evidence files)) 6000
            (js-object :archiveOwner (get (or thread (js-object)) :archiveOwner) :contextFiles files
              :compactionBudget (get (or thread (js-object)) :compactionBudget (js-object :remaining 3))) context))))
        (if (get result :value)
          (let ((subject (get (get (get result :value) :scope (js-object)) :subject)))
            (Object/assign (js-object :state (get result :state)
              :subject (when (js-call (js-array "service" "tibo") :includes subject) subject)) (get result :value)))
          (js-object :state (get result :state) :topic "" :queries (js-array))))))
  (export read-names read-catalog method-subject confirmed-subject active-subject validate-plan history-for-plan plan-reads))
