(module tibo.commands.catalog
  (import "../platform/host.eli" Number RegExp)
  (import "../platform/privacy.eli" public-text source-free-text)
  (import "./admin.eli" is-admin can-manage-group?)
  (import "../subscriptions/registry.eli" parse-subscription-items)
  (import "../capabilities/general.eli" units)
  (import "../evidence/web-policy.eli" public-url)
  (import "../platform/util.eli" fail ms)
  (defconst subscription-params (js-object
    :target (js-object :type "string" :enum (js-array "personal" "group") :default "personal")
    :chatId (js-object :type "string" :format "Lark-chat-ID" :maxLength 100)
    :items (js-object :type "string" :format "subscription-items" :default "all" :maxLength 120
      :description "订阅项目，可选 all(默认全部)、alerts(仅重置预警与确认，不含每日预测)、warnings(仅重置前预警)、daily(仅每日09:00/21:00定点预测)、promise(明确承诺预警)、probability(高概率预警)、confirmed(已重置确认)，支持逗号组合")))
  (defconst subscription-status-params (js-object
    :target (js-object :type "string" :enum (js-array "personal" "group") :default "personal")
    :chatId (js-object :type "string" :format "Lark-chat-ID" :maxLength 100)))
  (defconst catalog
    (js-array
      (js-object :name "forecast" :aliases (js-array "预测" "概率" "重置" "/tibo") :purpose "查询未来24h/48h global重置概率及已识别的预告期限；需要按提问解释下一次几点、还要多久、最晚何时，使用ask读取forecast后针对性回答"
        :params (js-object :horizon (js-object :type "string" :enum (js-array "24" "48" "both") :default "both") :noAi (js-object :type "boolean" :default false)) :positionals (js-array "horizon"))
      (js-object :name "status" :aliases (js-array "状态") :purpose "固定状态概览：是否刚重置、上次global时间、已过多久、当前重置预告期限、上次global后7天参考倒计时；实际个人每周自动刷新时间未知，7天自动刷新不算强行global。可判断指定UTC时间之后是否有公告"
        :params (js-object :since (js-object :type "string" :format "UTC-ISO-8601")) :positionals (js-array "since"))
      (js-object :name "posts" :aliases (js-array "发言" "推文" "tweets" "x" "原文") :purpose "查询Tibo的X原文，最新在前；可筛选条数、近多少小时、关键词或postId；固定命令返回原文"
        :params (js-object :limit (js-object :type "integer" :minimum 1 :maximum 10 :default 3)
          :hours (js-object :type "integer" :minimum 1 :maximum 168 :default 48)
          :postId (js-object :type "string" :maxLength 20 :format "X-ID")
          :keyword (js-object :type "string" :maxLength 80 :description "原文子串，忽略大小写；重置可用reset，并非语义全文搜索")) :positionals (js-array "limit" "keyword"))
      (js-object :name "history" :aliases (js-array "历史" "公告历史") :purpose "只读查询global/banked公告历史，最新在前"
        :params (js-object :limit (js-object :type "integer" :minimum 1 :maximum 20 :default 5)
          :kind (js-object :type "string" :enum (js-array "global" "banked" "all") :default "all")) :positionals (js-array "limit" "kind"))
      (js-object :name "banked" :aliases (js-array "发卡" "卡") :purpose "查询最近一次banked发卡及证据等级，不移动global时钟" :params (js-object) :positionals (js-array))
      (js-object :name "signals" :aliases (js-array "信号") :purpose "查询近48h已识别的承诺、暗示、补偿及发布信号" :params (js-object) :positionals (js-array))
      (js-object :name "stats" :aliases (js-array "统计") :purpose "查询历史global间隔的均值、中位数、最短/最长及可用样本量" :params (js-object) :positionals (js-array))
      (js-object :name "review" :aliases (js-array "复盘" "预测复盘") :purpose "只读查看最近实际预测及24h/48h内是否遇到已完成global公告；重叠窗口不能当独立准确率，个人7天自动刷新不计入" :params (js-object) :positionals (js-array))
      (js-object :name "help" :aliases (js-array "帮助" "commands" "命令") :purpose "查看当前身份可用的业务命令和参数" :params (js-object) :positionals (js-array))
      (js-object :name "pray" :aliases (js-array "祈祷" "上香" "🙏") :purpose "趣味电子上香；offer祈祷一次，me查看本人档案，board查看本会话匿名功德榜，stats查看本会话愿力池、已解锁的集体彩蛋及仪式内容。询问什么集体彩蛋、十次上香效果应选stats，不选ask。集体彩蛋按会话上香次数10/50/100/233/500/1000解锁，个人功德15秒冷却；不能改变重置概率，需要可信本人身份"
        :params (js-object :action (js-object :type "string" :enum (js-array "offer" "me" "board" "stats") :default "offer")
          :limit (js-object :type "integer" :minimum 1 :maximum 20 :default 10)) :positionals (js-array "action" "limit"))
      (js-object :name "subscribe" :aliases (js-array "订阅") :purpose "默认订阅本人私聊通知；target=personal默认；target=group由本群群主、群管理员或Tibo管理员在本群申请并二次确认（本群省略chatId；系统管理员可在私聊/操作群指定chatId）。items支持精细化按项订阅：all（默认全部）、alerts（仅重置预警与已重置确认，不含每日定点预测）、daily（仅每日09:00/21:00定点预测）、promise（明确承诺预警）、probability（高概率预警）、confirmed（已重置确认），支持逗号组合；不能代他人或自定义时间" :params subscription-params :positionals (js-array "target" "chatId" "items"))
      (js-object :name "unsubscribe" :aliases (js-array "退订" "取消订阅") :purpose "默认取消本人私聊订阅；target=group由本群群主、群管理员或Tibo管理员申请退订并二次确认；items默认all全部退订，也可指定daily、alerts、promise、probability、confirmed等单独退订某项并保留其余订阅" :params subscription-params :positionals (js-array "target" "chatId" "items"))
      (js-object :name "subscription" :aliases (js-array "订阅状态") :purpose "默认查看本人私聊订阅状态与已订阅项目；target=group由本群群主、群管理员或Tibo管理员查看本群订阅状态与项目，省略chatId规则同subscribe" :params subscription-status-params :positionals (js-array "target" "chatId"))
      (js-object :name "ask" :aliases (js-array "问答") :purpose "基础问答：理解用户真正想知道的结果，按需检索核实，再给简短结论及关键来源；支持商家联系方式、地址营业时间、一般事实、概念和文字处理；自然语言询问下一次重置的具体时间或还要等多久，读取forecast的resetTiming并解释预告时间窗口；可按需查官方服务状态、公开搜索与网页原文、数字计算和时间；引用时延续同一对话Thread，未引用时单轮；不能执行命令或操作账户，不提供未抓取的新事件事实"
        :params (js-object :question (js-object :type "string" :required t)) :positionals (js-array "question"))
      (js-object :name "service-status" :aliases (js-array) :purpose "查询OpenAI官方服务整体、组件与进行中事故；不同于Codex重置状态"
        :params (js-object) :positionals (js-array))
      (js-object :name "service-history" :aliases (js-array) :purpose "查询OpenAI官方服务事故历史，含已解决事故、时间与更新；不查询重置公告。官方最近一页可能不覆盖完整范围"
        :params (js-object :limit (js-object :type "integer" :minimum 1 :maximum 20 :default 8)
          :days (js-object :type "integer" :minimum 1 :maximum 90 :default 14)
          :component (js-object :type "string" :maxLength 80)) :positionals (js-array "limit" "days" "component"))
      (js-object :name "search" :aliases (js-array) :purpose "固定资料检索方法：合并多引擎结果，默认读取最多三个不同域名的正文；read=false仅返回标题摘要。自然语言要最终答案的事实问题使用ask整理，明确要资料或链接列表时直接search"
        :params (js-object :query (js-object :type "string" :maxLength 200 :required t) :read (js-object :type "boolean" :default t)) :positionals (js-array "query"))
      (js-object :name "read-page" :aliases (js-array "读网页") :purpose "读取给定公开网页原文，保留来源、正文和获取状态；必要时渲染页面；不支持登录、文件下载或执行用户脚本"
        :params (js-object :url (js-object :type "string" :maxLength 2048 :format "public-url" :required t)) :positionals (js-array "url"))
      (js-object :name "calculate" :aliases (js-array "calc") :purpose "有限浮点数字算术：括号、加减乘除、取余、幂；只解析数字，不执行代码"
        :params (js-object :expression (js-object :type "string" :maxLength 256 :required t)) :positionals (js-array "expression"))
      (js-object :name "time" :aliases (js-array) :purpose "当前或指定时刻的UTC与IANA时区时间；timezone例如UTC、Asia/Shanghai、America/Los_Angeles，不使用运行环境时区"
        :params (js-object :timezone (js-object :type "string" :maxLength 80 :default "UTC") :at (js-object :type "string" :maxLength 40)) :positionals (js-array "timezone" "at"))
      (js-object :name "date-diff" :aliases (js-array) :purpose "两个明确日期或UTC时刻的有符号时间差，返回秒/小时/天；日期YYYY-MM-DD表示UTC零点，时间须带Z"
        :params (js-object :from (js-object :type "string" :maxLength 40 :required t) :to (js-object :type "string" :maxLength 40 :required t)) :positionals (js-array "from" "to"))
      (js-object :name "convert" :aliases (js-array) :purpose "确定性单位换算：长度、质量、时长、数据容量与温度；不同维度拒绝，KB/MB/GB十进制、KiB/MiB/GiB二进制"
        :params (js-object :value (js-object :type "string" :maxLength 64 :required t)
          :from (js-object :type "string" :enum (Object/keys units) :required t) :to (js-object :type "string" :enum (Object/keys units) :required t)) :positionals (js-array "value" "from" "to"))
      (js-object :name "date-add" :aliases (js-array) :purpose "日期加减固定时长并给出星期和时区时间；days为24小时，weeks为7天，不表示当地夏令时日历加法"
        :params (js-object :from (js-object :type "string" :required t :maxLength 40)
          :amount (js-object :type "integer" :minimum -36600 :maximum 36600 :required t)
          :unit (js-object :type "string" :enum (js-array "seconds" "minutes" "hours" "days" "weeks") :default "days")
          :timezone (js-object :type "string" :maxLength 80 :default "UTC")) :positionals (js-array "from" "amount" "unit" "timezone"))
      (js-object :name "place" :aliases (js-array) :purpose "查询公开城市、地区或邮编的位置候选、经纬度与时区；query仅城市或邮编；国家用country的ISO两字母代码（英国GB）单独过滤，不把国家拼入query。同名城市需核对地区。不读取设备或IP位置，餐厅门店地址用search"
        :params (js-object :query (js-object :type "string" :maxLength 120 :required t)
          :limit (js-object :type "integer" :minimum 1 :maximum 3 :default 3)
          :country (js-object :type "string" :maxLength 2)) :positionals (js-array "query" "limit"))
      (js-object :name "weather" :aliases (js-array) :purpose "按用户明确给出的城市或纬度,经度查询当前天气及未来1至7天预报，城市名不拼接国家，country单独用ISO两字母代码；程序自行解析地点；返回已解析地点、当地时区、采集时间与来源"
        :params (js-object :place (js-object :type "string" :maxLength 120 :required t)
          :days (js-object :type "integer" :minimum 1 :maximum 7 :default 3)
          :country (js-object :type "string" :maxLength 2)) :positionals (js-array "place" "days"))
      (js-object :name "distance" :aliases (js-array) :purpose "两个公开城市参考点或明确纬度,经度之间的球面距离，单位km；不是驾车路线，不推断用户当前位置"
        :params (js-object :from (js-object :type "string" :maxLength 120 :required t)
          :to (js-object :type "string" :maxLength 120 :required t)
          :fromCountry (js-object :type "string" :maxLength 2) :toCountry (js-object :type "string" :maxLength 2)) :positionals (js-array "from" "to"))
      (js-object :name "clear-history" :aliases (js-array "清空历史" "重置历史") :purpose "危险写操作：申请清空本地历史缓存，需要管理员及二次确认" :admin t :params (js-object) :positionals (js-array))
      (js-object :name "clear-experience" :aliases (js-array "清空经验") :purpose "危险写操作：申请清空预测经验，需要管理员及二次确认" :admin t :params (js-object) :positionals (js-array))
      (js-object :name "reset-ai" :aliases (js-array "恢复AI" "ai-reset") :purpose "写操作：申请清除AI暂停与缓存，需要管理员及二次确认" :admin t :params (js-object) :positionals (js-array))
      (js-object :name "confirm" :aliases (js-array "确认") :purpose "只允许明确固定指令，确认本人在本会话申请的操作；AI不能代为确认" :admin t :explicit t
        :params (js-object :id (js-object :type "string" :maxLength 36 :required t)) :positionals (js-array "id"))
      (js-object :name "cancel" :aliases (js-array "取消") :purpose "取消本人在本会话的待确认操作" :admin t :explicit t
        :params (js-object :id (js-object :type "string" :maxLength 36 :required t)) :positionals (js-array "id"))))
  (defun visible-catalog (&optional context routing)
    (js-call catalog :filter (lambda (c) (and (or (not (get c :admin)) (is-admin context)
      (and (can-manage-group? context) (js-call (js-array "confirm" "cancel") :includes (get c :name))))
      (or (not routing) (not (get c :explicit)))))))
  (defun definition (name) (js-call catalog :find (lambda (c) (= name (get c :name)))))
  (defun canonical (name)
    (let ((command (js-call catalog :find (lambda (c) (or (= name (get c :name)) (js-call (get c :aliases) :includes name))))))
      (if command (get command :name) nil)))
  (defun validate-query (query)
    (unless (and query (= (value-type query) "object") (not (Array/isArray query))
                 (js-call (Object/keys query) :every (lambda (k) (or (= k "command") (= k "args"))))) (fail "命令结构不合法"))
    (let* ((name (get query :command)) (args (get query :args (js-object))) (spec (definition name)) (values (js-object)))
      (when (= name "unsupported")
        (unless (and args (= (value-type args) "object") (= (get (Object/keys args) :length) 0)) (fail "unsupported不能带参数")))
      (unless (and (or spec (= name "unsupported")) args (= (value-type args) "object") (not (Array/isArray args))) (fail "未知业务命令"))
      (when spec
        (let ((params (get spec :params)))
          (unless (js-call (Object/keys args) :every (lambda (key) (Object/hasOwn params key))) (fail "未知业务参数"))
          (js-call (Object/keys params) :forEach (lambda (key)
            (let* ((rule (get params key)) (value (if (Object/hasOwn args key) (get args key) (get rule :default))))
              (when (and (get rule :required) (nullish? value)) (fail "缺少必填参数"))
              (when (and (Object/hasOwn args key) (nullish? value)) (fail "参数不能为空"))
              (unless (nullish? value)
                (cond ((= (get rule :type) "integer")
                        (unless (and (Number/isInteger value) (>= value (get rule :minimum)) (<= value (get rule :maximum))) (fail "整数参数超出范围")))
                      ((= (get rule :type) "boolean") (unless (= (value-type value) "boolean") (fail "参数必须为布尔值")))
                      (t (unless (= (value-type value) "string") (fail "参数必须为字符串"))
                         (when (and (get rule :required) (= (get (js-call value :trim) :length) 0)) (fail "缺少必填参数"))
                         (unless (or (= (get rule :format) "Lark-chat-ID")
                           (= (public-text value (or (get rule :maxLength) (get value :length))) (source-free-text value))) (fail "参数包含非业务信息"))
                         (when (and (get rule :enum) (not (js-call (get rule :enum) :includes value))) (fail "枚举参数不合法"))
                         (when (and (get rule :maxLength) (or (= value "") (> (get value :length) (get rule :maxLength)))) (fail "关键词长度不合法"))
                         (when (get rule :format)
                           (if (= (get rule :format) "public-url") (public-url value)
                           (if (= (get rule :format) "Lark-chat-ID")
                             (unless (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test value) (fail "chatId必须为Lark群ID"))
                           (if (= (get rule :format) "subscription-items")
                             (parse-subscription-items value)
                           (if (= (get rule :format) "X-ID")
                             (unless (js-call (new RegExp "^[0-9]{16,20}$") :test value) (fail "postId必须为X帖子ID"))
                             (progn
                               (unless (js-call (new RegExp "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$") :test value) (fail "since必须为UTC时间"))
                               (ms value)))))))))
                (put values key value)))))))
      (js-object :command name :args values)))
  (defun write-query? (query)
    (or (get (or (definition (get query :command)) (js-object)) :admin)
      (and (js-call (js-array "subscribe" "unsubscribe") :includes (get query :command))
        (= (get (get query :args (js-object)) :target "personal") "group"))))
  (export catalog visible-catalog definition canonical validate-query write-query?))
