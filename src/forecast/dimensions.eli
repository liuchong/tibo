(module tibo.forecast.dimensions
  (import "../platform/util.eli" ms hour-ms clamp)
  (import "./promise-prior.eli" delivery-cdf)
  (defconst weights (js-object :before_last_reset 0 :after_last_reset 0.30 :last_48h 0.15
    :last_24h 0.20 :latest_three 0.15 :latest_anchored_24h 0.20 :official_context 0))
  (defconst delivery-prior (js-object :alpha 19 :beta 1 :kind "engineering-prior" :learned false))
  (defun language-score (row)
    (Math/max 0 (Math/min 1 (- (* (get row :support) (+ 0.5 (* 0.5 (get row :commitment)))
      (+ 0.8 (* 0.2 (get row :imminence)))) (get row :opposition)))))
  (defun apply-dimensions (result input assessment)
    (let* ((prob (get result :forecast)) (p (get (get result :signals) :promise)) (global (get (get result :signals) :lastGlobal))
      (now (ms (get (get result :snapshot) :now))) (base24 (get prob :base24)) (base48 (get prob :base48))
      (active (and p (get p :primary) (= (get p :kind) "global") (not (get p :fulfilled)) (not (get p :withdrawn))
        (or (not global) (> (ms (get p :at)) (ms (get global :at))))))
      (eligible (if active (js-array (get p :postId) (get p :parentId)) (js-array)))
      (sum 0) (mass 0) (rows (js-array))
      (historical (get (js-call (get input :windows) :find (lambda (w) (= (get w :name) "before_last_reset"))) :ids)))
      (js-call (get assessment :dimensions) :forEach (lambda (score)
        (let* ((name (get score :name)) (raw (language-score score))
          (window (js-call (get input :windows) :find (lambda (w) (= (get w :name) name))))
          (relevant (js-call (get score :citations) :some (lambda (ref) (js-call eligible :includes (get ref :postId)))))
          (weight (if relevant (get weights name 0) 0))
          (consumed (get (js-call (get score :citations) :filter (lambda (ref)
            (or (js-call historical :includes (get ref :postId)) (and global (= (get ref :postId) (get global :id)))))) :length))
          (purity (if (> (get (get score :citations) :length) 0) (- 1 (/ consumed (get (get score :citations) :length))) 0))
          (effective (if relevant (* raw purity) 0)))
          (setq mass (+ mass weight) sum (+ sum (* weight effective)))
          (js-call rows :push (Object/assign (js-object) window score
            (js-object :rawScore raw :consumedCitations consumed :unconsumedShare purity :effectiveScore effective
              :weight weight :contribution (* weight effective)))))))
      (let* ((strength (if (> mass 0) (/ sum mass) 0))
        ;; Linguistic strength is not a calibrated delivery probability. Use it
        ;; to discount prior odds once, rather than multiplying several scores
        ;; as independent chances of the same promise being fulfilled.
        (odds (* (/ (get delivery-prior :alpha) (get delivery-prior :beta)) strength))
        (q (/ odds (+ 1 odds)))
        (model (js-object :policy "dimensional-delivery-1" :at (get (get result :snapshot) :now) :source (get assessment :state "fallback")
          :dimensions rows :prior delivery-prior :strength strength :deliveryProbability q :baseline24 base24 :baseline48 base48
          :applied false :reason (if active "no-eligible-support" "no-unconsumed-commitment"))))
        (put prob :dimensions model)
        (put prob :policyVersion "10")
        (when (get prob :promisePrior)
          (put (get prob :promisePrior) :applied false)
          (put (get prob :promisePrior) :supersededBy "dimensional-delivery-1"))
        ;; The same original temporal baseline is always retained, including
        ;; after model failures. Never compound an older promise uplift.
        (unless (get (get prob :promisePolicy (js-object)) :applied)
          (put prob :p24 (clamp base24)) (put prob :p48 (Math/max (get prob :p24) (clamp base48)))
          (when (and active (> strength 0))
            (let* ((published (ms (get p :at))) (deadline (ms (get p :targetAt))) (delay 3)
              (seen (delivery-cdf now published deadline delay)) (values (js-array)) (delivery (js-array)))
              (js-call (js-array 24 48) :forEach (lambda (hours index)
                (let* ((future (delivery-cdf (+ now (* hours hour-ms)) published deadline delay))
                  (remaining (/ (* q (Math/max 0 (- future seen))) (Math/max 0.000001 (- 1 (* q seen)))))
                  (base (/ (if (= index 0) base24 base48) 100)))
                  (js-call delivery :push remaining)
                  (js-call values :push (clamp (* 100 (- 1 (* (- 1 base) (- 1 remaining)))))))))
              (put prob :p24 (get values 0)) (put prob :p48 (Math/max (get values 0) (get values 1)))
              (put prob :mode "dimensional-delivery") (put prob :confidence "中")
              (put model :applied t) (put model :reason "validated-current-delivery")
              (put model :remaining24 (get delivery 0)) (put model :remaining48 (get delivery 1))
              (put model :delayHours delay) (put model :timePrecision (get p :timePrecision))
              (put model :postId (get p :postId)) (put model :targetAt (get p :targetAt))
              (put prob :announcement (js-object :postId (get p :postId) :targetAt (get p :targetAt))))))
        ;; Normalised weights expose overlap without treating windows as
        ;; independent reset opportunities.
        (js-call rows :forEach (lambda (row) (put row :normalisedWeight (if (> mass 0) (/ (get row :weight) mass) 0))))
        result)))
  (export apply-dimensions weights language-score))
