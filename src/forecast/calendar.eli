(module tibo.forecast.calendar
  (import "../platform/util.eli" ms iso day-ms hour-ms sorted clamp)
  (import "../platform/time.eli" time-settings local-vector)
  (import "./models.eli" baseline-curve)
  (defconst policy "calendar-hazard-2")
  (defconst names (js-array "weekday" "dayOfMonth" "monthPhase" "hourBucket"))
  (defun timestamp (at) (if (= (value-type at) "number") at (ms at)))
  (defun survival (p) (Math/max 0.000001 (- 1 (/ p 100))))
  (defun cumulative-hazard (p) (* -1 (Math/log (survival p))))
  (defun calendar-vector (at zone) (local-vector at zone))
  (defun temporal-history (events now)
    (let* ((settings (time-settings)) (zone (get settings :forecastZone))
      (globals (sorted (js-call events :filter (lambda (e) (and (get e :global) (<= (ms (get e :at)) (ms now))))) "at"))
      (rows (js-array)) (previous nil))
      (js-call globals :forEach (lambda (event)
        (let ((gap (when previous (- (ms (get event :at)) (ms (get previous :at))))))
          (js-call rows :push (js-object :id (get event :id) :at (get event :at) :intervalMs gap
            :intervalHours (when gap (/ gap hour-ms)) :intervalDays (when gap (/ gap day-ms))
            :observed (get event :observed false) :verified (get event :verified false)
            :utc (calendar-vector (get event :at) "UTC") :pacific (calendar-vector (get event :at) "America/Los_Angeles")
            :local (calendar-vector (get event :at) zone)))
          (setq previous event))))
      (js-object :policy policy :settings settings :zone zone :events rows :recent (js-call rows :slice -12)
        :elapsedMs (when previous (- (ms now) (ms (get previous :at))))
        :elapsedHours (when previous (/ (- (ms now) (ms (get previous :at))) hour-ms))
        :elapsedDays (when previous (/ (- (ms now) (ms (get previous :at))) day-ms))
        :now (js-object :utc (calendar-vector now "UTC") :pacific (calendar-vector now "America/Los_Angeles")
          :local (calendar-vector now zone)))))
  (defun buckets (count prior-days)
    (js-call (Array/from (js-object :length count)) :map
      (lambda () (js-object :events 0 :exposureDays 0 :priorExposureDays prior-days :factor 1))))
  (defun tables () (js-object :weekday (buckets 7 14) :dayOfMonth (buckets 31 28)
    :monthPhase (buckets 3 28) :hourBucket (buckets 8 14)))
  (defun add-buckets (tables vector key amount)
    (js-call names :forEach (lambda (name)
      (let* ((index (- (get vector name) (if (= name "dayOfMonth") 1 0))) (bucket (get (get tables name) index)))
        (put bucket key (+ (get bucket key) amount))))))
  (defun decay (at now half-life)
    (Math/exp (* -1 (Math/log 2) (/ (- (timestamp now) (timestamp at)) (* half-life day-ms)))))
  (defun rate-tables (timeline now)
    (let* ((zone (get timeline :zone (get (time-settings) :forecastZone)))
      (events (js-call (get timeline :events) :filter (lambda (e) (and (get e :verified) (not (get e :observed))))))
      (first (get events 0)) (start (if first (ms (get first :at)) (ms now)))
      (profiles (js-call (js-array 45 180) :map (lambda (h) (js-object :halfLifeDays h :tables (tables)
        :eventMass 0 :squaredMass 0 :exposureDays 0)))) (cursor start))
      ;; UTC quarter-hour exposure follows IANA wall-clock transitions, including
      ;; DST and zones with fractional offsets. Missing archive coverage stays explicit.
      (while (< cursor (ms now))
        (let* ((end (Math/min (ms now) (* (+ (Math/floor (/ cursor 900000)) 1) 900000)))
          (middle (/ (+ cursor end) 2)) (v (calendar-vector middle zone)))
          (js-call profiles :forEach (lambda (profile)
            (let ((w (* (/ (- end cursor) day-ms) (decay middle now (get profile :halfLifeDays)))))
              (add-buckets (get profile :tables) v "exposureDays" w)
              (put profile :exposureDays (+ (get profile :exposureDays) w)))))
          (setq cursor end)))
      (js-call (js-call events :slice 1) :forEach (lambda (e)
        (js-call profiles :forEach (lambda (profile)
          (let ((w (decay (get e :at) now (get profile :halfLifeDays))))
            (add-buckets (get profile :tables) (get e :local) "events" w)
            (put profile :eventMass (+ (get profile :eventMass) w))
            (put profile :squaredMass (+ (get profile :squaredMass) (* w w))))))))
      (js-call profiles :forEach (lambda (profile)
        (let* ((mass (get profile :eventMass)) (exposure (get profile :exposureDays))
          (effective (if (> (get profile :squaredMass) 0) (/ (* mass mass) (get profile :squaredMass)) 0))
          (base (if (> exposure 0) (/ mass exposure) 0)) (global-shrink (/ effective (+ effective 20))))
          (put profile :rate base) (put profile :effectiveN effective)
          (js-call names :forEach (lambda (name)
            (let ((rows (get (get profile :tables) name)) (average 0))
              (js-call rows :forEach (lambda (bucket)
                (let* ((n (get bucket :events)) (tau (get bucket :priorExposureDays))
                  (posterior (if (> base 0) (/ (+ n (* base tau)) (+ (get bucket :exposureDays) tau)) 0))
                  (ratio (if (> base 0) (/ posterior base) 1))
                  (shrink (* global-shrink (/ n (+ n 3))))
                  (factor (Math/exp (* shrink (Math/log (Math/max 0.000001 ratio))))))
                  (put bucket :rateRatio ratio) (put bucket :shrink shrink) (put bucket :factor factor)
                  (setq average (+ average (* factor (get bucket :exposureDays)))))))
              (setq average (if (> exposure 0) (/ average exposure) 1))
              (js-call rows :forEach (lambda (bucket) (put bucket :factor (/ (get bucket :factor) average))))))))))
      (Object/assign (js-object :policy policy :zone zone :profiles profiles :coverage "observed-ledger"
        :rawExposureDays (/ (- (ms now) start) day-ms)) (get profiles 1))))
  (defun calendar-factor (rates at)
    (let* ((v (calendar-vector at (get rates :zone))) (parts (js-array))
      (short (get (get rates :profiles) 0)) (long (get (get rates :profiles) 1))
      (mix (/ (get short :effectiveN) (+ (get short :effectiveN) 20))) (date-log 0) (hour-log 0))
      (js-call names :forEach (lambda (name)
        (let* ((index (- (get v name) (if (= name "dayOfMonth") 1 0)))
          (a (get (get (get short :tables) name) index)) (b (get (get (get long :tables) name) index))
          (log (+ (* mix (Math/log (get a :factor))) (* (- 1 mix) (Math/log (get b :factor))))))
          (if (= name "hourBucket") (setq hour-log log) (setq date-log (+ date-log log)))
          (js-call parts :push (Object/assign (js-object :name name :value (get v name)
            :shortFactor (get a :factor) :longFactor (get b :factor) :combinedFactor (Math/exp log)) b)))))
      (js-object :at (iso (timestamp at)) :parts parts :shrink mix
        :factor (Math/max (/ 2 3) (Math/min 1.5 (Math/exp (/ (+ (/ date-log 3) hour-log) 2)))))))
  (defun apply-calendar (prob history events now)
    (let* ((timeline (temporal-history events now)) (rates (rate-tables timeline now))
      (curve (if (get prob :model)
        (baseline-curve (get prob :model) (get history :intervals) (get history :elapsedMs) now)
        (let ((values (js-array 0)) (i 1))
          (while (<= i 8)
            (let* ((a (cumulative-hazard (get prob :base24))) (b (cumulative-hazard (get prob :base48)))
              (h (if (<= i 4) (* a (/ i 4)) (+ a (* (Math/max 0 (- b a)) (/ (- i 4) 4))))))
              (js-call values :push (* 100 (- 1 (Math/exp (* -1 h)))))) (setq i (+ i 1))) values)))
      (adjusted (js-array 0)) (segments (js-array)) (hours (js-array)) (hazard 0) (last 0) (i 1))
      (while (<= i 8)
        (let* ((next (Math/max last (Math/min 99.9999 (get curve i))))
          (increment (Math/log (/ (survival last) (survival next)))) (j 0) (segment-hazard 0))
          (while (< j 6)
            (let* ((at (+ (ms now) (* (+ (* (- i 1) 6) j 0.5) hour-ms)))
              (factor (calendar-factor rates at)) (h (* (/ increment 6) (get factor :factor))))
              (setq segment-hazard (+ segment-hazard h))
              (put factor :baselineHazard (/ increment 6)) (put factor :adjustedHazard h)
              (js-call hours :push factor))
            (setq j (+ j 1)))
          (setq hazard (+ hazard segment-hazard) last next)
          (js-call segments :push (js-object :at (iso (+ (ms now) (* (- (* i 6) 3) hour-ms)))
            :baselineHazard increment :adjustedHazard segment-hazard
            :factor (if (> increment 0) (/ segment-hazard increment) 1)))
          (js-call adjusted :push (* 100 (- 1 (Math/exp (* -1 hazard))))))
        (setq i (+ i 1)))
      (put prob :temporal (Object/assign timeline (js-object :rates rates :segments segments :hourSegments hours
        :baselineCurve curve :curve adjusted)))
      (put prob :base24 (get adjusted 4)) (put prob :base48 (get adjusted 8))
      (put prob :p24 (clamp (get adjusted 4))) (put prob :p48 (Math/max (get prob :p24) (clamp (get adjusted 8)))) prob))
  (export temporal-history calendar-vector rate-tables calendar-factor apply-calendar))
