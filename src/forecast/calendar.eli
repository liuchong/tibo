(module tibo.forecast.calendar
  (import "../platform/host.eli" Date Intl)
  (import "../platform/util.eli" ms iso day-ms hour-ms sorted clamp)
  (import "./models.eli" baseline-curve)
  (defconst policy "calendar-hazard-1")
  (defun timestamp (at) (if (= (value-type at) "number") at (ms at)))
  (defun survival (p) (Math/max 0.000001 (- 1 (/ p 100))))
  (defun cumulative-hazard (p) (* -1 (Math/log (survival p))))
  (defun calendar-vector (at zone)
    (let* ((date (new Date at))
      (local (js-call (new Intl/DateTimeFormat "en-CA" (js-object :timeZone zone :year "numeric" :month "2-digit" :day "2-digit")) :format date))
      (wall (new Date (str local "T12:00:00Z"))) (day (js-call wall :getUTCDate)))
      (js-object :epochMs (timestamp at) :date local :weekday (js-call wall :getUTCDay) :dayOfMonth day
        :monthPhase (Math/min 2 (Math/floor (/ (- day 1) 10))))))
  (defun temporal-history (events now)
    (let* ((globals (sorted (js-call events :filter (lambda (e) (and (get e :global) (<= (ms (get e :at)) (ms now))))) "at"))
      (rows (js-array)) (previous nil))
      (js-call globals :forEach (lambda (event)
        (let ((gap (when previous (- (ms (get event :at)) (ms (get previous :at))))))
          (js-call rows :push (js-object :id (get event :id) :at (get event :at) :intervalMs gap
            :intervalHours (when gap (/ gap hour-ms)) :intervalDays (when gap (/ gap day-ms))
            :observed (get event :observed false) :verified (get event :verified false)
            :utc (calendar-vector (get event :at) "UTC") :pacific (calendar-vector (get event :at) "America/Los_Angeles")))
          (setq previous event))))
      (js-object :policy policy :events rows :recent (js-call rows :slice -12)
        :elapsedMs (when previous (- (ms now) (ms (get previous :at))))
        :elapsedHours (when previous (/ (- (ms now) (ms (get previous :at))) hour-ms))
        :elapsedDays (when previous (/ (- (ms now) (ms (get previous :at))) day-ms))
        :now (js-object :utc (calendar-vector now "UTC") :pacific (calendar-vector now "America/Los_Angeles")))))
  (defun buckets (count prior-days)
    (js-call (Array/from (js-object :length count)) :map
      (lambda () (js-object :events 0 :exposureDays 0 :priorExposureDays prior-days))))
  (defun add-buckets (tables vector key amount)
    (js-call (js-array "weekday" "dayOfMonth" "monthPhase") :forEach (lambda (name)
      (let* ((index (- (get vector name) (if (= name "dayOfMonth") 1 0))) (bucket (get (get tables name) index)))
        (put bucket key (+ (get bucket key) amount))))))
  (defun decay (at now) (Math/exp (* -1 (Math/log 2) (/ (- (timestamp now) (timestamp at)) (* 90 day-ms)))))
  (defun rate-tables (timeline now)
    (let* ((events (js-call (get timeline :events) :filter (lambda (e) (not (get e :observed)))))
      (tables (js-object :weekday (buckets 7 14) :dayOfMonth (buckets 31 28) :monthPhase (buckets 3 28)))
      (first (get events 0)) (cursor (if first (ms (get first :at)) (ms now))) (total 0) (mass 0))
      ;; Account for the ongoing, right-censored wait as exposure. These are
      ;; observed-ledger rates, not a claim that all historical posts were seen.
      (while (< cursor (ms now))
        (let* ((end (Math/min (ms now) (+ cursor day-ms))) (middle (/ (+ cursor end) 2))
          (weight (* (/ (- end cursor) day-ms) (decay middle now))))
          (add-buckets tables (calendar-vector middle "America/Los_Angeles") "exposureDays" weight)
          (setq total (+ total weight) cursor end)))
      (js-call (js-call events :slice 1) :forEach (lambda (event)
        (let ((weight (decay (get event :at) now)))
          (add-buckets tables (get event :pacific) "events" weight) (setq mass (+ mass weight)))))
      (js-object :tables tables :eventMass mass :exposureDays total :rate (if (> total 0) (/ mass total) 0)
        :coverage "observed-ledger" :halfLifeDays 90)))
  (defun calendar-factor (rates at)
    (let* ((vector (calendar-vector at "America/Los_Angeles")) (base (get rates :rate)) (logs 0)
      (parts (js-array)) (shrink (/ (get rates :eventMass) (+ (get rates :eventMass) 20))))
      (js-call (js-array "weekday" "dayOfMonth" "monthPhase") :forEach (lambda (name)
        (let* ((index (- (get vector name) (if (= name "dayOfMonth") 1 0)))
          (bucket (get (get (get rates :tables) name) index)) (tau (get bucket :priorExposureDays))
          (posterior (if (> base 0) (/ (+ (get bucket :events) (* base tau)) (+ (get bucket :exposureDays) tau)) 0))
          (ratio (if (> base 0) (/ posterior base) 1)))
          (setq logs (+ logs (Math/log (Math/max 0.000001 ratio))))
          (js-call parts :push (js-object :name name :value (get vector name) :events (get bucket :events)
            :exposureDays (get bucket :exposureDays) :priorExposureDays tau :rateRatio ratio)))))
      (js-object :at (iso (timestamp at)) :parts parts :shrink shrink
        :factor (Math/max 0.4 (Math/min 2.5 (Math/exp (* shrink (/ logs 3))))))))
  (defun apply-calendar (prob history events now)
    (let* ((timeline (temporal-history events now)) (rates (rate-tables timeline now))
      (curve (if (get prob :model)
        (baseline-curve (get prob :model) (get history :intervals) (get history :elapsedMs) now)
        (let ((values (js-array 0)) (i 1))
          (while (<= i 8)
            (let* ((h24 (cumulative-hazard (get prob :base24)))
              (h48 (cumulative-hazard (get prob :base48)))
              (hazard (if (<= i 4) (* h24 (/ i 4)) (+ h24 (* (Math/max 0 (- h48 h24)) (/ (- i 4) 4))))))
              (js-call values :push (* 100 (- 1 (Math/exp (* -1 hazard)))))) (setq i (+ i 1))) values)))
      (adjusted (js-array 0)) (segments (js-array)) (hazard 0) (last 0) (i 1))
      (while (<= i 8)
        (let* ((next (Math/max last (Math/min 99.9999 (get curve i))))
          (increment (Math/log (/ (survival last) (survival next))))
          (factor (calendar-factor rates (+ (ms now) (* (- (* i 6) 3) hour-ms)))))
          (setq hazard (+ hazard (* increment (get factor :factor))) last next)
          (put factor :baselineHazard increment) (put factor :adjustedHazard (* increment (get factor :factor)))
          (js-call segments :push factor) (js-call adjusted :push (* 100 (- 1 (Math/exp (* -1 hazard))))))
        (setq i (+ i 1)))
      (put prob :temporal (Object/assign timeline (js-object :rates rates :segments segments :baselineCurve curve :curve adjusted)))
      (put prob :base24 (get adjusted 4)) (put prob :base48 (get adjusted 8))
      (put prob :p24 (clamp (get adjusted 4))) (put prob :p48 (Math/max (get prob :p24) (clamp (get adjusted 8))))
      prob))
  (export temporal-history calendar-vector rate-tables calendar-factor apply-calendar))
