(module tibo.forecast.models
  (import "../platform/host.eli" Number Date)
  (import "../platform/util.eli" day-ms hour-ms ms fail)
  (import "./regime.eli" regime-rate regime-probability)
  (defconst model-names (js-array "recent-rate" "decayed-rate" "conditional" "decayed-conditional" "adaptive-rate"))
  (defun eligible (samples)
    ;; Do not create artificial long gaps by joining across observed-only resets.
    (js-call samples :filter (lambda (s) (and (not (get s :observed)) (> (get s :duration) 0)))))
  (defun probability (rate hours) (* 100 (- 1 (Math/exp (* -1 rate (/ hours 24))))))
  (defun candidates (samples elapsed now &optional horizon24 horizon48)
    (let* ((recent (js-call samples :slice -12)) (n (get recent :length))
           (h24 (or horizon24 24)) (h48 (or horizon48 48))
           (total (js-call recent :reduce (lambda (sum s) (+ sum (/ (get s :duration) day-ms))) 0))
           (rate (/ n total)) (mass 0) (exposure 0) (surviving 0) (hits24 0) (hits48 0)
           (sample (js-object :n 0 :a 0 :b 0)))
      (when (< n 3) (fail "至少需要 3 个非观测 global 间隔，无法给出历史概率"))
      (js-call samples :forEach (lambda (s)
        (let* ((age (Math/max 0 (/ (- (ms now) (ms (get s :end))) day-ms)))
               (w (Math/exp (* -1 (Math/log 2) (/ age 90)))))
          (setq mass (+ mass w) exposure (+ exposure (* w (/ (get s :duration) day-ms))))
          (when (> (get s :duration) elapsed)
            (put sample :n (+ (get sample :n) 1))
            (when (<= (get s :duration) (+ elapsed (* h24 hour-ms))) (put sample :a (+ (get sample :a) 1)))
            (when (<= (get s :duration) (+ elapsed (* h48 hour-ms))) (put sample :b (+ (get sample :b) 1)))
            (setq surviving (+ surviving w))
            (when (<= (get s :duration) (+ elapsed (* h24 hour-ms))) (setq hits24 (+ hits24 w)))
            (when (<= (get s :duration) (+ elapsed (* h48 hour-ms))) (setq hits48 (+ hits48 w)))))))
      (let* ((r24 (probability rate h24)) (r48 (probability rate h48))
             (decayed (/ mass exposure)) (prior 4))
        (js-array
          (js-object :name "recent-rate" :p24 r24 :p48 r48)
          (js-object :name "decayed-rate" :p24 (probability decayed h24) :p48 (probability decayed h48))
          (js-object :name "conditional" :p24 (/ (+ (* 100 (get sample :a)) (* prior r24)) (+ (get sample :n) prior))
            :p48 (/ (+ (* 100 (get sample :b)) (* prior r48)) (+ (get sample :n) prior)))
          (js-object :name "decayed-conditional"
            :p24 (/ (+ (* 100 hits24) (* prior (probability decayed h24))) (+ surviving prior))
            :p48 (/ (+ (* 100 hits48) (* prior (probability decayed h48))) (+ surviving prior)))))))
  (defun all-candidates (samples elapsed now &optional horizon24 horizon48 clock-unknown)
    (let* ((rows (candidates samples elapsed now horizon24 horizon48))
      (pace (regime-rate samples (if clock-unknown 0 elapsed) now)))
      (js-call rows :push (js-object :name "adaptive-rate" :p24 (regime-probability (get pace :rate) (or horizon24 24))
        :p48 (regime-probability (get pace :rate) (or horizon48 48)) :regime pace)) rows))
  (defun baseline-curve (model intervals elapsed now)
    (let* ((samples (eligible intervals)) (weights (get model :candidates)) (curve (js-array 0)) (i 1))
      (while (<= i 8)
        (let* ((rows (all-candidates samples elapsed now (* i 6) (* i 6) (get model :clockUnknown))) (value 0))
          (js-call rows :forEach (lambda (row)
            (let ((weight (js-call weights :find (lambda (p) (= (get p :name) (get row :name))))))
              (setq value (+ value (* (get weight :weight 0) (get row :p24)))))))
          (js-call curve :push value))
        (setq i (+ i 1))) curve))
  (defun replay (samples)
    (let ((scores (js-call model-names :map (lambda (name)
      (js-object :name name :sum24 0 :sum48 0 :cycleSum24 0 :cycleSum48 0 :recentSum24 0 :recentSum48 0))))
      (n 0) (cycles 0) (recent-mass 0) (i 8) (last-at (get (get samples (- (get samples :length) 1)) :end)))
      (while (< i (get samples :length))
        (let* ((row (get samples i)) (elapsed 0) (training (js-call samples :slice 0 i)) (points 0)
          (sums (js-call model-names :map (lambda () (js-array 0 0)))))
          (while (and (< elapsed (get row :duration))
            (<= (+ (ms (get row :start)) elapsed (* 2 day-ms)) (ms last-at)))
            (let* ((at (js-call (new Date (+ (ms (get row :start)) elapsed)) :toISOString))
              (predictions (all-candidates training elapsed at))
              (hit24 (if (<= (get row :duration) (+ elapsed day-ms)) 1 0))
              (hit48 (if (<= (get row :duration) (+ elapsed (* 2 day-ms))) 1 0)))
              (js-call predictions :forEach (lambda (p index)
                (let* ((score (get scores index)) (local (get sums index))
                  (a (Math/pow (- (/ (get p :p24) 100) hit24) 2)) (b (Math/pow (- (/ (get p :p48) 100) hit48) 2)))
                  (put score :sum24 (+ (get score :sum24) a)) (put score :sum48 (+ (get score :sum48) b))
                  (put local 0 (+ (get local 0) a)) (put local 1 (+ (get local 1) b)))))
              (setq n (+ n 1) points (+ points 1)))
            (setq elapsed (+ elapsed day-ms)))
          (when (> points 0)
            (let ((w (Math/exp (* -1 (Math/log 2) (/ (- (ms last-at) (ms (get row :end))) (* 45 day-ms))))))
              (setq cycles (+ cycles 1) recent-mass (+ recent-mass w))
              (js-call scores :forEach (lambda (score index)
                (let ((a (/ (get (get sums index) 0) points)) (b (/ (get (get sums index) 1) points)))
                  (put score :cycleSum24 (+ (get score :cycleSum24) a)) (put score :cycleSum48 (+ (get score :cycleSum48) b))
                  (put score :recentSum24 (+ (get score :recentSum24) (* w a)))
                  (put score :recentSum48 (+ (get score :recentSum48) (* w b)))))))))
        (setq i (+ i 1)))
      (js-call scores :forEach (lambda (s)
        (put s :brier24 (if (> n 0) (/ (get s :sum24) n) nil)) (put s :brier48 (if (> n 0) (/ (get s :sum48) n) nil))
        (put s :cycleBrier24 (if (> cycles 0) (/ (get s :cycleSum24) cycles) nil))
        (put s :cycleBrier48 (if (> cycles 0) (/ (get s :cycleSum48) cycles) nil))
        (put s :recentBrier24 (if (> recent-mass 0) (/ (get s :recentSum24) recent-mass) nil))
        (put s :recentBrier48 (if (> recent-mass 0) (/ (get s :recentSum48) recent-mass) nil))))
      (js-object :n n :cycles cycles :scores scores :kind "walk-forward cycle replay" :independent false)))
  (defun ensemble (intervals elapsed now &optional experience clock-unknown)
    (let* ((samples (eligible intervals)) (predictions (all-candidates samples elapsed now nil nil clock-unknown))
      (evaluation (replay samples)) (cycles (get evaluation :cycles))
      (live-scores (if experience (get experience :models (js-array)) (js-array)))
      (errors (js-call (get evaluation :scores) :map (lambda (s)
        (let* ((live (js-call live-scores :find (lambda (r) (= (get r :name) (get s :name)))))
          (learned (and live (>= (get live :n) 30) (Number/isFinite (get live :brier24)) (Number/isFinite (get live :brier48))))
          (error (if (>= cycles 8) (/ (+ (get s :cycleBrier24) (get s :cycleBrier48)
            (get s :recentBrier24) (get s :recentBrier48)) 4) 0.25))
          (support (if (>= cycles 8) cycles 0)))
          (when learned
            (setq error (/ (+ error (/ (+ (get live :brier24) (get live :brier48)) 2)) 2)
              support (+ support (get live :n))))
          (js-object :error error :support support :enabled (not (and clock-unknown
            (js-call (js-array "conditional" "decayed-conditional") :includes (get s :name)))))))))
      (enabled (get (js-call errors :filter (lambda (e) (get e :enabled))) :length))
      (inverse (js-call errors :map (lambda (e) (if (get e :enabled) (/ 1 (+ 0.05 (get e :error))) 0))))
      (total (js-call inverse :reduce (lambda (a b) (+ a b)) 0))
      (support (js-call errors :reduce (lambda (a e) (Math/max a (get e :support))) 0))
      (shrink (/ support (+ support 20))) (p24 0) (p48 0))
      (js-call predictions :forEach (lambda (p i)
        (let ((weight (if (get (get errors i) :enabled)
          (+ (/ (- 1 shrink) enabled) (* shrink (/ (get inverse i) total))) 0)))
          (put p :weight weight)
          (setq p24 (+ p24 (* weight (get p :p24))) p48 (+ p48 (* weight (get p :p48)))))))
      (js-object :p24 p24 :p48 p48 :candidates predictions :evaluation evaluation :clockUnknown clock-unknown
        :weightShrink shrink :usableIntervals (get samples :length) :excludedIntervals (- (get intervals :length) (get samples :length))
        :prospectiveSamples (if experience (get experience :resolved 0) 0) :prospectiveBasis "observed-ledger"
        :adaptive (> support 0))))
  (export candidates replay ensemble eligible model-names baseline-curve all-candidates))
