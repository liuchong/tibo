(module tibo.forecast.models
  (import "../platform/host.eli" Number Date)
  (import "../platform/util.eli" day-ms hour-ms ms fail)
  (defconst model-names (js-array "recent-rate" "decayed-rate" "conditional" "decayed-conditional"))
  (defun eligible (samples)
    ;; Do not create artificial long gaps by joining across observed-only resets.
    (js-call samples :filter (lambda (s) (and (not (get s :observed)) (> (get s :duration) 0)))))
  (defun probability (rate hours) (* 100 (- 1 (Math/exp (* -1 rate (/ hours 24))))))
  (defun candidates (samples elapsed now &optional horizon24 horizon48)
    (let* ((recent (js-call samples :slice -12)) (n (get recent :length))
           (h24 (or horizon24 24)) (h48 (or horizon48 48))
           (total (js-call recent :reduce (lambda (sum s) (+ sum (/ (get s :duration) day-ms))) 0))
           (rate (/ n total)) (mass 0) (exposure 0) (surviving 0) (hits24 0) (hits48 0)
           (sample (js-object :n 0 :a 0 :b 0)))
      (when (< n 3) (fail "至少需要 3 个非观测 global 间隔，无法给出历史概率"))
      (js-call samples :forEach (lambda (s)
        (let* ((age (Math/max 0 (/ (- (ms now) (ms (get s :end))) day-ms)))
               (w (Math/exp (* -1 (Math/log 2) (/ age 90)))))
          (setq mass (+ mass w) exposure (+ exposure (* w (/ (get s :duration) day-ms))))
          (when (> (get s :duration) elapsed)
            (put sample :n (+ (get sample :n) 1))
            (when (<= (get s :duration) (+ elapsed (* h24 hour-ms))) (put sample :a (+ (get sample :a) 1)))
            (when (<= (get s :duration) (+ elapsed (* h48 hour-ms))) (put sample :b (+ (get sample :b) 1)))
            (setq surviving (+ surviving w))
            (when (<= (get s :duration) (+ elapsed (* h24 hour-ms))) (setq hits24 (+ hits24 w)))
            (when (<= (get s :duration) (+ elapsed (* h48 hour-ms))) (setq hits48 (+ hits48 w)))))))
      (let* ((r24 (probability rate h24)) (r48 (probability rate h48))
             (decayed (/ mass exposure)) (prior 4))
        (js-array
          (js-object :name "recent-rate" :p24 r24 :p48 r48)
          (js-object :name "decayed-rate" :p24 (probability decayed h24) :p48 (probability decayed h48))
          (js-object :name "conditional" :p24 (/ (+ (* 100 (get sample :a)) (* prior r24)) (+ (get sample :n) prior))
            :p48 (/ (+ (* 100 (get sample :b)) (* prior r48)) (+ (get sample :n) prior)))
          (js-object :name "decayed-conditional"
            :p24 (/ (+ (* 100 hits24) (* prior (probability decayed h24))) (+ surviving prior))
            :p48 (/ (+ (* 100 hits48) (* prior (probability decayed h48))) (+ surviving prior)))))))
  (defun baseline-curve (model intervals elapsed now)
    (let* ((samples (eligible intervals)) (weights (get model :candidates)) (curve (js-array 0)) (i 1))
      (while (<= i 8)
        (let* ((rows (candidates samples elapsed now (* i 6) (* i 6))) (value 0))
          (js-call rows :forEach (lambda (row)
            (let ((weight (js-call weights :find (lambda (p) (= (get p :name) (get row :name))))))
              (setq value (+ value (* (get weight :weight 0) (get row :p24)))))))
          (js-call curve :push value))
        (setq i (+ i 1))) curve))
  (defun replay (samples)
    (let ((scores (js-call model-names :map (lambda (name) (js-object :name name :sum24 0 :sum48 0))))
          (n 0) (i 8) (last-at (get (get samples (- (get samples :length) 1)) :end)))
      (while (< i (get samples :length))
        (let* ((row (get samples i)) (elapsed 0) (training (js-call samples :slice 0 i)))
          (while (and (< elapsed (get row :duration))
                      (<= (+ (ms (get row :start)) elapsed (* 2 day-ms)) (ms last-at)))
            (let* ((at (js-call (new Date (+ (ms (get row :start)) elapsed)) :toISOString))
                   (predictions (candidates training elapsed at))
                   (hit24 (if (<= (get row :duration) (+ elapsed day-ms)) 1 0))
                   (hit48 (if (<= (get row :duration) (+ elapsed (* 2 day-ms))) 1 0)))
              (js-call predictions :forEach (lambda (p index)
                (let ((score (get scores index)))
                  (put score :sum24 (+ (get score :sum24) (Math/pow (- (/ (get p :p24) 100) hit24) 2)))
                  (put score :sum48 (+ (get score :sum48) (Math/pow (- (/ (get p :p48) 100) hit48) 2))))))
              (setq n (+ n 1)))
            (setq elapsed (+ elapsed day-ms))))
        (setq i (+ i 1)))
      (js-call scores :forEach (lambda (s)
        (put s :brier24 (if (> n 0) (/ (get s :sum24) n) nil))
        (put s :brier48 (if (> n 0) (/ (get s :sum48) n) nil))))
      (js-object :n n :scores scores :kind "walk-forward replay" :independent false)))
  (defun ensemble (intervals elapsed now &optional experience clock-unknown)
    (let* ((samples (eligible intervals)) (predictions (candidates samples elapsed now))
           (evaluation (replay samples)) (n (get evaluation :n))
           (live-scores (if experience (get experience :models (js-array)) (js-array)))
           (weights (js-call (get evaluation :scores) :map (lambda (s)
             (let* ((live (js-call live-scores :find (lambda (r) (= (get r :name) (get s :name)))))
                    (error (if (>= n 30) (/ (+ (get s :brier24) (get s :brier48)) 2) 0.25)))
               (when (and live (>= (get live :n) 30) (Number/isFinite (get live :brier24)) (Number/isFinite (get live :brier48)))
                 (setq error (/ (+ error (/ (+ (get live :brier24) (get live :brier48)) 2)) 2)))
               (if (and clock-unknown (js-call (js-array "conditional" "decayed-conditional") :includes (get s :name))) 0
                 (if (or (>= n 30) (and live (>= (get live :n) 30))) (/ 1 (+ 0.05 error)) 1))))))
           (sum (js-call weights :reduce (lambda (a b) (+ a b)) 0)) (p24 0) (p48 0))
      (js-call predictions :forEach (lambda (p i)
        (let ((weight (/ (get weights i) sum)))
          (put p :weight weight)
          (setq p24 (+ p24 (* weight (get p :p24))) p48 (+ p48 (* weight (get p :p48)))))))
      (js-object :p24 p24 :p48 p48 :candidates predictions :evaluation evaluation
        :usableIntervals (get samples :length) :excludedIntervals (- (get intervals :length) (get samples :length))
        :prospectiveSamples (if experience (get experience :resolved 0) 0) :prospectiveBasis "observed-ledger"
        :adaptive (or (>= n 30) (js-call live-scores :some (lambda (s) (>= (get s :n) 30)))))))
  (export candidates replay ensemble eligible model-names baseline-curve))
