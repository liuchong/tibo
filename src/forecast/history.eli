(module tibo.forecast.history
  (import "../platform/util.eli" ms days day-ms sorted last-item fail)
  (defun intervals (events)
    (let* ((globals (js-call (sorted events "at") :filter (lambda (e) (get e :global))))
           (result (js-array)) (previous nil))
      (js-call globals :forEach
        (lambda (e)
          (when previous
            (js-call result :push (js-object :start (get previous :at) :end (get e :at)
              :duration (- (ms (get e :at)) (ms (get previous :at)))
              :observed (or (get e :observed) (get previous :observed)))))
          (setq previous e)))
      result))
  (defun conditional (samples elapsed &optional since)
    (let ((n 0) (a 0) (b 0))
      (js-call samples :forEach
        (lambda (interval)
          (let ((duration (get interval :duration)))
            ;; Strict survival denominator, inclusive +24/+48 upper endpoints.
            (when (and (> duration elapsed) (or (not since) (>= (ms (get interval :start)) (ms since))))
              (setq n (+ n 1))
              (when (<= duration (+ elapsed day-ms)) (setq a (+ a 1)))
              (when (<= duration (+ elapsed (* 2 day-ms))) (setq b (+ b 1)))))))
      (js-object :n n :a a :b b :p24 (if (> n 0) (/ (* 100 a) n) nil) :p48 (if (> n 0) (/ (* 100 b) n) nil))))
  (defun banked-lags (events)
    (let ((result (js-array)))
      (js-call events :forEach
        (lambda (e)
          (when (and (get e :banked) (not (get e :global)) (not (get e :observed)))
            (let ((next (js-call events :find (lambda (g) (and (get g :global) (> (ms (get g :at)) (ms (get e :at))))))))
              (when next (js-call result :push (- (ms (get next :at)) (ms (get e :at)))))))))
      result))
  (defun summarize-history (events now)
    (let* ((globals (js-call events :filter (lambda (e) (get e :global))))
           (last-global (last-item globals)) (samples (intervals events)))
      (unless last-global (fail "无可用 global 历史，拒绝编造数值概率"))
      (let* ((elapsed (- (ms now) (ms (get last-global :at))))
             (recent-samples (js-call samples :slice -12)))
        (js-object :elapsedMs elapsed :elapsedDays (days elapsed) :intervals samples :count (get globals :length)
         :start (get (get globals 0) :at) :all (conditional samples elapsed)
         :recent (conditional recent-samples elapsed) :bankedLags (banked-lags events)))))
  (export intervals conditional banked-lags summarize-history))
