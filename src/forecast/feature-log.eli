(module tibo.forecast.feature-log
  (import "../platform/host.eli" Date)
  (import "../platform/state.eli" read-state write-state)
  (import "../platform/transaction.eli" state-transaction)
  (import "../platform/util.eli" ms hour-ms iso)
  (import "../evidence/post-features.eli" feature-contract)
  (defun settle-features (rows result)
    (let* ((snapshot (get result :snapshot)) (now (ms (get snapshot :now))) (coverage (get snapshot :coverage (js-object))))
      (js-call rows :map (lambda (original)
        (let* ((row (Object/assign (js-object) original)) (at (ms (get row :at)))
          (mature (>= now (+ at (* 48 hour-ms) 600000)))
          (covered (try (and mature (= (get coverage :audited) t) (= (get coverage :eventsComplete) t)
            (get coverage :from) (get coverage :through)
            (<= (ms (get coverage :from)) at) (>= (ms (get coverage :through)) (+ at (* 48 hour-ms)))) (catch error false)))
          (events (js-call (get result :events) :filter (lambda (e)
            (and (get e :global) (> (ms (get e :at)) at) (<= (ms (get e :at)) (+ at (* 48 hour-ms)))))))
          (hit (js-call events :filter (lambda (e) (and (get e :verified) (not (get e :observed))
            (= (get e :provenance) "primary")))))
          (ambiguous (js-call events :some (lambda (e) (or (not (get e :verified)) (get e :observed)
            (not (= (get e :provenance) "primary"))))))
          (outcome (js-object :y24 (if (js-call hit :some (lambda (e) (<= (ms (get e :at)) (+ at (* 24 hour-ms))))) 1 nil)
            :y48 (if (> (get hit :length) 0) 1 nil) :completeCoverage false :scoredAt (get snapshot :now))))
          (when (and covered (not ambiguous))
            (put outcome :completeCoverage t)
            (unless (get outcome :y24) (put outcome :y24 0))
            (unless (get outcome :y48) (put outcome :y48 0)))
          (when (or covered (> (get hit :length) 0)) (put row :outcome outcome)) row)))))
  (defasync record-feature-observation (result)
    (await (state-transaction "feature-observations" (async ()
      (let* ((saved (or (await (read-state "feature-observations")) (js-object :rows (js-array))))
        (rows (settle-features (get saved :rows) result)) (at (iso (Date/now)))
        (previous (get rows (- (get rows :length) 1))) (features (get result :structuredFeatures)))
        ;; These observations never masquerade as reconstructed old forecasts.
        (when (or (not previous) (>= (- (ms at) (ms (get previous :at))) (* 48 hour-ms)))
          (js-call rows :push (js-object :at at :evidenceAt (get (get result :snapshot) :now)
            :contract feature-contract :cycleId (get (get (get result :signals) :lastGlobal (js-object)) :id)
            :baseline (js-object :p24 (get (get result :forecast) :base24) :p48 (get (get result :forecast) :base48))
            :features features :outcome nil :prospective t)))
        (setq rows (js-call rows :slice -1000))
        (await (write-state "feature-observations" (js-object :contract feature-contract :rows rows)))
        (js-object :saved (get rows :length) :trainable (get (js-call rows :filter (lambda (r)
          (and (get (get r :features) :postsComplete) (get (get r :outcome (js-object)) :completeCoverage)))) :length)))))))
  (export settle-features record-feature-observation))
