(module tibo.forecast.features
  (import "../evidence/post-features.eli" feature-contract)
  (import "./signals.eli" target-time target-precision)
  (import "./reset-timing.eli" timing-window timing-claim? timing-at?)
  (import "../evidence/reset-timing.eli" timing-lifetime)
  (import "../platform/util.eli" ms hour-ms iso)
  (defconst numeric-features (js-array "promise" "hint" "incident" "programme" "timingExpectation"))
  (defun numeric-claim? (name c)
    (and (if (= name "timingExpectation") (timing-claim? c) (= (get c :kind) name))
      (= (get c :status) "active") (not (get c :contextMissing))
      (cond ((= name "promise") (and (= (get c :scope) "global") (= (get c :statement) "future")))
        ((= name "hint") (and (js-call (js-array "global" "unknown") :includes (get c :scope))
          (js-call (js-array "codex-usage" "chatgpt-work-usage") :includes (get c :subject))))
        ((= name "incident") (and (= (get c :provenance) "primary") (not (= (get c :subject) "unknown"))
          (not (= (get c :scope) "partial")))) (t t))))
  (defun feature-state (result extraction)
    (let* ((snapshot (get result :snapshot)) (now (get snapshot :now)) (signals (get result :signals))
      (global (get signals :lastGlobal)) (banked (get signals :lastBanked)) (programme (get signals :programme))
      (posts (get snapshot :posts)) (claims (js-array)) (episodes (js-array))
      (complete (try (and (get snapshot :coverage) (= (get (get snapshot :coverage) :postsComplete) t)
        (= (get (get snapshot :coverage) :audited) t) (get (get snapshot :coverage) :from)
        (get (get snapshot :coverage) :through)
        (<= (ms (get (get snapshot :coverage) :from)) (- (ms now) (* 48 hour-ms)))
        (>= (ms (get (get snapshot :coverage) :through)) (ms now))
        (js-call (js-call posts :filter (lambda (p) (and (<= (ms (get p :at)) (ms now))
          (>= (ms (get p :at)) (- (ms now) (* 48 hour-ms)))))) :every (lambda (p)
            (and (not (get p :truncated)) (js-call (get extraction :rows) :some (lambda (r)
              (and (= (get r :postId) (get p :id)) (not (get r :incomplete))))))))) (catch error false)))
      (values (js-object)) (profiles (js-array)))
      (js-call (get extraction :rows) :forEach (lambda (row)
        (js-call profiles :push (get row :extractor))
        (js-call (get row :claims) :forEach (lambda (source)
          (let* ((claim (Object/assign (js-object) source))
            (post (js-call posts :find (lambda (p) (= (get p :id) (get claim :postId)))))
            (persistent (and programme (= (get claim :kind) "programme") (= (get claim :postId) (get programme :postId))))
            (expected (timing-window claim))
            (lifetime (timing-lifetime (get claim :timing)))
            (target (when (and post (= (get claim :kind) "promise") (get claim :timeText))
              (target-time (Object/assign (js-object) post (js-object :text (get claim :quote))))))
            (consumed (and (not persistent)
              (or (and global (>= (ms (get global :at)) (ms (get claim :at))))
                (and banked (get banked :verifiedBanked) (= (get banked :fulfilledPromiseId) (get claim :postId))))))
            (status (cond ((or (not post) (get post :truncated) (get claim :contextMissing)) "unknown")
              ((= (get claim :kind) "completion") "completed") (consumed "consumed")
              ((and (= (get claim :kind) "promise") (get signals :promise)
                (= (get claim :postId) (get (get signals :promise) :postId)) (get (get signals :promise) :withdrawn)) "withdrawn")
              ((= (get claim :statement) "negated") "negated")
              ((and target (< (ms target) (ms now))) "overdue")
              ((and expected (get expected :through) (< (ms (get expected :through)) (ms now))) "expectation-passed")
              ((and persistent (< (ms now) (ms (get programme :expiresAt)))) "active")
              ((< (+ (ms (get claim :at)) lifetime) (ms now)) "expired") (t "active")))
            (episode (if persistent (str "programme:" (get programme :postId))
              (str (if global (get global :id) "clock-unknown") ":" (get claim :scope) ":"
                (get claim :kind) ":" (if post (or (get post :parentId) (get claim :timeText) "cycle-context") "unknown")))))
            (put claim :targetAt target) (put claim :status status) (put claim :episodeId episode)
            (put claim :expectedWindow expected)
            (put claim :expiresAt (if persistent (get programme :expiresAt)
              (iso (+ (ms (get claim :at)) lifetime))))
            (put claim :knownAt (get row :knownAt)) (put claim :extractor (get row :extractor))
            (put claim :timePrecision (if target (target-precision (get claim :quote))
              (if (get claim :timeText) "unresolved" "none")))
            (js-call claims :push claim)
            (unless (js-call episodes :includes episode) (js-call episodes :push episode)))))))
      (js-call numeric-features :forEach (lambda (name)
        (let ((present (js-call claims :some (lambda (c)
          (and (numeric-claim? name c) (or (not (= name "programme")) programme))))))
          (put values name (if (and (= name "timingExpectation") present
            (js-call claims :some (lambda (c) (and (timing-claim? c) (= (get (get c :expectedWindow) :resolution) "unresolved"))))) nil
            (if present 1 (if complete 0 nil)))))))
      (js-object :contract feature-contract :claims claims :episodes episodes :values values
        :sourceGrade (if (js-call (get extraction :rows) :every (lambda (r)
          (js-call posts :some (lambda (p) (and (= (get p :id) (get r :postId)) (= (get p :provenance) "primary")))))) "primary" "mixed-or-archive")
        :profile (if (js-call profiles :every (lambda (p) (= p "rules-1"))) "rules-1"
          (if (js-call profiles :every (lambda (p) (= p feature-contract))) feature-contract "mixed-1"))
        :postsComplete (not (not complete)) :rows (get extraction :rows)
        :aiRows (get extraction :aiRows) :ruleRows (get extraction :ruleRows))))
  (defun values-at (features at)
    (let ((values (Object/assign (js-object) (get features :values))))
      (js-call numeric-features :forEach (lambda (name)
        (when (= (get values name) 1)
          (unless (js-call (get features :claims) :some (lambda (c)
            (and (numeric-claim? name c)
              (> (ms (get c :expiresAt)) (ms at))
              (or (not (= name "timingExpectation")) (timing-at? c at))
              (or (not (= name "promise")) (not (get c :targetAt)) (> (ms (get c :targetAt)) (ms at))))))
            (put values name 0))))) values))
  (export feature-state numeric-features values-at))
