(module tibo.forecast.signals
  (import "../evidence/reset-text.eli" completed? completed-post? conditional-reset? routine-reset?)
  (import "../evidence/post-events.eli" events-from-posts)
  (import "../evidence/pacific-time.eli" pacific-target)
  (import "../evidence/day-plan.eli" programme-choice)
  (import "../evidence/post-context.eli" active-programme linked-reset-context completion-context)
  (import "../evidence/post-features.eli" reset-scope time-text)
  (import "../evidence/reset-timing.eli" expectation-stance negative-expectation? local-timing)
  (import "../platform/host.eli" Set Map Number)
  (import "../platform/util.eli" ms iso hour-ms day-ms matches match sorted last-item recent)
  (defun target-time (post)
    (let* ((text (get post :text))
           (m (match "(?:tomorrow|today)\\s+(?:at\\s+)?([0-9]{1,2})(?::([0-9]{2}))?\\s*(am|pm)\\s*(PST|PDT|PT)" text))
           (eod (match "\\bby\\s+(?:(today|tomorrow)[’']?s?\\s+)?(?:EOD|(?:the\\s+)?end of (?:the\\s+)?day)\\s+(?:(today|tomorrow)\\s+)?(PST|PDT|PT)\\b" text))
           (relative (or (local-timing "promise" text (time-text text)) (js-object))))
      (if (and (get relative :amount) (js-call (js-array "within-hours" "within-days") :includes (get relative :window)))
        (iso (+ (ms (get post :at)) (* (get relative :amount) (if (= (get relative :window) "within-hours") hour-ms day-ms))))
      (if eod
        (pacific-target (get post :at) 24 0 (js-call (get eod 3) :toUpperCase)
          (matches "tomorrow" (get eod 0)))
      (when m
        (let* ((n (Number (get m 1))) (minute (Number (or (get m 2) 0)))
               (hour (+ (% n 12) (if (= (js-call (get m 3) :toLowerCase) "pm") 12 0))))
          (when (and (>= n 1) (<= n 12) (< minute 60))
            (pacific-target (get post :at) hour minute (js-call (get m 4) :toUpperCase) (matches "tomorrow" (get m 0))))))))))
  (defun target-precision (text)
    (if (matches "\\bby\\b[^.!?]*(?:\\bEOD\\b|end of (?:the\\s+)?day)|\\bwithin\\b|\\bnext\\s+[0-9]+\\s+(?:hours?|days?)" text) "deadline" "instant"))
  (defun normalize-events (snapshot)
    (let* ((posts (get snapshot :posts)) (now (get snapshot :now)) (seen (new Set)) (events (js-array)) (records (new Map)))
      ;; Reconcile originals before any baseline, promise, feature or status
      ;; calculation, including offline snapshots and previously saved ledgers.
      (js-call (js-call (get snapshot :events) :concat (events-from-posts posts)) :forEach (lambda (event)
        (js-call records :set (get event :id) (Object/assign (js-object) (js-call records :get (get event :id)) event))))
      (js-call (sorted (Array/from (js-call records :values)) "at") :forEach
        (lambda (event)
          (let* ((post (js-call posts :find (lambda (p) (= (get p :id) (get event :id)))))
                 (text (if post (get post :text) ""))
                 (key (str (get event :at))))
            (when (and (<= (ms (get event :at)) (ms now)) (not (js-call seen :has key)))
              (js-call seen :add key)
              (let ((copy (Object/assign (js-object) event)))
                (when (or (get event :automaticWeekly) (= (get event :kind) "automatic-weekly")
                  (routine-reset? (str text " " (get event :summary "") " " (get event :scope ""))))
                  (put copy :global false))
                ;; Source text beats a tracker type. Future promises do not reset the clock.
                (when (> (get text :length) 0)
                  (when (routine-reset? text) (put copy :global false))
                  (when (and (matches "banked|reset card" text) (not (matches "global.*reset|reset.*global" text)))
                    (put copy :global false) (put copy :banked t))
                  (when (and (not (completed? text)) (matches "landing|will reset|reset tomorrow|reset next week|reset.*by EOD" text))
                    (put copy :global false)))
                ;; Explicit reviewed event identities preserve observations and
                ;; repeated announcements without counting another reset.
                (when (or (and post (get post :sameResetAs) (js-call records :has (get post :sameResetAs)))
                  (and (get event :observed) (js-call (Array/from (js-call records :values)) :some (lambda (candidate)
                    (and (= (get candidate :state) "completed") (= (get candidate :provenance) "primary")
                      (get candidate :global) (js-call (get candidate :replacesEventIds (js-array)) :includes (get event :id)))))))
                  (put copy :global false) (put copy :banked false))
                (put copy :verified (not (not (and post (not (get post :truncated))
                  (or (completed-post? post (completion-context post posts))
                    ;; An installation record can carry a reviewed public
                    ;; completion without inventing a typed quote relationship.
                    (and (= (get event :state) "completed")
                      (= (get event :completionBasis) "reviewed-public-announcement")
                      (= (get event :provenance) "primary") (= (get post :provenance) "primary")
                      (= (get post :author) "thsottiaux")
                      (= (Math/floor (/ (ms (get post :at)) 1000)) (Math/floor (/ (ms (get event :at)) 1000)))
                      (= (get post :url) (get event :url))))))))
                (when post (put copy :provenance (get post :provenance)))
                (put copy :verifiedBanked (not (not (and post (matches "banked|reset card" text)))))
                (put copy :text text)
                (js-call events :push copy))))))
      events))
  (defun analyze-signals (snapshot events)
    (let* ((now (get snapshot :now)) (posts (get snapshot :posts))
           (globals (js-call events :filter (lambda (e) (get e :global))))
           (bankeds (js-call events :filter (lambda (e) (get e :banked))))
           (last-global (last-item (sorted globals "at"))) (last-banked (last-item (sorted bankeds "at")))
           (programme (active-programme posts now last-global))
           (promise nil) (hints (js-array)) (catalysts (js-array)) (compensation nil))
      (js-call (sorted posts "at") :forEach
        (lambda (post)
          (when (and (<= (ms (get post :at)) (ms now))
            (or (recent (get post :at) now 48) (and programme (= (get programme :postId) (get post :id)))
              (let ((deadline (target-time post)))
                (and deadline (> (+ (ms deadline) (* 48 hour-ms)) (ms now))))))
            (let* ((text (get post :text)) (at (get post :at)) (context (linked-reset-context post posts programme))
                   (parent-text (get context :parentText ""))
                   (is-reset (and (or (matches "reset" text) (and (get context :resetContextVerified) (time-text text))) (not (routine-reset? text))))
                   (negative (or (negative-expectation? text) (negative-expectation? parent-text)
                     (matches "can't|can’t|cannot|won't|won’t|no reset|not.*reset|reset[^.!?]*\\b(?:not|never)\\b" (str text " " parent-text))))
                   (target (target-time post))
                   (scope-match (match "(?:for|across)\\s+((?:all|every|paid|Plus|Pro|Business)[^.]+?(?:accounts|users|plans))" text))
                   (consumed (or (and last-global (>= (ms (get last-global :at)) (ms at)))
                                 (and last-banked (get last-banked :verifiedBanked)
                                      (>= (ms (get last-banked :at)) (ms at))
                                      (= (get last-banked :fulfilledPromiseId) (get post :id))))))
              (let ((choice (programme-choice post programme posts)))
                (when choice
                  (put choice :fulfilled (not (not consumed)))
                  (setq promise choice)))
              (when (and promise (not consumed) (= (get post :provenance) "primary")
                (= (reset-scope text) "global") (not (get post :truncated))
                (or negative (matches "cancelled|canceled|withdrawn|postponed|delayed" text)))
                (put promise :withdrawn t) (put promise :withdrawalPostId (get post :id))
                (put promise :reason "后续官方原文撤回或推迟承诺"))
              (when (and is-reset (not negative) target (or scope-match (= (reset-scope text) "global") (= (get context :resetContextScope) "global"))
                         (not (= (reset-scope text) "partial"))
                         (not (get post :truncated)) (not (get post :contextMissing))
                         (not (matches "cancelled|canceled|withdrawn|postponed|delayed" text))
                         (not (completed? text)) (matches "will|we.ll|landing|\\bby\\b|promis" text)
                         (not (expectation-stance text)) (not (expectation-stance parent-text))
                         (not (conditional-reset? parent-text))
                         (not (conditional-reset? text)))
                (setq promise (js-object :postId (get post :id) :at at :targetAt target :scope (if scope-match (get scope-match 1) "global")
                   :text text :fulfilled (not (not consumed)) :kind (if (matches "banked|card" (str text " " parent-text)) "banked" "global")
                   :parentId (when (get context :resetContextVerified) (get post :parentId)) :scopeBasis (get context :resetContextBasis)
                   :programmePostId (get context :programmePostId)
                   :primary (= (get post :provenance) "primary")
                   :timePrecision (target-precision text)
                   :reason (if consumed "旧承诺已被后续 global 或 banked 消耗，权重归零" "承诺待核实兑现"))))
              (when (and is-reset (not negative) (or (not target) (conditional-reset? text) (expectation-stance text)) (not consumed) (not (completed? text)))
                (js-call hints :push (js-object :postId (get post :id) :text text :at at :conditional (conditional-reset? text))))
              (when (and is-reset (not negative) (not consumed) (not target) (not (completed? text))
                         (matches "apolog|outage|latency|incident|overcount|incorrect.*usage|blocked.*requests" text))
                (setq compensation (js-object :postId (get post :id) :text text :primary (= (get post :provenance) "primary"))))
              (when (matches "launch|release|million.*users|milestone|roll(?:ing)? out" text)
                (js-call catalysts :push (js-object :postId (get post :id) :text text :at at :consumed consumed)))))))
      (js-object :lastGlobal last-global :lastBanked last-banked :promise promise :hints hints :catalysts catalysts :compensation compensation :programme programme)))
  (export pacific-target target-time target-precision completed? conditional-reset? normalize-events analyze-signals))
