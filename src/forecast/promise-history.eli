(module tibo.forecast.promise-history
  (import "./signals.eli" analyze-signals normalize-events target-time)
  (import "../evidence/post-features.eli" local-row)
  (import "../platform/util.eli" ms hour-ms sorted last-item matches)
  (defun verified-global? (e)
    (and e (get e :global) (get e :verified) (not (get e :observed)) (= (get e :provenance) "primary")))
  (defun covered? (snapshot from through &optional posts)
    (try
      (js-call (js-call (get snapshot :coverages (js-array)) :concat
        (if (get snapshot :coverage) (js-array (get snapshot :coverage)) (js-array))) :some (lambda (c)
          (and (= (get c :audited) t) (= (get c :eventsComplete) t)
            (or (not posts) (= (get c :postsComplete) t))
            (<= (ms (get c :from)) from) (>= (ms (get c :through)) through)
            (<= (ms (get c :through)) (ms (get snapshot :now))))))
      (catch error false)))
  (defun lead-bucket (p)
    (let ((lead (- (ms (get p :targetAt)) (ms (get p :at)))))
      (cond ((<= lead (* 24 hour-ms)) "under24h") ((<= lead (* 48 hour-ms)) "under48h") (t "over48h"))))
  (defun promise-history (snapshot)
    (let* ((now (ms (get snapshot :now))) (events (normalize-events snapshot))
      (globals (js-call events :filter (lambda (e) (get e :global)))) (rows (js-array)) (duplicates 0) (unresolved 0))
      (js-call (sorted (get snapshot :posts) "at") :forEach (lambda (post)
        (when (<= (ms (get post :at)) now)
          ;; The original publication time is used for classification, with no
          ;; future outcome supplied to the deterministic promise parser.
          (let* ((p (when (or (target-time post) (matches "\\bday\\s+[0-9]{1,2}\\s*[/：:][^.!?]*reset" (get post :text)))
            (get (analyze-signals (js-object :posts (js-call (get snapshot :posts) :filter
            (lambda (p) (<= (ms (get p :at)) (ms (get post :at))))) :now (get post :at))
              (js-call events :filter (lambda (e) (< (ms (get e :at)) (ms (get post :at)))))) :promise)))
            (prior (last-item (js-call globals :filter (lambda (e) (< (ms (get e :at)) (ms (get post :at))))))))
            (when (and (not p) (js-call (get (local-row post) :claims) :some (lambda (c)
              (and (= (get c :kind) "promise") (= (get c :statement) "future") (= (get c :scope) "global") (get c :timeText)))))
              (setq unresolved (+ unresolved 1)))
            (when (and p (= (get p :postId) (get post :id)) (= (get p :kind) "global") (> (ms (get p :targetAt)) (ms (get p :at))))
              (let* ((cycle (if prior (get prior :id) "unknown-cycle"))
                (old (js-call rows :find (lambda (r) (= (get r :cycleId) cycle))))
                (after (js-call globals :filter (lambda (e) (> (ms (get e :at)) (ms (get p :at))))))
                (hit (js-call after :find (lambda (e) (and (verified-global? e)
                  (<= (ms (get e :at)) (+ (ms (get p :targetAt)) (* 48 hour-ms)))))))
                (on-time (js-call after :find (lambda (e) (and (verified-global? e) (<= (ms (get e :at)) (ms (get p :targetAt)))))))
                (finished (>= now (+ (ms (get p :targetAt)) (* 48 hour-ms))))
                (coverage (covered? snapshot (ms (get p :at)) (ms (get p :targetAt))))
                (ambiguous (js-call after :some (lambda (e) (and (<= (ms (get e :at)) (ms (get p :targetAt))) (not (verified-global? e)))))))
                (let ((record (Object/assign (js-object) p (js-object :cycleId cycle :cycleReliable (not (not (verified-global? prior)))
                    :revisionCount 1 :leadBucket (lead-bucket p) :followingGlobals after
                    :completionAt (when (and (get p :primary) hit) (get hit :at))
                    :onTime (cond ((and (get p :primary) on-time) 1)
                      ((and (get p :primary) (>= now (ms (get p :targetAt))) coverage (not ambiguous)) 0) (t nil))
                    :state (cond ((and (get p :primary) on-time) "on-time")
                      ((< now (ms (get p :targetAt))) "pending")
                      ((and (get p :primary) hit) "completion-after-deadline-observed")
                      ((and finished (get p :primary) (covered? snapshot (ms (get p :at)) (+ (ms (get p :targetAt)) (* 48 hour-ms)))
                        (not (js-call after :some (lambda (e) (<= (ms (get e :at)) (+ (ms (get p :targetAt)) (* 48 hour-ms))))))) "no-completion-in-audited-window")
                      (t "unknown"))))))
                  (cond ((and old (= (get old :timePrecision) "programme-day")
                    (not (= (get p :timePrecision) "programme-day")) (= (get p :parentId) (get old :postId))
                    (= (get p :scopeBasis) "declared-full-reset-programme"))
                    ;; An estimated day boundary is not an author deadline.
                    ;; Preserve that decision, then use the first actual linked
                    ;; deadline; later revisions still retain their audit cost.
                    (put record :programmeDecisionPostId (get old :postId))
                    (put record :programmeDecisionAt (get old :at))
                    (put record :estimatedTargetAt (get old :targetAt))
                    (Object/assign old record))
                    (old (put old :revisionCount (+ (get old :revisionCount) 1)) (setq duplicates (+ duplicates 1)))
                    (t (js-call rows :push record))))))))))
      (js-object :rows rows :duplicates duplicates :unresolvedDeadlines unresolved)))
  (defun wilson (successes n)
    (when (> n 0)
      (let* ((z2 (* 1.96 1.96)) (rate (/ successes n)) (denom (+ 1 (/ z2 n)))
        (center (/ (+ rate (/ z2 (* 2 n))) denom))
        (half (/ (* 1.96 (Math/sqrt (+ (/ (* rate (- 1 rate)) n) (/ z2 (* 4 n n))))) denom)))
        (js-object :successes successes :n n :rate (* 100 rate) :estimate (* 100 center)
          :low (* 100 (Math/max 0 (- center half))) :high (* 100 (Math/min 1 (+ center half)))
          :width (* 200 half) :level 0.95))))
  (defun estimate-promise (snapshot signals history)
    (let* ((p (get signals :promise)) (now (ms (get snapshot :now)))
      (active (and p (not (get p :fulfilled)) (not (get p :withdrawn)) (= (get p :kind) "global")))
      (rows (get history :rows)) (current (when p (js-call rows :find (lambda (r) (= (get r :postId) (get p :postId))))))
      (offset (when p (- now (ms (get p :targetAt)))))
      (n 0) (a 0) (b 0) (unknown 0) (audit-unknown 0) (not-yet 0) (already 0) (comparable 0))
      (when active
        (js-call rows :forEach (lambda (r)
          (when (and (not (= (get r :cycleId) (if current (get current :cycleId) "unknown-cycle")))
            (= (get r :timePrecision) (get p :timePrecision)) (= (get r :leadBucket) (lead-bucket p)))
            (let* ((start (+ (ms (get r :targetAt)) offset)) (end (+ start (* 48 hour-ms)))
              (events (get r :followingGlobals))
              (before (js-call events :some (lambda (e) (and (verified-global? e) (<= (ms (get e :at)) start))))))
              (when (>= start (ms (get r :at)))
                (setq comparable (+ comparable 1))
                (cond ((> end now) (setq not-yet (+ not-yet 1)))
                  ((or (not (get r :primary)) (not (get r :cycleReliable))
                    (not (covered? snapshot (ms (get r :at)) end t))
                    (js-call events :some (lambda (e) (and (<= (ms (get e :at)) end) (not (verified-global? e))))))
                    (setq unknown (+ unknown 1))
                    (when (covered? snapshot (ms (get r :at)) end t) (setq audit-unknown (+ audit-unknown 1))))
                  (before (setq already (+ already 1)))
                  (t (setq n (+ n 1))
                    (when (js-call events :some (lambda (e) (and (> (ms (get e :at)) start) (<= (ms (get e :at)) (+ start (* 24 hour-ms))))))
                      (setq a (+ a 1)))
                    (when (js-call events :some (lambda (e) (and (> (ms (get e :at)) start) (<= (ms (get e :at)) end))))
                      (setq b (+ b 1)))))))))))
      (let* ((h24 (wilson a n)) (h48 (wilson b n))
        (reason (cond ((not active) "no-active-promise") ((not (get p :primary)) "unverified-current-promise")
          ((not (verified-global? (get signals :lastGlobal))) "clock-unverified")
          ((or (not current) (> (get current :revisionCount) 1)) "revised-or-unmatched-promise")
          ((> unknown 0) "incomplete-audited-cohort")
          ((< n 12) "insufficient-audited-cases")
          ((or (> (get h24 :width) 40) (> (get h48 :width) 40)) "wide-confidence-interval") (t nil))))
        (js-object :policy "promise-history-1" :applied (nullish? reason) :reason reason :calibrated false
          :postId (when p (get p :postId)) :targetAt (when p (get p :targetAt)) :offsetHours (when p (/ offset hour-ms))
          :n n :comparable comparable :unknown unknown :auditUnknown audit-unknown :pending not-yet :alreadyCompleted already
          :unresolvedDeadlines (get history :unresolvedDeadlines)
          :h24 h24 :h48 h48 :minCases 12 :maxIntervalWidth 40))))
  (export promise-history estimate-promise wilson covered?))
