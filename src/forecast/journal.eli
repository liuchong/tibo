(module tibo.forecast.journal
  (import "../platform/state.eli" read-state write-state with-lock)
  (import "../platform/host.eli" Number)
  (import "../platform/privacy.eli" public-text)
  (import "../platform/util.eli" ms day-ms fail)
  ;; Every real report has a receipt. These overlapping windows are NOT independent
  ;; training samples; experience.eli keeps its separate 48h sampling policy.
  (defun saved-receipt (report evidence diagnostics)
    (when (and report evidence diagnostics (get diagnostics :forecast) (= (get report :now) (get evidence :now))
      (= (get report :now) (get diagnostics :at))
      (= (get report :p24) (get (get diagnostics :forecast) :p24))
      (= (get report :p48) (get (get diagnostics :forecast) :p48))
      (Number/isInteger (get report :p24)) (Number/isInteger (get report :p48))
      (>= (get report :p24) 0) (<= (get report :p48) 100) (>= (get report :p48) (get report :p24)))
      (js-object :at (get report :now) :p24 (get report :p24) :p48 (get report :p48)
        :origin "saved-report" :channel "schedule" :signal (get (get diagnostics :forecast) :signal) :audit (js-object))))
  (defun audit-rows (rows events now fresh)
    (js-call rows :map (lambda (row)
      (let ((copy (Object/assign (js-object) row)) (audit (js-object)))
        (js-call (js-array 24 48) :forEach (lambda (hours)
          (let* ((end (+ (ms (get row :at)) (* (/ hours 24) day-ms)))
            (window (js-call events :filter (lambda (e) (and (get e :global)
              (> (ms (get e :at)) (ms (get row :at))) (<= (ms (get e :at)) end) (<= (ms (get e :at)) (ms now))))))
            (hit (js-call window :find (lambda (e) (and (get e :verified) (not (get e :observed))))))
            (y (cond (hit 1) ((and fresh (>= (ms now) (+ end 600000)) (= (get window :length) 0)) 0) (t nil))))
            (put audit (str "h" hours) (if (and (nullish? y) (get row :audit)
              (get (get row :audit) (str "h" hours))
              (not (nullish? (get (get (get row :audit) (str "h" hours)) :outcome))))
              (get (get row :audit) (str "h" hours))
              (js-object :outcome y :eventId (when hit (get hit :id))
              :eventAt (when hit (get hit :at)) :eventText (when hit (public-text (get hit :text "") 500))
              :brier (when (not (nullish? y)) (Math/pow (- (/ (get row (str "p" hours)) 100) y) 2))
              :state (cond (hit "announcement-hit") ((= y 0) "no-event-in-fresh-ledger") (t "pending-or-unverified"))))))))
        (put copy :audit audit) copy))))
  (defun cases (rows)
    (let ((seen (js-array)) (result (js-array)))
      (js-call (js-call (js-call rows :slice) :reverse) :forEach (lambda (r)
        (let* ((hit (get (get r :audit) :h48)) (id (get hit :eventId)))
          (when (and id (not (js-call seen :includes id)) (< (get result :length) 3))
            (js-call seen :push id)
            (js-call result :push (js-object :forecastAt (get r :at) :p24 (get r :p24) :p48 (get r :p48)
              :signal (get r :signal) :resetAt (get hit :eventAt) :completionText (get hit :eventText "")
              :announcementGrade "completed-public-announcement"
              :lesson "更新与reset可同日发生；只是单次复盘，不是独立日频率或加分项")))))) result))
  (defasync update-journal (result &optional channel record)
    (await (with-lock "forecast-journal" (async ()
      (let* ((existing (or (await (read-state "forecast-journal")) (js-object)))
        (rows (get existing :reports (js-array))) (now (get (get result :snapshot) :now))
        (prob (get result :forecast (js-object :available false :information (js-object
          :historyFresh (js-call (get (get result :snapshot) :sources (js-array)) :some (lambda (s) (and (= (get s :name) "archive") (get s :ok)))))))))
        (unless (Array/isArray rows) (fail "不可读的预测报告记录"))
        (unless (get existing :savedScheduleImported)
          (let ((receipt (saved-receipt (await (read-state "report-schedule"))
                  (await (read-state "evidence-schedule")) (await (read-state "diagnostics-schedule")))))
            (when (and receipt (<= (ms (get receipt :at)) (ms now))
              (not (js-call rows :some (lambda (r) (and (= (get r :at) (get receipt :at)) (= (get r :channel) "schedule"))))))
              (js-call rows :push receipt)))
          (put existing :savedScheduleImported t))
        (when (and record (not (= (get prob :available) false))
          (not (js-call rows :some (lambda (r) (and (= (get r :at) now) (= (get r :channel) channel))))))
          (js-call rows :push (js-object :at now :p24 (get prob :p24) :p48 (get prob :p48)
            :origin "prospective-report" :channel channel :policyVersion (get prob :policyVersion)
            :signal (get prob :signal) :audit (js-object))))
        (setq rows (audit-rows (js-call rows :slice -400) (get result :events) now (get (get prob :information) :historyFresh)))
        (put existing :reports rows)
        (await (write-state "forecast-journal" existing)) existing)))))
  (export saved-receipt audit-rows cases update-journal))
