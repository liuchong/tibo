(module tibo.forecast.experience
  (import "../platform/state.eli" read-state write-state with-lock)
  (import "../platform/util.eli" ms day-ms)
  (defun resolve-predictions (rows events now)
    (js-call rows :map (lambda (row)
      (let ((copy (Object/assign (js-object) row)))
        (when (and (not (get row :outcome)) (>= (ms now) (+ (ms (get row :at)) (* 2 day-ms) 600000)))
          (let* ((start (ms (get row :at)))
                 (after (js-call events :filter (lambda (e) (and (get e :global) (> (ms (get e :at)) start)
                                                   (<= (ms (get e :at)) (+ start (* 2 day-ms))))))))
            (put copy :outcome (js-object
              :y24 (if (js-call after :some (lambda (e) (<= (ms (get e :at)) (+ start day-ms)))) 1 0)
              :y48 (if (> (get after :length) 0) 1 0)
              :basis "observed-ledger" :scoredAt now))))
        copy))))
  (defun accuracy (rows)
    (let ((resolved (js-call rows :filter (lambda (r) (get r :outcome)))) (s24 0) (s48 0)
          (models (js-array)) (ai-n 0) (ai-error 0) (base-error 0))
      (js-call resolved :forEach (lambda (r)
        (setq s24 (+ s24 (Math/pow (- (/ (get r :p24) 100) (get (get r :outcome) :y24)) 2))
              s48 (+ s48 (Math/pow (- (/ (get r :p48) 100) (get (get r :outcome) :y48)) 2)))
        (when (get r :aiPrediction)
          (let ((ai (get r :aiPrediction)) (base (get r :baselinePrediction)) (outcome (get r :outcome)))
            (setq ai-n (+ ai-n 1)
              ai-error (+ ai-error (/ (+ (Math/pow (- (/ (get ai :p24) 100) (get outcome :y24)) 2)
                                       (Math/pow (- (/ (get ai :p48) 100) (get outcome :y48)) 2)) 2))
              base-error (+ base-error (/ (+ (Math/pow (- (/ (get base :p24) 100) (get outcome :y24)) 2)
                                           (Math/pow (- (/ (get base :p48) 100) (get outcome :y48)) 2)) 2)))))
        (js-call (get r :models (js-array)) :forEach (lambda (p)
          (let ((score (js-call models :find (lambda (s) (= (get s :name) (get p :name))))))
            (unless score
              (setq score (js-object :name (get p :name) :n 0 :sum24 0 :sum48 0))
              (js-call models :push score))
            (put score :n (+ (get score :n) 1))
            (put score :sum24 (+ (get score :sum24) (Math/pow (- (/ (get p :p24) 100) (get (get r :outcome) :y24)) 2)))
            (put score :sum48 (+ (get score :sum48) (Math/pow (- (/ (get p :p48) 100) (get (get r :outcome) :y48)) 2))))))))
      (js-call models :forEach (lambda (s)
        (put s :brier24 (/ (get s :sum24) (get s :n))) (put s :brier48 (/ (get s :sum48) (get s :n)))))
      (js-object :saved (get rows :length) :resolved (get resolved :length)
        :brier24 (if (> (get resolved :length) 0) (/ s24 (get resolved :length)) nil)
        :brier48 (if (> (get resolved :length) 0) (/ s48 (get resolved :length)) nil)
        :aiCalibration (js-object :n ai-n :baselineBrier (if (> ai-n 0) (/ base-error ai-n) nil)
          :aiBrier (if (> ai-n 0) (/ ai-error ai-n) nil))
        :models models :basis "observed-ledger" :completeCoverage false)))
  (defasync record-prediction (result)
    (await (with-lock "experience" (async ()
      (let* ((now (get (get result :snapshot) :now)) (prob (get result :forecast))
             (existing (get (or (await (read-state "experience")) (js-object)) :predictions (js-array)))
             (rows (if (get (get prob :information (js-object)) :historyFresh)
               (resolve-predictions existing (get result :events) now) existing))
             (last (get rows (- (get rows :length) 1))))
        ;; Keep prospective, non-overlapping 48h windows; do not backfill history.
        (when (or (not last) (>= (ms now) (+ (ms (get last :at)) (* 2 day-ms))))
          (let* ((ai (get result :ai)) (proposal (if ai (get (get ai :features) :forecast) nil))
                 (row (js-object :at now :p24 (get prob :p24) :p48 (get prob :p48)
                   :historicalPrediction (js-object :p24 (Math/round (get prob :base24)) :p48 (Math/round (get prob :base48)))
                   :information (get prob :information) :policyVersion (get prob :policyVersion)
                   :signalBucket (get prob :signalBucket) :models (get (get prob :model) :candidates) :signal (get prob :signal) :outcome nil)))
            (when (and proposal (get proposal :value))
              (put row :aiPrediction (js-object :p24 (get (get proposal :value) :p24) :p48 (get (get proposal :value) :p48)))
              (put row :baselinePrediction (get ai :baseline)))
            (when ai
              (let* ((features (get ai :features)) (research (get features :research)) (review (get features :review)))
                (when (and research (get research :value))
                  (put row :researchFeatures (js-call (get (get research :value) :facts) :map (lambda (f)
                    (js-object :kind (get f :kind) :scope (get f :scope) :status (get f :status) :impact (get f :impact))))))
                (when (and review (get review :value)) (put row :aiReview (js-object :accept (get (get review :value) :accept) :reason (get (get review :value) :reason))))))
            (js-call rows :push row)))
        (setq rows (js-call rows :slice -1000))
        (let ((stats (accuracy rows)))
          (await (write-state "experience" (js-object :predictions rows :accuracy stats))) stats))))))
  (export resolve-predictions accuracy record-prediction))
