;; Learn signal adjustments only from completed, non-overlapping real predictions.
(module tibo.signal_model
  (import "../platform/host.eli" Number Date)
  (import "../platform/util.eli" clamp)
  (defun signal-experience (rows signal base24 base48 &optional now bucket)
    (let* ((samples (js-call rows :filter (lambda (row)
      (and (= (get row :signal) signal) (or (not bucket) (= (get row :signalBucket) bucket))
        (or (not now) (and (Number/isFinite (Date/parse (get row :at)))
          (Number/isFinite (Date/parse (get (get row :outcome (js-object)) :scoredAt)))
          (<= (+ (Date/parse (get row :at)) 173400000) (Date/parse now))
          (<= (Date/parse (get (get row :outcome (js-object)) :scoredAt)) (Date/parse now))))
        (js-call (js-array 0 1) :includes (get (get row :outcome (js-object)) :y24))
        (js-call (js-array 0 1) :includes (get (get row :outcome (js-object)) :y48)) (get row :outcome) (get row :historicalPrediction)
        (Number/isFinite (get (get row :historicalPrediction) :p24))
        (Number/isFinite (get (get row :historicalPrediction) :p48))))))
      (n (get samples :length)) (result (js-object :n n :applied false :p24 base24 :p48 base48 :weight 0)))
      (when (>= n 30)
        (let* ((split (Math/floor (* n (/ 2 3)))) (training (js-call samples :slice 0 split)) (validation (js-call samples :slice split))
          (rate24 (/ (js-call training :reduce (lambda (sum r) (+ sum (get (get r :outcome) :y24))) 0) split))
          (rate48 (/ (js-call training :reduce (lambda (sum r) (+ sum (get (get r :outcome) :y48))) 0) split))
          (base-error 0) (candidate-error 0))
          (js-call validation :forEach (lambda (r)
            (let* ((base (get r :historicalPrediction)) (a (/ (get base :p24) 100)) (b (/ (get base :p48) 100))
              (y24 (get (get r :outcome) :y24)) (y48 (get (get r :outcome) :y48)))
              (setq base-error (+ base-error (Math/pow (- a y24) 2) (Math/pow (- b y48) 2)))
              (setq candidate-error (+ candidate-error (Math/pow (- (+ (* 0.8 a) (* 0.2 rate24)) y24) 2)
                (Math/pow (- (+ (* 0.8 b) (* 0.2 rate48)) y48) 2))))))
          (put result :validationN (get validation :length))
          (put result :baselineBrier (/ base-error (* 2 (get validation :length))))
          (put result :candidateBrier (/ candidate-error (* 2 (get validation :length))))
          ;; Conservative held-out improvement gate. Never train on the tested suffix.
          (when (< (+ candidate-error (* 0.002 (* 2 (get validation :length)))) base-error)
            (let ((actual24 (/ (js-call samples :reduce (lambda (sum r) (+ sum (get (get r :outcome) :y24))) 0) n))
              (actual48 (/ (js-call samples :reduce (lambda (sum r) (+ sum (get (get r :outcome) :y48))) 0) n)))
              (put result :applied t) (put result :weight 0.2)
              (put result :p24 (clamp (+ (* 0.8 base24) (* 20 actual24))))
              (put result :p48 (Math/max (get result :p24) (clamp (+ (* 0.8 base48) (* 20 actual48))))))))) result))
  (export signal-experience))
