(module tibo.forecast.card
  (import "../platform/host.eli" Number)
  (defun card-advice (prob)
    (let* ((a (get prob :p24)) (b (get prob :p48))
      (tier (cond ((or (= (get prob :available) false) (not (Number/isFinite a)) (not (Number/isFinite b))) "unknown")
        ((>= a 85) "very-high") ((>= a 65) "high") ((or (>= a 35) (>= b 60)) "medium")
        ((>= a 15) "low") (t "very-low")))
      (decision (cond ((= tier "unknown") "unknown") ((js-call (js-array "very-high" "high") :includes tier) "wait")
        ((= tier "medium") "lean-wait") (t "use-now")))
      (label (cond ((= tier "very-high") "建议先等") ((= tier "high") "倾向先等")
        ((= tier "medium") "略倾向先等") ((= tier "low") "倾向现在用") ((= tier "very-low") "建议现在用") (t "暂不能判断")))
      (h (if (and (= tier "medium") (< a 35)) 48 24)) (p (if (= h 48) b a))
      (reasons (cond ((= tier "very-high") (js-array
        (str "未来24h全局重置概率约" a "%，现在用卡很可能与即将到来的重置重叠。")
        (str "未来24h重置概率约" a "%，等本轮落地更有希望省下一张卡。")
        (str "短期重置概率已到" a "%，先等本轮比现在消耗卡更值得。")))
        ((= tier "high") (js-array
          (str "未来24h重置概率约" a "%，等待一次全局发放更有吸引力。")
          (str "未来24h有约" a "%的重置机会，先留卡等一轮更合适。")
          (str "短期重置概率约" a "%，现在用卡与下一次发放挨得太近的可能性较高。")))
        ((= tier "medium") (js-array
          (str "未来" h "h重置概率约" p "%，先等一轮有一定机会省下这张卡。")
          (str "未来" h "h有约" p "%的重置机会，等待的价值略高一些。")
          (str "未来" h "h重置概率约" p "%，目前留卡等一轮稍占优势。")))
        ((= tier "low") (js-array
          (str "未来24h全局重置概率仅约" a "%，不值得专门停下来等。")
          (str "未来24h重置概率约" a "%，现在用卡比押注短期发放更直接。")
          (str "短期重置机会约" a "%，目前没有很强的等待理由。")))
        ((= tier "very-low") (js-array
          (str "未来24h重置概率仅约" a "%，短期等到全局发放的希望偏低。")
          (str "未来24h全局重置概率约" a "%，现在用卡的倾向更明确。")
          (str "短期重置概率仅约" a "%，继续等一轮的吸引力较小。")))
        (t (js-array "当前没有可用的重置概率，无法比较用卡与等待。"))))
      (index (if (= tier "unknown") 0 (% (Math/round (+ a b)) (get reasons :length)))))
      (js-object :policy "card-advice-2" :decision decision :tier tier :label label
        :text (str label "。" (get reasons index)) :p24 a :p48 b :source "local"
        :assumption "usable-card-and-choice-to-spend-or-wait")))
  (defun current-card (prob)
    (let ((native (card-advice prob)) (saved (get prob :cardAdvice)))
      (if (and saved (= (get saved :policy) (get native :policy)) (= (get saved :p24) (get native :p24))
        (= (get saved :p48) (get native :p48)) (= (get saved :decision) (get native :decision))
        (= (get saved :tier) (get native :tier)) (= (value-type (get saved :text)) "string")
        (> (get (get saved :text) :length) 6) (<= (get (get saved :text) :length) 115)) saved native)))
  (export card-advice current-card))
