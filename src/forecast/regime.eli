(module tibo.forecast.regime
  (import "../platform/util.eli" ms day-ms)
  (defun regime-probability (rate hours) (* 100 (- 1 (Math/exp (* -1 rate (/ hours 24))))))
  (defun regime-rate (samples elapsed now)
    (let* ((clock (ms now))
      (past (js-call samples :filter (lambda (s) (and (not (get s :observed)) (> (get s :duration) 0) (<= (ms (get s :end)) clock)))))
      (long-mass 0) (long-exposure 0) (profiles (js-array)) (logs 0) (shrink-total 0))
      (js-call past :forEach (lambda (s)
        (let ((w (Math/exp (* -1 (Math/log 2) (/ (- clock (ms (get s :end))) (* 90 day-ms))))))
          (setq long-mass (+ long-mass w) long-exposure (+ long-exposure (* w (/ (get s :duration) day-ms)))))))
      (let ((long-rate (if (> long-exposure 0) (/ long-mass long-exposure) 0.1)))
        (js-call (js-array 14 45 90) :forEach (lambda (half-life)
          (let ((mass 0) (squared 0) (exposure 0) (k (/ (Math/log 2) half-life)))
            (js-call past :forEach (lambda (s)
              (let ((w (Math/exp (* -1 k (/ (- clock (ms (get s :end))) day-ms)))))
                (setq mass (+ mass w) squared (+ squared (* w w)) exposure (+ exposure (* w (/ (get s :duration) day-ms)))))))
            (let* ((censor (/ (- 1 (Math/exp (* -1 k (Math/max 0 (/ elapsed day-ms))))) k))
              (effective (if (> squared 0) (/ (* mass mass) squared) 0)) (shrink (/ effective (+ effective 8)))
              (rate (/ (+ mass 4) (+ exposure censor (/ 4 long-rate)))))
              (setq logs (+ logs (* shrink (Math/log (/ rate long-rate)))) shrink-total (+ shrink-total shrink))
              (js-call profiles :push (js-object :halfLifeDays half-life :mass mass :squaredMass squared :exposureDays exposure
                :censoredDays censor :effectiveN effective :shrink shrink :rate rate))))))
        (js-object :policy "regime-rate-1" :longRate long-rate :profiles profiles :shrink (/ shrink-total 3)
          :rate (* long-rate (Math/exp (/ logs 3)))))))
  (export regime-rate regime-probability))
