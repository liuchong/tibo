(module tibo.forecast.feature-model
  (import "../platform/host.eli" Number Date)
  (import "../platform/util.eli" ms clamp)
  (import "../evidence/post-features.eli" feature-contract)
  (import "./features.eli" numeric-features values-at)
  (defun model-gate (model features now)
    (if (not model) "no-validated-model" (try
      (let* ((support (get model :support)) (validation (get model :validation))
        (coefficients (get model :coefficients)) (names (Object/keys coefficients)))
        (cond ((not model) "no-validated-model")
          ((or (not (= (get model :contract) feature-contract)) (not (= (get model :status) "validated"))
            (not (= (get model :sourceGrade) (get features :sourceGrade)))
            (not (= (get model :profile) (get features :profile)))) "model-profile-mismatch")
          ((or (not (= (get support :auditedCoverage) t)) (not (Number/isInteger (get support :cycles))) (< (get support :cycles 0) 30)
            (not (= (get support :completePositiveAndNegativeWindows) t))) "insufficient-audited-samples")
          ((or (> (ms (get model :trainedThrough)) (ms now)) (> (ms (get validation :through)) (ms now))
            (< (- (ms (get validation :from)) (ms (get model :trainedThrough))) (* 48 3600000))
            (< (ms (get validation :through)) (ms (get validation :from)))
            (not (= (get validation :wholeCycleSplit) t)) (not (= (get validation :episodeDisjoint) t))) "invalid-time-validation")
          ((or (= (get names :length) 0) (> (get names :length) (get numeric-features :length))
            (js-call names :some (lambda (name)
              (or (not (js-call numeric-features :includes name))
                (not (Number/isFinite (get coefficients name)))
                (not (js-call (js-array 0 1) :includes (get (get features :values) name)))
                (not (Number/isInteger (get (get (get support :features) name (js-object)) :presentCycles)))
                (not (Number/isInteger (get (get (get support :features) name (js-object)) :absentCycles)))
                (< (get (get (get support :features) name (js-object)) :presentCycles 0) 10)
                (< (get (get (get support :features) name (js-object)) :absentCycles 0) 10))))) "unsupported-feature-or-missing-data")
          ((or (not (Number/isInteger (get validation :cycles))) (< (get validation :cycles 0) 10) (not (= (get validation :stableAcrossTime) t))
            (not (= (get validation :clusterUncertaintyPassed) t))
            (not (js-call (js-array "24" "48") :every (lambda (h)
              (let ((score (get validation (str "h" h))))
                (and score (Number/isFinite (get score :brierImprovement)) (> (get score :brierImprovement) 0)
                  (Number/isFinite (get score :logLossImprovement)) (> (get score :logLossImprovement) 0))))))) "validation-not-passed")
          (t nil)))
      (catch error "invalid-model"))))
  (defun adjusted-risk (base features model now)
    (let* ((reason (model-gate model features now)) (survival 1) (p24 (get base 4)) (p48 (get base 8)))
      (if reason (js-object :applied false :reason reason :p24 (clamp p24) :p48 (Math/max (clamp p24) (clamp p48)))
        (let ((i 0) (linear 0))
          (while (< i 8)
            (setq linear 0)
            (let ((values (values-at features (new Date (+ (ms now) (* i 6 3600000))))))
              (js-call (Object/keys (get model :coefficients)) :forEach (lambda (name)
                (setq linear (+ linear (* (get (get model :coefficients) name) (get values name)))))))
            (let* ((before (Math/max 0.000000001 (- 1 (/ (get base i) 100))))
              (after (Math/max 0.000000001 (- 1 (/ (get base (+ i 1)) 100))))
              (hazard (Math/max 0 (- (Math/log (/ after before)))))
              ;; The exponent bound is numerical protection, not a signal boost.
              (factor (Math/exp (Math/max -20 (Math/min 20 linear)))))
              (setq survival (* survival (Math/exp (* -1 hazard factor))))
              (when (= i 3) (setq p24 (* 100 (- 1 survival))))
              (when (= i 7) (setq p48 (* 100 (- 1 survival)))))
            (setq i (+ i 1)))
          (js-object :applied t :reason "validated-risk-model" :modelId (get model :id)
            :timingUsed (and (Object/hasOwn (get model :coefficients) "timingExpectation")
              (not (= (get (get model :coefficients) :timingExpectation) 0)))
            :p24 (clamp p24) :p48 (Math/max (clamp p24) (clamp p48)))))))
  (export model-gate adjusted-risk))
