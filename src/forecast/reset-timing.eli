(module tibo.forecast.reset-timing
  (import "./signals.eli" target-time pacific-target)
  (import "../platform/util.eli" ms iso hour-ms day-ms matches)
  (defun timing-window (claim)
    (let* ((timing (or (get claim :timing) (js-object))) (window (get timing :window)) (amount (get timing :amount))
      (zone (get timing :zone "unknown")) (at (get claim :at))
      (target (when (get claim :timing) (target-time (js-object :at at :text (get claim :quote))))))
      (when (get claim :timing)
        (cond (target (js-object :from at :through target :resolution "quoted-time"))
          ((and amount (js-call (js-array "within-hours" "within-days") :includes window))
            (js-object :from at :through (iso (+ (ms at) (* amount (if (= window "within-hours") hour-ms day-ms)))) :resolution "relative-window"))
          ((and (not (= zone "unknown")) (js-call (js-array "today" "tomorrow") :includes window)
            (matches (if (= window "tomorrow") "tomorrow" "today|EOD|end of (?:the )?day") (get claim :timeText "")))
            (let* ((next (= window "tomorrow"))
              (start (if (= zone "UTC") (iso (+ (ms (str (js-call at :slice 0 10) "T00:00:00Z")) (if next day-ms 0)))
                (pacific-target at 0 0 zone next)))
              (end (if (= zone "UTC") (iso (+ (ms start) day-ms)) (pacific-target at 24 0 zone next))))
              (js-object :from (iso (Math/max (ms at) (ms start))) :through end :resolution "calendar-window")))
          (t (js-object :from nil :through nil :resolution "unresolved"))))))
  (defun timing-claim? (c)
    (and (= (get c :status) "active") (get c :timing) (not (get c :contextMissing)) (= (get c :provenance) "primary")
      (js-call (js-array "promise" "hint") :includes (get c :kind))
      (js-call (js-array "codex-usage" "chatgpt-work-usage") :includes (get c :subject))
      (js-call (js-array "global" "unknown") :includes (get c :scope))
      (js-call (js-array "expectation" "intention" "possibility") :includes (get (get c :timing) :stance))))
  (defun timing-at? (c at)
    (let ((range (get c :expectedWindow)))
      (and (timing-claim? c) range (get range :from) (get range :through)
        (< (ms (get range :from)) (+ (ms at) (* 6 hour-ms))) (>= (ms (get range :through)) (ms at)))))
  (defun timing-assessment (features adjustment)
    (let ((claims (js-call (get features :claims) :filter timing-claim?)))
      (js-object :active claims :available (> (get claims :length) 0)
        :applied (not (not (and (> (get claims :length) 0) (get adjustment :applied) (get adjustment :timingUsed false))))
        :reason (get adjustment :reason "no-validated-timing-model"))))
  (export timing-window timing-claim? timing-at? timing-assessment))
