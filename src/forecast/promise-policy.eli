(module tibo.forecast.promise-policy
  (import "./promise-history.eli" promise-history estimate-promise)
  (import "./promise-prior.eli" estimate-prior)
  (import "../platform/util.eli" clamp ms hour-ms)
  (defun apply-promise-policy (prob signals snapshot)
    (let* ((dimensions (get prob :dimensions (js-object))) (promise (get signals :promise)))
      (if (and promise (get dimensions :applied) (= (get dimensions :at) (get snapshot :now))
        (= (get dimensions :postId) (get promise :postId)) (= (get dimensions :targetAt) (get promise :targetAt))
        (not (get promise :fulfilled)) (not (get promise :withdrawn))) prob
    (let* ((history (promise-history snapshot)) (estimate (estimate-promise snapshot signals history)))
      (put prob :promiseHistory history) (put prob :promisePolicy estimate)
      ;; Replace with the conditional estimate; do not add a second supposedly
      ;; independent chance on top of the interval models using the same events.
      (when (get estimate :applied)
        (put prob :p24 (clamp (get (get estimate :h24) :estimate)))
        (put prob :p48 (Math/max (get prob :p24) (clamp (get (get estimate :h48) :estimate))))
        (put prob :available t) (put prob :confidence "中") (put prob :mode "empirical-promise-history"))
      ;; Sparse histories use an explicit smoothed model instead of withholding
      ;; numbers or presenting the unconditional baseline as the final forecast.
      (let ((p (get signals :promise)))
        (when (and p (get p :primary) (= (get p :kind) "global")
          (not (get p :fulfilled)) (not (get p :withdrawn)) (not (get estimate :applied)))
          (let ((smoothed (estimate-prior prob p snapshot history estimate)))
            (put prob :promisePrior smoothed) (put prob :available t)
            (put prob :p24 (get smoothed :p24)) (put prob :p48 (get smoothed :p48)))
          (put prob :mode "smoothed-promise-history") (put prob :confidence "中")
          (put prob :announcement (js-object :postId (get p :postId) :targetAt (get p :targetAt))))) prob))))
  (export apply-promise-policy))
