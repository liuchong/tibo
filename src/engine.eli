(module tibo.engine
  (import "./host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "node:fs/promises" readFile)
  (import "./sources.eli" collect-sources)
  (import "./signals.eli" normalize-events analyze-signals)
  (import "./history.eli" summarize-history)
  (import "./forecast.eli" forecast)
  (import "./models.eli" eligible)
  (import "./availability.eli" information)
  (import "./report.eli" render-report)
  (import "./experience.eli" record-prediction)
  (import "./ai.eli" enhance)
  (import "./diagnostics.eli" diagnostics)
  (import "./state.eli" read-state write-state with-lock)
  (import "./util.eli" ms iso fail)
  (defun validate-snapshot (snapshot)
    (unless (and (= (get snapshot :schemaVersion) 1) (Array/isArray (get snapshot :events))
                 (Array/isArray (get snapshot :posts)) (Array/isArray (get snapshot :sources))
                 (Array/isArray (get snapshot :unknowns))) (fail "证据快照 schemaVersion/数组不合法"))
    (ms (get snapshot :now))
    (js-call (get snapshot :events) :forEach
      (lambda (e)
        (ms (get e :at))
        (unless (and (= (value-type (get e :id)) "string") (= (value-type (get e :global)) "boolean")
                     (= (value-type (get e :banked)) "boolean")) (fail "历史记录字段不合法"))))
    (js-call (get snapshot :posts) :forEach
      (lambda (p)
        (ms (get p :at))
        (unless (and (= (get p :author) "thsottiaux") (= (value-type (get p :text)) "string")
                     (= (value-type (get p :id)) "string")) (fail "帖子作者/字段不合法"))))
    snapshot)
  (defun observe (snapshot)
    (validate-snapshot snapshot)
    (let* ((events (normalize-events snapshot)) (signals (analyze-signals snapshot events)))
      (js-object :templateVersion "2" :snapshot snapshot :events events :signals signals)))
  (defun judge (snapshot)
    (let* ((result (observe snapshot)) (history (summarize-history (get result :events) (get snapshot :now)))
           (prob (forecast snapshot history (get result :signals))))
      (put result :history history) (put result :forecast prob) result))
  (defun available-judgment (snapshot)
    (let* ((observed (observe snapshot))
      (history (when (get (get observed :signals) :lastGlobal) (summarize-history (get observed :events) (get snapshot :now)))))
      (if (and history (>= (get (eligible (get history :intervals)) :length) 3)) (judge snapshot)
        (progn
          (put observed :history history)
          (put observed :forecast (js-object :available false :p24 nil :p48 nil :base24 nil :base48 nil :confidence "低"
            :mode "evidence-only" :policyVersion "3" :information (information snapshot (get observed :signals) history)
            :signal "数值依据不足" :signalStrength "未知" :reasons (js-array "历史不足，保留公告和原帖；不编造数值概率"))) observed))))
  (defasync load-snapshot (&optional path offline)
    (if path (validate-snapshot (JSON/parse (await (readFile path "utf8"))))
      (let ((snapshot (validate-snapshot (await (collect-sources nil offline)))))
        (try
          (let ((experience (await (read-state "experience"))))
            (when experience
              (unless (and (Array/isArray (get experience :predictions (js-array)))
                           (Array/isArray (get (get experience :accuracy (js-object)) :models (js-array))))
                (fail "预测经验结构不可读"))
              (put snapshot :experience (get experience :accuracy))
              (put snapshot :predictionExperience (get experience :predictions (js-array)))))
          (catch error (put snapshot :experienceUnavailable t))) snapshot)))
  (defasync run-report (&optional options)
    (let* ((started (Date/now)) (channel (get options :channel "cli")) (persist (get options :persist t))
           (snapshot (await (load-snapshot (get options :snapshotPath) (get options :offline))))
           (collected (Date/now))
           (native (available-judgment snapshot))
           (result (if (= (get (get native :forecast) :available) false) native
             (await (enhance native (or (get options :snapshotPath) (get options :offline) (get options :noAi))))))
           (previous (await (read-state (str "report-" channel)))))
      (put result :timing (js-object :collectionMs (- collected started) :analysisMs (- (Date/now) collected)))
      (when (and (not (= (get (get result :forecast) :available) false)) (not (get options :snapshotPath)) (not (get options :offline)))
        (try (put result :experience (await (record-prediction result)))
          (catch error (put (get (get result :forecast) :information) :experienceUnavailable t))))
      (when (and previous (> (ms (get previous :now)) (ms (get snapshot :now)))) (setq previous nil))
      (put result :report (render-report result previous (get options :titleTime)))
      (when persist (await (save-report channel result)))
      result))
  (defasync save-report (channel result)
    (await (write-state (str "diagnostics-" channel) (diagnostics result)))
    (unless (= (get (get result :forecast) :available) false)
    (await (write-state (str "report-" channel) (js-object :now (get (get result :snapshot) :now)
      :p24 (get (get result :forecast) :p24) :p48 (get (get result :forecast) :p48)))))
    (await (write-state (str "evidence-" channel) (get result :snapshot))))
  (defun reset-status (result &optional since)
    (let* ((event (get (get result :signals) :lastGlobal))
           (verified (and event (get event :verified)))
           (new-reset (and event since (> (ms (get event :at)) (ms since)))))
      (js-object :now (get (get result :snapshot) :now) :latestGlobal event
        :state (if (not event) "unknown" (if verified (if (= (get event :provenance) "primary") "confirmed-announcement" "archived-announcement") "unverified-record"))
        :newSince (if (not event) "unknown" (if since (if new-reset (if verified (if (= (get event :provenance) "primary") "confirmed" "archived") "unverified") "none-in-evidence") "not-requested"))
        :accountApplied "unknown" :latestBanked (get (get result :signals) :lastBanked)
        :unknowns (get (get result :snapshot) :unknowns))))
  (export validate-snapshot observe judge available-judgment load-snapshot run-report save-report reset-status))
