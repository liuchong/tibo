;; Bounded data-only HTML reader for the selectors used by our source adapters.
;; This is deliberately not a browser or a general HTML5 tree repair engine.
(module tibo.html
  (import "./host.eli" Error RegExp Number parseInt)
  (import "./util.eli" fail clean match matches)
  (defun decode-entities (text)
    (js-call text :replace (new RegExp "&(#x[0-9a-f]+|#[0-9]+|amp|lt|gt|quot|apos|nbsp|mdash|ndash|hellip);" "gi")
      (lambda (whole entity)
        (let ((key (js-call entity :toLowerCase)))
          (if (= (get key 0) "#")
            (let ((n (if (= (get key 1) "x") (parseInt (js-call key :slice 2) 16) (Number (js-call key :slice 1)))))
              (if (and (> n 0) (<= n 1114111) (not (and (>= n 55296) (<= n 57343)))) (String/fromCodePoint n) "�"))
            (get (js-object :amp "&" :lt "<" :gt ">" :quot "\"" :apos "'" :nbsp " " :mdash "—" :ndash "–" :hellip "…") key whole))))))
  (defun parse-attrs (text)
    (let ((attrs (Object/create nil))
          (rows (Array/from (js-call text :matchAll (new RegExp "([^\\s=/>]+)(?:\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+)))?" "g")))))
      (js-call rows :forEach (lambda (m)
        (let ((key (js-call (get m 1) :toLowerCase)))
          (unless (Object/hasOwn attrs key)
            (put attrs key (decode-entities (or (get m 2) (get m 3) (get m 4) "")))))))
      attrs))
  (defun parse-html (html)
    (when (> (get html :length) 2000000) (fail "HTML exceeds 2 MB"))
    (let* ((text (js-call html :replace (new RegExp "<(script|style)\\b[^>]*>[\\s\\S]*?(?:</\\1\\s*>|$)" "gi") ""))
           (root (js-object :tag "root" :attrs (js-object) :children (js-array)))
           (stack (js-array root)) (count 0)
           (tokens (Array/from (js-call text :matchAll
             (new RegExp "<!--[\\s\\S]*?(?:-->|$)|<![^>]*>|</?[a-zA-Z](?:[^>\"']|\"[^\"]*\"|'[^']*')*>|[^<]+|<" "g")))))
      (js-call tokens :forEach
        (lambda (row)
          (let ((token (get row 0)) (parent (get stack (- (get stack :length) 1))))
            (cond
              ((matches "^<!" token) nil)
              ((matches "^</" token)
                (let* ((m (match "^</([a-zA-Z0-9:-]+)" token)) (tag (js-call (get m 1) :toLowerCase))
                       (i (- (get stack :length) 1)))
                  (while (and (> i 0) (not (= (get (get stack i) :tag) tag))) (setq i (- i 1)))
                  (when (> i 0) (put stack :length i))))
              ((matches "^<[a-zA-Z]" token)
                (let* ((m (match "^<([a-zA-Z0-9:-]+)" token)) (tag (js-call (get m 1) :toLowerCase))
                       (node (js-object :tag tag :attrs (parse-attrs (js-call token :slice (get (get m 0) :length) -1)) :children (js-array))))
                  (setq count (+ count 1))
                  (when (> count 50000) (fail "HTML node limit exceeded"))
                  (js-call (get parent :children) :push node)
                  (unless (or (matches "^(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)$" tag) (matches "/>$" token))
                    (when (>= (get stack :length) 128) (fail "HTML depth limit exceeded"))
                    (js-call stack :push node))))
              (t (js-call (get parent :children) :push (decode-entities token)))))))
      root))
  (defun select (node predicate)
    (let ((result (js-array)))
      (js-call (get node :children (js-array)) :forEach
        (lambda (child)
          (when (= (value-type child) "object")
            (when (funcall predicate child) (js-call result :push child))
            (setq result (js-call result :concat (select child predicate))))))
      result))
  (defun by-tag (node tag) (select node (lambda (n) (= (get n :tag) tag))))
  (defun by-class (node class)
    (select node (lambda (n) (js-call (js-call (get (get n :attrs) :class "") :split (new RegExp "\\s+")) :includes class))))
  (defun html-text (node)
    (if (not node) ""
      (clean (js-call (js-call (get node :children (js-array)) :map
        (lambda (child) (if (= (value-type child) "string") child (str " " (html-text child) " ")))) :join ""))))
  (defun attr (node key) (if node (get (get node :attrs) key nil) nil))
  (export decode-entities parse-html select by-tag by-class html-text attr))
