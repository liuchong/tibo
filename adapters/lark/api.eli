(module tibo.lark.api
  (import "../../src/platform/host.eli" Date RegExp Error Number URLSearchParams fetch AbortSignal encodeURIComponent)
  (import "node:timers/promises" setTimeout)
  (import "../../src/evidence/transport.eli" request-json)
  (import "../../src/platform/util.eli" fail)
  (defasync message-attempt (url payload token operation timeout)
    (let ((diagnostic (js-object :operation operation :kind "network")))
      (try
        (let* ((response (await (fetch url (js-object :method "POST" :redirect "error"
          :signal (AbortSignal/timeout timeout) :headers (js-object :content-type "application/json" :authorization (str "Bearer " token))
          :body payload)))) (result nil))
          (put diagnostic :httpStatus (get response :status))
          (let ((id (or (js-call (get response :headers) :get "x-tt-logid") (js-call (get response :headers) :get "x-request-id"))))
            (when (and id (js-call (new RegExp "^[A-Za-z0-9_-]{1,128}$") :test id)) (put diagnostic :requestId id)))
          (put diagnostic :kind "response-json")
          (let ((text (await (js-call response :text))))
            (when (> (get text :length) 2000000) (fail "Message response exceeds limit"))
            (try (setq result (JSON/parse text)) (catch error nil)))
          (unless (and (get response :ok) result (= (get result :code) 0))
          (when (Number/isInteger (get (or result (js-object)) :code)) (put diagnostic :code (get result :code)))
          (put diagnostic :kind (if (and (>= (get response :status) 400) (< (get response :status) 500)) "http-rejected"
            (if (and (get response :ok) result (Number/isInteger (get result :code))) "api-rejected" "response-unconfirmed")))
          (let ((error (new Error "Message request was not confirmed")))
            (put error :deliveryDiagnostic diagnostic)
            (when (or (= (get diagnostic :kind) "http-rejected") (= (get diagnostic :kind) "api-rejected")) (put error :definitiveRejection t))
            (when (and (get error :definitiveRejection) (Number/isInteger (get diagnostic :code))) (put error :larkCode (get diagnostic :code)))
            (throw error))) result)
        (catch error
          (unless (get error :deliveryDiagnostic)
            (when (js-call (js-array "TimeoutError" "AbortError") :includes (get error :name)) (put diagnostic :kind "timeout"))
            (let ((code (get (get error :cause (js-object)) :code (get error :code))))
              (when (and (= (value-type code) "string") (js-call (new RegExp "^[A-Z_]{1,40}$") :test code)) (put diagnostic :networkCode code)))
            (put error :deliveryDiagnostic diagnostic))
          (throw error)))))
  (defasync message-request (url body token operation)
    ;; The official one-hour UUID contract makes these identical short-window
    ;; attempts one logical send. Never regenerate content or retry without it.
    (let ((payload (JSON/stringify body)) (deadline (+ (Date/now) 27000)) (attempt 0) (result nil) (complete false)
      (deduplicated (and (= (value-type (get body :uuid)) "string") (> (get (get body :uuid) :length) 0) (<= (get (get body :uuid) :length) 50))))
      (while (not complete)
        (setq attempt (+ attempt 1))
        (try
          (setq result (await (message-attempt url payload token operation (Math/max 1 (Math/min 8000 (- deadline (Date/now)))))) complete t)
          (catch error
            (let* ((diagnostic (get error :deliveryDiagnostic (js-object))) (status (get diagnostic :httpStatus 0))
              (retryable (or (js-call (js-array "network" "timeout") :includes (get diagnostic :kind))
                (= status 408) (= status 429) (>= status 500))))
              (put diagnostic :attempts attempt) (put error :deliveryDiagnostic diagnostic)
              (if (and deduplicated retryable (< attempt 3) (> (- deadline (Date/now)) 2000))
                (await (setTimeout (if (= attempt 1) 500 1500))) (throw error)))))) result))
  (defun create-client (app-id secret domain)
    (unless (or (= domain "feishu") (= domain "lark") (not domain)) (fail "Lark domain 必须是 feishu 或 lark"))
    (let ((base (if (= domain "lark") "https://open.larksuite.com" "https://open.feishu.cn"))
          (token nil) (expires 0) (refresh nil))
      (let ((access (async ()
              (when (or (not token) (>= (Date/now) expires))
                (unless refresh
                  (setq refresh (request-json (str base "/open-apis/auth/v3/tenant_access_token/internal")
                    (js-object :method "POST" :redirect "error" :headers (js-object :content-type "application/json")
                      :body (JSON/stringify (js-object :app_id app-id :app_secret secret))))))
                (try
                  (let ((result (await refresh)))
                    (unless (and (= (get result :code) 0) (get result :tenant_access_token) (> (get result :expire 0) 60))
                      (fail "Lark token 请求失败，检查应用凭据与权限"))
                    (setq token (get result :tenant_access_token) expires (+ (Date/now) (* (- (get result :expire) 60) 1000))))
                  (finally (setq refresh nil))))
              token)))
        (js-object
          :botInfo (async ()
            (let ((result (await (request-json (str base "/open-apis/bot/v3/info")
                     (js-object :redirect "error" :headers (js-object :authorization (str "Bearer " (await (funcall access)))))))))
              (unless (and (= (get result :code) 0) (get (get result :bot) :open_id)) (fail "Lark 机器人信息不可用，检查机器人能力与应用发布状态"))
              (get result :bot)))
          :send (async (body &optional recipient-type)
            (setq recipient-type (or recipient-type "chat_id"))
            (unless (or (= recipient-type "chat_id") (= recipient-type "open_id")) (fail "消息接收者类型无效"))
            ;; Fixed UUID attempts are bounded inside message-request.
            (await (message-request (str base "/open-apis/im/v1/messages?receive_id_type=" recipient-type) body (await (funcall access)) "send")))
          :reply (async (id body)
            (unless (js-call (new RegExp "^om_[A-Za-z0-9_-]{1,180}$") :test id) (fail "Invalid message ID"))
            (await (message-request (str base "/open-apis/im/v1/messages/" id "/reply") body (await (funcall access)) "reply")))
          :historyPage (async (kind id token start end &optional signal)
            (unless (and (js-call (js-array "chat" "thread") :includes kind)
              (js-call (new RegExp (if (= kind "chat") "^oc_[A-Za-z0-9]+$" "^omt_[A-Za-z0-9_-]{1,180}$")) :test id)
              (or (not token) (and (= (value-type token) "string") (<= (get token :length) 2048)))) (fail "Invalid history selector"))
            (let ((params (new URLSearchParams (js-object :container_id_type kind :container_id id :page_size "50" :sort_type "ByCreateTimeAsc"))))
              (when token (js-call params :set "page_token" token))
              (when (= kind "chat")
                (js-call params :set "start_time" (str (Math/floor (/ (Number start) 1000))))
                (js-call params :set "end_time" (str (+ 1 (Math/floor (/ (Number end) 1000))))))
              (let ((result (await (request-json (str base "/open-apis/im/v1/messages?" (js-call params :toString))
                (js-object :redirect "error" :signal signal :headers (js-object :authorization (str "Bearer " (await (funcall access))))) 1800))))
                (unless (and (= (get result :code) 0) (get result :data)) (fail "History unavailable")) (get result :data))))
          ;; Fixed read-only API for verified legacy message metadata, never an AI URL.
          :react (async (id emoji)
            (unless (and (js-call (new RegExp "^om_[A-Za-z0-9_-]{1,180}$") :test id)
              (js-call (js-array "OK" "SMILE" "THUMBSUP" "Typing") :includes emoji)) (fail "Invalid reaction"))
            (let ((result (await (request-json (str base "/open-apis/im/v1/messages/" id "/reactions")
              (js-object :method "POST" :redirect "error" :headers (js-object :content-type "application/json"
                :authorization (str "Bearer " (await (funcall access))))
                :body (JSON/stringify (js-object :reaction_type (js-object :emoji_type emoji)))) 1800))))
              (unless (and (= (get result :code) 0) (get (get result :data (js-object)) :reaction_id))
                (let ((error (new Error "Reaction unavailable"))) (put error :larkCode (get result :code)) (throw error)))
              (get (get result :data) :reaction_id)))
          :unreact (async (id reaction-id)
            (unless (and (js-call (new RegExp "^om_[A-Za-z0-9_-]{1,180}$") :test id)
              (= (value-type reaction-id) "string") (> (get reaction-id :length) 0) (<= (get reaction-id :length) 1024)) (fail "Invalid reaction ID"))
            (let ((result (await (request-json (str base "/open-apis/im/v1/messages/" id "/reactions/" (encodeURIComponent reaction-id))
              (js-object :method "DELETE" :redirect "error"
                :headers (js-object :authorization (str "Bearer " (await (funcall access))))) 1800))))
              (unless (= (get result :code) 0) (fail "Reaction removal unavailable")) t))
          :chatInfo (async (id)
            (unless (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test id) (fail "Invalid chat ID"))
            (let ((result (await (request-json (str base "/open-apis/im/v1/chats/" id "?user_id_type=open_id")
              (js-object :redirect "error" :headers (js-object :authorization (str "Bearer " (await (funcall access))))) 4000))))
              (unless (and (= (get result :code) 0) (get result :data)) (fail "Chat metadata unavailable")) (get result :data)))
          :messageInfo (async (id &optional signal)
            (unless (js-call (new RegExp "^om_[A-Za-z0-9_-]{1,180}$") :test id) (fail "Invalid message ID"))
            (let* ((result (try (await (request-json (str base "/open-apis/im/v1/messages/" id)
              (js-object :redirect "error" :signal signal :headers (js-object :authorization (str "Bearer " (await (funcall access))))) 1800))
                (catch error
                  (when (js-call (js-array "HTTP 403" "HTTP 404") :includes (get error :message)) (put error :permanent t)) (throw error))))
                   (item (get (get (get result :data (js-object)) :items (js-array)) 0)))
              (unless (and (= (get result :code) 0) item (= (get item :message_id) id))
                (let ((error (new Error "Message unavailable")))
                  (when (and (= (get result :code) 0) (not item)) (put error :permanent t)) (throw error))) item))
          :connectConfig (async ()
            (await (request-json (str base "/callback/ws/endpoint")
              (js-object :method "POST" :redirect "error" :headers (js-object :content-type "application/json" :locale "zh")
                :body (JSON/stringify (js-object :AppID app-id :AppSecret secret))))))))))
  (export create-client))
