;; Transport-owned delivery receipts surround shared relevance and pacing.
(module tibo.lark.interaction
  (import "../../src/platform/host.eli" Date)
  (import "../../src/platform/state.eli" read-state write-state)
  (import "../../src/platform/util.eli" iso)
  (import "../../src/commands/index.eli" fixed-query)
  (import "../../src/commands/catalog.eli" definition)
  (import "../../src/presentation/syntax.eli" parse-pipeline)
  (import "../../src/prayer/pray.eli" pray record-pray)
  (import "../../src/im/triggers.eli" decide-secondary)
  (import "../../src/im/reactions.eli" reaction-choice)
  (import "../../src/im/context.eli" conversation-context group-context?)
  (import "../../src/im/reply-policy.eli" reply-permit settle-reply)
  (import "../../src/im/tasks.eli" run-tasks)
  (import "../../src/im/plan.eli" interaction-plan)
  (import "./service.eli" delivery-key deliver account-key)
  (defun reply-kind (job)
    (cond ((>= (get job :triggerLevel 0) 2) "ambient")
      ((= (get job :triggerKind) "prayer") "prayer")
      (t (let* ((base (try (get (parse-pipeline (get job :command) t) :base) (catch error (get job :command))))
        (query (fixed-query base)))
        (if (and query (= (get query :command) "pray") (= (get (get query :args) :action "offer") "offer")) "prayer" "direct")))))
  (defasync suppress (job decision)
    (let* ((key (delivery-key (get job :group) (get job :key))) (context (get job :context)) (recorded false))
      ;; Silence is an output decision, never permission to lose an offering.
      ;; The prayer receipt uses the same key as a normal delivery/replay.
      (when (= (reply-kind job) "prayer")
        (let ((response (await (pray (js-object :action "offer")
          (Object/assign (js-object) context (js-object :requestId key)) (js-object :noAi t :silent t)))))
          (setq recorded (get response :ok))))
      (await (write-state key (js-object :state "suppressed" :at (iso (Date/now)) :reason (get decision :reason)
        :replyPolicy decision :prayerRecorded recorded))) nil))
  (defun reaction-decision (job decision)
    (cond ((= (reply-kind job) "ambient") decision)
      ((= (reply-kind job) "direct")
        (try
          (let* ((query (fixed-query (get (parse-pipeline (get job :command) t) :base)))
            (name (when query (get query :command))) (spec (when query (definition name))))
            (when (or (not query) (and spec (not (get spec :admin))
              (not (js-call (js-array "pray" "subscribe" "unsubscribe") :includes name))))
              ;; Unknown semantic text still needs local business relatedness.
              ;; Fixed read queries need no AI just to acknowledge their receipt.
              (js-object :accepted t :method (if spec "direct-query" "local") :reason "speech-suppressed")))
          (catch error nil))) (t nil)))
  (defasync maybe-react (client job decision activity)
    (let* ((context (get job :context)) (text (get job :command)) (id (get job :key))
      (circuit-key (str "lark-reaction-circuit-" (account-key)))
      (circuit (try (await (read-state circuit-key)) (catch error (js-object :until (+ (Date/now) 600000)))))
      (candidate (reaction-decision job decision))
      (emoji (when (and candidate (group-context? context)
        (= (get context :authenticated) t) (<= (get (or circuit (js-object)) :until 0) (Date/now))
        (= (value-type (get client :react)) "function")) (reaction-choice text candidate)))
      (permit (when emoji (await (reply-permit context (str "reaction:" id) "reaction" text activity t))))
      (key (delivery-key (get job :group) id)))
      (when (and permit (get permit :accepted))
        ;; Reserve the durable receipt before external I/O; uncertain sends are not retried.
        (await (write-state key (js-object :state "reaction-sending" :at (iso (Date/now)) :emoji emoji :replyPolicy permit)))
        (try
          (let ((reaction-id (await (js-call client :react (get job :messageId id) emoji))))
            (await (write-state key (js-object :state "reacted" :at (iso (Date/now)) :emoji emoji :reactionId reaction-id :replyPolicy permit)))
            (await (settle-reply context (str "reaction:" id) "sent")))
          (catch error
            (try (await (write-state circuit-key (js-object :until (+ (Date/now) 600000) :at (iso (Date/now))))) (catch error nil))
            (await (write-state key (js-object :state "reaction-unavailable-or-uncertain" :at (iso (Date/now)) :emoji emoji :replyPolicy permit)))
            (await (settle-reply context (str "reaction:" id) "uncertain")))) t)))
  (defasync process-single (client job)
    ;; Count first, before any send receipt or AI. A failed count leaves the
    ;; durable inbox event retryable; later replay/generation never counts twice.
    (when (= (reply-kind job) "prayer")
      (await (record-pray (js-object :action "offer")
        (Object/assign (js-object) (get job :context)
          (js-object :requestId (delivery-key (get job :group) (get job :key)))) (js-object :silent t))))
    (let* ((context (get job :context)) (kind (reply-kind job)) (command (get job :command)) (id (get job :key))
      (history (await (conversation-context context command (get job :messageId id) (or (get job :createdAt) (iso (Date/now))))))
      (origin (get job :sourceEvent ""))
      (first (await (reply-permit context id kind command (get history :activity) nil origin))) (decision nil))
      (cond
        ((and (= kind "ambient") (group-context? context) (get job :createdAt)
          (< (Date/parse (get job :createdAt)) (- (Date/now) 90000)))
          (await (suppress job (js-object :accepted false :kind kind :reason "ambient-expired"))))
        ((not (get first :accepted))
          ;; Keep sensitivity statistics even when speech is suppressed;
          ;; classify locally only, never spend AI on an exhausted budget.
          (setq decision (when (= kind "ambient") (await (decide-secondary command context id t))))
          (await (suppress job first))
          (unless (= (get first :reason) "repeat-request") (await (maybe-react client job decision (get history :activity)))))
        (t
          (setq decision (when (= kind "ambient") (await (decide-secondary command context id (= (get job :triggerLevel) 3)))))
          (if (and decision (or (not (get decision :accepted)) (= (get job :triggerLevel) 3)))
            (progn
              (await (write-state (delivery-key (get job :group) id) (js-object :state "filtered" :at (iso (Date/now))
                :reason (get decision :reason) :method (get decision :method))))
              (await (maybe-react client job decision (get history :activity))))
            (let ((permit (await (reply-permit context id kind command (get history :activity) t origin))))
              (if (not (get permit :accepted)) (progn (await (suppress job permit))
                (unless (= (get permit :reason) "repeat-request") (await (maybe-react client job decision (get history :activity)))))
                (progn
                  (put job :replyPolicy permit)
                  (try (await (deliver client (get job :group) id command (get job :titleTime) context nil job))
                    (finally
                      (let ((receipt (await (read-state (delivery-key (get job :group) id)))))
                        (await (settle-reply context id (get receipt :state))))))))))))))
  (defasync process-interaction (client job)
    (let* ((group (get job :group)) (root (delivery-key group (get job :key)))
      (plan (interaction-plan job (async (leaf)
        (let* ((key (delivery-key group (get leaf :key))) (receipt (await (read-state key))))
          (unless receipt
            (if (get leaf :followupOf)
              ;; A continuation is part of an already admitted response. It can
              ;; only follow a confirmed send, never a suppressed/unknown one.
              (let ((prior (await (read-state (delivery-key group (get leaf :followupOf))))))
                (when (and (= (get prior :state) "sent") (not (= (get prior :businessOk) false)))
                  (put leaf :replyPolicy (get (get prior :latency (js-object)) :replyPolicy))
                  (await (deliver client group (get leaf :key) (get leaf :command) (get leaf :titleTime)
                    (get leaf :context) nil leaf))))
              (await (process-single client leaf))))
          (let ((saved (await (read-state key))))
            (and (= (get saved :state) "sent") (not (= (get saved :businessOk) false)))))))))
      (await (run-tasks (get plan :tree)))
      (when (get plan :composed)
        (await (write-state root (js-object :state "handled" :at (iso (Date/now))
          :receiptKey (delivery-key group (or (get plan :prayerId) (get plan :contentId)))
          :companionReceiptKey (delivery-key group (get plan :contentId))
          :forecastReceiptKey (when (get plan :forecastId) (delivery-key group (get plan :forecastId)))))))))
  (export reply-kind process-interaction))
