(module tibo.lark.socket
  (import "node:timers" setTimeout clearTimeout)
  (import "node:zlib" gunzipSync)
  (import "../../src/platform/host.eli" Error Date Promise Map Number WebSocket URL Uint8Array TextEncoder TextDecoder)
  (import "../../src/platform/util.eli" fail matches)
  (import "./wire.eli" encode-frame decode-frame header-value merge-fragment)
  (defun seconds (value fallback low high)
    (let ((n (Number value)))
      (if (and (Number/isFinite n) (> n 0)) (Math/max low (Math/min high (* n 1000))) fallback)))
  (defasync open-socket (client handler &optional signal)
    (let ((ws nil) (stopped false) (heartbeat nil) (watchdog nil) (retry nil) (handshake nil)
          (interval 120000) (retry-ms 10000) (fragments (new Map)) (state "connecting") (attempts 0)
          (encoder (new TextEncoder)) (decoder (new TextDecoder "utf-8" (js-object :fatal t)))
          (connect nil) (ping nil) (reconnect nil) (close nil))
      (setq close (lambda ()
        (setq stopped t state "stopped")
        (clearTimeout heartbeat) (clearTimeout watchdog) (clearTimeout retry) (clearTimeout handshake)
        (when signal (js-call signal :removeEventListener "abort" close))
        (when ws (js-call ws :close)) (js-call fragments :clear)))
      (when signal
        (when (get signal :aborted) (fail "Lark 已停止"))
        (js-call signal :addEventListener "abort" close (js-object :once t)))
      (setq ping (lambda ()
        (when (and (not stopped) ws (= (get ws :readyState) 1))
          (js-call ws :send (encode-frame (js-object :service (Number (js-call (get (new URL (get ws :url)) :searchParams) :get "service_id"))
            :kind 0 :headers (js-array (js-object :key "type" :value "ping")))))
          (clearTimeout watchdog)
          (let ((socket ws)) (setq watchdog (setTimeout (lambda () (js-call socket :close)) 30000)))
          (clearTimeout heartbeat) (setq heartbeat (setTimeout ping interval)))))
      (setq reconnect (lambda ()
        (unless stopped
          (setq state "reconnecting" attempts (+ attempts 1))
          (js-call (funcall connect) :catch (lambda (error)
            (unless stopped
              (console/error "tibo-lark: 长连接重连失败，稍后重试")
              (setq retry (setTimeout reconnect retry-ms))))))))
      (setq connect (async ()
        (let* ((config (await (js-call client :connectConfig))) (data (get config :data (js-object)))
               (address (get data :URL "")) (settings (get data :ClientConfig (js-object))))
          (when stopped (fail "Lark 已停止"))
          (unless (= (get config :code) 0) (fail "Lark 长连接配置失败，检查事件订阅与应用凭据"))
          (let ((parsed (new URL address)))
            (unless (and (= (get parsed :protocol) "wss:") (= (get parsed :username) "") (= (get parsed :password) "")
                         (matches "(?:^|\\.)(?:feishu\\.cn|larksuite\\.com|larkoffice\\.com)$" (get parsed :hostname))
                         (Number/isInteger (Number (js-call (get parsed :searchParams) :get "service_id")))
                         (> (Number (js-call (get parsed :searchParams) :get "service_id")) 0))
              (fail "Lark 长连接地址不合法")))
          (setq interval (seconds (get settings :PingInterval) interval 5000 300000)
                retry-ms (seconds (get settings :ReconnectInterval) retry-ms 1000 60000))
          (setq ws (new WebSocket address)) (put ws :binaryType "arraybuffer")
          (await (new Promise (lambda (resolve reject)
            (let ((socket ws) (opened false))
              (setq handshake (setTimeout (lambda () (js-call socket :close) (funcall reject (new Error "Lark 握手超时"))) 15000))
              (put socket :onopen (lambda ()
                (when stopped (js-call socket :close) (funcall reject (new Error "Lark 已停止")))
                (unless stopped (setq opened t state "connected") (clearTimeout handshake) (funcall ping) (funcall resolve nil))))
              (put socket :onerror (lambda ()
                (unless opened (clearTimeout handshake) (js-call socket :close) (funcall reject (new Error "Lark 握手失败")))))
              (put socket :onclose (lambda ()
                (when (= ws socket)
                  (clearTimeout handshake) (clearTimeout heartbeat) (clearTimeout watchdog) (js-call fragments :clear)
                  (unless opened (funcall reject (new Error "Lark 握手关闭")))
                  (when (and opened (not stopped)) (setq state "reconnecting" retry (setTimeout reconnect retry-ms))))))
              (put socket :onmessage (async (message)
                (when (and (not stopped) (= socket ws))
                  (try
                    (let* ((frame (decode-frame (new Uint8Array (get message :data))))
                           (kind (get frame :kind)) (type (header-value frame "type")))
                      (clearTimeout watchdog)
                      (cond
                        ((and (= kind 0) (= type "pong") (get frame :payload))
                          (let ((pong (JSON/parse (js-call decoder :decode (get frame :payload)))))
                            (setq interval (seconds (get pong :PingInterval) interval 5000 300000)
                                  retry-ms (seconds (get pong :ReconnectInterval) retry-ms 1000 60000))))
                        ((and (= kind 1) (= type "event"))
                          (let ((bytes (merge-fragment fragments frame (Date/now))))
                            (when bytes
                              (when (= (get frame :encoding) "gzip") (setq bytes (gunzipSync bytes (js-object :maxOutputLength 2097152))))
                              (unless (or (not (get frame :encoding)) (= (get frame :encoding) "") (= (get frame :encoding) "gzip")) (fail "Unsupported event encoding"))
                              (let ((event (JSON/parse (js-call decoder :decode bytes))) (started (Date/now)) (code 200))
                                (try
                                  (when (js-call (js-array "im.message.receive_v1" "im.message.reaction.created_v1") :includes (get (get event :header) :event_type))
                                    (await (funcall handler (get event :event) (get event :header))))
                                  (catch error (setq code 500) (console/error "tibo-lark: 事件入队失败，等待平台重投")))
                                (js-call (get frame :headers) :push (js-object :key "biz_rt" :value (str (- (Date/now) started))))
                                (put frame :payload (js-call encoder :encode (JSON/stringify (js-object :code code))))
                                (put frame :encoding "")
                                (when (and (not stopped) (= (get socket :readyState) 1)) (js-call socket :send (encode-frame frame)))))))))
                    (catch error (console/error "tibo-lark: 无法处理事件帧，检查接入协议与本地状态")))))))))))))
      (try (await (funcall connect)) (catch error (funcall close) (throw error)))
      (js-object :close close :status (lambda () (js-object :state state :reconnectAttempts attempts)))))
  (export open-socket))
