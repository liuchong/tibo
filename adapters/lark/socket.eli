(module tibo.lark.socket
  (import "node:timers" setTimeout clearTimeout)
  (import "node:zlib" gunzipSync)
  (import "../../src/host.eli" Error Date Promise Map Number WebSocket URL Uint8Array TextEncoder TextDecoder)
  (import "../../src/util.eli" fail matches)
  (import "./wire.eli" encode-frame decode-frame header-value merge-fragment)
  (defasync open-socket (client handler)
    (let ((ws nil) (stopped false) (heartbeat nil) (watchdog nil) (retry nil)
          (interval 120000) (retry-ms 10000) (fragments (new Map))
          (encoder (new TextEncoder)) (decoder (new TextDecoder "utf-8" (js-object :fatal t)))
          (connect nil) (ping nil))
      (let ((close (lambda ()
              (setq stopped t) (clearTimeout heartbeat) (clearTimeout watchdog) (clearTimeout retry)
              (when ws (js-call ws :close)) (js-call fragments :clear))))
        (setq ping (lambda ()
          (when (and (not stopped) ws (= (get ws :readyState) 1))
            (js-call ws :send (encode-frame (js-object :service (Number (js-call (get (new URL (get ws :url)) :searchParams) :get "service_id"))
              :kind 0 :headers (js-array (js-object :key "type" :value "ping")))))
            (clearTimeout watchdog)
            (setq watchdog (setTimeout (lambda () (when ws (js-call ws :close))) 30000))
            (setq heartbeat (setTimeout ping interval)))))
        (setq connect (async ()
          (let* ((config (await (js-call client :connectConfig))) (data (get config :data))
                 (address (get data :URL "")) (parsed (new URL address)) (settings (get data :ClientConfig)))
            (unless (and (= (get config :code) 0) (= (get parsed :protocol) "wss:")
                         (matches "(?:^|\\.)(?:feishu\\.cn|larksuite\\.com|larkoffice\\.com)$" (get parsed :hostname)))
              (fail "Lark 长连接配置失败"))
            (when stopped (fail "Lark 已停止"))
            (setq interval (Math/max 5000 (Math/min 300000 (* (get settings :PingInterval 120) 1000)))
                  retry-ms (Math/max 1000 (Math/min 60000 (* (get settings :ReconnectInterval 10) 1000))))
            (setq ws (new WebSocket address))
            (put ws :binaryType "arraybuffer")
            (await (new Promise (lambda (resolve reject)
              (let ((socket ws) (opened false)
                    (timeout (setTimeout (lambda () (js-call ws :close) (funcall reject (new Error "Lark 握手超时"))) 15000)))
                (put socket :onopen (lambda () (setq opened t) (clearTimeout timeout) (funcall ping) (funcall resolve nil)))
                (put socket :onerror (lambda ()
                  (unless opened (clearTimeout timeout) (funcall reject (new Error "Lark 握手失败")))))
                (put socket :onclose (lambda ()
                  (clearTimeout timeout) (clearTimeout heartbeat) (clearTimeout watchdog) (js-call fragments :clear)
                  (unless opened (funcall reject (new Error "Lark 握手关闭")))
                  (when (and opened (not stopped))
                    (let ((reconnect nil))
                      (setq reconnect (lambda ()
                        (unless stopped
                          (js-call (funcall connect) :catch (lambda (error)
                            (console/error "tibo-lark: 长连接重连失败，稍后重试")
                            (unless stopped (setq retry (setTimeout reconnect retry-ms))))))))
                      (setq retry (setTimeout reconnect retry-ms))))))
                (put socket :onmessage (async (message)
                  (clearTimeout watchdog)
                  (try
                    (let* ((frame (decode-frame (new Uint8Array (get message :data))))
                           (kind (get frame :kind)) (type (header-value frame "type")))
                      (cond
                        ((and (= kind 0) (= type "pong") (get frame :payload))
                          (let ((pong (JSON/parse (js-call decoder :decode (get frame :payload)))))
                            (when (> (get pong :PingInterval 0) 0)
                              (setq interval (Math/max 5000 (Math/min 300000 (* (get pong :PingInterval) 1000)))))))
                        ((and (= kind 1) (= type "event"))
                          (let ((bytes (merge-fragment fragments frame (Date/now))))
                            (when bytes
                              (when (= (get frame :encoding) "gzip") (setq bytes (gunzipSync bytes (js-object :maxOutputLength 2097152))))
                              (unless (or (not (get frame :encoding)) (= (get frame :encoding) "") (= (get frame :encoding) "gzip")) (fail "Unsupported event encoding"))
                              (let ((event (JSON/parse (js-call decoder :decode bytes))))
                                (when (= (get (get event :header) :event_type) "im.message.receive_v1")
                                  (await (funcall handler (get event :event))))
                                (put frame :payload (js-call encoder :encode (JSON/stringify (js-object :code 200))))
                                (put frame :encoding "")
                                (js-call socket :send (encode-frame frame))))))))
                    (catch error (console/error "tibo-lark: 无法处理事件帧，检查接入协议与本地状态"))))))))))))
        (await (funcall connect))
        (js-object :close close))))
  (export open-socket))
