(module tibo.lark.main
  (import "node:process" :default process)
  (import "./bot.eli" lark-config check-lark start-lark)
  (import "../../src/config.eli" load-config)
  (import "../../src/service.eli" service)
  (import "../../src/state.eli" read-state)
  (import "../../src/util.eli" json fail)
  (defasync main ()
    (await (load-config))
    (let* ((args (js-call (get process :argv) :slice 2)) (command (get args 0 "run")))
      (cond
        ((or (= command "run") (= command "start")) (await (start-lark)))
        ((= command "check") (console/log (json (await (check-lark)))))
        ((= command "status") (console/log (json (or (await (read-state "lark-runtime")) (js-object :state "not-started")))))
        ((= command "service")
          (when (= (get args 1) "install") (await (lark-config)))
          (console/log (json (await (service (get args 1) "lark")))))
        ((= command "help") (console/log "tibo-lark run | check | status | service install/restart/status/uninstall\ncheck只验证凭据与机器人身份，不发送消息；status是最近本地状态，结合service status确认进程仍存活。"))
        (t (fail "Lark 命令无效，使用 tibo-lark help")))))
  (js-call (main) :catch (lambda (error) (console/error "tibo-lark: 操作未完成。请检查本地配置、应用能力、事件权限和服务状态。") (put process :exitCode 1))))
