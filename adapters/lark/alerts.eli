(module tibo.lark.alerts
  (import "node:crypto" createHash)
  (import "../../src/platform/host.eli" Date)
  (import "../../src/platform/state.eli" read-state write-state)
  (import "../../src/platform/transaction.eli" state-transaction)
  (import "../../src/platform/util.eli" ms)
  (import "../../src/subscriptions/alerts.eli" pending-alerts)
  (import "../../src/subscriptions/registry.eli" active-recipients sync-group-subscriptions)
  (import "./broadcast.eli" send-target)
  (import "./service.eli" account-key)
  (defun plan-key (account alert)
    (str "lark-alert-" (js-call (js-call (js-call (createHash "sha256") :update (str account ":" (get alert :key))) :digest "hex") :slice 0 40)))
  (defasync run-alert (client groups account alert stopped? progress)
    (let ((key (plan-key account alert)))
      (await (state-transaction key (async ()
        (let ((plan (await (read-state key))))
          (unless plan
            (let ((members (await (active-recipients "lark" account))))
              (setq plan (js-object :schemaVersion 1 :alertKey (get alert :key) :cursor 0 :state "pending"
                :targets (js-call (js-call members :filter (lambda (m) (<= (ms (get m :updatedAt)) (ms (get alert :at)))))
                  :map (lambda (m) (js-object :kind (get m :kind) :id (get m :id) :revision (get m :revision)))))))
            (await (write-state key plan)))
          (unless (= (get plan :state) "complete")
            (while (and (not (funcall stopped?)) (< (get plan :cursor) (get (get plan :targets) :length)))
              (await (send-target client groups account (js-object :key (get alert :key))
                (get (get plan :targets) (get plan :cursor)) alert))
              (put plan :cursor (+ (get plan :cursor) 1))
              (await (write-state key plan)))
            (put plan :state (if (= (get plan :cursor) (get (get plan :targets) :length)) "complete" "pending"))
            (await (write-state key plan))) (funcall progress plan)))))))
  (defun create-alert-delivery (client groups)
    (let ((account (account-key)) (active nil) (stopped false) (progress nil))
      (js-object
        :tick (async ()
          (unless (or stopped active)
            (setq active (js-call ((async ()
              (await (sync-group-subscriptions "lark" account groups))
              (let ((alerts (await (pending-alerts))) (i 0))
                (while (and (not stopped) (< i (get alerts :length)))
                  (when (get alerts i) (await (run-alert client groups account (get alerts i) (lambda () stopped) (lambda (p) (setq progress p)))))
                  (setq i (+ i 1)))))) :finally (lambda () (setq active nil)))))
          (when active (await active)))
        :status (lambda () (js-object :active (not (not active)) :state (get (or progress (js-object)) :state "idle")
          :processed (get (or progress (js-object)) :cursor 0)))
        :halt (lambda () (setq stopped t))
        :stop (async () (setq stopped t) (when active (await active))))))
  (export create-alert-delivery plan-key))
