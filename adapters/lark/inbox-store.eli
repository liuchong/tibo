;; One atomic file per accepted event. Memory contains only a small work window.
(module tibo.lark.inbox-store
  (import "node:fs/promises" mkdir readdir readFile writeFile rename rm)
  (import "node:path" join)
  (import "node:crypto" randomUUID)
  (import "../../src/platform/host.eli" RegExp Date)
  (import "../../src/platform/state.eli" state-root)
  (import "../../src/platform/util.eli" fail)
  (import "./service.eli" delivery-key)
  (import "../../src/commands/index.eli" fixed-query)
  (defun fast-job? (job)
    (let ((command (get job :command "")))
      (and (not (js-call command :includes "|"))
        (let ((query (fixed-query command)))
          (not (not (and query (js-call (js-array "help" "pray" "subscribe" "unsubscribe" "subscription") :includes (get query :command)))))))))
  (defun directory () (join (state-root) "lark-inbox-pending"))
  (defun valid-file? (file) (js-call (new RegExp "^[fn]-[0-9]{13}-lark-[a-f0-9]{40}\\.json$") :test file))
  (defun file-key (file) (js-call file :slice 16 -5))
  (defun file-lane (file) (if (js-call file :startsWith "f-") "fast" "normal"))
  (defasync pending-files ()
    (await (mkdir (directory) (js-object :recursive t :mode 448)))
    (js-call (js-call (await (readdir (directory))) :filter valid-file?) :sort))
  (defasync read-pending (file)
    (unless (valid-file? file) (fail "收件箱文件名无效"))
    (JSON/parse (await (readFile (join (directory) file) "utf8"))))
  (defasync write-pending (job &optional file)
    (setq file (or file (str (if (fast-job? job) "f-" "n-") (Date/now) "-" (delivery-key (get job :group) (get job :key)) ".json")))
    (unless (valid-file? file) (fail "收件箱文件名无效"))
    (await (mkdir (directory) (js-object :recursive t :mode 448)))
    (let* ((path (join (directory) file)) (temp (str path "." (randomUUID) ".tmp")))
      (try
        (await (writeFile temp (JSON/stringify job) (js-object :mode 384)))
        (await (rename temp path)) file
        (finally (await (rm temp (js-object :force t)))))))
  (defasync remove-pending (file)
    (unless (valid-file? file) (fail "收件箱文件名无效"))
    (await (rm (join (directory) file) (js-object :force t))))
  (export pending-files file-key file-lane fast-job? read-pending write-pending remove-pending))
