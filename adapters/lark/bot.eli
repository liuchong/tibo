(module tibo.lark.bot
  (import "./api.eli" create-client)
  (import "./socket.eli" open-socket)
  (import "./inbox.eli" create-inbox)
  (import "./broadcast.eli" create-broadcaster)
  (import "../../src/platform/config.eli" load-config)
  (import "node:process" :default process)
  (import "node:timers" setTimeout clearTimeout)
  (import "../../src/platform/host.eli" Date Promise Number RegExp AbortController)
  (import "../../src/platform/state.eli" with-lock write-state)
  (import "../../src/im/context.eli" remember-message group-context?)
  (import "../../src/im/access.eli" group-allowed?)
  (import "../../src/subscriptions/registry.eli" sync-group-subscriptions)
  (import "../../src/platform/util.eli" iso fail)
  (import "./service.eli" group-config admin-group-config notify-group-config account-key message-text message-candidate sender-context slot-at pending-reaction)
  (defasync lark-config ()
    (await (load-config))
    (let* ((env (get process :env)) (groups (group-config)) (domain (get env :TIBO_LARK_DOMAIN "feishu"))
           (app-id (get env :TIBO_LARK_APP_ID "")) (secret (get env :TIBO_LARK_APP_SECRET ""))
           (bot-id (get env :TIBO_LARK_BOT_OPEN_ID "")) (admins (get env :TIBO_LARK_ADMIN_OPEN_IDS "")))
      (unless (and (> (get app-id :length) 0) (> (get secret :length) 0)) (fail "缺少 Lark app id/secret，请在本地配置中填写"))
      (unless (or (= domain "feishu") (= domain "lark")) (fail "Lark domain 必须是 feishu 或 lark"))
      (unless (or (= bot-id "") (js-call (new RegExp "^ou_[a-zA-Z0-9]+$") :test bot-id)) (fail "Lark bot open id 格式无效"))
      (unless (or (= admins "") (js-call (js-call admins :split ",") :every
        (lambda (id) (js-call (new RegExp "^ou_[a-zA-Z0-9]+$") :test id)))) (fail "Lark 管理员应为应用内 open_id 列表"))
      (when (> (get (get env :TIBO_SNAPSHOT "") :length) 0) (fail "Lark 实际投递禁止使用测试快照"))
      (js-object :groups groups :adminGroups (admin-group-config) :notifyGroups (notify-group-config)
        :domain domain :appId app-id :secret secret :botId bot-id)))
  (defasync identify (client config)
    (let* ((bot (await (js-call client :botInfo))) (id (get bot :open_id)))
      (unless (js-call (new RegExp "^ou_[a-zA-Z0-9]+$") :test id) (fail "官方机器人信息格式无效"))
      (when (and (get config :botId) (not (= (get config :botId) "")) (not (= id (get config :botId))))
        (fail "配置的 bot open id 与当前应用不匹配")) id))
  (defasync check-lark ()
    (let* ((config (await (lark-config))) (client (create-client (get config :appId) (get config :secret) (get config :domain)))
           (id (await (identify client config))))
      (js-object :state "credentials-and-bot-verified" :botOpenId id :groups (get config :groups)
        :adminGroups (get config :adminGroups) :notifyGroups (get config :notifyGroups)
        :note "未发送消息；长连接、事件权限、群内收发和定时推送仍须实际验证")))
  (defasync start-lark ()
    (let ((config (await (lark-config))))
      (await (with-lock "lark-instance" (async ()
        (let ((controller (new AbortController)) (ws nil) (inbox nil) (broadcaster nil) (timer nil) (stopping false) (resolve-stop nil)
              (client (create-client (get config :appId) (get config :secret) (get config :domain)))
              (stopped nil) (stop nil)
              (events (js-object :received 0 :accepted 0 :reactions 0 :acceptedReactions 0)))
          (setq stopped (new Promise (lambda (resolve) (setq resolve-stop resolve))))
          (setq stop (lambda ()
            (setq stopping t) (clearTimeout timer) (js-call controller :abort)
            (when broadcaster (js-call broadcaster :halt))
            (when ws (js-call ws :close)) (funcall resolve-stop nil)))
          (js-call process :once "SIGINT" stop) (js-call process :once "SIGTERM" stop)
          (try
            (await (write-state "lark-runtime" (js-object :state "starting" :pid (get process :pid) :at (iso (Date/now)))))
            (let ((bot-id (await (identify client config))) (groups (get config :groups)))
              (unless stopping
                (await (sync-group-subscriptions "lark" (account-key) (get config :notifyGroups)))
                (setq inbox (await (create-inbox client groups)))
                (setq broadcaster (create-broadcaster client (get config :notifyGroups)))
                (setq ws (await (open-socket client (async (event header)
                  (let ((reaction (= (get header :event_type) "im.message.reaction.created_v1"))
                        (audit (js-object :reason "filtered")) (accepted false))
                    (put events :received (+ (get events :received) 1))
                    (put events :lastReceivedAt (iso (Date/now)))
                    (try
                      (if reaction
                        (let ((job (pending-reaction event (get header :event_id))))
                          (put audit :reason (if job "queued-for-resolution" "not-prayer-or-stale"))
                          (when (and (not stopping) job) (await (js-call inbox :accept job)) (setq accepted t)))
                        (let* ((candidate (message-candidate event groups bot-id)) (message (get event :message (js-object)))
                               (context (sender-context event)) (id (get message :message_id)) (created (Number (get message :create_time 0))))
                          (when (and (not stopping) context (= (value-type id) "string") (> (get id :length) 0)
                                     (> created (- (Date/now) 300000)) (<= created (+ (Date/now) 60000)))
                            (when (and (group-context? context) (group-allowed? groups (get message :chat_id)))
                              (await (remember-message context id (message-text message) (iso created))))
                            (when candidate
                              (await (js-call inbox :accept (js-object :group (get message :chat_id) :key id :command (get candidate :command)
                                :triggerLevel (get candidate :level) :triggerKind (get candidate :kind) :prayerMaterial (get candidate :material)
                                :companion (get candidate :companion)
                                :context context :createdAt (iso created) :acceptedAt (iso (Date/now)))))
                              (setq accepted t)))))
                      (finally
                        (when accepted (put events :accepted (+ (get events :accepted) 1)))
                        (when reaction
                          (put events :reactions (+ (get events :reactions) 1))
                          (when accepted (put events :acceptedReactions (+ (get events :acceptedReactions) 1)))
                          (put events :lastReaction (js-object :at (iso (Date/now)) :accepted accepted :reason (get audit :reason))))
                        ;; Optional diagnostics never turn an accepted business event into a failed ACK.
                        (try (await (write-state "lark-events" events)) (catch error (console/error "tibo-lark: 事件诊断记录失败")))))))
                  (get controller :signal))))
                (let ((tick nil))
                  (setq tick (async ()
                  (unless stopping
                    (try
                      (let ((slot (slot-at (iso (Date/now)))))
                        (when slot (await (js-call broadcaster :tick slot))))
                      (await (write-state "lark-runtime" (js-object :state "running" :pid (get process :pid)
                        :at (iso (Date/now)) :connection (js-call ws :status) :inbox (js-call inbox :status) :broadcast (js-call broadcaster :status))))
                      (catch error (console/error "tibo-lark: 定时任务或状态更新失败"))
                      (finally
                        (unless stopping
                          (setq timer (setTimeout (lambda () (js-call (funcall tick) :catch (lambda (error) (console/error "tibo-lark: 定时任务失败"))))
                            (- 60000 (% (Date/now) 60000))))))))))
                  (js-call inbox :resume)
                  (await (funcall tick)))
                (console/error "tibo-lark: 已启动；相关度与群回复预算独立控制，🙏限频时仍记档；订阅者只在北京时间09:00/21:00收私聊")
                (await stopped)))
            (finally
              (funcall stop)
              (js-call process :removeListener "SIGINT" stop) (js-call process :removeListener "SIGTERM" stop)
              (when inbox (await (js-call inbox :stop)))
              (when broadcaster (await (js-call broadcaster :stop)))
              (await (write-state "lark-runtime" (js-object :state "stopped" :pid (get process :pid) :at (iso (Date/now)))))))))))))
  (export lark-config check-lark start-lark))
