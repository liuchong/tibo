(module tibo.lark.bot
  (import "./api.eli" create-client)
  (import "./socket.eli" open-socket)
  (import "../../src/config.eli" load-config)
  (import "node:process" :default process)
  (import "node:timers" setTimeout setInterval clearInterval)
  (import "../../src/host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "../../src/state.eli" with-lock read-state)
  (import "../../src/util.eli" iso ms fail)
  (import "./service.eli" group-config command-of sender-context slot-at delivery-key deliver)
  (defasync start-lark ()
    (await (load-config))
    (let* ((env (get process :env)) (groups (group-config))
           (app-id (get env :TIBO_LARK_APP_ID)) (app-secret (get env :TIBO_LARK_APP_SECRET))
           (bot-id (get env :TIBO_LARK_BOT_OPEN_ID)) (queue (Promise/resolve nil)) (timer nil) (stopping false))
      (unless (and app-id app-secret bot-id (> (get app-id :length) 0) (> (get app-secret :length) 0) (> (get bot-id :length) 0)) (fail "缺少 Lark app id/secret/bot open id；请用环境变量配置"))
      (when (get env :TIBO_SNAPSHOT) (fail "Lark 实际投递禁止使用测试快照"))
      (await (with-lock "lark-instance" (async ()
        (let* ((client (create-client app-id app-secret (get env :TIBO_LARK_DOMAIN))) (ws nil)
               (enqueue (lambda (task)
                 (unless stopping (setq queue (js-call (js-call queue :then (async () (unless stopping (await (funcall task))))) :catch (lambda (error) (console/error "tibo-lark: 任务失败，检查本地投递账本"))))))))
          (setq ws (await (open-socket client
                (async (event)
                  (let* ((command (command-of event groups bot-id)) (message (get event :message (js-object)))
                         (id (get message :message_id)) (created (Number (get message :create_time 0))))
                    (when (and command id (> created (- (Date/now) 300000)) (<= created (+ (Date/now) 60000)))
                      ;; Acknowledge immediately; evidence collection stays outside the 3s callback.
                      (setTimeout (lambda () (funcall enqueue (async ()
                        (unless (await (read-state (delivery-key (get message :chat_id) id)))
                          (await (deliver client (get message :chat_id) id command nil (sender-context event))))))) 0))
                    nil)))))
          (let ((tick (lambda ()
            (let ((slot (slot-at (iso (Date/now)))))
              (when slot
                (js-call groups :forEach
                  (lambda (group)
                    (funcall enqueue (async ()
                      (unless (await (read-state (delivery-key group (get slot :key))))
                        (await (deliver client group (get slot :key) "forecast" (get slot :at)))))))))))))
            (funcall tick)
            (setq timer (setInterval tick 60000)))
          (console/error "tibo-lark: 已启动；只接收配置群中明确@本机器人的命令")
          (await (new Promise (lambda (resolve reject)
            (js-call process :once "SIGINT" (lambda () (setq stopping t) (clearInterval timer) (js-call ws :close) (funcall resolve nil)))
            (js-call process :once "SIGTERM" (lambda () (setq stopping t) (clearInterval timer) (js-call ws :close) (funcall resolve nil))))))
          (await queue)))))))
  (try (js-call (start-lark) :catch (lambda (error) (console/error (get error :message)) (put process :exitCode 1)))
       (catch error (console/error (get error :message)) (put process :exitCode 1)))
  (export start-lark))
