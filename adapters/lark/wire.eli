;; The narrow protobuf schema used by the Lark event socket, encoded locally.
(module tibo.lark.wire
  (import "../../src/platform/host.eli" BigInt Number Uint8Array TextEncoder TextDecoder)
  (import "../../src/platform/util.eli" fail)
  (defconst encoder (new TextEncoder))
  (defconst decoder (new TextDecoder "utf-8" (js-object :fatal t)))
  (defun append-bytes (out bytes) (js-call bytes :forEach (lambda (b) (js-call out :push b))))
  (defun write-varint (out value)
    (let ((n (BigInt value)))
      (when (or (< n (BigInt 0)) (> n (BigInt "18446744073709551615"))) (fail "Invalid unsigned integer"))
      (while (>= n (BigInt 128))
        (js-call out :push (+ 128 (Number (bit-and n (BigInt 127)))))
        (setq n (bit-shift-right n (BigInt 7))))
      (js-call out :push (Number n))))
  (defun read-varint (reader)
    (let ((n (BigInt 0)) (shift (BigInt 0)) (done false) (count 0))
      (while (not done)
        (when (or (>= (get reader :pos) (get (get reader :bytes) :length)) (>= count 10)) (fail "Truncated/overflow protobuf integer"))
        (let ((byte (get (get reader :bytes) (get reader :pos))))
          (when (and (= count 9) (> byte 1)) (fail "Overflow protobuf integer"))
          (put reader :pos (+ (get reader :pos) 1))
          (setq n (+ n (bit-shift-left (BigInt (bit-and byte 127)) shift))
                shift (+ shift (BigInt 7)) count (+ count 1) done (< byte 128))))
      n))
  (defun read-bytes (reader)
    (let* ((n (Number (read-varint reader))) (end (+ (get reader :pos) n)))
      (when (> end (get (get reader :bytes) :length)) (fail "Truncated protobuf bytes"))
      (let ((bytes (js-call (get reader :bytes) :subarray (get reader :pos) end)))
        (put reader :pos end) bytes)))
  (defun fields (bytes)
    (when (> (get bytes :length) 2097152) (fail "Frame exceeds 2 MB"))
    (let ((reader (js-object :bytes bytes :pos 0)) (result (js-array)))
      (while (< (get reader :pos) (get bytes :length))
        (let* ((tag (Number (read-varint reader))) (wire (bit-and tag 7)) (field (unsigned-bit-shift-right tag 3)))
          (when (= field 0) (fail "Invalid protobuf field"))
          (cond ((= wire 0) (js-call result :push (js-object :field field :wire wire :value (read-varint reader))))
                ((= wire 2) (js-call result :push (js-object :field field :wire wire :value (read-bytes reader))))
                ((or (= wire 1) (= wire 5))
                  (put reader :pos (+ (get reader :pos) (if (= wire 1) 8 4)))
                  (when (> (get reader :pos) (get bytes :length)) (fail "Truncated fixed field")))
                (t (fail "Unsupported protobuf wire type")))))
      result))
  (defun write-number (out field value) (write-varint out (* field 8)) (write-varint out value))
  (defun write-bytes (out field bytes)
    (write-varint out (+ (* field 8) 2)) (write-varint out (get bytes :length)) (append-bytes out bytes))
  (defun write-text (out field text) (when text (write-bytes out field (js-call encoder :encode text))))
  (defun encode-frame (frame)
    (let ((out (js-array)))
      (write-number out 1 (get frame :sequence 0)) (write-number out 2 (get frame :log 0))
      (write-number out 3 (get frame :service 0)) (write-number out 4 (get frame :kind 0))
      (js-call (get frame :headers (js-array)) :forEach (lambda (h)
        (let ((part (js-array))) (write-text part 1 (get h :key)) (write-text part 2 (get h :value))
          (write-bytes out 5 part))))
      (write-text out 6 (get frame :encoding)) (write-text out 7 (get frame :contentType))
      (when (get frame :payload) (write-bytes out 8 (get frame :payload)))
      (write-text out 9 (get frame :newLogId))
      (Uint8Array/from out)))
  (defun decode-frame (bytes)
    (let ((frame (js-object :headers (js-array))))
      (js-call (fields bytes) :forEach (lambda (f)
        (let ((field (get f :field)) (value (get f :value)) (wire (get f :wire)))
          (cond ((and (>= field 1) (<= field 4))
                  (unless (= wire 0) (fail "Invalid integer field wire type"))
                  (put frame (get (js-array "sequence" "log" "service" "kind") (- field 1)) (if (< field 3) value (Number value))))
                ((= field 5)
                  (unless (= wire 2) (fail "Invalid header wire type"))
                  (when (>= (get (get frame :headers) :length) 64) (fail "Too many frame headers"))
                  (let ((header (js-object)))
                    (js-call (fields value) :forEach (lambda (item)
                      (when (or (= (get item :field) 1) (= (get item :field) 2))
                        (unless (= (get item :wire) 2) (fail "Invalid header value"))
                        (put header (if (= (get item :field) 1) "key" "value") (js-call decoder :decode (get item :value))))))
                    (js-call (get frame :headers) :push header)))
                ((and (>= field 6) (<= field 9))
                  (unless (= wire 2) (fail "Invalid payload wire type"))
                  (put frame (get (js-array "encoding" "contentType" "payload" "newLogId") (- field 6))
                    (if (= field 8) value (js-call decoder :decode value))))))))
      (unless (and (Object/hasOwn frame "sequence") (Object/hasOwn frame "log")
                   (Object/hasOwn frame "service") (Object/hasOwn frame "kind")) (fail "Missing required frame fields"))
      frame))
  (defun header-value (frame key &optional fallback)
    (let ((header (js-call (get frame :headers) :find (lambda (h) (= (get h :key) key)))))
      (if header (get header :value) fallback)))
  (defun merge-fragment (cache frame now)
    (let* ((sum (Number (header-value frame "sum" "1"))) (seq (Number (header-value frame "seq" "0")))
           (id (header-value frame "message_id")) (payload (get frame :payload (new Uint8Array 0))))
      (unless (and (Number/isInteger sum) (>= sum 1) (<= sum 64) (Number/isInteger seq) (>= seq 0) (< seq sum)) (fail "Invalid event fragment metadata"))
      (js-call cache :forEach (lambda (row key) (when (> (- now (get row :at)) 5000) (js-call cache :delete key))))
      (if (= sum 1) payload
        (progn
          (unless (and id (> (get id :length) 0)) (fail "Missing fragment id"))
          (unless (js-call cache :has id)
            (when (>= (get cache :size) 16) (fail "Too many incomplete events"))
            (js-call cache :set id (js-object :at now :sum sum :parts (js-array) :count 0 :bytes 0)))
          (let ((row (js-call cache :get id)))
            (unless (= (get row :sum) sum) (fail "Fragment count changed"))
            (unless (get (get row :parts) seq)
              (put (get row :parts) seq payload) (put row :count (+ (get row :count) 1))
              (put row :bytes (+ (get row :bytes) (get payload :length))))
            (when (> (get row :bytes) 2097152) (js-call cache :delete id) (fail "Event exceeds 2 MB"))
            (when (= (get row :count) sum)
              (let ((result (new Uint8Array (get row :bytes))) (offset 0))
                (js-call (get row :parts) :forEach (lambda (part) (js-call result :set part offset) (setq offset (+ offset (get part :length)))))
                (js-call cache :delete id) result)))))))
  (export encode-frame decode-frame header-value merge-fragment))
