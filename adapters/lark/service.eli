(module tibo.lark.service
  (import "node:process" :default process)
  (import "node:crypto" createHash)
  (import "../../src/platform/host.eli" Error Date RegExp Set Number Map)
  (import "../../src/app/engine.eli" save-report)
  (import "../../src/platform/state.eli" read-state write-state)
  (import "../../src/commands/index.eli" resolve-query execute-query)
  (import "../../src/im/triggers.eli" trigger-candidate)
  (import "../../src/prayer/material.eli" prayer-material)
  (import "../../src/prayer/pray.eli" settle-festivals)
  (import "./messages.eli" markdown-post send-report)
  (import "./celebration-delivery.eli" finish-celebration)
  (import "../../src/subscriptions/schedule.eli" slot-at)
  (import "../../src/platform/util.eli" ms iso clean fail)
  (defun account-key ()
    (js-call (js-call (js-call (createHash "sha256") :update
      (str (get (get process :env) :TIBO_LARK_DOMAIN "feishu") ":" (get (get process :env) :TIBO_LARK_APP_ID ""))) :digest "hex") :slice 0 40))
  (defun sender-context (event)
    (let* ((sender (get event :sender (js-object))) (id (get sender :sender_id (js-object))) (message (get event :message (js-object))))
      (when (= (get sender :sender_type) "user")
        (when (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test (get id :open_id ""))
          (js-object :transport "lark" :actor (get id :open_id) :scope (get message :chat_id "") :authenticated t
            :account (account-key) :conversationType (get message :chat_type))))))
  (defun allowed-job? (job groups)
    (let ((context (get job :context)))
      (or (and (= (get job :kind) "reaction") (= (get job :group) "reaction-pending")
          (= (get job :account) (account-key)) (pending-reaction (get job :reaction) (get job :eventId) t))
        (js-call groups :includes (get job :group))
        (and context (= (get context :transport) "lark") (= (get context :authenticated) t)
          (= (get context :conversationType) "p2p") (= (get context :account) (account-key))
          (= (get context :scope) (get job :group))
          (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test (get job :group ""))
          (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test (get context :actor ""))))))
  (defun group-config ()
    (let* ((raw (get (get process :env) :TIBO_LARK_CHAT_IDS ""))
           (groups (Array/from (new Set (js-call (js-call (js-call raw :split ",") :map (lambda (x) (js-call x :trim))) :filter (lambda (x) (> (get x :length) 0)))))))
      (unless (and (> (get groups :length) 0) (js-call groups :every
        (lambda (id) (js-call (new RegExp "^oc_[a-zA-Z0-9]+$") :test id)))) (fail "TIBO_LARK_CHAT_IDS 必须为明确授权的群ID列表"))
      groups))
  (defun message-text (message)
    (try
      (let* ((content (get message :content (get (get message :body (js-object)) :content "{}")))
             (body (JSON/parse content)) (kind (get message :message_type (get message :msg_type))))
        (cond ((= kind "text") (let ((text (get body :text ""))) (if (= (value-type text) "string") text "")))
          ((= kind "post")
            (let* ((post (if (Array/isArray (get body :content)) body
                     (js-call (Object/values body) :find (lambda (p) (and p (Array/isArray (get p :content)))))))
                   (rows (get (or post (js-object)) :content (js-array))))
              (js-call (js-call (js-call rows :flat) :map (lambda (p)
                (if (and p (js-call (js-array "text" "md" "a") :includes (get p :tag)) (= (value-type (get p :text)) "string")) (get p :text) ""))) :join "\n")))
          (t ""))) (catch error "")))
  (defun message-candidate (event allowed bot-id)
    (let* ((message (get event :message (js-object))) (chat-id (get message :chat_id))
           (sender (get event :sender (js-object))) (mentions (get message :mentions (js-array))))
      (when (and (= (get sender :sender_type) "user")
        (or (and (= (get message :chat_type) "group") (js-call allowed :includes chat-id))
            (and (= (get message :chat_type) "p2p") (sender-context event) (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test chat-id))))
        (let ((text (message-text message)))
          (js-call mentions :forEach (lambda (mention) (setq text (js-call text :replaceAll (get mention :key) ""))))
          (setq text (clean text))
          (let ((candidate (trigger-candidate text
            (js-call mentions :some (lambda (m) (= (get (get m :id (js-object)) :open_id) bot-id))) (= (get message :chat_type) "p2p"))))
            (when candidate
              (put candidate :material (if (= (get candidate :kind) "prayer") (prayer-material text) "")) candidate))))))
  (defun command-of (event allowed bot-id)
    ;; Compatibility helper: secondary candidates are never direct commands.
    (let ((candidate (message-candidate event allowed bot-id)))
      (when (and candidate (= (get candidate :level) 1)) (get candidate :command))))
  (defun delivery-key (group key)
    (str "lark-" (js-call (js-call (js-call (createHash "sha256") :update (str group ":" key)) :digest "hex") :slice 0 40)))
  (defun message-key (id) (str "lark-message-" (js-call (js-call (js-call (createHash "sha256") :update id) :digest "hex") :slice 0 40)))
  (defun pending-reaction (event &optional event-id accepted)
    (let* ((actor (get (get event :user_id (js-object)) :open_id "")) (id (get event :message_id ""))
      (created (Number (get event :action_time 0))))
      (when (and (= (get event :operator_type) "user") (= (get (get event :reaction_type (js-object)) :emoji_type) "THANKS")
        (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test actor) (js-call (new RegExp "^om_[A-Za-z0-9_-]{1,180}$") :test id)
        (Number/isSafeInteger created) (or accepted (and (> created (- (Date/now) 300000)) (<= created (+ (Date/now) 60000)))))
        (js-object :group "reaction-pending" :kind "reaction" :command "pray" :triggerKind "prayer"
          :key (str "reaction-" (message-key (str actor ":" id ":" (or event-id created)))) :eventId event-id
          :account (account-key) :reaction (js-object :operator_type "user" :user_id (js-object :open_id actor)
            :message_id id :reaction_type (js-object :emoji_type "THANKS") :action_time (str created))
          :createdAt (iso created) :acceptedAt (iso (Date/now))))))
  (defconst reaction-cache (new Map))
  (defasync cached-message (client id)
    (let* ((key (str (account-key) ":" id)) (entry (js-call reaction-cache :get key)))
      (when (or (not entry) (<= (get entry :until) (Date/now)))
        (setq entry (js-object :until (+ (Date/now) 60000) :value (js-call client :messageInfo id)))
        (js-call reaction-cache :set key entry)
        (when (> (get reaction-cache :size) 128) (js-call reaction-cache :delete (get (js-call (js-call reaction-cache :keys) :next) :value))))
      (try (await (get entry :value))
        (catch error (when (= entry (js-call reaction-cache :get key)) (js-call reaction-cache :delete key)) (throw error)))))
  (defasync reaction-job (event allowed &optional client audit event-id accepted)
    (setq audit (or audit (js-object))) (put audit :reason "not-prayer")
    (let* ((actor (get (get event :user_id (js-object)) :open_id "")) (id (get event :message_id ""))
           (created (Number (get event :action_time 0))))
      (when (and (= (get event :operator_type) "user") (= (get (get event :reaction_type (js-object)) :emoji_type) "THANKS")
        (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test actor) (= (value-type id) "string") (> (get id :length) 0) (<= (get id :length) 200))
        (put audit :reason "stale-or-invalid-time")
        (when (and (Number/isSafeInteger created) (or accepted (and (> created (- (Date/now) 300000)) (<= created (+ (Date/now) 60000)))))
          (let* ((sent (await (read-state (message-key id))))
                 (own (and sent (= (get sent :messageId) id) (= (get sent :appId "") (get (get process :env) :TIBO_LARK_APP_ID ""))))
                 (info nil) (material (if own (get sent :text "") "")))
            (put audit :reason "message-not-readable")
            ;; Resolve any reacted message through a fixed read-only API. Known
            ;; own replies use sanitized cached text and avoid a network hop.
            (when (and client (= (value-type (get client :messageInfo)) "function") (or (not own) (not (Object/hasOwn sent "text"))))
              (setq info (await (cached-message client id))))
            (when (or own (and info (= (get info :message_id) id)))
              (let* ((group (if own (get sent :group) (get info :chat_id)))
                     (kind (when own (get sent :conversationType))) (account (account-key)))
                (when (and info (= (get info :chat_id) group)) (setq material (prayer-material (message-text info))))
                (when (and (not kind) (not (js-call allowed :includes group)) client)
                  (put audit :reason "chat-metadata-unavailable")
                  (let ((chat (await (js-call client :chatInfo group)))) (setq kind (get chat :chat_mode))))
                (when own
                  (put sent :conversationType (if (js-call allowed :includes group) "group" kind))
                  (put sent :account account)
                  (when (and info (= (get info :chat_id) group)) (put sent :text material)) (await (write-state (message-key id) sent)))
                (let* ((context (js-object :transport "lark" :actor actor :scope group :authenticated t
                          :account account :conversationType (if (js-call allowed :includes group) "group" kind)))
                       (job (js-object :group group :key (str "reaction-" (message-key (str actor ":" id ":" (or event-id created)))) :command "pray"
                         :triggerKind "prayer" :prayerMaterial material :context context :createdAt (iso created) :acceptedAt (iso (Date/now)))))
                  (put audit :reason "chat-not-authorized")
                  (when (allowed-job? job allowed) (put audit :reason "accepted") job)))))))))
  (defasync deliver (client group key command &optional title-time context prepared job)
    (setq job (or job (js-object)))
    (let* ((ledger-key (delivery-key group key)) (started (Date/now)) (festival-request nil)
           (latency (js-object :startedAt (iso started) :replyPolicy (get job :replyPolicy)
             :contextMessages (get (get job :recentMessages (js-array)) :length))))
      (when (get job :acceptedAt)
        (put latency :acceptedAt (get job :acceptedAt))
        (put latency :queueMs (Math/max 0 (- started (ms (get job :acceptedAt)))))
        (when (get job :createdAt)
          (put latency :platformMs (Math/max 0 (- (ms (get job :acceptedAt)) (ms (get job :createdAt)))))))
      (when context (setq context (Object/assign (js-object) context (js-object :requestId ledger-key))))
      (when (await (read-state ledger-key)) (fail "投递已有记录，禁止自动重复发送"))
      ;; Reserve BEFORE invoking external I/O. Unknown send outcomes stay auditable.
      (await (write-state ledger-key (js-object :state "pending" :at (iso (Date/now)) :group group :key key :latency latency)))
      (try
        (let* ((options (js-object :channel group :persist false :titleTime title-time :context context
                 :prayerMaterial (get job :prayerMaterial)
                 :recentMessages (get job :recentMessages)
                 :completePrayer t :festivalDelivery t
                 :humanInput (and (not prepared) context (= (get context :authenticated) t))))
               (response (if prepared (js-object :ok t :text (get prepared :text)) (try
                  (let* ((route-start (Date/now)) (query (await (resolve-query command context options))))
                    (put latency :routeMs (- (Date/now) route-start))
                    (let ((execute-start (Date/now)))
                      (try (await (execute-query query options))
                        (finally (put latency :executeMs (- (Date/now) execute-start))))))
                  (catch error (js-object :ok false :text "查询暂时出了问题，请稍后再试。")))))
               (text (get response :text)) (result (get response :result)))
          (setq festival-request (get response :festivalRequest))
          (when result (put latency :core (get result :timing)))
          (put latency :sendStartedAt (iso (Date/now)))
          (await (write-state ledger-key (js-object :state "sending" :at (iso (Date/now)) :group group :key key :latency latency
            :festivalRequest festival-request :festivalIds (get response :festivalIds) :festivalMessages (get response :festivalMessages))))
          (let* ((send-start (Date/now)) (id (await (send-report client group ledger-key text))))
            (put latency :sendMs (- (Date/now) send-start))
            (put latency :totalMs (- (Date/now) started))
            (await (write-state ledger-key (js-object :state "sent" :messageId id :at (iso (Date/now)) :group group :key key :latency latency
              :festivalRequest festival-request :festivalIds (get response :festivalIds) :festivalMessages (get response :festivalMessages))))
            (await (write-state (message-key id) (js-object :messageId id :group group
              :appId (get (get process :env) :TIBO_LARK_APP_ID "")
              :text (prayer-material text) :account (account-key) :conversationType (if context (get context :conversationType) "group") :at (iso (Date/now)))))
            ;; The prior forecast is updated only AFTER confirmed successful report delivery.
            (when (and result (get response :ok)) (await (save-report group result)))
            (when festival-request (await (finish-celebration client ledger-key context)))
            id))
        (catch error
          (let ((ledger (await (read-state ledger-key))))
            (unless (= (get ledger :state) "sent")
              (await (write-state ledger-key (js-object :state (if (Number/isInteger (get error :larkCode)) "rejected"
                       (if (= (get ledger :state) "sending") "uncertain" "failed-before-send"))
                     :larkCode (get error :larkCode) :at (iso (Date/now)) :group group :key key :latency latency))))
            (when (and festival-request (not (= (get ledger :state) "sent")))
              (await (settle-festivals context festival-request (get (await (read-state ledger-key)) :state)))))
          (throw (new Error "投递未完成；检查本地账本，未知结果不自动重试"))))))
  (export group-config command-of message-text message-candidate sender-context account-key allowed-job? slot-at delivery-key message-key pending-reaction reaction-job markdown-post send-report deliver))
