(module tibo.lark.service
  (import "node:process" :default process)
  (import "node:crypto" createHash)
  (import "../../src/host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "../../src/engine.eli" run-report save-report reset-status observe load-snapshot)
  (import "../../src/state.eli" read-state write-state)
  (import "../../src/util.eli" ms iso beijing utc clean fail json)
  (defun group-config ()
    (let* ((raw (get (get process :env) :TIBO_LARK_CHAT_IDS ""))
           (groups (js-call (js-call raw :split ",") :filter (lambda (x) (> (get x :length) 0)))))
      (unless (and (> (get groups :length) 0) (js-call groups :every
        (lambda (id) (js-call (new RegExp "^oc_[a-zA-Z0-9]+$") :test id)))) (fail "TIBO_LARK_CHAT_IDS 必须为明确授权的群ID列表"))
      groups))
  (defun command-of (event allowed bot-id)
    (let* ((message (get event :message (js-object))) (chat-id (get message :chat_id))
           (sender (get event :sender (js-object))) (mentions (get message :mentions (js-array))))
      (when (and message (= (get sender :sender_type) "user") (= (get message :chat_type) "group")
                 (= (get message :message_type) "text") (js-call allowed :includes chat-id)
                 (js-call mentions :some (lambda (mention) (= (get (get mention :id) :open_id) bot-id))))
        (try
          (let ((text (get (JSON/parse (get message :content)) :text "")))
            (js-call mentions :forEach
              (lambda (mention) (setq text (js-call text :replace (get mention :key) ""))))
            (setq text (clean text))
            (cond ((or (= text "重置") (= text "预测") (= text "forecast") (= text "/tibo")) "forecast")
                  ((or (= text "状态") (= text "status")) "status")
                  ((or (= text "帮助") (= text "help")) "help") (t nil)))
          (catch error nil)))))
  (defun slot-at (now)
    (let* ((local (beijing now)) (hour (Number (js-call local :slice 6 8)))
           (minute (Number (js-call local :slice 9 11))))
      ;; Only a bounded 15-minute delivery window. Restarts do not replay old reports.
      (when (and (or (= hour 9) (= hour 21)) (< minute 15))
        (let ((target (iso (- (ms now) (+ (* minute 60000) (% (ms now) 60000))))))
          (js-object :key (str (js-call now :slice 0 10) "-" hour) :at target)))))
  (defun delivery-key (group key)
    (str "lark-" (js-call (js-call (js-call (createHash "sha256") :update (str group ":" key)) :digest "hex") :slice 0 40)))
  (defun markdown-post (markdown)
    (JSON/stringify (js-object :zh_cn (js-object :content (js-array (js-array (js-object :tag "md" :text markdown)))))))
  (defasync send-report (client group key text)
    (let ((response (await (js-call (get (get client :im) :message) :create
      (js-object :params (js-object :receive_id_type "chat_id")
        :data (js-object :receive_id group :msg_type "post" :content (markdown-post text)
                        :uuid (js-call key :slice -40)))))))
      (unless (and (= (get response :code) 0) (get (get response :data) :message_id))
        (fail "Lark 返回失败或缺少 message_id"))
      (get (get response :data) :message_id)))
  (defasync deliver (client group key command &optional title-time)
    (let ((ledger-key (delivery-key group key)))
      (when (await (read-state ledger-key)) (fail "投递已有记录，禁止自动重复发送"))
      ;; Reserve BEFORE invoking external I/O. Unknown send outcomes stay auditable.
      (await (write-state ledger-key (js-object :state "pending" :at (iso (Date/now)) :group group :key key)))
      (try
        (let* ((result (cond ((= command "help") nil)
                             ((= command "status") (observe (await (load-snapshot))))
                             (t (await (run-report (js-object :channel group :persist false :titleTime title-time))))))
               (text (cond ((= command "help") "@机器人 预测 / 重置：v1.1报告；状态：最近global公告；早晚报：北京时间09:00/21:00。")
                           ((= command "status") (str "**Codex 重置状态**\n• 最近 global："
                              (if (get (reset-status result) :latestGlobal) (utc (get (get (reset-status result) :latestGlobal) :at)) "未核实") "\n• 证据状态：" (get (reset-status result) :state)
                              "\n• 个人账户是否生效：未核实\n• banked 需要手动使用，不改变 global 时钟。"))
                           (t (get result :report)))))
          (await (write-state ledger-key (js-object :state "sending" :at (iso (Date/now)) :group group :key key)))
          (let ((id (await (send-report client group ledger-key text))))
            (await (write-state ledger-key (js-object :state "sent" :messageId id :at (iso (Date/now)) :group group :key key)))
            ;; The prior forecast is updated only AFTER confirmed successful report delivery.
            (when (and result (= command "forecast")) (await (save-report group result)))
            id))
        (catch error
          (let ((ledger (await (read-state ledger-key))))
            (unless (= (get ledger :state) "sent")
              (await (write-state ledger-key (js-object :state (if (= (get ledger :state) "sending") "uncertain" "failed-before-send")
                     :at (iso (Date/now)) :group group :key key)))))
          (throw (new Error "投递未完成；检查本地账本，未知结果不自动重试"))))))
  (export group-config command-of slot-at delivery-key markdown-post send-report deliver))
