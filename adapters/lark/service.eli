(module tibo.lark.service
  (import "node:process" :default process)
  (import "node:crypto" createHash)
  (import "../../src/host.eli" Error Date Promise RegExp Map Set Number Intl fetch AbortSignal)
  (import "../../src/engine.eli" run-report save-report reset-status observe load-snapshot)
  (import "../../src/state.eli" read-state write-state)
  (import "../../src/commands.eli" resolve-query execute-query)
  (import "../../src/privacy.eli" public-text)
  (import "../../src/pray.eli" has-pray?)
  (import "../../src/util.eli" ms iso beijing utc clean fail json)
  (defun sender-context (event)
    (let* ((sender (get event :sender (js-object))) (id (get sender :sender_id (js-object))) (message (get event :message (js-object))))
      (when (= (get sender :sender_type) "user")
        (when (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test (get id :open_id ""))
          (js-object :transport "lark" :actor (get id :open_id) :scope (get message :chat_id "") :authenticated t)))))
  (defun group-config ()
    (let* ((raw (get (get process :env) :TIBO_LARK_CHAT_IDS ""))
           (groups (Array/from (new Set (js-call (js-call (js-call raw :split ",") :map (lambda (x) (js-call x :trim))) :filter (lambda (x) (> (get x :length) 0)))))))
      (unless (and (> (get groups :length) 0) (js-call groups :every
        (lambda (id) (js-call (new RegExp "^oc_[a-zA-Z0-9]+$") :test id)))) (fail "TIBO_LARK_CHAT_IDS 必须为明确授权的群ID列表"))
      groups))
  (defun command-of (event allowed bot-id)
    (let* ((message (get event :message (js-object))) (chat-id (get message :chat_id))
           (sender (get event :sender (js-object))) (mentions (get message :mentions (js-array))))
      (when (and message (= (get sender :sender_type) "user") (= (get message :chat_type) "group")
                 (= (get message :message_type) "text") (js-call allowed :includes chat-id))
        (try
          (let ((text (get (JSON/parse (get message :content)) :text "")))
            (js-call mentions :forEach
              (lambda (mention) (setq text (js-call text :replace (get mention :key) ""))))
            (setq text (clean text))
            (when (and (> (get text :length) 0) (<= (get text :length) 800))
              (cond ((has-pray? text) "pray")
                    ((js-call mentions :some (lambda (mention) (= (get (get mention :id (js-object)) :open_id) bot-id))) text)
                    (t nil))))
          (catch error nil)))))
  (defun slot-at (now)
    (let* ((local (beijing now)) (hour (Number (js-call local :slice 6 8)))
           (minute (Number (js-call local :slice 9 11))))
      ;; Only a bounded 15-minute delivery window. Restarts do not replay old reports.
      (when (and (or (= hour 9) (= hour 21)) (< minute 15))
        (let ((target (iso (- (ms now) (+ (* minute 60000) (% (ms now) 60000))))))
          (js-object :key (str (js-call now :slice 0 10) "-" hour) :at target)))))
  (defun delivery-key (group key)
    (str "lark-" (js-call (js-call (js-call (createHash "sha256") :update (str group ":" key)) :digest "hex") :slice 0 40)))
  (defun message-key (id) (str "lark-message-" (js-call (js-call (js-call (createHash "sha256") :update id) :digest "hex") :slice 0 40)))
  (defasync reaction-job (event allowed)
    ;; THANKS is Lark's 双手合十 🙏 emoji. Only our confirmed sent messages qualify.
    (let* ((actor (get (get event :user_id (js-object)) :open_id "")) (id (get event :message_id ""))
           (created (Number (get event :action_time 0))))
      (when (and (= (get event :operator_type) "user")
                 (= (get (get event :reaction_type (js-object)) :emoji_type) "THANKS")
                 (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test actor)
                 (= (value-type id) "string") (> (get id :length) 0) (<= (get id :length) 200)
                 (> created (- (Date/now) 300000)) (<= created (+ (Date/now) 60000)))
        (let* ((sent (await (read-state (message-key id)))) (group (get (or sent (js-object)) :group)))
          (when (and sent (= (get sent :messageId) id)
                     (= (get sent :appId "") (get (get process :env) :TIBO_LARK_APP_ID ""))
                     (js-call allowed :includes group))
            (js-object :group group :key (str "reaction-" (message-key (str actor ":" id))) :command "pray"
              :context (js-object :transport "lark" :actor actor :scope group :authenticated t) :acceptedAt (iso (Date/now))))))))
  (defun markdown-post (markdown)
    (JSON/stringify (js-object :zh_cn (js-object :content (js-array (js-array (js-object :tag "md" :text markdown)))))))
  (defasync send-report (client group key text)
    (let ((response (await (js-call client :send
      (js-object :receive_id group :msg_type "post" :content (markdown-post (public-text text))
                        :uuid (js-call key :slice -40))))))
      (unless (= (get response :code) 0)
        (let ((error (new Error "Lark 消息 API 拒绝请求")))
          (when (Number/isInteger (get response :code)) (put error :larkCode (get response :code)))
          (throw error)))
      (unless (get (get response :data (js-object)) :message_id) (fail "Lark 返回缺少 message_id"))
      (get (get response :data) :message_id)))
  (defasync deliver (client group key command &optional title-time context)
    (let ((ledger-key (delivery-key group key)))
      (when context (setq context (Object/assign (js-object) context (js-object :requestId ledger-key))))
      (when (await (read-state ledger-key)) (fail "投递已有记录，禁止自动重复发送"))
      ;; Reserve BEFORE invoking external I/O. Unknown send outcomes stay auditable.
      (await (write-state ledger-key (js-object :state "pending" :at (iso (Date/now)) :group group :key key)))
      (try
        (let* ((response (try
                  (await (execute-query (await (resolve-query command context)) (js-object :channel group :persist false :titleTime title-time :context context)))
                  (catch error (js-object :ok false :text "查询暂时出了问题，请稍后再试。"))))
               (text (get response :text)) (result (get response :result)))
          (await (write-state ledger-key (js-object :state "sending" :at (iso (Date/now)) :group group :key key)))
          (let ((id (await (send-report client group ledger-key text))))
            (await (write-state ledger-key (js-object :state "sent" :messageId id :at (iso (Date/now)) :group group :key key)))
            (await (write-state (message-key id) (js-object :messageId id :group group
              :appId (get (get process :env) :TIBO_LARK_APP_ID "") :at (iso (Date/now)))))
            ;; The prior forecast is updated only AFTER confirmed successful report delivery.
            (when (and result (get response :ok)) (await (save-report group result)))
            id))
        (catch error
          (let ((ledger (await (read-state ledger-key))))
            (unless (= (get ledger :state) "sent")
              (await (write-state ledger-key (js-object :state (if (Number/isInteger (get error :larkCode)) "rejected"
                       (if (= (get ledger :state) "sending") "uncertain" "failed-before-send"))
                     :larkCode (get error :larkCode) :at (iso (Date/now)) :group group :key key)))))
          (throw (new Error "投递未完成；检查本地账本，未知结果不自动重试"))))))
  (export group-config command-of sender-context slot-at delivery-key message-key reaction-job markdown-post send-report deliver))
