;; Durable fan-out is independent of the bounded interactive-command inbox.
(module tibo.lark.broadcast
  (import "node:crypto" createHash)
  (import "node:timers" setTimeout)
  (import "../../src/platform/host.eli" Date Promise Number RegExp)
  (import "../../src/platform/state.eli" read-state write-state with-lock)
  (import "../../src/subscriptions/registry.eli" active-subscribers still-subscribed?)
  (import "../../src/subscriptions/bulletin.eli" ensure-bulletin bulletin-key)
  (import "../../src/platform/util.eli" ms fail)
  (import "./service.eli" account-key delivery-key deliver)
  (defun plan-key (account slot)
    (str "lark-broadcast-" (js-call (js-call (js-call (createHash "sha256") :update (str account ":" (bulletin-key slot))) :digest "hex") :slice 0 40)))
  (defasync load-plan (groups account slot)
    (await (with-lock (plan-key account slot) (async ()
      (let ((saved (await (read-state (plan-key account slot)))))
        (if saved
          (progn
            (unless (and (= (get saved :schemaVersion) 1) (= (get saved :slotAt) (get slot :at))
              (Array/isArray (get saved :targets)) (Number/isInteger (get saved :cursor))
              (>= (get saved :cursor) 0) (<= (get saved :cursor) (get (get saved :targets) :length))
              (js-call (get saved :targets) :every (lambda (target)
                (or (and (= (get target :kind) "group") (js-call (new RegExp "^oc_[A-Za-z0-9]+$") :test (get target :id "")))
                    (and (= (get target :kind) "dm") (js-call (new RegExp "^ou_[A-Za-z0-9]+$") :test (get target :id ""))
                         (= (value-type (get target :revision)) "string")))))) (fail "定点分发档案不可读")) saved)
          (let* ((subscribers (await (active-subscribers "lark" account)))
                 (targets (js-call groups :map (lambda (group) (js-object :kind "group" :id group)))))
            (js-call subscribers :forEach (lambda (member)
              ;; Subscriptions start strictly after the subscription request.
              (when (< (ms (get member :updatedAt)) (ms (get slot :at)))
                (js-call targets :push (js-object :kind "dm" :id (get member :actor) :revision (get member :revision))))))
            (let ((plan (js-object :schemaVersion 1 :slotAt (get slot :at) :cursor 0 :targets targets :state "pending")))
              (await (write-state (plan-key account slot) plan)) plan))))))))
  (defasync send-target (client groups account slot target bulletin)
    (let* ((id (get target :id))
           (eligible (if (= (get target :kind) "group") (js-call groups :includes id)
             (await (still-subscribed? "lark" account id (get target :revision))))))
      (when (and eligible (not (await (read-state (delivery-key id (get slot :key))))))
        (try (await (deliver client id (get slot :key) nil nil nil bulletin))
          (catch error
            (unless (await (read-state (delivery-key id (get slot :key)))) (throw error))
            (console/error "tibo-lark: 某个定点收件人未送达，详情留在本地账本")))
        ;; Ten recipient requests per second at most, plus actual HTTP time.
        (await (new Promise (lambda (resolve) (setTimeout resolve 100)))))))
  (defasync run-plan (client groups account slot stopped? generate progress)
    (let* ((plan (await (load-plan groups account slot))) (targets (get plan :targets)))
      (funcall progress plan)
      (when (and (< (get plan :cursor) (get targets :length)) (< (Date/now) (+ (ms (get slot :at)) 900000)))
        (let ((bulletin (await (ensure-bulletin slot generate))))
          (if (not (= (get bulletin :state) "ready"))
            (progn (put plan :state "generation-unavailable") (await (write-state (plan-key account slot) plan)))
            (while (and (not (funcall stopped?)) (< (get plan :cursor) (get targets :length))
                        (< (Date/now) (+ (ms (get slot :at)) 900000)))
              (await (send-target client groups account slot (get targets (get plan :cursor)) bulletin))
              (put plan :cursor (+ (get plan :cursor) 1))
              (put plan :state (if (= (get plan :cursor) (get targets :length)) "complete" "pending"))
              (await (write-state (plan-key account slot) plan))))))))
  (defun create-broadcaster (client groups &optional generate)
    (let ((account (account-key)) (active nil) (stopped false) (progress nil))
      (js-object
        :tick (async (slot)
          (unless stopped
            (unless active
              (setq active (js-call (run-plan client groups account slot (lambda () stopped) generate (lambda (plan) (setq progress plan)))
                :finally (lambda () (setq active nil)))))
            (when active (await active))))
        :status (lambda () (js-object :active (not (not active)) :state (get (or progress (js-object)) :state "idle")
          :processed (get (or progress (js-object)) :cursor 0) :recipients (get (get (or progress (js-object :targets (js-array))) :targets) :length)))
        :halt (lambda () (setq stopped t))
        :stop (async () (setq stopped t) (when active (await active))))))
  (export create-broadcaster plan-key))
