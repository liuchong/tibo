;; Official post emotion identifiers. This catalog is presentation data, not a
;; rule mapping the user's mood or words to a mandatory reply.
(module tibo.lark.emojis
  (defconst reply-emojis (js-array
    (js-object :id "SMILE" :label "微笑" :glyphs (js-array "🙂")) (js-object :id "BLUSH" :label "开心" :glyphs (js-array "😊"))
    (js-object :id "LAUGH" :label "大笑" :glyphs (js-array "😄" "😆")) (js-object :id "LOL" :label "笑哭" :glyphs (js-array "😂" "🤣"))
    (js-object :id "SMIRK" :label "得意的笑" :glyphs (js-array "😏") :aliases (js-array "坏笑")) (js-object :id "WINK" :label "眨眼" :glyphs (js-array "😉"))
    (js-object :id "FACEPALM" :label "捂脸" :glyphs (js-array "🤦")) (js-object :id "NOSEPICK" :label "抠鼻")
    (js-object :id "FullMoonFace" :label "满月脸" :glyphs (js-array "🌝")) (js-object :id "THINKING" :label "思考" :glyphs (js-array "🤔"))
    (js-object :id "GLANCE" :label "斜眼看" :glyphs (js-array "🙄")) (js-object :id "DULL" :label "呆住" :glyphs (js-array "😐"))
    (js-object :id "WOW" :label "惊讶" :glyphs (js-array "😮")) (js-object :id "SHOCKED" :label "震惊" :glyphs (js-array "😱"))
    (js-object :id "SOB" :label "大哭" :glyphs (js-array "😭")) (js-object :id "HUG" :label "拥抱" :glyphs (js-array "🤗"))
    (js-object :id "THANKS" :label "双手合十" :glyphs (js-array "🙏")) (js-object :id "THUMBSUP" :label "赞" :glyphs (js-array "👍"))
    (js-object :id "APPLAUSE" :label "鼓掌" :glyphs (js-array "👏")) (js-object :id "OK" :label "好的" :glyphs (js-array "👌"))
    (js-object :id "MUSCLE" :label "加油" :glyphs (js-array "💪")) (js-object :id "SaluteFace" :label "敬礼" :glyphs (js-array "🫡"))
    (js-object :id "Shrug" :label "摊手" :glyphs (js-array "🤷")) (js-object :id "Partying" :label "庆祝" :glyphs (js-array "🥳"))))
  (defun supported-emoji? (id) (js-call reply-emojis :some (lambda (row) (= (get row :id) id))))
  (export reply-emojis supported-emoji?))
