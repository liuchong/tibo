;; One instance owns this bounded inbox. Durable acceptance precedes ACK.
(module tibo.lark.inbox
  (import "node:timers" setTimeout clearTimeout)
  (import "../../src/host.eli" Promise Date Number)
  (import "../../src/state.eli" read-state write-state)
  (import "../../src/commands.eli" fixed-query)
  (import "../../src/util.eli" fail iso ms)
  (import "../../src/im-trigger.eli" decide-secondary)
  (import "./service.eli" delivery-key deliver allowed-job?)
  (defun fast-job? (job)
    ;; Classify locally, without AI. Pipes and management stay in the normal lane.
    (let ((command (get job :command "")))
      (and (not (js-call command :includes "|"))
        (let ((query (fixed-query command)))
          (not (not (and query (js-call (js-array "help" "pray" "subscribe" "unsubscribe" "subscription") :includes (get query :command)))))))))
  (defasync create-inbox (client groups)
    (let* ((saved (or (await (read-state "lark-inbox")) (js-object))) (jobs (get saved :jobs (js-array)))
           (serial (Promise/resolve nil)) (workers (js-object :fast nil :normal nil)) (timer nil) (stopped false) (pump nil))
      (unless (and (Array/isArray jobs) (<= (get jobs :length) 32)
                   (js-call jobs :every (lambda (job)
                     (and job (= (value-type (get job :group)) "string") (= (value-type (get job :key)) "string")
                          (= (value-type (get job :command)) "string") (> (get (get job :command) :length) 0)
                          (<= (get (get job :command) :length) 800))))) (fail "Lark 收件箱损坏，请保留文件后检查"))
      (let ((mutate (lambda (operation)
              (let ((result (js-call serial :then operation)))
                (setq serial (js-call result :catch (lambda (error) nil))) result))))
        (setq pump (lambda ()
          (unless stopped
            (js-call (js-array "fast" "normal") :forEach (lambda (lane)
              (unless (get workers lane)
                (let ((job (js-call jobs :find (lambda (row) (= (fast-job? row) (= lane "fast"))))) (removable t))
                  (when job
                    (put workers lane (js-call (js-call (js-call (async ()
                      (when (and (allowed-job? job groups)
                                 (or (not (get job :expiresAt)) (> (ms (get job :expiresAt)) (Date/now)))
                                 (not (await (read-state (delivery-key (get job :group) (get job :key))))))
                        (let ((decision (when (= (get job :triggerLevel) 2)
                          (await (decide-secondary (get job :command) (get job :context) (get job :key))))))
                          (if (and decision (not (get decision :accepted)))
                            (await (write-state (delivery-key (get job :group) (get job :key))
                              (js-object :state "filtered" :at (iso (Date/now)) :reason (get decision :reason) :method (get decision :method))))
                            (await (deliver client (get job :group) (get job :key) (get job :command) (get job :titleTime) (get job :context) nil job)))))) :call nil)
                      :catch (async (error)
                        (console/error "tibo-lark: 查询投递未完成，详情留在本地账本")
                        (try
                          (unless (await (read-state (delivery-key (get job :group) (get job :key)))) (setq removable false))
                          (catch error (setq removable false)))))
                      :then (async ()
                        (try
                          (if (not removable)
                            (progn (setq stopped t) (console/error "tibo-lark: 无可确认的投递记录，保留收件箱并暂停处理"))
                            (await (funcall mutate (async ()
                              ;; Concurrent lanes remove their own job; never shift another job.
                              (let ((remaining (js-call jobs :filter (lambda (row) (not (= row job))))))
                                (await (write-state "lark-inbox" (js-object :jobs remaining :updatedAt (iso (Date/now)))))
                                (setq jobs remaining))))))
                          (catch error (setq stopped t) (console/error "tibo-lark: 收件箱不可写，已暂停处理")))
                        (put workers lane nil)
                        (unless stopped (setq timer (setTimeout (lambda () (setq timer nil) (funcall pump)) 0))))))))))))))
        (js-object
          :accept (async (job)
            (await (funcall mutate (async ()
              (when stopped (fail "Lark 已停止接收"))
              (unless (and (allowed-job? job groups) (= (value-type (get job :key)) "string")
                           (= (value-type (get job :command)) "string") (<= (get (get job :command) :length) 800)) (fail "Lark 入队参数无效"))
              (let ((key (delivery-key (get job :group) (get job :key))))
                (unless (or (js-call jobs :some (lambda (row) (= key (delivery-key (get row :group) (get row :key)))))
                            (await (read-state key)))
                  (when (>= (get jobs :length) 32) (fail "Lark 收件箱已满"))
                  (let ((next (js-call jobs :concat (js-array job))))
                    (await (write-state "lark-inbox" (js-object :jobs next :updatedAt (iso (Date/now)))))
                    (setq jobs next)))))))
            (unless (or stopped timer) (setq timer (setTimeout (lambda () (setq timer nil) (funcall pump)) 0))) nil)
          :resume (lambda () (funcall pump))
          :status (lambda () (js-object :pending (get jobs :length) :active (js-call (Object/values workers) :some (lambda (w) (not (not w)))) :paused stopped))
          :stop (async () (setq stopped t) (clearTimeout timer) (await serial)
            (await (Promise/all (js-call (Object/values workers) :filter (lambda (w) (not (not w)))))))))))
  (export create-inbox fast-job?))
