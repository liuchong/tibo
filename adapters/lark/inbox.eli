;; Durable spool, bounded cache and independent asynchronous workers.
(module tibo.lark.inbox
  (import "node:timers" setTimeout clearTimeout)
  (import "../../src/platform/host.eli" Promise Date Map Set)
  (import "../../src/platform/state.eli" read-state write-state)
  (import "../../src/platform/util.eli" fail iso ms)
  (import "./celebration-delivery.eli" finish-celebration)
  (import "./interaction.eli" process-interaction)
  (import "./service.eli" delivery-key allowed-job? reaction-job)
  (import "./inbox-store.eli" pending-files file-key file-lane fast-job? read-pending write-pending remove-pending)
  (defun valid-job? (job)
    (and job (= (value-type (get job :group)) "string") (= (value-type (get job :key)) "string")
      (= (value-type (get job :command)) "string") (> (get (get job :command) :length) 0)
      (<= (get (get job :command) :length) 800)))
  (defasync reconcile-festival (client job key)
    (let ((receipt (await (read-state key))) (context (get job :context)))
      (when (get (or receipt (js-object)) :receiptKey)
        (setq key (get receipt :receiptKey)) (setq receipt (await (read-state key))))
      (when (and receipt (= (get receipt :state) "sent") (get receipt :festivalRequest))
        (when (= (get job :kind) "reaction")
          (setq context (js-object :transport "lark" :authenticated t :account (get job :account)
            :actor (get (get (get job :reaction) :user_id) :open_id) :scope (get receipt :group))))
        (await (finish-celebration client key context)))))
  (defasync create-inbox (client groups)
    (let* ((saved (or (await (read-state "lark-inbox")) (js-object)))
      (files (new Map)) (cache (new Map)) (active (new Set)) (workers (new Set))
      (lanes (js-object :fast 0 :normal 0)) (serial (Promise/resolve nil))
      (timer nil) (stopped false) (paused false) (pump nil) (mutate nil) (fill nil) (snapshot nil)
      (cached-count (lambda (lane) (get (js-call (Array/from (js-call cache :values)) :filter (lambda (job) (= (fast-job? job) (= lane "fast")))) :length))))
      (js-call (await (pending-files)) :forEach (lambda (file) (js-call files :set (file-key file) file)))
      ;; Upgrade accepted legacy jobs first; stable spool keys make crashes safe.
      (let ((legacy (get saved :jobs (js-array))))
        (unless (and (Array/isArray legacy) (js-call legacy :every valid-job?)) (fail "Lark 收件箱损坏，请保留文件后检查"))
        (let ((i 0))
          (while (< i (get legacy :length))
            (let* ((job (get legacy i)) (key (delivery-key (get job :group) (get job :key))))
              (unless (js-call files :has key) (js-call files :set key (await (write-pending job)))))
            (setq i (+ i 1)))))
      (setq mutate (lambda (operation)
        (let ((result (js-call serial :then operation)))
          (setq serial (js-call result :catch (lambda (error) nil))) result)))
      (setq snapshot (async ()
        (await (write-state "lark-inbox" (js-object :schemaVersion 2 :jobs (js-array)
          :pending (get files :size) :cached (get cache :size) :updatedAt (iso (Date/now)))))))
      (setq fill (async ()
        (let* ((names (js-call (Array/from (js-call files :values)) :sort)) (i 0))
          (while (and (< (get cache :size) 128) (< i (get names :length)))
            (let* ((file (get names i)) (key (file-key file)))
              (when (and (not (js-call cache :has key)) (< (funcall cached-count (file-lane file)) 64))
                (let ((job (await (read-pending file))))
                  (unless (and (valid-job? job) (= key (delivery-key (get job :group) (get job :key)))) (fail "Lark 待处理事件损坏"))
                  (js-call cache :set key job)))) (setq i (+ i 1))))))
      (await (funcall fill)) (await (funcall snapshot))
      (setq pump (lambda ()
        (unless (or stopped paused)
          (js-call (js-array "fast" "normal") :forEach (lambda (lane)
            (let ((limit (if (= lane "fast") 4 2)) (available t))
              (while (and available (< (get lanes lane) limit))
                (let* ((entry (js-call (Array/from (js-call cache :entries)) :find (lambda (pair)
                  (and (not (js-call active :has (get pair 0))) (= (fast-job? (get pair 1)) (= lane "fast"))
                    (<= (get (get pair 1) :retryAt 0) (Date/now))))))
                  (key (when entry (get entry 0))) (job (when entry (get entry 1))))
                  (if (not job) (setq available false)
                    (let ((worker nil) (removable t) (receipt-key key))
                      (js-call active :add key) (put lanes lane (+ 1 (get lanes lane)))
                      (setq worker (js-call (js-call (js-call (async ()
                        (when (and (allowed-job? job groups)
                          (or (= (get job :triggerKind) "prayer") (not (get job :expiresAt)) (> (ms (get job :expiresAt)) (Date/now)))
                          (not (await (read-state key))))
                          (let ((resolved job) (audit (js-object)))
                            (when (= (get job :kind) "reaction")
                              (setq resolved (await (reaction-job (get job :reaction) groups client audit (get job :eventId) t))))
                            (if (not resolved)
                              (await (write-state key (js-object :state "filtered" :reason (get audit :reason) :at (iso (Date/now)))))
                              (progn
                                (setq receipt-key (delivery-key (get resolved :group) (get resolved :key)))
                                (put resolved :acceptedAt (get job :acceptedAt))
                                (unless (await (read-state receipt-key)) (await (process-interaction client resolved)))
                                (when (not (= receipt-key key))
                                  (await (write-state key (js-object :state "handled" :receiptKey receipt-key :at (iso (Date/now))))))))))) :call nil)
                        :catch (async (error)
                          (console/error "tibo-lark: 处理暂未完成，按事件保留重试")
                          (when (get error :permanent)
                            (await (write-state key (js-object :state "filtered" :reason "message-permanently-unavailable" :at (iso (Date/now))))))
                          (try
                            (if (not (await (read-state receipt-key))) (setq removable false)
                              (when (not (= receipt-key key))
                                (await (write-state key (js-object :state "handled" :receiptKey receipt-key :at (iso (Date/now)))))))
                            (catch error (setq removable false paused t)))))
                        :then (async ()
                          ;; Resume unsent ceremony parts after a crash; confirmed
                          ;; and unknown outcomes are never automatically resent.
                          (when removable
                            (try (await (reconcile-festival client job receipt-key))
                              (catch error (setq removable false))))
                          (try
                            (await (funcall mutate (async ()
                              (if removable
                                (progn (await (remove-pending (js-call files :get key))) (js-call files :delete key) (js-call cache :delete key))
                                (progn
                                  (put job :attempts (+ 1 (get job :attempts 0)))
                                  (put job :retryAt (+ (Date/now) (Math/min 60000 (* 1000 (Math/pow 2 (Math/min 6 (get job :attempts)))))))
                                  (await (write-pending job (js-call files :get key)))))
                              (await (funcall fill)) (await (funcall snapshot)))))
                            (catch error (setq paused t) (console/error "tibo-lark: 收件箱不可写，已保留事件并暂停")))
                          (js-call active :delete key) (js-call workers :delete worker) (put lanes lane (- (get lanes lane) 1))
                          (unless (or stopped paused)
                            (clearTimeout timer) (setq timer (setTimeout (lambda () (setq timer nil) (funcall pump)) (if removable 0 1000)))))))
                      (js-call workers :add worker))))))))
          (when (and (> (get files :size) 0) (= (get workers :size) 0) (not timer))
            (setq timer (setTimeout (lambda () (setq timer nil) (funcall pump)) 1000))))))
      (js-object
        :accept (async (job)
          (await (funcall mutate (async ()
            (when (or stopped paused) (fail "Lark 已停止接收"))
            (unless (and (valid-job? job) (allowed-job? job groups)) (fail "Lark 入队参数无效"))
            (let ((key (delivery-key (get job :group) (get job :key))))
              (unless (or (js-call files :has key) (await (read-state key)))
                (js-call files :set key (await (write-pending job)))
                (when (< (funcall cached-count (if (fast-job? job) "fast" "normal")) 64) (js-call cache :set key job))
                (await (funcall snapshot)))))))
          (unless (or stopped paused timer) (setq timer (setTimeout (lambda () (setq timer nil) (funcall pump)) 0))) nil)
        :resume (lambda () (funcall pump))
        :status (lambda () (js-object :pending (get files :size) :cached (get cache :size)
          :active (> (get workers :size) 0) :workers (get workers :size) :paused paused))
        :stop (async () (setq stopped t) (clearTimeout timer) (await serial)
          (await (Promise/all (Array/from workers))) (await serial)))))
  (export create-inbox fast-job?))
