(module tibo.lark.messages
  (import "../../src/platform/host.eli" Error Number)
  (import "../../src/platform/privacy.eli" public-text)
  (import "../../src/platform/util.eli" fail)
  (import "./emojis.eli" supported-emoji?)
  (defun markdown-post (markdown &optional emoji)
    (let ((rows (js-array (js-array (js-object :tag "md" :text markdown)))))
      ;; md owns its paragraph; native emotion goes in the same message's next
      ;; paragraph, never embedded as a textual placeholder inside Markdown.
      (when (supported-emoji? emoji) (js-call rows :push (js-array (js-object :tag "emotion" :emoji_type emoji))))
      (JSON/stringify (js-object :zh_cn (js-object :content rows)))))
  (defasync send-report (client group key text &optional metadata reference emoji)
    (let ((response (await (if reference
      (js-call client :reply (get reference :messageId)
        (js-object :msg_type "post" :content (markdown-post (public-text text) emoji) :uuid (js-call key :slice -40)
          :reply_in_thread (not (not (get reference :threadId)))))
      (js-call client :send
      (js-object :receive_id group :msg_type "post" :content (markdown-post (public-text text) emoji)
                        :uuid (js-call key :slice -40))
      (if (js-call group :startsWith "ou_") "open_id" "chat_id"))))))
      (unless (= (get response :code) 0)
        (let ((error (new Error "Lark 消息 API 拒绝请求")))
          (when (Number/isInteger (get response :code)) (put error :larkCode (get response :code)))
          (throw error)))
      (unless (get (get response :data (js-object)) :message_id) (fail "Lark 返回缺少 message_id"))
      (when metadata
        (put metadata :chatId (get (get response :data) :chat_id))
        (put metadata :threadId (get (get response :data) :thread_id)))
      (get (get response :data) :message_id)))
  (export markdown-post send-report))
