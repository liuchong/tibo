;; Platform history is the durable conversation store. Reads are opt-in and
;; fixed; no AI-generated URLs, selectors, identities or commands are accepted.
(module tibo.lark.thread
  (import "../../src/platform/host.eli" RegExp Date Number Map Set AbortSignal)
  (import "../../src/ai/conversation.eli" conversation-turns)
  (import "../../src/platform/util.eli" fail)
  (defun message-id? (id) (and (= (value-type id) "string") (js-call (new RegExp "^om_[A-Za-z0-9_-]{1,180}$") :test id)))
  (defun reference-of (message)
    (when (or (and (message-id? (get message :parent_id)) (not (= (get message :parent_id) (get message :message_id))))
              (and (message-id? (get message :root_id)) (not (= (get message :root_id) (get message :message_id)))))
      (js-object :parentId (get message :parent_id) :rootId (get message :root_id) :threadId (get message :thread_id))))
  (defun body-text (message)
    (try
      (let* ((body (JSON/parse (get (get message :body (js-object)) :content "{}"))) (kind (get message :msg_type)))
        (cond ((= kind "text") (if (= (value-type (get body :text)) "string") (get body :text) ""))
          ((= kind "post")
            (let* ((post (if (Array/isArray (get body :content)) body
              (js-call (Object/values body) :find (lambda (p) (and p (Array/isArray (get p :content)))))))
              (parts (js-call (get post :content (js-array)) :flat)))
              (str (get post :title "") "\n" (js-call (js-call parts :map (lambda (p)
                (if (and p (js-call (js-array "text" "md" "a") :includes (get p :tag)) (= (value-type (get p :text)) "string")) (get p :text) ""))) :join "\n"))))
          (t ""))) (catch error "")))
  (defasync load-thread (client job app-id)
    (if (not (get job :reference)) (js-object :state "none" :messages (js-array))
      (let* ((context (get job :context)) (group (get job :group)) (id (get job :messageId (get job :key)))
        (rows (new Map)) (partial false) (native-thread nil) (origin nil) (current nil)
        (signal (AbortSignal/timeout 6000)))
        (try
          (unless (and (= (get context :authenticated) t) (= (get context :transport) "lark")
            (= (get context :scope) group) (message-id? id)) (fail "thread-scope"))
          (setq current (await (js-call client :messageInfo id signal)))
          (unless (and (= (get current :chat_id) group) (= (get current :message_id) id)
            (= (get (get current :sender) :sender_type) "user")
            (= (get (get current :sender) :id) (get context :actor)) (not (get current :deleted)) (reference-of current))
            (fail "thread-scope"))
          (setq native-thread (get current :thread_id))
          (let ((parent (or (get current :parent_id) (get current :root_id))) (depth 0) (seen (new Set)))
            (while (and parent (not (= parent id)) (not (js-call seen :has parent)) (< depth 16) (not (get signal :aborted)))
              (js-call seen :add parent)
              (let ((item (await (js-call client :messageInfo parent signal))))
                (unless (and (= (get item :message_id) parent) (= (get item :chat_id) group)
                  (<= (Number (get item :create_time)) (Number (get current :create_time)))) (fail "thread-scope"))
                (js-call rows :set parent item) (setq origin parent)
                (setq parent (or (get item :parent_id)
                  (when (not (= (get item :root_id) parent)) (get item :root_id)))))
              (setq depth (+ depth 1)))
            (when parent (setq partial t)))
          ;; A root can be explicitly supplied even when the parent is a topic
          ;; reply. Verify it, then gather the entire connected component.
          (let ((root (get current :root_id)))
            (when (and (message-id? root) (not (= root id)) (not (js-call rows :has root)))
              (let ((item (await (js-call client :messageInfo root signal))))
                (unless (and (= (get item :chat_id) group) (= (get item :message_id) root)
                  (<= (Number (get item :create_time)) (Number (get current :create_time)))) (fail "thread-scope"))
                (js-call rows :set root item) (setq origin root))))
          (let ((token nil) (pages 0) (more t) (candidates (js-array)))
            (while (and more (< pages 4) (not (get signal :aborted)))
              (let ((page (await (js-call client :historyPage (if native-thread "thread" "chat") (or native-thread group)
                token (get (js-call rows :get origin) :create_time) (get current :create_time) signal))))
                (unless (Array/isArray (get page :items)) (fail "thread-page"))
                (setq candidates (js-call candidates :concat (js-call (get page :items) :slice 0 50)))
                (setq more (= (get page :has_more) t) token (get page :page_token) pages (+ pages 1))
                (when (and more (or (not (= (value-type token) "string")) (= token ""))) (fail "thread-page"))))
            (when more (setq partial t))
            (let ((connected (new Set (Array/from (js-call rows :keys)))) (round 0))
              (js-call connected :add id)
              (while (< round 16)
                (js-call candidates :forEach (lambda (item)
                  (when (and (message-id? (get item :message_id)) (= (get item :chat_id) group)
                    (not (= (get item :message_id) id))
                    (<= (Number (get item :create_time)) (Number (get current :create_time)))
                    (or (not (= (get item :create_time) (get current :create_time)))
                      (not (get current :message_position))
                      (< (Number (get item :message_position)) (Number (get current :message_position))))
                    (if native-thread (= (get item :thread_id) native-thread)
                      (or (js-call connected :has (get item :message_id))
                          (js-call connected :has (get item :parent_id)) (js-call connected :has (get item :root_id)))))
                    (js-call connected :add (get item :message_id)) (js-call rows :set (get item :message_id) item))))
                (setq round (+ round 1)))))
          (catch error (setq partial t)))
        (let* ((ordered (js-call (Array/from (js-call rows :values)) :sort (lambda (a b)
          (or (- (Number (get a :create_time)) (Number (get b :create_time)))
            (- (Number (get a :message_position 0)) (Number (get b :message_position 0)))))))
          (turns (js-array)))
          (js-call ordered :forEach (lambda (item)
            (let* ((sender (get item :sender (js-object)))
              (role (cond ((= (get sender :sender_type) "user") "user")
                ((and (= (get sender :sender_type) "app") (= (get sender :id_type) "app_id") (= (get sender :id) app-id)) "assistant")))
              (text (body-text item)))
              (when (and role (not (get item :deleted)) (> (get text :length) 0))
                (js-call turns :push (js-object :role role :content text))))))
          (let ((bounded (conversation-turns turns)))
            (js-object :state (if (= (get (get bounded :messages) :length) 0) "unavailable" (if partial "partial" "ready"))
              :messages (get bounded :messages) :trimmed (or partial (get bounded :trimmed))))))))
  (export reference-of body-text load-thread))
