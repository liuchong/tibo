;; Platform history bootstraps and incrementally supplies the local dialogue. Reads are opt-in and
;; fixed; no AI-generated URLs, selectors, identities or commands are accepted.
(module tibo.lark.thread
  (import "../../src/platform/host.eli" RegExp Date Number Map Set AbortSignal)
  (import "../../src/ai/conversation.eli" conversation-turns)
  (import "../../src/platform/util.eli" fail)
  (import "../../src/platform/state.eli" read-state write-state)
  (import "../../src/chat/store.eli" conversation-key read-session session-messages import-turns)
  (defun message-id? (id) (and (= (value-type id) "string") (js-call (new RegExp "^om_[A-Za-z0-9_-]{1,180}$") :test id)))
  (defun thread-id? (id) (and (= (value-type id) "string") (js-call (new RegExp "^omt_[A-Za-z0-9_-]{1,180}$") :test id)))
  (defun reference-of (message)
    (when (or (thread-id? (get message :thread_id)) (and (message-id? (get message :parent_id)) (not (= (get message :parent_id) (get message :message_id))))
              (and (message-id? (get message :root_id)) (not (= (get message :root_id) (get message :message_id)))))
      (js-object :parentId (get message :parent_id) :rootId (get message :root_id) :threadId (get message :thread_id))))
  (defun body-text (message)
    (try
      (let* ((body (JSON/parse (get (get message :body (js-object)) :content "{}"))) (kind (get message :msg_type)))
        (cond ((= kind "text") (if (= (value-type (get body :text)) "string") (get body :text) ""))
          ((= kind "post")
            (let* ((post (if (Array/isArray (get body :content)) body
              (js-call (Object/values body) :find (lambda (p) (and p (Array/isArray (get p :content)))))))
              (parts (js-call (get post :content (js-array)) :flat)))
              (str (get post :title "") "\n" (js-call (js-call parts :map (lambda (p)
                (if (and p (js-call (js-array "text" "md" "a") :includes (get p :tag)) (= (value-type (get p :text)) "string")) (get p :text) ""))) :join "\n"))))
          (t ""))) (catch error "")))
  (defun record-of (item app-id)
    (let* ((sender (get item :sender (js-object)))
      (role (cond ((= (get sender :sender_type) "user") "user")
        ((and (= (get sender :sender_type) "app") (= (get sender :id_type) "app_id") (= (get sender :id) app-id)) "assistant")))
      (text (body-text item)))
      (when (and role (not (get item :deleted)) (> (get text :length) 0))
        (let ((safe (get (get (conversation-turns (js-array (js-object :role role :content text))) :messages) 0)))
          (when safe (Object/assign (js-object :id (get item :message_id) :at (Number (get item :create_time))
            :position (Number (get item :message_position 0))) safe))))))
  (defasync reference-root (client job)
    ;; Resolve legacy parent-only events before taking the dialogue lock. This
    ;; avoids two branches of one chain getting different serialization keys.
    (let* ((context (get job :context)) (id (get job :messageId (get job :key)))
      (signal (AbortSignal/timeout 6000)) (item (await (js-call client :messageInfo id signal))) (seen (new Set)))
      (unless (and (= (get item :chat_id) (get context :scope)) (= (get item :message_id) id)
        (= (get (get item :sender) :sender_type) "user") (= (get (get item :sender) :id) (get context :actor)))
        (fail "thread-scope"))
      (while (and (not (message-id? (get item :root_id))) (message-id? (get item :parent_id)))
        (let ((parent (get item :parent_id)))
          (when (js-call seen :has parent) (fail "thread-cycle"))
          (js-call seen :add parent) (setq item (await (js-call client :messageInfo parent signal)))
          (unless (= (get item :chat_id) (get context :scope)) (fail "thread-scope"))))
      (or (get item :root_id) (get item :message_id))))
  (defasync load-thread (client job app-id)
    (if (not (get job :reference)) (js-object :state "none" :messages (js-array))
      (let* ((context (get job :context)) (group (get job :group)) (id (get job :messageId (get job :key)))
        (signal (AbortSignal/timeout 6000)) (session nil) (key nil))
        (try
          (unless (and (= (get context :authenticated) t) (= (get context :transport) "lark")
            (= (get context :scope) group) (message-id? id)) (fail "thread-scope"))
          (let* ((current (await (js-call client :messageInfo id signal)))
            (native (get current :thread_id)) (root (get current :root_id))
            (origin nil) (parent (get current :parent_id)) (visited (new Set)))
            (unless (and (= (get current :chat_id) group) (= (get current :message_id) id)
              (= (get (get current :sender) :sender_type) "user")
              (= (get (get current :sender) :id) (get context :actor)) (not (get current :deleted)) (reference-of current))
              (fail "thread-scope"))
            (unless (or (not native) (thread-id? native)) (fail "thread-id"))
            ;; Lark supplies root_id for ordinary chains. Older messages may
            ;; require parent resolution, with no arbitrary depth truncation.
            (when (message-id? root)
              (setq origin (if (= root id) current (await (js-call client :messageInfo root signal)))))
            (while (and (not origin) (message-id? parent) (not (js-call visited :has parent)))
              (js-call visited :add parent)
              (let ((item (await (js-call client :messageInfo parent signal))))
                (unless (= (get item :chat_id) group) (fail "thread-scope"))
                (cond ((and (message-id? (get item :root_id)) (not (= (get item :root_id) parent)))
                  (setq root (get item :root_id) origin (await (js-call client :messageInfo root signal))))
                  ((and (message-id? (get item :parent_id)) (not (= (get item :parent_id) parent))) (setq parent (get item :parent_id)))
                  (t (setq origin item root parent)))))
            (when (and native (not origin)) (setq origin current root id))
            (unless (and origin (= (get origin :chat_id) group)
              (<= (Number (get origin :create_time)) (Number (get current :create_time)))) (fail "thread-root"))
            (setq session (or native root) key (conversation-key context session))
            (let* ((state (await (read-session key))) (progress-key (str "lark-import-" (js-call key :slice 13)))
              (saved (await (read-state progress-key)))
              (progress (or saved (js-object :token nil :start (Math/max (get state :through) (Number (get origin :create_time)))
                :end (Number (get current :create_time)) :currentId id :position (Number (get current :message_position 0))
                :records (js-array) :connected (js-call (js-array root) :concat (get state :seen)) :kind (if (and native (= (get state :through) 0)) "thread" "chat"))))
              (pages 0) (more t) (records (get progress :records)) (connected (new Set (get progress :connected))))
              ;; Only sanitized text and opaque local identifiers survive a
              ;; pagination pause. Partial imports never become model input.
              (when (and (= (get state :through) 0) (not (= root (get progress :currentId))))
                (let ((row (record-of origin app-id)))
                  (when (and row (not (js-call records :some (lambda (r) (= (get r :id) root))))) (js-call records :push row))))
              (while (and more (< pages 4) (not (get signal :aborted)))
                (let ((page (await (js-call client :historyPage (get progress :kind)
                  (if (= (get progress :kind) "thread") native group)
                  (get progress :token) (get progress :start) (get progress :end) signal))))
                  (unless (Array/isArray (get page :items)) (fail "thread-page"))
                  (js-call (get page :items) :forEach (lambda (item)
                    (when (and (message-id? (get item :message_id)) (= (get item :chat_id) group)
                      (not (= (get item :message_id) (get progress :currentId)))
                      (<= (Number (get item :create_time)) (get progress :end))
                      (or (< (Number (get item :create_time)) (get progress :end)) (= (get progress :position) 0)
                        (< (Number (get item :message_position 0)) (get progress :position)))
                      (or (and native (= (get item :thread_id) native))
                        (= (get item :message_id) root) (= (get item :root_id) root)
                        (js-call connected :has (get item :parent_id))))
                      (js-call connected :add (get item :message_id))
                      (let ((row (record-of item app-id))) (when row (js-call records :push row))))))
                  (setq more (= (get page :has_more) t) pages (+ pages 1))
                  (put progress :token (get page :page_token))
                  (when (and more (or (not (= (value-type (get progress :token)) "string")) (= (get progress :token) ""))) (fail "thread-page"))
                  (put progress :connected (Array/from connected))
                  (await (write-state progress-key progress))))
              (if more (js-object :state "partial" :messages (js-array))
                (progn
                  (await (import-turns key (js-call
                    (js-call records :sort (lambda (a b) (or (- (get a :at) (get b :at)) (- (get a :position) (get b :position)))))
                    :map (lambda (row) (js-object :id (get row :id) :role (get row :role) :content (get row :content)))) (get progress :end)))
                  (await (write-state progress-key nil))
                  ;; An older paused import must catch up to this request before
                  ;; answering. It resumes from through on the next attempt.
                  (if (not (= (get progress :currentId) id)) (js-object :state "partial" :messages (js-array))
                    (js-object :state "ready" :sessionId session :currentId id
                      :messages (session-messages (await (read-session key)))))))))
          (catch error (js-object :state "unavailable" :messages (js-array)))))))
  (export reference-of body-text load-thread reference-root))
