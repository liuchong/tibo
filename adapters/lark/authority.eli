;; Live platform role lookup belongs to the adapter; core code sees only a
;; scoped proof and never receives an API client or raw group member list.
(module tibo.lark.authority
  (import "../../src/commands/admin.eli" is-admin ticket-key)
  (import "../../src/im/authority.eli" group-action?)
  (import "../../src/platform/state.eli" read-state)
  (import "../../src/platform/util.eli" fail)
  (defasync command-context (client query context)
    (let* ((next (Object/assign (js-object) (or context (js-object))))
      (name (get query :command)) (args (get query :args (js-object)))
      (needed (and (js-call (js-array "subscribe" "unsubscribe" "subscription") :includes name)
        (= (get args :target "personal") "group"))))
      (put next :groupAuthority (js-object)) (put next :groupRoleState "none")
      (when (and context (= (get context :authenticated) t) (= (get context :transport) "lark")
        (= (get context :conversationType) "group"))
        (when (js-call (js-array "confirm" "cancel") :includes name)
          (let ((ticket (try (await (read-state (ticket-key (get args :id)))) (catch error nil))))
            (setq needed (and ticket (group-action? (get ticket :action))
              (= (get ticket :actor) (get context :actor)) (= (get ticket :scope) (get context :scope))
              (= (get ticket :account) (get context :account))))))
        (when (and needed (not (is-admin context)))
          (try
            (let* ((info (await (js-call client :chatInfo (get context :scope))))
              (owner (get info :owner_id)) (managers (get info :user_manager_id_list)) (role nil))
              (unless (and (not (= (get info :chat_mode) "p2p"))
                (or (not owner) (= (get info :owner_id_type) "open_id"))
                (Array/isArray managers) (js-call managers :every (lambda (id) (= (value-type id) "string"))))
                (fail "Group role metadata unavailable"))
              (setq role (cond ((= owner (get context :actor)) "owner")
                ((js-call managers :includes (get context :actor)) "manager") (t "member")))
              (put next :groupRoleState "verified")
              (put next :groupAuthority (js-object :verified t :role role :transport "lark"
                :account (get context :account) :actor (get context :actor) :scope (get context :scope))))
            (catch error (put next :groupRoleState "unavailable"))))) next))
  (export command-context))
