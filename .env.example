# See docs/configuration.md for defaults and precedence.
# All examples are commented: even an empty environment value overrides config.env.
# Official public-page collection requires no API key.
# Optional local output redaction; comma-separated hostnames, no fetching involved.
# TIBO_HIDDEN_SOURCE_HOSTS=
# Optional AI. The installer saves private settings in ~/.config/tibo/config.env (0600).
# DEEPSEEK_API_KEY=
# TIBO_AI_FEATURES=signals,search,research,brief,router,translate,answer,repair,oracle,wish,trigger,festival
# TIBO_CHAT_SEARCH=1
# TIBO_CHAT_CONTEXT_TOKENS=900000
# Report maintenance interval; X monitoring normally checks every 300 seconds.
# TIBO_DAEMON_INTERVAL=900
# TIBO_CONFIG_FILE=
# Defaults to .tibo under the process working directory
# TIBO_STATE_DIR=
# Separate Lark adapter; passive interactions, administration and reports have separate scopes
# TIBO_LARK_APP_ID=
# TIBO_LARK_APP_SECRET=
# Optional assertion only; startup retrieves bot identity from the official API.
# TIBO_LARK_BOT_OPEN_ID=
# Passive interactions in every joined group; an explicit list or empty value is also supported.
# TIBO_LARK_CHAT_IDS=all
# Explicit operation/report groups only; these never accept all.
# TIBO_LARK_ADMIN_CHAT_IDS=
# TIBO_LARK_NOTIFY_CHAT_IDS=
# Empty denies dangerous admin operations; normal pray and private self-subscription remain available.
# Dangerous admin operations require a confirmation ID.
# TIBO_LARK_ADMIN_OPEN_IDS=
# The installer records its own UID; manual setup may explicitly set it.
# TIBO_LOCAL_ADMIN_UID=
# TIBO_LARK_DOMAIN=feishu
