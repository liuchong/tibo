# Core collection and rule-based forecasting require no API key
# Optional AI. The daemon installer saves these in ~/.config/tibo/config.env (0600).
# DEEPSEEK_API_KEY=
# TIBO_AI_FEATURES=signals,forecast,brief
# TIBO_AI_WEIGHT=0.2
# TIBO_DAEMON_INTERVAL=900
# TIBO_CONFIG_FILE=
# Defaults to .tibo under the process working directory
# TIBO_STATE_DIR=
# Separate Lark adapter; configure your own standalone app and explicit groups
TIBO_LARK_APP_ID=
TIBO_LARK_APP_SECRET=
TIBO_LARK_BOT_OPEN_ID=
TIBO_LARK_CHAT_IDS=
TIBO_LARK_DOMAIN=feishu
