# See docs/configuration.md for defaults and precedence.
# All examples are commented: even an empty environment value overrides config.env.
# Core collection and historical forecasting require no API key.
# Optional AI. The installer saves private settings in ~/.config/tibo/config.env (0600).
# DEEPSEEK_API_KEY=
# TIBO_AI_FEATURES=signals,search,research,forecast,review,brief,router,translate,answer,repair
# TIBO_AI_WEIGHT=0.2
# TIBO_DAEMON_INTERVAL=900
# TIBO_CONFIG_FILE=
# Defaults to .tibo under the process working directory
# TIBO_STATE_DIR=
# Separate Lark adapter; configure your own standalone app and explicit groups
# TIBO_LARK_APP_ID=
# TIBO_LARK_APP_SECRET=
# Optional assertion only; startup retrieves bot identity from the official API.
# TIBO_LARK_BOT_OPEN_ID=
# TIBO_LARK_CHAT_IDS=
# Empty denies dangerous admin operations; normal pray/subscription remain available.
# Dangerous admin operations require a confirmation ID.
# TIBO_LARK_ADMIN_OPEN_IDS=
# The installer records its own UID; manual setup may explicitly set it.
# TIBO_LOCAL_ADMIN_UID=
# TIBO_LARK_DOMAIN=feishu
